# Copy to .env and fill in. Never commit .env. On a server, scripts/install.sh
# asks for the first values and scripts/set-key.sh adds the rest.
ANTHROPIC_API_KEY=

# Dashboard lock: needed before the dashboard is reachable from the internet
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=

# Reddit "script" app (https://www.reddit.com/prefs/apps). Without these the
# reddit scout falls back to the public read-only JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=venture-factory/0.1 by u/your_username

# Deep Dive marketplaces (official APIs; the App Store needs no key)
ETSY_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Smoke tests
META_ADS_ENABLED=false
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Your domain, e.g. mytrials.co.za: test pages at https://<domain>/pages/<slug>/
FACTORY_DOMAIN=
# Optional: deploy pages to Vercel instead of serving them from the factory
VERCEL_TOKEN=
VERCEL_SCOPE=
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# Ventures
PAYSTACK_SECRET_KEY=

# Optional overrides
# FACTORY_DB=data/factory.db

# Warden reports and alerts by email (optional; standard-library smtplib)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
