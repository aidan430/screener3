# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Reddit "script" app (https://www.reddit.com/prefs/apps). Without these the
# reddit scout falls back to the public read-only JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=venture-factory/0.1 by u/your_username

# Deep Dive marketplaces (official APIs; the App Store needs no key)
ETSY_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Smoke tests
META_ADS_ENABLED=false
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
FACTORY_DOMAIN=
VERCEL_TOKEN=
VERCEL_SCOPE=
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# Ventures
PAYSTACK_SECRET_KEY=

# Optional overrides
# FACTORY_DB=data/factory.db

# Warden reports and alerts by email (optional; standard-library smtplib)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
