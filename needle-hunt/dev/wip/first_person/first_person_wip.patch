+// A pose ({ pos, rot }) moved by a row of six: pos + its first three, rot + its last three.
+Pose.place = (base, off) => CF.mul(CF.new(base.pos[0] + off[0], base.pos[1] + off[1], base.pos[2] + off[2]),
