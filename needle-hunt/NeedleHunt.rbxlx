	<Item class="ServerScriptService" referent="RBX00022">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX00023">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00024">
				<Properties>
					<string name="Name">AntiCheat</string>
					<ProtectedString name="Source"><![CDATA[-- Basic anti-exploit: every Config.AntiCheat.checkEvery seconds, each character's position is
-- compared with the last; moving faster than Config.AntiCheat.maxSpeed (outside a teleport the
-- server made itself, see AntiCheat.allow) puts the character back and flags the player, which
-- stops them claiming a needle for a few seconds. Claims are also checked for distance and rate
-- in server/NeedleSpawner. Nothing here trusts the client.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local AntiCheat = {}
local last = {} -- [player] = { position, time }
local allowedUntil = {} -- [player] = os.clock() a server teleport is allowed until
local flaggedUntil = {} -- [player] = os.clock() claims are refused until
local strikes = {}

-- The server is about to move this player itself (to a map or back to the lobby).
function AntiCheat.allow(player, seconds)
	allowedUntil[player] = os.clock() + (seconds or 2)
	last[player] = nil
end

function AntiCheat.flagged(player)
	return (flaggedUntil[player] or 0) > os.clock()
end

local function check(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		last[player] = nil
		return
	end
	if root.Position.Y < Config.AntiCheat.fallY then -- fell off a map: back you come
		local h = player.Character:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 then
			h.Health = 0
		end
		return
	end
	local now = os.clock()
	local prev = last[player]
	if (allowedUntil[player] or 0) > now or not prev then
		last[player] = { position = root.Position, time = now }
		return
	end
	local speed = (root.Position - prev.position).Magnitude / math.max(now - prev.time, 0.05)
	if speed > Config.AntiCheat.maxSpeed then
		root.CFrame = CFrame.new(prev.position) -- back to where they were
		root.AssemblyLinearVelocity = Vector3.zero
		flaggedUntil[player] = now + 5
		strikes[player] = (strikes[player] or 0) + 1
		warn(string.format("[AntiCheat] %s moved %.0f studs/s; put back (strike %d)", player.Name, speed, strikes[player]))
		if Config.AntiCheat.strikesToKick > 0 and strikes[player] >= Config.AntiCheat.strikesToKick then
			player:Kick("Unusual movement was detected. Please rejoin.")
		end
		return
	end
	last[player] = { position = root.Position, time = now }
end

function AntiCheat.init()
	Players.PlayerRemoving:Connect(function(player)
		last[player], allowedUntil[player], flaggedUntil[player], strikes[player] = nil, nil, nil, nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			AntiCheat.allow(player, 3) -- spawning is a teleport too
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AntiCheat.checkEvery)
			for _, player in ipairs(Players:GetPlayers()) do
				check(player)
			end
		end
	end)
end

return AntiCheat
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00025">
				<Properties>
					<string name="Name">BoxManager</string>
					<ProtectedString name="Source"><![CDATA[-- Box openings (Config.Boxes, shared/Boxes). Coin boxes open through Remotes.Box ("open"); the
-- dearer boxes can also be opened with Robux (a developer product: server/ShopManager calls
-- openInto from ProcessReceipt, then Remotes.BoxResult shows the reel). The server rolls; the
-- odds are shown before every open; every Config.Boxes.pity opens without Rare or better, the
-- next is Rare or better. Where paid random items are restricted (PolicyService), boxes are off
-- for that player: BoxesAllowed = false, and the Boxes screen and stall say so.
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Boxes = require(Shared:WaitForChild("Boxes"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local CollectionManager = require(script.Parent.CollectionManager)

local BoxManager = {}
local rng = Random.new()
local busy = {}

-- Opens `box` into a player's data (call inside DataManager.update). Returns the result.
function BoxManager.openInto(data, box)
	local pityHit = data.boxPity >= Config.Boxes.pity - 1
	local typeId, skinId = Boxes.roll(box, rng, pityHit)
	local result = CollectionManager.addTo(data, typeId, skinId)
	local good = Needles.rarity(result.rarityId).mult >= Needles.rarity("rare").mult
	data.boxPity = if good then 0 else data.boxPity + 1
	data.boxesOpened += 1
	result.box, result.pity = box.id, data.boxPity
	return result
end

local function allowed(player)
	return player:GetAttribute("BoxesAllowed") == true
end

local function openWithCoins(player, boxId)
	local box = Boxes.get(boxId)
	local d = DataManager.get(player)
	if not box or not d then
		return false, "?"
	elseif not allowed(player) then
		return false, "Boxes aren't available where you are."
	elseif busy[player] then
		return false, "One at a time!"
	elseif d.coins < box.coins then
		return false, "You need " .. (box.coins - d.coins) .. " more coins."
	end
	busy[player] = true
	local result
	DataManager.update(player, function(data)
		data.coins -= box.coins
		result = BoxManager.openInto(data, box)
	end)
	CollectionManager.after(player, result)
	task.delay(1, function()
		busy[player] = nil
	end)
	return true, result
end

-- What the Boxes screen needs: whether boxes are on, and how near the pity guarantee you are.
local function info(player)
	local d = DataManager.get(player)
	return { allowed = allowed(player), pity = d and d.boxPity or 0, pityAt = Config.Boxes.pity, coins = d and d.coins or 0 }
end

local function checkPolicy(player)
	local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	-- unknown (the check failed) counts as restricted: boxes stay off rather than risk it
	player:SetAttribute("BoxesAllowed", ok and policy ~= nil and policy.ArePaidRandomItemsRestricted == false)
end

function BoxManager.init()
	Remotes.Box.OnServerInvoke = function(player, action, boxId)
		if action == "info" then
			return info(player)
		elseif action == "open" and type(boxId) == "string" then
			return openWithCoins(player, boxId)
		end
		return nil
	end
	Players.PlayerAdded:Connect(checkPolicy)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(checkPolicy, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		busy[player] = nil
	end)
end

return BoxManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00026">
				<Properties>
					<string name="Name">CollectionManager</string>
					<ProtectedString name="Source"><![CDATA[-- The needle collection, on the server. Each player who finishes a round keeps the needle they
-- found: the server rolls its type and skin (shared/Needles.roll), with a little more luck for
-- 1st place and Hard rounds, and a Golden skin in a Golden Needle round. Boxes (server/BoxManager)
-- and trades (server/TradeManager) add needles too, through addTo. The collection is saved; its value (each different needle once) is shown, ranked on a
-- leaderboard and on the lobby's showcase pedestals. Remotes.Collection lets anyone look at the
-- collection of a player in the same server ("get") and set their own showcase needle ("showcase").
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local QuestManager = require(script.Parent.QuestManager)
local LeaderboardManager = require(script.Parent.LeaderboardManager)

local CollectionManager = {}
local rng = Random.new()

-- Gives `player` the needle they found. Returns what it was, for the reveal.
function CollectionManager.award(player, place, diff, golden)
	local d = DataManager.get(player)
	if not d then
		return nil
	end
	local C = Config.Collection
	local luck = 1 + (if place == 1 then C.firstLuck else 0) + (if diff.id == "hard" then C.hardLuck else 0)
	local typeId, skinId = Needles.roll(rng, luck, golden)
	local result
	DataManager.update(player, function(data)
		result = CollectionManager.addTo(data, typeId, skinId)
	end)
	CollectionManager.after(player, result)
	return result
end

-- Puts a needle in a player's saved data (inside DataManager.update) and says what it was, for
-- the reveal: finds, boxes and trades all add needles this way.
function CollectionManager.addTo(data, typeId, skinId)
	local key = Needles.key(typeId, skinId)
	local isNew = (data.collection[key] or 0) == 0
	data.collection[key] = (data.collection[key] or 0) + 1
	if data.showcase == "" or Needles.value(typeId, skinId) > Needles.value(Needles.split(data.showcase)) then
		data.showcase = key -- your best needle goes on show until you pick one
	end
	local rarity = Needles.rarity(Needles.skin(skinId).rarity)
	return { type = typeId, skin = skinId, name = Needles.name(typeId, skinId), rarity = rarity.name, rarityId = rarity.id, value = Needles.value(typeId, skinId), new = isNew }
end

-- After a needle is added: boards and quests.
function CollectionManager.after(player, result)
	LeaderboardManager.mark(player)
	if result.new then
		QuestManager.record(player, "collect", 1)
	end
	if Needles.rarity(result.rarityId).mult >= Needles.rarity("rare").mult then
		QuestManager.record(player, "rare", 1)
	end
end

-- What a player's collection looks like to anyone in the server.
function CollectionManager.view(target)
	local d = DataManager.get(target)
	if not d then
		return nil
	end
	return { userId = target.UserId, name = target.DisplayName, entries = d.collection, value = Needles.total(d.collection), showcase = d.showcase }
end

function CollectionManager.init()
	Remotes.Collection.OnServerInvoke = function(player, action, arg)
		if action == "get" then
			local target = if type(arg) == "number" then Players:GetPlayerByUserId(arg) else player
			return target and CollectionManager.view(target)
		elseif action == "list" then -- everyone in the server, for the "Look at" buttons
			local list = {}
			for _, p in ipairs(Players:GetPlayers()) do
				local d = DataManager.get(p)
				if d then
					table.insert(list, { userId = p.UserId, name = p.DisplayName, value = Needles.total(d.collection) })
				end
			end
			return list
		elseif action == "showcase" and type(arg) == "string" then
			local d = DataManager.get(player)
			if d and (d.collection[arg] or 0) > 0 then
				DataManager.update(player, function(data)
					data.showcase = arg
				end)
				return true
			end
		end
		return nil
	end
end

return CollectionManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00027">
				<Properties>
					<string name="Name">Combat</string>
					<ProtectedString name="Source"><![CDATA[-- Needle combat. Everyone carries their showcase needle as a tool (the "Needle", rebuilt when the
-- showcase changes) and can inspect it anywhere (Remotes.Inspect: the needle lifts and turns in
-- the hand, and everyone sees it). During a round's search, a poke (Remotes.Poke, with the player
-- aimed at) takes one heart if the server agrees it can land: both in the round, close enough
-- (Config.Combat.reach), roughly in front, off cooldown, and the target not just back in. Three
-- hearts gone and you're tagged out: you pop back at a maze start after Config.Combat.respawn
-- seconds (server/RoundManager puts respawning players back in the maze), safe for a moment.
-- Every needle pokes the same: skins are looks only.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local RewardManager = require(script.Parent.RewardManager)

local Combat = {}
local C, T = Config.Combat, Config.NeedleTool
local round = nil
local lastPoke, lastHit, moving = {}, {}, {}

local function baseGrip()
	return CFrame.Angles(math.rad(T.grip[1]), math.rad(T.grip[2]), math.rad(T.grip[3]))
end

local function toolOf(player)
	local character = player.Character
	return character and character:FindFirstChild("Needle")
end

-- Builds (or rebuilds) a player's Needle tool from their showcase needle.
function Combat.giveTool(player)
	local d = DataManager.get(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local key = if d and d.showcase ~= "" then d.showcase else "sewing:steel"
	local typeId, skinId = Needles.split(key)
	typeId, skinId = typeId or "sewing", skinId or "steel"
	for _, holder in ipairs({ backpack, player.Character }) do
		local old = holder and holder:FindFirstChild("Needle")
		if old then
			old:Destroy()
		end
	end
	local model = NeedleLook.build(typeId, skinId, T.scale, 2)
	local cf, size = model:GetBoundingBox()
	local tool = Instance.new("Tool")
	tool.Name, tool.ToolTip, tool.CanBeDropped, tool.Grip = "Needle", Needles.name(typeId, skinId), false, baseGrip()
	local handle = Instance.new("Part")
	handle.Name, handle.Size, handle.Transparency, handle.CanCollide, handle.Massless = "Handle", Vector3.one * 0.4, 1, false, true
	handle.CFrame = CFrame.new(cf.Position.X - size.X / 2 + 0.5, 0, 0) -- held near the eye end, point outwards
	handle.Parent = tool
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored, part.Massless = false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = handle, part
			weld.Parent = part
			part.Parent = tool
		end
	end
	model:Destroy()
	tool.Parent = backpack
end

-- The tool's little moves, done here so everyone sees them: a jab, and the inspect.
local function play(player, steps)
	local tool = toolOf(player)
	if not tool or moving[player] then
		return
	end
	moving[player] = true
	for _, step in ipairs(steps) do
		local tween = TweenService:Create(tool, TweenInfo.new(step[2], Enum.EasingStyle.Sine), { Grip = step[1] })
		tween:Play()
		tween.Completed:Wait()
	end
	moving[player] = nil
end

local function jab(player)
	local g = baseGrip()
	task.spawn(play, player, { { CFrame.new(0, 0, -1.2) * g, 0.08 }, { g, 0.16 } })
end

local function inspect(player)
	local g, up = baseGrip(), CFrame.new(0, 0.8, -0.4) * CFrame.Angles(math.rad(-55), 0, 0)
	local third = T.inspect / 6
	task.spawn(play, player, {
		{ up * g, third }, -- lifts it to look at
		{ up * g * CFrame.Angles(math.rad(120), 0, 0), third }, -- and turns it round its length
		{ up * g * CFrame.Angles(math.rad(240), 0, 0), third },
		{ up * g * CFrame.Angles(math.rad(360), 0, 0), third },
		{ up * CFrame.Angles(0, 0, math.rad(25)) * g, third }, -- a last tilt to catch the light
		{ g, third },
	})
end

local function inRound(player)
	return round ~= nil and round.participants[player] == true and ReplicatedStorage:GetAttribute("Phase") == "search"
end
Combat.inRound = inRound

local function tagOut(attacker, target, humanoid)
	DataManager.update(attacker, function(d)
		d.eliminations += 1
	end)
	RewardManager.track(attacker, "elims", 1)
	local coins = C.eliminationCoins * (if RewardManager.hasPass(attacker, "DoubleCoins") then 2 else 1)
	RewardManager.grant(attacker, coins, 0, nil)
	Remotes.Notify:FireClient(attacker, { text = "You tagged out " .. target.DisplayName .. "! +" .. coins .. " coins", tone = "good" })
	Remotes.Notify:FireClient(target, { text = attacker.DisplayName .. " tagged you out! Back in " .. C.respawn .. "...", tone = "bad" })
	humanoid.BreakJointsOnDeath = false -- a soft pop, not falling apart
	humanoid.Health = 0
end

local function poke(attacker, targetId)
	local now = os.clock()
	if now - (lastPoke[attacker] or 0) < C.cooldown then
		return
	end
	lastPoke[attacker] = now
	if attacker:GetAttribute("NeedleAway") then
		return -- it's flying: nothing in your hand to poke with
	end
	jab(attacker)
	if not inRound(attacker) or type(targetId) ~= "number" then
		return
	end
	local target = Players:GetPlayerByUserId(targetId)
	local a = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	local b = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local humanoid = b and target.Character:FindFirstChildOfClass("Humanoid")
	if not toolOf(attacker) or not humanoid or humanoid.Health <= 0 or not inRound(target) or target == attacker then
		return
	end
	local offset = b.Position - a.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if offset.Magnitude > C.reach + 1 or (flat.Magnitude > 0.5 and a.CFrame.LookVector:Dot(flat.Unit) < 0.2) then
		return -- too far, or behind you
	end
	Combat.damage(attacker, target, 1)
end

-- Takes `amount` hearts from `target` (a poke 1, a thrown needle Config.Combat.throwDamage), if
-- both are in the round, the target is alive and isn't in their safe time. Returns true if it hit.
function Combat.damage(attacker, target, amount)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local humanoid = root and target.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or target == attacker or not inRound(attacker) or not inRound(target) then
		return false
	elseif (target:GetAttribute("SafeUntil") or 0) > workspace:GetServerTimeNow() then
		return false
	end
	attacker:SetAttribute("SafeUntil", 0) -- attacking ends your own safe time
	local hearts = math.max(0, (target:GetAttribute("Hearts") or C.hearts) - amount)
	target:SetAttribute("Hearts", hearts)
	lastHit[target] = os.clock()
	Remotes.Hit:FireAllClients({ from = attacker.UserId, to = target.UserId, hearts = hearts, position = root.Position, amount = amount })
	if hearts == 0 then
		tagOut(attacker, target, humanoid)
	end
	return true
end

Combat.toolOf = toolOf

function Combat.start(r)
	round = r
	for p in pairs(r.participants) do
		p:SetAttribute("Hearts", C.hearts)
	end
end

function Combat.stop()
	round = nil
end

function Combat.init()
	Players.RespawnTime = C.respawn
	Remotes.Poke.OnServerEvent:Connect(poke)
	Remotes.Inspect.OnServerEvent:Connect(function(player)
		if toolOf(player) then
			inspect(player)
		end
	end)
	local function joined(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			player:SetAttribute("Hearts", C.hearts)
			player:SetAttribute("SafeUntil", workspace:GetServerTimeNow() + C.safe)
			Combat.giveTool(player)
		end)
		player:GetAttributeChangedSignal("Showcase"):Connect(function()
			Combat.giveTool(player)
		end)
	end
	Players.PlayerAdded:Connect(joined)
	for _, p in ipairs(Players:GetPlayers()) do
		joined(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastPoke[player], lastHit[player], moving[player] = nil, nil, nil
	end)
	task.spawn(function() -- hearts come back, one every Config.Combat.regen seconds without a hit
		while true do
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local hearts = p:GetAttribute("Hearts") or C.hearts
				if hearts > 0 and hearts < C.hearts and os.clock() - (lastHit[p] or 0) >= C.regen then
					p:SetAttribute("Hearts", hearts + 1)
					lastHit[p] = os.clock()
				end
			end
		end
	end)
end

return Combat
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00028">
				<Properties>
					<string name="Name">CombatThrow</string>
					<ProtectedString name="Source"><![CDATA[-- Throwing your needle (Config.Throw). The client sends where it's aiming (Remotes.Throw); the
-- server checks you're in the round's search, holding your needle, off cooldown, and that the aim
-- is a real direction, then traces the flight from your head: a sphere the needle's width along
-- the aim, up to its range, stopped by the first wall or player. Everyone's screen draws the
-- flight (Remotes.Thrown); a player hit loses Config.Throw.damage hearts when it arrives
-- (server/Combat.damage, with the same safe-time rules as a poke). The needle is out of your hand
-- until it comes back, so you can't poke in the meantime.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local Combat = require(script.Parent.Combat)

local CombatThrow = {}
local T = Config.Throw
local lastThrow = {}

local function setAway(player, tool, away)
	player:SetAttribute("NeedleAway", away or nil)
	for _, part in ipairs(tool:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "Handle" then
			if away then
				part:SetAttribute("Was", part.Transparency)
				part.Transparency = 1
			else
				part.Transparency = part:GetAttribute("Was") or 0
			end
		end
	end
end

local function throw(player, aim)
	local now = os.clock()
	local tool = Combat.toolOf(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if typeof(aim) ~= "Vector3" or aim.Magnitude < 0.5 or aim.Magnitude > 2 or aim ~= aim then
		return -- not a direction (or not a number)
	elseif not tool or not head or not Combat.inRound(player) or player:GetAttribute("NeedleAway") then
		return
	elseif now - (lastThrow[player] or 0) < T.cooldown then
		return
	end
	lastThrow[player] = now
	local dir = aim.Unit
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { player.Character }
	local origin = head.Position + dir * 1.5
	local hit = workspace:Spherecast(origin, T.radius, dir * T.range, params)
	local finish = if hit then hit.Position else origin + dir * T.range
	local target = hit and Players:GetPlayerFromCharacter(hit.Instance:FindFirstAncestorOfClass("Model"))
	local seconds = (finish - origin).Magnitude / T.speed
	local d = DataManager.get(player)
	Remotes.Thrown:FireAllClients({ from = player.UserId, key = d and d.showcase or "", origin = origin, finish = finish, seconds = seconds, hitPlayer = target ~= nil })
	setAway(player, tool, true)
	task.delay(seconds, function()
		if target then
			Combat.damage(player, target, T.damage)
		end
	end)
	task.delay(T.back, function() -- the needle comes back to your hand
		if tool.Parent then
			setAway(player, tool, false)
		else
			player:SetAttribute("NeedleAway", nil)
		end
	end)
end

function CombatThrow.init()
	Remotes.Throw.OnServerEvent:Connect(throw)
	Players.PlayerRemoving:Connect(function(player)
		lastThrow[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			player:SetAttribute("NeedleAway", nil) -- a fresh needle after a respawn
		end)
	end)
end

return CombatThrow
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00029">
				<Properties>
					<string name="Name">Dash</string>
					<ProtectedString name="Source"><![CDATA[-- Dashing (Config.Dash; the dash itself is client/DashFx, since each player's device moves its
-- own character). The server only rate-limits the announcement and passes it on, so everyone
-- sees a puff of dust where someone dashed. server/AntiCheat keeps checking speed as always.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Dash = {}
local last = {}

function Dash.init()
	Remotes.Dash.OnServerEvent:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or os.clock() - (last[player] or 0) < Config.Dash.cooldown * 0.8 then
			return
		end
		last[player] = os.clock()
		Remotes.Dash:FireAllClients(player.UserId, root.Position - Vector3.new(0, 2.5, 0))
	end)
	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
	end)
end

return Dash
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002A">
				<Properties>
					<string name="Name">DataManager</string>
					<ProtectedString name="Source"><![CDATA[-- Player data: loaded on join, cached for the session, saved with UpdateAsync on an autosave
-- timer, on leave and on shutdown. A save that can't be loaded (DataStores down) plays unsaved,
-- so it can never overwrite the real one. Every other module changes data only through
-- DataManager.update, which marks it to save and shows it to the player (attributes, leaderstats
-- and the Profile remote for the UI).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = {}
local store = nil
local sessions = {} -- [player] = { data, dirty, unsaved }
local loadedCallbacks = {}

-- A fresh save, or an old one with anything missing or the wrong type put right.
local function number(t, key, default)
	local v = type(t) == "table" and t[key]
	return if type(v) == "number" and v == v then v else default
end

function DataManager.fresh(saved)
	saved = if type(saved) == "table" then saved else {}
	local d = {
		coins = number(saved, "coins", 0), coinsEarned = number(saved, "coinsEarned", 0),
		level = math.max(1, math.floor(number(saved, "level", 1))), xp = number(saved, "xp", 0),
		needles = number(saved, "needles", 0), bestTime = number(saved, "bestTime", 0),
		rounds = number(saved, "rounds", 0), wins = number(saved, "wins", 0), winStreak = number(saved, "winStreak", 0),
		lastDay = number(saved, "lastDay", 0), loginStreak = number(saved, "loginStreak", 0),
		hintsDay = number(saved, "hintsDay", 0), hintsUsed = number(saved, "hintsUsed", 0),
		weekly = { week = 0, wins = 0 }, quests = { day = 0, progress = {}, done = {} },
		owned = {}, equipped = {}, receipts = {}, starterBought = saved.starterBought == true, -- the Starter Bundle is once each
		boxPity = number(saved, "boxPity", 0), boxesOpened = number(saved, "boxesOpened", 0), -- opens since the last Rare or better
		eliminations = number(saved, "eliminations", 0),
		collection = {}, showcase = "", -- needles kept: ["type:skin"] = how many; the one on show
		settings = { music = true, sfx = true, reduceEffects = false, autoJoin = true },
	}
	if type(saved.weekly) == "table" then
		d.weekly = { week = number(saved.weekly, "week", 0), wins = number(saved.weekly, "wins", 0) }
	end
	if type(saved.quests) == "table" then
		d.quests.day = number(saved.quests, "day", 0)
		for key, list in pairs({ progress = saved.quests.progress, done = saved.quests.done }) do
			if type(list) == "table" then
				for id, v in pairs(list) do
					if type(id) == "string" and (type(v) == "number" or v == true) then
						d.quests[key][id] = v
					end
				end
			end
		end
	end
	for _, id in ipairs(Cosmetics.starting) do
		d.owned[id] = true
	end
	if type(saved.owned) == "table" then
		for id, v in pairs(saved.owned) do
			if v == true and Cosmetics.get(id) then
				d.owned[id] = true
			end
		end
	end
	for kind, id in pairs(Cosmetics.defaults) do
		d.equipped[kind] = id
	end
	if type(saved.equipped) == "table" then
		for kind, id in pairs(saved.equipped) do
			local item = Cosmetics.get(id)
			if item and item.kind == kind and d.owned[id] then
				d.equipped[kind] = id
			end
		end
	end
	if type(saved.settings) == "table" then
		for key, default in pairs(d.settings) do
			local v = saved.settings[key]
			d.settings[key] = if type(v) == "boolean" then v else default
		end
	end
	if type(saved.collection) == "table" then
		for key, count in pairs(saved.collection) do
			if type(count) == "number" and count > 0 and Needles.split(key) then
				d.collection[key] = math.floor(count)
			end
		end
	end
	if type(saved.showcase) == "string" and d.collection[saved.showcase] then
		d.showcase = saved.showcase
	end
	if type(saved.receipts) == "table" then
		for _, id in ipairs(saved.receipts) do
			if type(id) == "string" then
				table.insert(d.receipts, id)
			end
		end
	end
	return d
end

local function key(player)
	return "u_" .. player.UserId
end

local function load(player)
	if not store then
		return DataManager.fresh(nil), false
	end
	for attempt = 1, Config.LoadRetries do
		local ok, saved = pcall(store.GetAsync, store, key(player))
		if ok then
			return DataManager.fresh(saved), true
		end
		warn("[Data] load failed for " .. player.Name .. " (try " .. attempt .. "): " .. tostring(saved))
		task.wait(2 ^ attempt)
	end
	return DataManager.fresh(nil), false
end

-- Shows the data to the player: attributes for the HUD, leaderstats, and the Profile remote.
local function publish(player, d)
	player:SetAttribute("Coins", d.coins)
	player:SetAttribute("Level", d.level)
	player:SetAttribute("XP", d.xp)
	player:SetAttribute("XPNeed", Rules.xpNeed(d.level))
	player:SetAttribute("Needles", d.needles)
	player:SetAttribute("Wins", d.wins)
	player:SetAttribute("Showcase", d.showcase) -- server/Combat rebuilds your Needle tool when it changes
	player:SetAttribute("BestTime", d.bestTime)
	player:SetAttribute("LoginStreak", d.loginStreak)
	local kinds = 0
	for _ in pairs(d.collection) do
		kinds += 1
	end
	player:SetAttribute("CollectionValue", Needles.total(d.collection))
	player:SetAttribute("CollectionCount", kinds)
	player:SetAttribute("HintsUsed", if d.hintsDay == math.floor(os.time() / 86400) then d.hintsUsed else 0) -- hints reset each day (UTC)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Level.Value, stats.Needles.Value, stats.Collection.Value = d.level, d.needles, Needles.total(d.collection)
	end
	Remotes.Profile:FireClient(player, { owned = d.owned, equipped = d.equipped, quests = d.quests, settings = d.settings, collection = d.collection, showcase = d.showcase, starterBought = d.starterBought })
end

function DataManager.get(player)
	local s = sessions[player]
	return s and s.data
end

function DataManager.unsaved(player)
	local s = sessions[player]
	return s ~= nil and s.unsaved
end

-- Changes a player's data: change(data) edits it in place.
function DataManager.update(player, change)
	local s = sessions[player]
	if not s then
		return false
	end
	change(s.data)
	s.dirty = true
	publish(player, s.data)
	return true
end

-- Saves now (UpdateAsync, so a newer save on another server is never lost to an older one).
function DataManager.save(player)
	local s = sessions[player]
	if not s or s.unsaved or not store then
		return false
	end
	local data = s.data
	local ok, err = pcall(store.UpdateAsync, store, key(player), function()
		return data
	end)
	if ok then
		s.dirty = false
	else
		warn("[Data] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataManager.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function added(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Level", "Needles", "Collection" }) do
		Instance.new("IntValue", stats).Name = name
	end
	stats.Parent = player
	local data, ok = load(player)
	if player.Parent == nil then
		return
	end
	sessions[player] = { data = data, dirty = false, unsaved = not ok }
	publish(player, data)
	if not ok then
		Remotes.Notify:FireClient(player, { text = "We couldn't load your save, so this visit won't be saved. Try rejoining later.", tone = "bad" })
	end
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
end

function DataManager.init()
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, Config.DataStoreName)
	store = if ok then result else nil
	if not store then
		warn("[Data] DataStores unavailable (in Studio: Game Settings > Security > Enable Studio Access to API Services)")
	end
	Players.PlayerAdded:Connect(added)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(added, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataManager.save(player)
		sessions[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(sessions) do
			pending += 1
			task.spawn(function()
				DataManager.save(player)
				pending -= 1
			end)
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited += task.wait(0.5)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, s in pairs(sessions) do
				if s.dirty then
					task.spawn(DataManager.save, player)
				end
			end
		end
	end)
end

return DataManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002B">
				<Properties>
					<string name="Name">HaystackModel</string>
					<ProtectedString name="Source"><![CDATA[-- The owner's own haystack model (Config.Haystacks.model): loaded once with InsertService (it must
-- belong to the game's owner, or be public), centred and set on its base. MapKit.haystack places a
-- copy, scaled to each haystack's size, wherever one goes. Until it loads (or with no ID), the
-- built terrain haystacks are used.
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local HaystackModel = {}
local template = nil

function HaystackModel.load()
	local id = Config.Haystacks.model
	if id == 0 then
		return
	end
	local ok, asset = pcall(InsertService.LoadAsset, InsertService, id)
	if not ok or not asset then
		warn("[HaystackModel] couldn't load model " .. id .. ": " .. tostring(asset) .. " (it must be owned by the game's owner or be public)")
		return
	end
	local model = asset:FindFirstChildWhichIsA("Model") or asset
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanQuery, p.CanTouch = true, false, false
		end
	end
	local cf, size = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(cf.Position - Vector3.new(0, size.Y / 2, 0)) -- the middle of its base
	model:PivotTo(CFrame.new())
	model.Name = "Haystack"
	template = model
end

-- A copy standing on `ground` (a Vector3), about `width` studs across; nil if there's no model.
function HaystackModel.place(ground, width, turn)
	if not template then
		return nil
	end
	local m = template:Clone()
	local _, size = m:GetBoundingBox()
	m:ScaleTo(m:GetScale() * width / math.max(size.X, size.Z))
	m:PivotTo(CFrame.new(ground) * CFrame.Angles(0, turn, 0))
	return m
end

return HaystackModel
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002C">
				<Properties>
					<string name="Name">LeaderboardManager</string>
					<ProtectedString name="Source"><![CDATA[-- Global leaderboards (Config.Boards), each an OrderedDataStore: most needles, fastest find,
-- highest level, most coins earned and this week's winners. Writes are batched: a player is
-- marked when a stat changes and written every Config.BoardFlushSeconds (and when they leave),
-- never more than the DataStore budget allows. Each board is read every Config.BoardReadSeconds
-- into a cache that the lobby boards and the Leaderboard screen show; clients never read stores.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)

local LeaderboardManager = {}
local dirty = {} -- [player] = true
local cache = {} -- [board id] = { { name, value } }
local names = {} -- [userId] = name
local listeners = {}

local function storeFor(board)
	local name = board.store .. (if board.weekly then tostring(Rules.week()) else "")
	local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, name)
	return if ok then store else nil
end

-- The value a player has on a board (nil = nothing to write).
local function valueFor(board, d)
	if board.id == "needles" then
		return d.needles
	elseif board.id == "fastest" then
		return if d.bestTime > 0 then math.floor(d.bestTime * 10) else nil -- tenths of a second
	elseif board.id == "level" then
		return d.level
	elseif board.id == "coins" then
		return d.coinsEarned
	elseif board.id == "collection" then
		return if next(d.collection) then Needles.total(d.collection) else nil
	elseif board.id == "weekly" then
		return if d.weekly.week == Rules.week() and d.weekly.wins > 0 then d.weekly.wins else nil
	end
	return nil
end

function LeaderboardManager.mark(player)
	dirty[player] = true
end

local function budget()
	return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.SetIncrementSortedAsync)
end

local function write(player)
	local d = DataManager.get(player)
	if not d or DataManager.unsaved(player) then
		return
	end
	for _, board in ipairs(Config.Boards) do
		local value = valueFor(board, d)
		local store = value and budget() > 2 and storeFor(board)
		if store then
			pcall(store.SetAsync, store, tostring(player.UserId), value)
		end
	end
	dirty[player] = nil
end

local function nameOf(userId)
	if not names[userId] then
		local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
		names[userId] = if ok then name else "Player"
	end
	return names[userId]
end

local function read()
	for _, board in ipairs(Config.Boards) do
		local store = storeFor(board)
		local ok, pages = false, nil
		if store then
			ok, pages = pcall(store.GetSortedAsync, store, board.ascending, Config.BoardRows)
		end
		if ok and pages then
			local rows = {}
			for _, entry in ipairs(pages:GetCurrentPage()) do
				local value = if board.seconds then entry.value / 10 else entry.value
				table.insert(rows, { name = nameOf(tonumber(entry.key)), value = value })
			end
			cache[board.id] = rows
		end
	end
	for _, listener in ipairs(listeners) do
		task.spawn(listener, cache)
	end
end

-- This server's players on a board (shown when the global store can't be reached, and on the
-- "This server" tab, where friends you play with appear).
function LeaderboardManager.serverRows(boardId)
	local board
	for _, b in ipairs(Config.Boards) do
		if b.id == boardId then
			board = b
		end
	end
	local rows = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local d = DataManager.get(p)
		local v = board and d and valueFor(board, d)
		if v then
			table.insert(rows, { name = p.DisplayName, value = if board.seconds then v / 10 else v })
		end
	end
	table.sort(rows, function(a, b)
		if board.ascending then
			return a.value < b.value
		end
		return a.value > b.value
	end)
	return rows
end

function LeaderboardManager.cache()
	return cache
end

-- callback(cache) runs after each read (the lobby boards).
function LeaderboardManager.onUpdate(callback)
	table.insert(listeners, callback)
end

function LeaderboardManager.init()
	Remotes.Boards.OnServerInvoke = function(_player, boardId)
		if type(boardId) ~= "string" then
			return nil
		end
		return { global = cache[boardId] or {}, server = LeaderboardManager.serverRows(boardId) }
	end
	Players.PlayerRemoving:Connect(function(player)
		if dirty[player] then
			write(player)
		end
		dirty[player] = nil
	end)
	task.spawn(function()
		while true do
			read()
			task.wait(Config.BoardReadSeconds)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.BoardFlushSeconds)
			for player in pairs(dirty) do
				if player.Parent then
					write(player)
				end
			end
		end
	end)
end

return LeaderboardManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002D">
				<Properties>
					<string name="Name">LobbyBuilder</string>
					<ProtectedString name="Source"><![CDATA[-- The lobby, built once at Config.LobbyCentre: a wooden plaza in a field, the animated title sign
-- (a giant needle turns above it), the glowing Play pad with the next round's countdown, a
-- leaderboard that cycles through every board, the Daily Challenge board, a Shop stall and a
-- Wardrobe (their prompts open those screens on the player's own UI), and haystacks round the edge.
-- Paths, fountains, flowers, lamps, trees and the hay yard are in LobbyDecor.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Quests = require(Shared:WaitForChild("Quests"))
local Rules = require(Shared:WaitForChild("Rules"))
local MapKit = require(script.Parent.MapKit)
local LeaderboardManager = require(script.Parent.LeaderboardManager)
local DataManager = require(script.Parent.DataManager)
local Needles = require(Shared:WaitForChild("Needles"))
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))

local LobbyBuilder = {}
local ctx = nil

-- A board at map-local (x, y, z) facing the plaza, with a SurfaceGui on its front (a part's
-- Front face looks down its LookVector); returns the frame to write on.
local function board(name, x, y, z, w, h)
	local pos = MapKit.at(ctx, x, y, z)
	local cf = CFrame.lookAt(pos, MapKit.at(ctx, 0, y, 10))
	local p = MapKit.part(ctx, { Name = name, Size = Vector3.new(w, h, 0.6), CFrame = cf, Color = { 120, 84, 50 }, Material = "WoodPlanks" })
	for _, dx in ipairs({ -w / 2 + 0.6, w / 2 - 0.6 }) do
		MapKit.part(ctx, { Name = "Post", Size = Vector3.new(0.8, h + cf.Position.Y, 0.8), CFrame = cf * CFrame.new(dx, -(cf.Position.Y) / 2, 0.5), Color = { 96, 66, 40 }, Material = "Wood" })
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.SizingMode, gui.PixelsPerStud, gui.LightInfluence = Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 30, 0.1
	gui.Parent = p
	local paper = Instance.new("Frame")
	paper.Size, paper.Position, paper.BackgroundColor3 = UDim2.new(1, -24, 1, -24), UDim2.fromOffset(12, 12), Color3.fromRGB(30, 34, 44)
	Instance.new("UICorner", paper).CornerRadius = UDim.new(0, 18)
	paper.Parent = gui
	return paper
end

local function text(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency, l.Font, l.TextScaled, l.TextColor3 = 1, Enum.Font.BuilderSansBold, true, Color3.new(1, 1, 1)
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function stall(name, x, z, opens, colour)
	local base = MapKit.at(ctx, x, 0, z)
	MapKit.part(ctx, { Name = name, Size = Vector3.new(10, 3, 5), CFrame = CFrame.new(base + Vector3.new(0, 1.5, 0)), Color = { 150, 106, 64 }, Material = "WoodPlanks" })
	for _, dx in ipairs({ -4.6, 4.6 }) do
		MapKit.part(ctx, { Name = "Post", Size = Vector3.new(0.6, 8, 0.6), CFrame = CFrame.new(base + Vector3.new(dx, 4, -2)), Color = { 96, 66, 40 }, Material = "Wood" })
	end
	local roof = MapKit.part(ctx, { Name = "Awning", Size = Vector3.new(11, 0.5, 6), CFrame = CFrame.new(base + Vector3.new(0, 8.2, -0.5)) * CFrame.Angles(math.rad(-12), 0, 0), Color = colour, Material = "Fabric" })
	local sign = Instance.new("SurfaceGui")
	sign.Face, sign.PixelsPerStud, sign.SizingMode = Enum.NormalId.Top, 20, Enum.SurfaceGuiSizingMode.PixelsPerStud
	sign.Parent = roof
	text(sign, { Size = UDim2.fromScale(1, 1), Text = opens:upper() })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText, prompt.HoldDuration, prompt.MaxActivationDistance = "Open", opens, 0, 12
	prompt:SetAttribute("Opens", opens)
	prompt.Parent = ctx.model:FindFirstChild(name)
end

-- The Hall of Needles: three pedestals in front of the title sign showing the most valuable
-- collections in this server, each with its owner's showcase needle turning slowly above it.
function LobbyBuilder.showcase()
	local slots = {}
	local sign = board("HallSign", 0, 4.4, -31, 16, 2.6) -- a banner behind the pedestals, under the title sign
	text(sign, { Size = UDim2.new(1, -30, 1, -14), Position = UDim2.fromOffset(15, 7), Text = "HALL OF NEEDLES", TextColor3 = Color3.fromRGB(255, 214, 90) })
	local rims = { { 200, 206, 216 }, { 255, 200, 70 }, { 205, 140, 90 } } -- 2nd (left), 1st (middle), 3rd (right)
	for i, x in ipairs({ -13, 0, 13 }) do
		local base = MapKit.at(ctx, x, 0, -24)
		local h = if i == 2 then 4.2 else 3.2
		local pedestal = MapKit.part(ctx, { Name = "Pedestal", Shape = "Cylinder", Size = Vector3.new(h, 6, 6), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 236, 230, 214 }, Material = "Marble" })
		MapKit.part(ctx, { Name = "Rim", Shape = "Cylinder", Size = Vector3.new(0.35, 6.4, 6.4), CFrame = CFrame.new(base + Vector3.new(0, h - 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = rims[i], Material = "Metal" })
		local tag = Instance.new("BillboardGui")
		tag.Size, tag.StudsOffset, tag.MaxDistance = UDim2.fromOffset(240, 70), Vector3.new(0, h / 2 + 5.4, 0), 80
		tag.Parent = pedestal
		local label = text(tag, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.3, Text = "" })
		slots[i] = { top = base + Vector3.new(0, h + 2.6, 0), label = label, model = nil, key = nil }
	end
	local order = { 2, 1, 3 } -- the best in the middle, on the tallest
	task.spawn(function()
		local spin = 0
		while true do
			local ranked = {}
			for _, p in ipairs(Players:GetPlayers()) do
				local d = DataManager.get(p)
				if d and d.showcase ~= "" then
					table.insert(ranked, { player = p, value = Needles.total(d.collection), key = d.showcase })
				end
			end
			table.sort(ranked, function(a, b)
				return a.value > b.value
			end)
			for rank, slotIndex in ipairs(order) do
				local slot, entry = slots[slotIndex], ranked[rank]
				local key = entry and (entry.player.UserId .. entry.key)
				if key ~= slot.key then
					if slot.model then
						slot.model:Destroy()
						slot.model = nil
					end
					slot.key = key
					if entry then
						local t, s = Needles.split(entry.key)
						slot.model = NeedleLook.build(t, s, 1.5, 2) -- the longest (knitting) is about 4.5 studs: it fits the 6-stud top
						slot.model.Parent = ctx.model
					end
				end
				slot.label.Text = if entry then entry.player.DisplayName .. "\n" .. Rules.commas(entry.value) .. " collection value" else ""
			end
			for _ = 1, 50 do -- turn the needles slowly for 5 seconds, then look again
				spin += 0.04
				for _, slot in ipairs(slots) do
					if slot.model then
						slot.model:PivotTo(CFrame.new(slot.top) * CFrame.Angles(0, spin, math.rad(20)))
					end
				end
				task.wait(0.1)
			end
		end
	end)
end

function LobbyBuilder.spawnPoint(i)
	local a = (i or 1) * 2.399 -- spread out round the pad
	return CFrame.new(MapKit.at(ctx, math.cos(a) * 10, 3, 18 + math.sin(a) * 6))
end

function LobbyBuilder.build()
	local model = Instance.new("Model")
	model.Name = "Lobby"
	model.Parent = workspace
	ctx = { model = model, rng = Random.new(7), centre = Config.LobbyCentre, def = { straw = { 226, 188, 92 } }, spots = {}, spawns = {}, floorY = 0 }
	MapKit.ground(ctx, 260, 260, { 104, 160, 76 }, "Grass")
	MapKit.edges(ctx, 90, 90, { 104, 160, 76 }) -- a hedge all the way round: nobody wanders off
	MapKit.part(ctx, { Name = "Plaza", Size = Vector3.new(170, 0.4, 170), CFrame = CFrame.new(MapKit.at(ctx, 0, 0.2, 0)), Color = { 116, 172, 82 }, Material = "Grass" }) -- a lawn (LobbyDecor lays the paths)
	-- you arrive at the front, facing the Champion's Needle (server/LobbySocial) and the Play pad
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored, spawn.Size, spawn.Duration, spawn.Neutral = true, Vector3.new(12, 1, 12), 0, true
	spawn.CFrame, spawn.Color, spawn.Material = CFrame.new(MapKit.at(ctx, 0, 0.5, 72)), Color3.fromRGB(196, 150, 92), Enum.Material.WoodPlanks
	spawn.Parent = model
	for _, b in ipairs({ { -30, 56, 0 }, { 30, 56, 0 }, { -38, -6, 90 }, { 38, -6, 90 } }) do -- benches to sit and chat
		local seat = Instance.new("Seat")
		seat.Anchored, seat.Size, seat.Color, seat.Material = true, Vector3.new(8, 1, 2.4), Color3.fromRGB(140, 98, 58), Enum.Material.WoodPlanks
		seat.CFrame = CFrame.new(MapKit.at(ctx, b[1], 1.5, b[2])) * CFrame.Angles(0, math.rad(b[3]), 0)
		seat.Parent = model
		MapKit.part(ctx, { Name = "BenchBack", Size = Vector3.new(8, 2.4, 0.4), CFrame = seat.CFrame * CFrame.new(0, 1.4, 1.1), Color = { 120, 84, 50 }, Material = "WoodPlanks" })
	end
	-- the title sign and its turning needle
	local title = board("TitleSign", 0, 14, -54, 40, 9) -- well behind the Hall, so its needles stand clear
	text(title, { Size = UDim2.new(1, -40, 0.62, 0), Position = UDim2.new(0, 20, 0.06, 0), Text = "A NEEDLE IN A HAYSTACK", TextColor3 = Color3.fromRGB(255, 214, 90) })
	text(title, { Size = UDim2.new(1, -40, 0.26, 0), Position = UDim2.new(0, 20, 0.68, 0), Text = "Find it first. Win the round.", TextColor3 = Color3.fromRGB(220, 226, 240) })
	local needle = MapKit.part(ctx, { Name = "BigNeedle", Shape = "Cylinder", Size = Vector3.new(16, 0.6, 0.6), CFrame = CFrame.new(MapKit.at(ctx, 0, 23, -54)), Color = { 210, 214, 224 }, Material = "Metal", CanCollide = false })
	TweenService:Create(needle, TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { CFrame = needle.CFrame * CFrame.Angles(math.pi, 0, 0) }):Play()
	TweenService:Create(needle, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = needle.Position + Vector3.new(0, 1.2, 0) }):Play()
	-- the Play pad
	local pad = MapKit.part(ctx, { Name = "PlayPad", Shape = "Cylinder", Size = Vector3.new(0.4, 18, 18), CFrame = CFrame.new(MapKit.at(ctx, 0, 0.6, 6)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 255, 206, 80 }, Material = "Neon", CanCollide = false })
	local above = Instance.new("BillboardGui")
	above.Size, above.StudsOffset, above.AlwaysOnTop = UDim2.fromOffset(420, 120), Vector3.new(0, 4, 0), false -- low over the pad, clear of the title sign
	above.Parent = pad
	local status = text(above, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.3, Text = "" })
	task.spawn(function()
		while true do
			local phase = ReplicatedStorage:GetAttribute("Phase")
			local left = (ReplicatedStorage:GetAttribute("EndsAt") or 0) - workspace:GetServerTimeNow()
			status.Text = if phase == "lobby" then "NEXT ROUND IN " .. Rules.clock(left) elseif phase == "search" then "ROUND IN PLAY: " .. Rules.clock(left) else "GET READY..."
			task.wait(0.5)
		end
	end)
	-- the leaderboard: cycles through every board
	local lb = board("Leaderboard", -34, 9, -8, 18, 16)
	local lbTitle = text(lb, { Size = UDim2.new(1, -30, 0.11, 0), Position = UDim2.new(0, 15, 0.02, 0), TextColor3 = Color3.fromRGB(255, 214, 90) })
	local lbRows = {}
	for i = 1, Config.BoardRows do
		lbRows[i] = text(lb, { Size = UDim2.new(1, -40, 0.075, 0), Position = UDim2.new(0, 20, 0.14 + (i - 1) * 0.084, 0), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.BuilderSans })
	end
	task.spawn(function()
		local i = 0
		while true do
			i = i % #Config.Boards + 1
			local b = Config.Boards[i]
			local rows = LeaderboardManager.cache()[b.id]
			if not rows or #rows == 0 then
				rows = LeaderboardManager.serverRows(b.id)
			end
			lbTitle.Text = b.name
			for r = 1, Config.BoardRows do
				local row = rows[r]
				lbRows[r].Text = if row then r .. ".  " .. row.name .. "  ·  " .. (if b.seconds then string.format("%.1fs", row.value) else Rules.commas(row.value)) else ""
			end
			task.wait(8)
		end
	end)
	-- the daily challenge board
	local dc = board("DailyChallenge", 34, 9, -8, 18, 12)
	text(dc, { Size = UDim2.new(1, -30, 0.16, 0), Position = UDim2.new(0, 15, 0.03, 0), Text = "DAILY CHALLENGE", TextColor3 = Color3.fromRGB(255, 214, 90) })
	local dcRows = {}
	for i = 1, Quests.perDay do
		dcRows[i] = text(dc, { Size = UDim2.new(1, -40, 0.18, 0), Position = UDim2.new(0, 20, 0.22 + (i - 1) * 0.25, 0), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.BuilderSans })
	end
	task.spawn(function()
		while true do
			for i, q in ipairs(Quests.forDay(Quests.today())) do
				dcRows[i].Text = "• " .. q.text .. "  (+" .. q.coins .. " coins)"
			end
			task.wait(60)
		end
	end)
	LobbyBuilder.showcase()
	stall("ShopStall", -18, 30, "Shop", { 196, 64, 50 })
	stall("Wardrobe", 18, 30, "Inventory", { 76, 106, 170 })
	stall("BoxStall", -34, 30, "Boxes", { 230, 120, 50 })
	require(script.Parent.LobbySocial).build(ctx, text)
	require(script.Parent.LobbyDecor).build(ctx)
	-- the countryside beyond the hedge, and a few bales on the plaza
	for _, h in ipairs({ { -110, -80 }, { 110, -84 }, { -120, 40 }, { 122, 50 }, { 0, -120 }, { -70, 115 }, { 76, 118 } }) do
		MapKit.haystack(ctx, h[1], h[2], 7, 12)
	end
	for _, b in ipairs({ { -30, 0, -30 }, { 30, 0, -32 }, { -44, 0, 30 }, { 44, 0, 32 } }) do
		MapKit.bale(ctx, b[1], b[2], b[3], ctx.rng:NextNumber() * 3)
	end
	Players.PlayerAdded:Connect(function(player)
		player.RespawnLocation = spawn
	end)
end

return LobbyBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002E">
				<Properties>
					<string name="Name">LobbyDecor</string>
					<ProtectedString name="Source"><![CDATA[-- The lobby's dressing (LobbyBuilder calls build once): a lawn crossed by cobbled paths (spawn to
-- the Champion, the Play pad and the Hall; a cross path to the boards; walks along the booths), two
-- spool fountains by the spawn, flower beds, lamp posts along the paths, trees along the hedge and
-- a hay yard of real haystacks behind the title sign. Nothing here does anything; it's to look at.
local MapKit = require(script.Parent.MapKit)

local LobbyDecor = {}

local STONE = { 196, 182, 154 }
local FLOWERS = { { 240, 90, 110 }, { 255, 200, 70 }, { 250, 248, 240 }, { 170, 110, 240 }, { 255, 140, 60 } }

-- Paths: { x, z, width (x), length (z) } just above the lawn.
local PATHS = {
	{ 0, 18, 14, 124 }, -- the avenue: spawn, Champion, stalls, Play pad, Hall
	{ 0, -8, 120, 10 }, -- the cross path to the boards
	{ 0, 62, 112, 8 }, -- the front path to the booths
	{ -59, 0, 8, 116 }, { 59, 0, 8, 116 }, -- walks along the booths
	{ 0, -26, 40, 20 }, -- the Hall's square
}
local BEDS = { { -12, 62, 6, 10 }, { 12, 62, 6, 10 }, { -12, 40, 6, 8 }, { 12, 40, 6, 8 }, { -46, -36, 10, 6 }, { 46, -36, 10, 6 }, { -46, 16, 10, 6 }, { 46, 16, 10, 6 }, { -40, 82, 12, 4 }, { 40, 82, 12, 4 } }
local LAMPS = { { -9, 76 }, { 9, 76 }, { -9, 54 }, { 9, 54 }, { -9, 36 }, { 9, 36 }, { -9, -40 }, { 9, -40 }, { -20, -14 }, { 20, -14 }, { -50, -14 }, { 50, -14 }, { -54, 40 }, { 54, 40 }, { -54, -40 }, { 54, -40 } }
local FOUNTAINS = { { -40, 72, { 196, 64, 50 } }, { 40, 72, { 76, 106, 170 } } }
local HAYSTACKS = { { -48, -70, 7, 12 }, { 48, -72, 7, 12 }, { -76, -78, 5, 9 }, { 76, -76, 5, 9 }, { -22, -78, 5, 8 }, { 24, -79, 5, 8 } }

local function upright(x, y, z, length, diameter)
	return CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(length, diameter, diameter)
end

local function bed(ctx, x, z, w, d)
	local c = MapKit.at(ctx, x, 0, z)
	MapKit.part(ctx, { Name = "Planter", Size = Vector3.new(w, 0.9, d), CFrame = CFrame.new(c + Vector3.new(0, 0.45, 0)), Color = { 120, 84, 50 }, Material = "WoodPlanks" })
	MapKit.part(ctx, { Name = "Soil", Size = Vector3.new(w - 0.6, 0.1, d - 0.6), CFrame = CFrame.new(c + Vector3.new(0, 0.95, 0)), Color = { 90, 62, 40 }, Material = "Ground", CanCollide = false })
	for i = 1, math.floor(w * d / 2) do
		local p = c + Vector3.new((ctx.rng:NextNumber() - 0.5) * (w - 1.2), 1.15, (ctx.rng:NextNumber() - 0.5) * (d - 1.2))
		MapKit.part(ctx, { Name = "Flower", Shape = "Ball", Size = Vector3.one * 0.6, CFrame = CFrame.new(p), Color = FLOWERS[(i - 1) % #FLOWERS + 1], Material = "SmoothPlastic", CanCollide = false })
	end
end

local function lampPost(ctx, x, z)
	local base = MapKit.at(ctx, x, 0, z)
	local cf, size = upright(base.X, base.Y + 4.5, base.Z, 9, 0.5)
	MapKit.part(ctx, { Name = "LampPost", Shape = "Cylinder", Size = size, CFrame = cf, Color = { 60, 56, 52 }, Material = "Metal" })
	MapKit.lamp(ctx, base + Vector3.new(0, 9.5, 0), { 255, 210, 140 }, 18)
	MapKit.part(ctx, { Name = "LampCap", Size = Vector3.new(1.4, 0.3, 1.4), CFrame = CFrame.new(base + Vector3.new(0, 10.25, 0)), Color = { 60, 56, 52 }, Material = "Metal" })
end

-- A fountain with a giant spool of thread in the middle and a needle stuck through it.
local function fountain(ctx, x, z, thread)
	local c = MapKit.at(ctx, x, 0, z)
	local cf, size = upright(c.X, c.Y + 0.8, c.Z, 1.6, 14)
	MapKit.part(ctx, { Name = "Basin", Shape = "Cylinder", Size = size, CFrame = cf, Color = { 226, 220, 206 }, Material = "Marble" })
	cf, size = upright(c.X, c.Y + 1.55, c.Z, 0.2, 12.6)
	MapKit.part(ctx, { Name = "Water", Shape = "Cylinder", Size = size, CFrame = cf, Color = { 110, 180, 220 }, Material = "Glass", Transparency = 0.25, CanCollide = false })
	for _, y in ipairs({ 2.0, 8.2 }) do
		cf, size = upright(c.X, c.Y + y, c.Z, 0.8, 5)
		MapKit.part(ctx, { Name = "SpoolEnd", Shape = "Cylinder", Size = size, CFrame = cf, Color = { 150, 106, 64 }, Material = "Wood" })
	end
	cf, size = upright(c.X, c.Y + 5.1, c.Z, 5.4, 3.6)
	local spool = MapKit.part(ctx, { Name = "Thread", Shape = "Cylinder", Size = size, CFrame = cf, Color = thread, Material = "Fabric" })
	MapKit.part(ctx, { Name = "SpoolNeedle", Shape = "Cylinder", Size = Vector3.new(8, 0.35, 0.35), CFrame = CFrame.new(c + Vector3.new(0.6, 7.4, 0)) * CFrame.Angles(0, math.rad(30), math.rad(55)), Color = { 210, 214, 224 }, Material = "Metal", CanCollide = false })
	local spray = Instance.new("ParticleEmitter") -- a soft spray falling off the spool into the basin
	spray.Rate, spray.Lifetime, spray.Speed, spray.SpreadAngle = 30, NumberRange.new(1, 1.4), NumberRange.new(6, 8), Vector2.new(30, 30)
	spray.Acceleration, spray.Transparency = Vector3.new(0, -24, 0), NumberSequence.new(0.3, 1)
	spray.Size, spray.Color = NumberSequence.new(0.35, 0.1), ColorSequence.new(Color3.fromRGB(200, 230, 255))
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(3.4, 0, 0) -- the spool's top (the cylinder's axis is its X)
	top.Parent = spool
	spray.Parent = top
end

function LobbyDecor.build(ctx)
	for _, p in ipairs(PATHS) do
		MapKit.part(ctx, { Name = "Path", Size = Vector3.new(p[3], 0.12, p[4]), CFrame = CFrame.new(MapKit.at(ctx, p[1], 0.44, p[2])), Color = STONE, Material = "Cobblestone" })
	end
	local pad = MapKit.at(ctx, 0, 0.46, 6)
	local cf, size = upright(pad.X, pad.Y, pad.Z, 0.12, 32) -- the round paving under the Play pad
	MapKit.part(ctx, { Name = "PadPaving", Shape = "Cylinder", Size = size, CFrame = cf, Color = STONE, Material = "Cobblestone" })
	for _, b in ipairs(BEDS) do
		bed(ctx, b[1], b[2], b[3], b[4])
	end
	for _, l in ipairs(LAMPS) do
		lampPost(ctx, l[1], l[2])
	end
	for _, f in ipairs(FOUNTAINS) do
		fountain(ctx, f[1], f[2], f[3])
	end
	for _, side in ipairs({ -80, 80 }) do -- a row of trees behind each line of booths
		for z = -60, 60, 20 do
			MapKit.tree(ctx, side, z, 13 + ctx.rng:NextNumber() * 4)
		end
	end
	for _, t in ipairs({ { -78, 80 }, { 78, 80 }, { -60, -84 }, { 60, -84 } }) do
		MapKit.tree(ctx, t[1], t[2], 14)
	end
	for _, h in ipairs(HAYSTACKS) do -- the hay yard behind the title sign
		MapKit.haystack(ctx, h[1], h[2], h[3], h[4])
	end
	for _, b in ipairs({ { -36, -74 }, { 36, -76 }, { -60, -70 }, { 62, -66 } }) do
		MapKit.bale(ctx, b[1], 0, b[2], ctx.rng:NextNumber() * 3)
	end
end

return LobbyDecor
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0002F">
				<Properties>
					<string name="Name">LobbyShowOff</string>
					<ProtectedString name="Source"><![CDATA[-- Show off (Remotes.ShowOff): hold your showcase needle (or your best) up over your head for a
-- few seconds, and everyone in the server is told what it is. Lobby only, with a cooldown.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Needles = require(Shared:WaitForChild("Needles"))
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local LobbySocial = require(script.Parent.LobbySocial)

local LobbyShowOff = {}
local lastShow = {}
local SHOW_COOLDOWN, SHOW_SECONDS = 15, 6

local function showOff(player)
	local d = DataManager.get(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	local phase = ReplicatedStorage:GetAttribute("Phase")
	if not d or not head or phase == "search" or phase == "countdown" or (lastShow[player] or 0) > os.clock() - SHOW_COOLDOWN then
		return
	end
	local entry = nil
	local t, s = Needles.split(d.showcase)
	if t then
		entry = { type = t, skin = s, value = Needles.value(t, s) }
	else
		entry = LobbySocial.ranked(d)[1]
	end
	if not entry then
		Remotes.Notify:FireClient(player, { text = "Find a needle first, then you'll have something to show off!", tone = "bad" })
		return
	end
	lastShow[player] = os.clock()
	local m = NeedleLook.build(entry.type, entry.skin, 1.6, 2)
	m:PivotTo(head.CFrame * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(80)))
	for _, part in ipairs(m:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored, part.Massless = false, true
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = head, part
			w.Parent = part
		end
	end
	m.Parent = player.Character
	task.delay(SHOW_SECONDS, function()
		m:Destroy()
	end)
	local words = LobbySocial.describe(entry)
	Remotes.Notify:FireAllClients({ text = player.DisplayName .. " is showing off their " .. words .. " (worth " .. Rules.commas(entry.value) .. ")!", tone = "level" })
end

function LobbyShowOff.init()
	Remotes.ShowOff.OnServerEvent:Connect(showOff)
	Players.PlayerRemoving:Connect(function(player)
		lastShow[player] = nil
	end)
end

return LobbyShowOff
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00030">
				<Properties>
					<string name="Name">LobbySocial</string>
					<ProtectedString name="Source"><![CDATA[-- The lobby's social side: showing off collections.
--   The Champion's Needle: a tall podium right in front of where you arrive, with the single most
--     valuable needle anyone in the server owns, big and glowing, and whose it is.
--   Booths: down both sides of the plaza, every player gets a booth (claimed on join) with their
--     three most valuable needles on show; its prompt opens their Collection for anyone.
--   Tags: over each player's head, their best needle in its rarity colour; the champion gets a
--     crown line. Hidden while a round is being searched, so they never get in the way.
--   Show off: see server/LobbyShowOff.
-- Remotes.LobbyInfo "best" tells a joining player who has the most valuable needle.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MapKit = require(script.Parent.MapKit)
local DataManager = require(script.Parent.DataManager)

local LobbySocial = {}
local ctx, text
local booths = {} -- { player, models, title, line, prompt }
local champion = nil -- { player, key, value }

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- A player's needles, most valuable first: { key, type, skin, value }.
function LobbySocial.ranked(d)
	local list = {}
	for key in pairs(d.collection) do
		local t, s = Needles.split(key)
		if t then
			table.insert(list, { key = key, type = t, skin = s, value = Needles.value(t, s) })
		end
	end
	table.sort(list, function(a, b)
		return a.value > b.value
	end)
	return list
end

function LobbySocial.describe(entry)
	local skin = Needles.skin(entry.skin)
	return Needles.rarity(skin.rarity).name .. " " .. Needles.name(entry.type, entry.skin), rgb(Needles.rarity(skin.rarity).colour)
end

-- Who has the most valuable needle in the server right now.
function LobbySocial.best()
	local top = nil
	for _, p in ipairs(Players:GetPlayers()) do
		local d = DataManager.get(p)
		local list = d and LobbySocial.ranked(d)
		if list and list[1] and (not top or list[1].value > top.entry.value) then
			top = { player = p, entry = list[1] }
		end
	end
	return top
end

local function tag(player, d, isChampion, visible)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("LobbyTag")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name, gui.Size, gui.StudsOffset, gui.MaxDistance = "LobbyTag", UDim2.fromOffset(260, 64), Vector3.new(0, 4.2, 0), 70
		gui.Parent = head
		local layout = Instance.new("UIListLayout")
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = gui
		for i, name in ipairs({ "Crown", "Best" }) do
			local l = Instance.new("TextLabel")
			l.Name, l.LayoutOrder, l.BackgroundTransparency, l.Size = name, i, 1, UDim2.new(1, 0, 0, if i == 1 then 26 else 22)
			l.Font, l.TextScaled, l.TextStrokeTransparency = Enum.Font.BuilderSansBold, true, 0.35
			l.Parent = gui
		end
	end
	gui.Enabled = visible
	local best = LobbySocial.ranked(d)[1]
	gui.Crown.Text, gui.Crown.TextColor3, gui.Crown.Visible = "♛ MOST VALUABLE NEEDLE", Color3.fromRGB(255, 205, 70), isChampion
	if best then
		local words, colour = LobbySocial.describe(best)
		gui.Best.Text, gui.Best.TextColor3 = "Best: " .. words .. " · " .. Rules.commas(best.value), colour
	else
		gui.Best.Text, gui.Best.TextColor3 = "No needles yet", Color3.fromRGB(200, 205, 215)
	end
end

local function clearModels(list)
	for _, m in ipairs(list) do
		m:Destroy()
	end
	table.clear(list)
end

local function buildBooth(i, x, z)
	local pos = MapKit.at(ctx, x, 0, z)
	local face = CFrame.lookAt(pos, MapKit.at(ctx, 0, 0, z)) -- facing the middle of the plaza
	MapKit.part(ctx, { Name = "BoothCounter", Size = Vector3.new(10, 3, 3), CFrame = face * CFrame.new(0, 1.5, -1), Color = { 150, 106, 64 }, Material = "WoodPlanks" })
	MapKit.part(ctx, { Name = "BoothBack", Size = Vector3.new(11, 9, 0.6), CFrame = face * CFrame.new(0, 4.5, 2.2), Color = { 120, 84, 50 }, Material = "WoodPlanks" })
	local glass = MapKit.part(ctx, { Name = "BoothShelf", Size = Vector3.new(9.4, 0.3, 2.4), CFrame = face * CFrame.new(0, 3.15, -1), Color = { 236, 230, 214 }, Material = "Marble" })
	local plate = MapKit.part(ctx, { Name = "BoothSign", Size = Vector3.new(11, 2.6, 0.6), CFrame = face * CFrame.new(0, 10.3, 2.2), Color = { 96, 66, 40 }, Material = "Wood" })
	local surface = Instance.new("SurfaceGui")
	surface.Face, surface.SizingMode, surface.PixelsPerStud, surface.LightInfluence = Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 30, 0.1
	surface.Parent = plate
	local sign = Instance.new("Frame")
	sign.Size, sign.Position, sign.BackgroundColor3 = UDim2.new(1, -12, 1, -12), UDim2.fromOffset(6, 6), Color3.fromRGB(30, 34, 44)
	sign.Parent = surface
	local title = text(sign, { Size = UDim2.new(1, -20, 0.6, 0), Position = UDim2.fromOffset(10, 4), Text = "Free booth", TextColor3 = Color3.fromRGB(255, 214, 90) })
	local line = text(sign, { Size = UDim2.new(1, -20, 0.36, 0), Position = UDim2.new(0, 10, 0.62, 0), Text = "Join and it's yours", Font = Enum.Font.BuilderSans })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText, prompt.HoldDuration, prompt.MaxActivationDistance, prompt.Enabled = "View collection", "", 0, 12, false
	prompt.Parent = glass
	booths[i] = { player = nil, models = {}, keys = "", title = title, line = line, prompt = prompt, face = face, plate = plate, sign = sign }
end

local function fillBooth(b)
	local d = b.player and DataManager.get(b.player)
	if not d then
		clearModels(b.models)
		b.keys = ""
		b.title.Text, b.line.Text, b.prompt.Enabled = "Free booth", "Join and it's yours", false
		return
	end
	local list = LobbySocial.ranked(d)
	local grand = b.player:GetAttribute("Pass_GrandBooth") == true -- the Grand Booth pass: more on show, a gold sign
	local limit = if grand then Config.GrandBooth.needles else 3
	local keys = if grand then "grand" else ""
	for slot = 1, limit do
		keys ..= (list[slot] and list[slot].key or "") .. ","
	end
	b.plate.Color = if grand then Color3.fromRGB(214, 170, 60) else Color3.fromRGB(96, 66, 40)
	b.sign.BackgroundColor3 = if grand then Color3.fromRGB(60, 44, 16) else Color3.fromRGB(30, 34, 44)
	b.title.Text = b.player.DisplayName .. "'s collection"
	b.line.Text = Rules.commas(Needles.total(d.collection)) .. " value  ·  press E to look"
	b.prompt.ObjectText, b.prompt.Enabled = b.player.DisplayName, true
	b.prompt:SetAttribute("ViewUser", b.player.UserId)
	if keys == b.keys then
		return -- the same needles: leave them be
	end
	b.keys = keys
	clearModels(b.models)
	for slot, entry in ipairs(list) do
		if slot > limit then
			break
		end
		local row, col = (slot - 1) // 3, (slot - 1) % 3 -- three on the shelf; a Grand Booth's next three hang higher, on the back wall
		local m = NeedleLook.build(entry.type, entry.skin, 1.35, 2)
		m:PivotTo(b.face * CFrame.new((col - 1) * 3.1, 4.4 + row * 3, -1 + row * 2.4) * CFrame.Angles(0, math.pi / 2, math.rad(50)))
		m.Parent = ctx.model
		table.insert(b.models, m)
	end
end

local function buildChampion()
	local base = MapKit.at(ctx, 0, 0, 48)
	MapKit.part(ctx, { Name = "ChampionPodium", Shape = "Cylinder", Size = Vector3.new(6, 8, 8), CFrame = CFrame.new(base + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 236, 230, 214 }, Material = "Marble" })
	MapKit.part(ctx, { Name = "ChampionRim", Shape = "Cylinder", Size = Vector3.new(0.4, 8.5, 8.5), CFrame = CFrame.new(base + Vector3.new(0, 5.9, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 255, 200, 70 }, Material = "Metal" })
	local anchor = MapKit.part(ctx, { Name = "ChampionLabel", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(base + Vector3.new(0, 13.5, 0)), Transparency = 1, CanCollide = false })
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.MaxDistance = UDim2.fromOffset(420, 120), 140
	gui.Parent = anchor
	local lines = {}
	for i, size in ipairs({ 36, 30, 26 }) do
		lines[i] = text(gui, { Size = UDim2.new(1, 0, 0, size), Position = UDim2.fromOffset(0, (i - 1) * 38), TextStrokeTransparency = 0.3 })
	end
	lines[1].Text, lines[1].TextColor3 = "MOST VALUABLE NEEDLE HERE", Color3.fromRGB(255, 205, 70)
	local light = Instance.new("PointLight")
	light.Range, light.Brightness = 16, 1.5
	light.Parent = anchor
	return base + Vector3.new(0, 9.5, 0), lines, light
end

local function refresh(top, lines, light, state)
	local key = top and (top.player.UserId .. top.entry.key)
	if key ~= state.key then
		if state.model then
			state.model:Destroy()
			state.model = nil
		end
		state.key = key
		if top then
			state.model = NeedleLook.build(top.entry.type, top.entry.skin, 3, 2)
			state.model.Parent = ctx.model
		end
	end
	if top then
		local words, colour = LobbySocial.describe(top.entry)
		lines[2].Text, lines[2].TextColor3 = words, colour
		lines[3].Text = "owned by " .. top.player.DisplayName .. "  ·  worth " .. Rules.commas(top.entry.value)
		light.Color = colour
	else
		lines[2].Text, lines[3].Text = "Nobody's found one yet", "Win a round and it could be yours"
	end
end

function LobbySocial.build(lobbyCtx, textFn)
	ctx, text = lobbyCtx, textFn
	local i = 0
	for _, x in ipairs({ -66, 66 }) do
		for _, z in ipairs({ -50, -30, -10, 10, 30, 50 }) do
			i += 1
			buildBooth(i, x, z)
		end
	end
	local top, lines, light = buildChampion()
	local state = { key = nil, model = nil }
	local function assign(player)
		for _, b in ipairs(booths) do
			if b.player == player then
				return
			end
		end
		for _, b in ipairs(booths) do
			if not b.player then
				b.player = player
				return
			end
		end
	end
	DataManager.onLoaded(assign)
	Players.PlayerRemoving:Connect(function(player)
		for _, b in ipairs(booths) do
			if b.player == player then
				b.player = nil
				fillBooth(b)
			end
		end
	end)
	Remotes.LobbyInfo.OnServerInvoke = function(_player, action)
		if action == "best" then
			local best = LobbySocial.best()
			if best then
				local words = LobbySocial.describe(best.entry)
				return { name = best.player.DisplayName, userId = best.player.UserId, needle = words, type = best.entry.type, skin = best.entry.skin, value = best.entry.value }
			end
		end
		return nil
	end
	task.spawn(function() -- every 3 seconds: booths, tags and the champion
		local spin = 0
		while true do
			local best = LobbySocial.best()
			refresh(best, lines, light, state)
			local phase = ReplicatedStorage:GetAttribute("Phase")
			local tagsOn = phase ~= "search" and phase ~= "countdown"
			for _, b in ipairs(booths) do
				fillBooth(b)
			end
			for _, p in ipairs(Players:GetPlayers()) do
				local d = DataManager.get(p)
				if d then
					tag(p, d, best ~= nil and best.player == p, tagsOn)
				end
			end
			for _ = 1, 30 do -- turn the champion's needle
				spin += 0.03
				if state.model then
					state.model:PivotTo(CFrame.new(top + Vector3.new(0, math.sin(spin * 2) * 0.4, 0)) * CFrame.Angles(0, spin, math.rad(25)))
				end
				task.wait(0.1)
			end
		end
	end)
end

return LobbySocial
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX00031">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[-- Starts A Needle in a Haystack on the server. Systems that react to a player's save loading are
-- started before DataManager, so none of them misses the first players. Each starts in a pcall:
-- one failing is reported in the Output window instead of stopping the rest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LobbyBuilder = require(script.Parent.LobbyBuilder)
local DataManager = require(script.Parent.DataManager)
local QuestManager = require(script.Parent.QuestManager)
local RewardManager = require(script.Parent.RewardManager)
local ShopManager = require(script.Parent.ShopManager)
local LeaderboardManager = require(script.Parent.LeaderboardManager)
local AntiCheat = require(script.Parent.AntiCheat)
local Requests = require(script.Parent.Requests)
local CollectionManager = require(script.Parent.CollectionManager)
local NeedleModel = require(script.Parent.NeedleModel)
local HaystackModel = require(script.Parent.HaystackModel)
local LobbyShowOff = require(script.Parent.LobbyShowOff)
local RoundManager = require(script.Parent.RoundManager)
local BoxManager = require(script.Parent.BoxManager)
local Combat = require(script.Parent.Combat)
local CombatThrow = require(script.Parent.CombatThrow)
local Dash = require(script.Parent.Dash)
local TradeManager = require(script.Parent.TradeManager)

-- While testing in Studio, server errors also show on screen.
if RunService:IsStudio() then
	game:GetService("ScriptContext").Error:Connect(function(message)
		ReplicatedStorage.Remotes.Notify:FireAllClients({ text = "SERVER ERROR: " .. tostring(message), tone = "bad" })
	end)
end

for _, step in ipairs({
	{ "HaystackModel", HaystackModel.load }, -- before the lobby, so its haystacks can use it
	{ "Lobby", LobbyBuilder.build },
	{ "NeedleModel", NeedleModel.load },
	{ "AntiCheat", AntiCheat.init },
	{ "Quests", QuestManager.init },
	{ "Rewards", RewardManager.init },
	{ "Shop", ShopManager.init },
	{ "Leaderboards", LeaderboardManager.init },
	{ "Requests", Requests.init },
	{ "Collection", CollectionManager.init },
	{ "ShowOff", LobbyShowOff.init },
	{ "Boxes", BoxManager.init },
	{ "Combat", Combat.init },
	{ "Throw", CombatThrow.init },
	{ "Dash", Dash.init },
	{ "Trading", TradeManager.init },
	{ "Data", DataManager.init },
	{ "Rounds", RoundManager.start },
}) do
	local ok, err = pcall(step[2])
	if not ok then
		warn("[Start] " .. step[1] .. " failed: " .. tostring(err))
	end
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00032">
				<Properties>
					<string name="Name">MapKit</string>
					<ProtectedString name="Source"><![CDATA[-- The building kit for maps (server/MapsA, MapsB): ground, hay bales, haystacks, crates, fences,
-- trees, walls, lamps, loose straw and tumbling hay. Each prop records the hiding spots it makes
-- (on its top, or on the ground beside it) as it is placed, so a needle only ever goes on a real
-- surface; server/NeedleSpawner checks each spot again before using it.
-- ctx: { model, rng, centre = Vector3, def = a Maps row, spots = {}, spawns = {}, floorY }
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapKit = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end
MapKit.rgb = rgb

-- An anchored, smooth part in the map. props: Size, CFrame, Color ({r,g,b} or Color3), Material, Shape...
function MapKit.part(ctx, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k == "Color" and type(v) == "table" then
			v = rgb(v)
		elseif k == "Material" and type(v) == "string" then
			v = Enum.Material[v]
		elseif k == "Shape" and type(v) == "string" then
			v = Enum.PartType[v]
		end
		p[k] = v
	end
	p.Parent = props.Parent or ctx.model
	return p
end

-- A world position from map-local x, y (height above the floor), z.
function MapKit.at(ctx, x, y, z)
	return ctx.centre + Vector3.new(x, ctx.floorY + y, z)
end

-- A hiding spot: the needle lies flat on a surface at `pos` (its top), turned any way.
-- climb = true for spots up high that stairs or a ladder reach.
function MapKit.spot(ctx, pos, climb)
	table.insert(ctx.spots, { cf = CFrame.new(pos), climb = climb == true })
end

-- Spots on the top face of a part, and on the ground round its foot.
function MapKit.spotsOn(ctx, part, onTop, around, climb)
	local cf, size = part.CFrame, part.Size
	for _ = 1, onTop do
		local x = (ctx.rng:NextNumber() - 0.5) * size.X * 0.7
		local z = (ctx.rng:NextNumber() - 0.5) * size.Z * 0.7
		MapKit.spot(ctx, (cf * CFrame.new(x, size.Y / 2, z)).Position, climb)
	end
	for _ = 1, around do
		local a = ctx.rng:NextNumber() * math.pi * 2
		local r = math.max(size.X, size.Z) / 2 + 1.0 -- clear of the prop's corners
		local p = cf.Position + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		MapKit.spot(ctx, Vector3.new(p.X, ctx.centre.Y + ctx.floorY, p.Z))
	end
end

function MapKit.ground(ctx, sx, sz, colour, material)
	return MapKit.part(ctx, { Name = "Ground", Size = Vector3.new(sx, 2, sz), CFrame = CFrame.new(MapKit.at(ctx, 0, -1, 0)), Color = colour, Material = material or "Grass" })
end

-- The edge of an outdoor map: countryside running off to the horizon (so the map never ends in
-- mid-air), a tall hedge you can see all the way round the play area (half sizes halfX, halfZ),
-- and invisible walls on top of it up to 200 studs, so nobody walks, jumps or flies off. Neither
-- can be clicked through to (they ignore clicks and raycasts).
function MapKit.edges(ctx, halfX, halfZ, colour)
	MapKit.part(ctx, { Name = "Countryside", Size = Vector3.new(900, 2, 900), CFrame = CFrame.new(MapKit.at(ctx, 0, -1.1, 0)), Color = colour, Material = "Grass", CanQuery = false })
	for _, w in ipairs({ { 0, -halfZ, halfX * 2 + 3, 3 }, { 0, halfZ, halfX * 2 + 3, 3 }, { -halfX, 0, 3, halfZ * 2 + 3 }, { halfX, 0, 3, halfZ * 2 + 3 } }) do
		MapKit.part(ctx, { Name = "Hedge", Size = Vector3.new(w[3], 9, w[4]), CFrame = CFrame.new(MapKit.at(ctx, w[1], 4.5, w[2])), Color = { 52, 104, 52 }, Material = "LeafyGrass", CanQuery = false })
		MapKit.part(ctx, { Name = "Edge", Size = Vector3.new(w[3], 200, w[4]), CFrame = CFrame.new(MapKit.at(ctx, w[1], 109, w[2])), Transparency = 1, CanQuery = false, CastShadow = false })
	end
end

function MapKit.spawnAt(ctx, x, z)
	table.insert(ctx.spawns, CFrame.new(MapKit.at(ctx, x, 3, z)) * CFrame.Angles(0, ctx.rng:NextNumber() * math.pi * 2, 0))
end

-- A rectangular hay bale with two twine bands. y = the height of its base above the floor.
function MapKit.bale(ctx, x, y, z, turn, climb)
	local cf = CFrame.new(MapKit.at(ctx, x, y + 1.25, z)) * CFrame.Angles(0, turn or 0, 0)
	local straw = ctx.def.straw
	local bale = MapKit.part(ctx, { Name = "Bale", Size = Vector3.new(4, 2.5, 2.5), CFrame = cf, Color = straw, Material = "Grass" })
	for _, dx in ipairs({ -1, 1 }) do
		MapKit.part(ctx, { Name = "Twine", Size = Vector3.new(0.15, 2.56, 2.56), CFrame = cf * CFrame.new(dx, 0, 0), Color = { 150, 100, 60 }, Material = "Fabric", CanCollide = false, CanQuery = false })
	end
	MapKit.spotsOn(ctx, bale, 1, if y > 0 then 0 else 1, climb)
	return bale
end

-- A round haystack: stacked, shrinking cylinders under a dome. Spots round its foot.
-- A haystack: the owner's model if it's loaded (server/HaystackModel), otherwise a smooth, lumpy
-- terrain dome (a drum with a dome on top and a few bulges), coloured straw gold. Terrain cells
-- are 4 studs, so hiding spots go a little further out round its foot.
function MapKit.haystack(ctx, x, z, radius, height)
	local ground = MapKit.at(ctx, x, 0, z)
	local own = require(script.Parent.HaystackModel).place(ground, radius * 2.2, ctx.rng:NextNumber() * math.pi * 2)
	if own then
		own.Parent = ctx.model
	else
		local terrain = workspace.Terrain
		local H = Config.Haystacks
		local material = Enum.Material[H.material]
		terrain:SetMaterialColor(material, Color3.fromRGB(H.colour[1], H.colour[2], H.colour[3]))
		local domeY = math.max(radius * 0.4, height - radius)
		terrain:FillCylinder(CFrame.new(ground + Vector3.new(0, domeY / 2, 0)), domeY, radius, material)
		terrain:FillBall(ground + Vector3.new(0, domeY, 0), radius, material)
		terrain:FillBall(ground + Vector3.new(0, domeY + radius * 0.75, 0), radius * 0.6, material) -- the rounded peak
		for _ = 1, 5 do -- gentle bulges, so no two stacks look the same
			local a = ctx.rng:NextNumber() * math.pi * 2
			local up = ctx.rng:NextNumber(0.2, 0.9)
			local p = ground + Vector3.new(math.cos(a) * radius * 0.6, domeY * up + radius * 0.3, math.sin(a) * radius * 0.6)
			terrain:FillBall(p, radius * ctx.rng:NextNumber(0.25, 0.35), material)
		end
	end
	for _ = 1, 3 do
		local a = ctx.rng:NextNumber() * math.pi * 2
		MapKit.spot(ctx, MapKit.at(ctx, x + math.cos(a) * (radius + 3), 0, z + math.sin(a) * (radius + 3)))
	end
end

-- Clears the terrain haystacks round `centre` (the arena, between rounds).
function MapKit.clearTerrain(centre)
	workspace.Terrain:FillBlock(CFrame.new(centre + Vector3.new(0, 40, 0)), Vector3.new(340, 100, 340), Enum.Material.Air)
end

function MapKit.crate(ctx, x, y, z, size, climb)
	size = size or 3
	local c = MapKit.part(ctx, { Name = "Crate", Size = Vector3.one * size, CFrame = CFrame.new(MapKit.at(ctx, x, y + size / 2, z)) * CFrame.Angles(0, ctx.rng:NextNumber() * 0.6, 0), Color = { 150, 106, 64 }, Material = "WoodPlanks" })
	MapKit.spotsOn(ctx, c, 1, if y > 0 then 0 else 1, climb)
	return c
end

-- A wall or floor panel (collides). cf is its centre.
function MapKit.wall(ctx, cf, size, colour, material)
	return MapKit.part(ctx, { Name = "Wall", Size = size, CFrame = cf, Color = colour, Material = material or "WoodPlanks" })
end

-- A fence from a to b (map-local x, z pairs): posts and two rails.
function MapKit.fence(ctx, ax, az, bx, bz)
	local a, b = MapKit.at(ctx, ax, 0, az), MapKit.at(ctx, bx, 0, bz)
	local length = (b - a).Magnitude
	for i = 0, math.floor(length / 8) do
		local p = a:Lerp(b, i * 8 / length)
		MapKit.part(ctx, { Name = "Post", Size = Vector3.new(0.6, 4, 0.6), CFrame = CFrame.new(p + Vector3.new(0, 2, 0)), Color = { 120, 84, 50 }, Material = "Wood" })
	end
	for _, h in ipairs({ 1.6, 3.2 }) do
		local mid = (a + b) / 2 + Vector3.new(0, h, 0)
		MapKit.part(ctx, { Name = "Rail", Size = Vector3.new(0.3, 0.4, length), CFrame = CFrame.lookAt(mid, mid + (b - a)), Color = { 140, 100, 60 }, Material = "Wood" })
	end
end

-- A tree: a trunk and a few leafy balls. Spots among its roots.
function MapKit.tree(ctx, x, z, height, leaf)
	local h = height or 14
	MapKit.part(ctx, { Name = "Trunk", Shape = "Cylinder", Size = Vector3.new(h, 1.8, 1.8), CFrame = CFrame.new(MapKit.at(ctx, x, h / 2, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 96, 70, 46 }, Material = "Wood" })
	for i = 1, 3 do
		local o = Vector3.new((ctx.rng:NextNumber() - 0.5) * 4, h - 1 + i, (ctx.rng:NextNumber() - 0.5) * 4)
		MapKit.part(ctx, { Name = "Leaves", Shape = "Ball", Size = Vector3.one * (8 - i), CFrame = CFrame.new(MapKit.at(ctx, x, 0, z) + o), Color = leaf or { 60, 110, 60 }, Material = "Grass", CanCollide = false })
	end
	for _ = 1, 2 do
		local a = ctx.rng:NextNumber() * math.pi * 2
		MapKit.spot(ctx, MapKit.at(ctx, x + math.cos(a) * 2.2, 0, z + math.sin(a) * 2.2))
	end
end

-- A lamp: a small glowing block with a warm light.
function MapKit.lamp(ctx, pos, colour, range)
	local p = MapKit.part(ctx, { Name = "Lamp", Size = Vector3.new(0.8, 1.2, 0.8), CFrame = CFrame.new(pos), Color = colour or { 255, 200, 120 }, Material = "Neon", CanCollide = false })
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = p.Color, range or 22, 1.6
	light.Parent = p
	return p
end

-- Loose straws scattered on the floor: the haystack's busyness. Half land near hiding spots,
-- so a needle never sits alone on bare ground. They can't be clicked or stood on.
function MapKit.clutter(ctx, count, halfX, halfZ)
	local straw = ctx.def.straw
	for i = 1, count do
		local pos
		if i % 2 == 0 and #ctx.spots > 0 then
			local s = ctx.spots[ctx.rng:NextInteger(1, #ctx.spots)].cf.Position
			pos = s + Vector3.new((ctx.rng:NextNumber() - 0.5) * 5, 0, (ctx.rng:NextNumber() - 0.5) * 5)
		else
			pos = MapKit.at(ctx, (ctx.rng:NextNumber() * 2 - 1) * halfX, 0, (ctx.rng:NextNumber() * 2 - 1) * halfZ)
		end
		local shade = 0.75 + ctx.rng:NextNumber() * 0.4
		MapKit.part(ctx, { Name = "Straw", Size = Vector3.new(0.12, 0.08, 0.8 + ctx.rng:NextNumber() * 1.4), CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, ctx.rng:NextNumber() * math.pi * 2, 0),
			Color = Color3.fromRGB(math.min(255, straw[1] * shade), math.min(255, straw[2] * shade), math.min(255, straw[3] * shade)), Material = "SmoothPlastic", CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	end
end

-- Hay bundles that drift slowly to and fro and turn (Hard rounds). They can't be clicked.
function MapKit.moving(ctx, count, halfX, halfZ)
	for _ = 1, count do
		local from = MapKit.at(ctx, (ctx.rng:NextNumber() * 2 - 1) * halfX, 1.2, (ctx.rng:NextNumber() * 2 - 1) * halfZ)
		local bundle = MapKit.part(ctx, { Name = "Tumble", Shape = "Ball", Size = Vector3.one * 2.4, CFrame = CFrame.new(from), Color = ctx.def.straw, Material = "Grass", CanCollide = false, CanQuery = false, CanTouch = false })
		local to = from + Vector3.new((ctx.rng:NextNumber() - 0.5) * 30, 0, (ctx.rng:NextNumber() - 0.5) * 30)
		TweenService:Create(bundle, TweenInfo.new(6 + ctx.rng:NextNumber() * 4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = CFrame.new(to) * CFrame.Angles(0, math.pi, math.pi) }):Play()
	end
end

return MapKit
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00033">
				<Properties>
					<string name="Name">MapsA</string>
					<ProtectedString name="Source"><![CDATA[-- Map builders: Classic Haystack Field (a hedge maze), Barn Interior (a maze of stall walls) and
-- Farm at Sunset (a maze of stacked hay bales). shared/Maps holds their names, light and colours.
-- Each builds round ctx.centre with MapKit and MazeKit: the maze records its own hiding spots
-- (dead ends, wall feet); props go inside cells and clearings and add theirs. Then the round's
-- loose straw (ctx.diff.clutter) and, on Hard, tumbling hay (ctx.diff.moving).
local MapKit = require(script.Parent.MapKit)
local MazeKit = require(script.Parent.MazeKit)

local MapsA = {}

-- A random spot inside a maze cell, clear of its walls.
local function inCell(ctx, maze, margin)
	local cell = maze.randomCell()
	local room = maze.size / 2 - 1 - (margin or 1.5)
	return cell.x + ctx.rng:NextNumber(-room, room), cell.z + ctx.rng:NextNumber(-room, room)
end
MapsA.inCell = inCell

local function finish(ctx, half)
	MapKit.clutter(ctx, ctx.diff.clutter, half, half)
	MapKit.moving(ctx, ctx.diff.moving, half * 0.8, half * 0.8)
end

-- Classic Haystack Field: a hedge maze over the field, haystacks in its clearings, bales and
-- hay carts tucked into the corridors.
function MapsA.field(ctx)
	local r = ctx.rng
	MapKit.ground(ctx, 140, 140, ctx.def.ground, "Grass")
	MapKit.edges(ctx, 68, 68, ctx.def.ground)
	local maze = MazeKit.build(ctx, { cols = 8, rows = 8, size = 16, height = 10, style = "hedge", loops = 0.15, rooms = 3 })
	for _, room in ipairs(maze.rooms) do
		MapKit.haystack(ctx, room.x + r:NextNumber(-3, 3), room.z + r:NextNumber(-3, 3), r:NextNumber(5, 6.5), r:NextNumber(9, 12))
	end
	for _ = 1, 14 do
		local x, z = inCell(ctx, maze, 2.5)
		MapKit.bale(ctx, x, 0, z, r:NextNumber() * math.pi)
	end
	for _ = 1, 6 do
		local x, z = inCell(ctx, maze, 3)
		MapKit.crate(ctx, x, 0, z, 2.5)
	end
	maze.spawns(8)
	finish(ctx, 62)
end

-- Barn Interior: a red barn whose floor is a maze of wooden stall walls under the hay loft;
-- stairs up the west wall to the loft, crates and bales in the stalls, warm lamps above.
function MapsA.barn(ctx)
	local r = ctx.rng
	local W, D, H = 76, 52, 24
	local wood, dark = { 150, 96, 60 }, { 110, 70, 44 }
	MapKit.ground(ctx, W + 10, D + 10, ctx.def.ground, "WoodPlanks")
	for _, w in ipairs({ { 0, -D / 2, W, 1 }, { 0, D / 2, W, 1 }, { -W / 2, 0, 1, D }, { W / 2, 0, 1, D } }) do
		MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, w[1], H / 2, w[2])), Vector3.new(w[3], H, w[4]), { 168, 70, 56 }, "WoodPlanks")
	end
	MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, 0, H + 0.5, 0)), Vector3.new(W, 1, D), dark, "WoodPlanks")
	local loftZ = -D / 2 + 7
	MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, 0, 10, loftZ)), Vector3.new(W - 2, 1, 14), wood, "WoodPlanks")
	for i = 0, 11 do -- stairs up the west wall, outside the maze
		MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, -W / 2 + 3.5, 0.4 + i * 0.8, loftZ + 7 + 19 - i * 1.6)), Vector3.new(5, 0.8, 1.7), wood, "WoodPlanks")
	end
	for _ = 1, 8 do
		MapKit.bale(ctx, r:NextNumber(-W / 2 + 10, W / 2 - 6), 10.5, loftZ + r:NextNumber(-4, 4), r:NextNumber() * 3, true)
	end
	for i = 0, 4 do
		MapKit.spot(ctx, MapKit.at(ctx, -W / 2 + 12 + i * 12, 10.5, loftZ + 6), true)
	end
	local maze = MazeKit.build(ctx, { cols = 6, rows = 4, size = 11, height = 8, style = "planks", loops = 0.2, rooms = 1, ox = 3.5, oz = 0 })
	for _ = 1, 10 do
		local x, z = inCell(ctx, maze, 1.5)
		MapKit.crate(ctx, x, 0, z, r:NextNumber(1.8, 2.6))
	end
	for _ = 1, 6 do
		local x, z = inCell(ctx, maze, 2.5)
		MapKit.bale(ctx, x, 0, z, r:NextNumber() * 3)
	end
	for i = 0, 3 do
		MapKit.lamp(ctx, MapKit.at(ctx, -W / 2 + 12 + i * 17, H - 3, 6), { 255, 196, 120 }, 30)
	end
	maze.spawns(8)
	finish(ctx, 32)
end

-- Farm at Sunset: a maze of hay-bale walls four high across the farm, with the farmhouse, the
-- tractor and a little crop patch with its scarecrow in the clearings.
function MapsA.sunset(ctx)
	local r = ctx.rng
	MapKit.ground(ctx, 140, 140, ctx.def.ground, "Grass")
	MapKit.edges(ctx, 68, 68, ctx.def.ground)
	local maze = MazeKit.build(ctx, { cols = 8, rows = 8, size = 16, height = 10, style = "bales", loops = 0.15, rooms = 3 })
	for i, room in ipairs(maze.rooms) do
		if i == 1 then -- the farmhouse
			local house = MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, room.x, 7, room.z)), Vector3.new(16, 14, 12), { 236, 226, 200 }, "WoodPlanks")
			MapKit.part(ctx, { Name = "Roof", Size = Vector3.new(18, 2, 14), CFrame = CFrame.new(house.Position + Vector3.new(0, 8, 0)), Color = { 150, 60, 50 }, Material = "Slate" })
			MapKit.spotsOn(ctx, house, 0, 4)
		elseif i == 2 then -- the tractor
			local body = MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, room.x, 2.5, room.z)), Vector3.new(8, 3, 4.5), { 196, 52, 40 }, "SmoothPlastic")
			MapKit.part(ctx, { Name = "Cab", Size = Vector3.new(3.5, 3.5, 4), CFrame = body.CFrame * CFrame.new(-2, 3, 0), Color = { 196, 52, 40 }, Material = "SmoothPlastic" })
			for _, w in ipairs({ { -3, 2.2 }, { 3, 1.4 } }) do
				for _, side in ipairs({ -1, 1 }) do
					MapKit.part(ctx, { Name = "Wheel", Shape = "Cylinder", Size = Vector3.new(1, w[2] * 2, w[2] * 2), CFrame = CFrame.new(MapKit.at(ctx, room.x + w[1], w[2], room.z + side * 2.8)) * CFrame.Angles(0, math.pi / 2, 0), Color = { 40, 40, 44 }, Material = "Fabric" })
				end
			end
			MapKit.spotsOn(ctx, body, 1, 4)
		else -- crops and the scarecrow
			for row = 0, 4 do
				local x = room.x - 10 + row * 5
				MapKit.part(ctx, { Name = "Crops", Size = Vector3.new(2, 1.2, 22), CFrame = CFrame.new(MapKit.at(ctx, x, 0.6, room.z)), Color = { 90, 140, 60 }, Material = "Grass" })
				MapKit.spot(ctx, MapKit.at(ctx, x + 2.5, 0, room.z + r:NextNumber(-9, 9)))
			end
			MapKit.part(ctx, { Name = "Pole", Size = Vector3.new(0.5, 9, 0.5), CFrame = CFrame.new(MapKit.at(ctx, room.x + 1, 4.5, room.z)), Color = { 120, 84, 50 }, Material = "Wood" })
			MapKit.part(ctx, { Name = "Scarecrow", Shape = "Ball", Size = Vector3.one * 2.4, CFrame = CFrame.new(MapKit.at(ctx, room.x + 1, 9.5, room.z)), Color = { 214, 186, 140 }, Material = "Fabric" })
		end
	end
	for _ = 1, 10 do
		local x, z = inCell(ctx, maze, 2.5)
		MapKit.bale(ctx, x, 0, z, r:NextNumber() * 3)
	end
	maze.spawns(8)
	finish(ctx, 62)
end

return MapsA
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00034">
				<Properties>
					<string name="Name">MapsB</string>
					<ProtectedString name="Source"><![CDATA[-- Map builders: Night Forest (a thicket maze) and Abandoned Attic (a maze of stacked boxes under
-- the roof). See MapsA for how a builder works.
local MapKit = require(script.Parent.MapKit)
local MazeKit = require(script.Parent.MazeKit)
local MapsA = require(script.Parent.MapsA)

local MapsB = {}

-- Night Forest: paths through dark thickets in the fog; trees, logs, rocks and glowing mushrooms
-- in the corridors, and lanterns in the clearings so you can find your way.
function MapsB.forest(ctx)
	local r = ctx.rng
	MapKit.ground(ctx, 130, 130, ctx.def.ground, "Grass")
	MapKit.edges(ctx, 63, 63, ctx.def.ground)
	local maze = MazeKit.build(ctx, { cols = 8, rows = 8, size = 15, height = 10, style = "thicket", loops = 0.18, rooms = 3 })
	for _, room in ipairs(maze.rooms) do
		MapKit.tree(ctx, room.x, room.z, r:NextNumber(16, 22), { 40, 76, 50 })
		MapKit.part(ctx, { Name = "LanternPost", Size = Vector3.new(0.4, 6, 0.4), CFrame = CFrame.new(MapKit.at(ctx, room.x + 6, 3, room.z + 6)), Color = { 60, 50, 40 }, Material = "Wood" })
		MapKit.lamp(ctx, MapKit.at(ctx, room.x + 6, 6.4, room.z + 6), { 255, 190, 110 }, 34)
		local log = MapKit.part(ctx, { Name = "Log", Shape = "Cylinder", Size = Vector3.new(10, 2.2, 2.2), CFrame = CFrame.new(MapKit.at(ctx, room.x - 5, 1.1, room.z - 4)) * CFrame.Angles(0, r:NextNumber() * math.pi, 0), Color = { 92, 66, 44 }, Material = "Wood" })
		MapKit.spot(ctx, (log.CFrame * CFrame.new(r:NextNumber(-3, 3), 1.1, 0)).Position)
		MapKit.spotsOn(ctx, log, 0, 2)
	end
	for _ = 1, 8 do
		local x, z = MapsA.inCell(ctx, maze, 2.5)
		MapKit.tree(ctx, x, z, r:NextNumber(14, 20), { 40, 76, 50 })
	end
	for _ = 1, 10 do
		local x, z = MapsA.inCell(ctx, maze, 2.5)
		local rock = MapKit.part(ctx, { Name = "Rock", Shape = "Ball", Size = Vector3.one * r:NextNumber(2.5, 4), CFrame = CFrame.new(MapKit.at(ctx, x, 0.6, z)), Color = { 96, 104, 100 }, Material = "Slate" })
		MapKit.spotsOn(ctx, rock, 0, 2)
	end
	for _ = 1, 18 do -- glowing mushrooms light the way
		local x, z = MapsA.inCell(ctx, maze, 1.5)
		MapKit.part(ctx, { Name = "Stalk", Size = Vector3.new(0.3, 0.8, 0.3), CFrame = CFrame.new(MapKit.at(ctx, x, 0.4, z)), Color = { 230, 226, 210 }, Material = "SmoothPlastic", CanCollide = false })
		MapKit.part(ctx, { Name = "Cap", Shape = "Ball", Size = Vector3.new(1.1, 1.1, 1.1), CFrame = CFrame.new(MapKit.at(ctx, x, 0.9, z)), Color = { 120, 200, 255 }, Material = "Neon", CanCollide = false })
	end
	maze.spawns(8)
	MapKit.clutter(ctx, ctx.diff.clutter, 58, 58)
	MapKit.moving(ctx, ctx.diff.moving, 45, 45)
end

-- Abandoned Attic: a long room under a sloping roof, its floor a maze of stacked boxes; trunks,
-- an old table, a wardrobe and furniture under dust sheets in the corners and the clearing, lit
-- by a round window at each end and dusty lamps.
function MapsB.attic(ctx)
	local r = ctx.rng
	local L, Wd, H = 80, 48, 20
	local wood, dark = { 132, 98, 66 }, { 96, 70, 48 }
	MapKit.ground(ctx, L + 6, Wd + 6, ctx.def.ground, "WoodPlanks")
	-- the roof: two slopes, low (3 studs) at the side walls, up to a flat ridge at about 19.6
	local slope, tilt = 20, math.rad(55)
	for _, side in ipairs({ -1, 1 }) do
		local run, rise = slope / 2 * math.cos(tilt), slope / 2 * math.sin(tilt)
		MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, 0, 3 + rise, side * (Wd / 2 - run))) * CFrame.Angles(side * tilt, 0, 0), Vector3.new(L, 1, slope), dark, "WoodPlanks")
		MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, 0, 1.5, side * Wd / 2)), Vector3.new(L, 3, 1), wood, "WoodPlanks")
	end
	MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, 0, 3 + slope * math.sin(tilt) + 0.2, 0)), Vector3.new(L, 1, Wd - 4 * slope / 2 * math.cos(tilt) + 2), dark, "WoodPlanks")
	for _, side in ipairs({ -1, 1 }) do -- end walls with a round window
		MapKit.wall(ctx, CFrame.new(MapKit.at(ctx, side * L / 2, H / 2, 0)), Vector3.new(1, H, Wd), wood, "WoodPlanks")
		local win = MapKit.part(ctx, { Name = "Window", Shape = "Cylinder", Size = Vector3.new(1.2, 6, 6), CFrame = CFrame.new(MapKit.at(ctx, side * (L / 2 - 0.2), 12, 0)), Color = { 255, 236, 190 }, Material = "Neon", CanCollide = false })
		local light = Instance.new("SpotLight")
		light.Face, light.Range, light.Angle, light.Brightness = if side > 0 then Enum.NormalId.Left else Enum.NormalId.Right, 60, 70, 2
		light.Color = Color3.fromRGB(255, 226, 170)
		light.Parent = win
	end
	local maze = MazeKit.build(ctx, { cols = 8, rows = 3, size = 9.5, height = 6, style = "crates", loops = 0.22, rooms = 1 })
	for _, room in ipairs(maze.rooms) do -- the old table in the clearing
		local top = MapKit.part(ctx, { Name = "Table", Size = Vector3.new(7, 0.5, 4), CFrame = CFrame.new(MapKit.at(ctx, room.x, 3, room.z)), Color = wood, Material = "Wood" })
		for _, d in ipairs({ { -3.1, -1.6 }, { 3.1, -1.6 }, { -3.1, 1.6 }, { 3.1, 1.6 } }) do
			MapKit.part(ctx, { Name = "Leg", Size = Vector3.new(0.5, 2.8, 0.5), CFrame = CFrame.new(MapKit.at(ctx, room.x + d[1], 1.4, room.z + d[2])), Color = dark, Material = "Wood" })
		end
		MapKit.spotsOn(ctx, top, 3, 2)
	end
	for _ = 1, 4 do
		local x, z = MapsA.inCell(ctx, maze, 2)
		local t = MapKit.part(ctx, { Name = "Trunk", Size = Vector3.new(3.4, 2.4, 2.2), CFrame = CFrame.new(MapKit.at(ctx, x, 1.2, z)) * CFrame.Angles(0, r:NextNumber() * math.pi, 0), Color = { 110, 70, 46 }, Material = "Wood" })
		MapKit.spotsOn(ctx, t, 1, 1)
	end
	for _ = 1, 3 do
		local x, z = MapsA.inCell(ctx, maze, 2)
		local sheet = MapKit.part(ctx, { Name = "DustSheet", Size = Vector3.new(r:NextNumber(3, 4), r:NextNumber(3, 4), r:NextNumber(3, 3.6)), CFrame = CFrame.new(MapKit.at(ctx, x, 1.8, z)), Color = { 226, 222, 210 }, Material = "Fabric" })
		MapKit.spotsOn(ctx, sheet, 1, 2)
	end
	for i = 0, 3 do
		MapKit.lamp(ctx, MapKit.at(ctx, -30 + i * 20, 15, 0), { 255, 214, 150 }, 30)
	end
	maze.spawns(8)
	MapKit.clutter(ctx, ctx.diff.clutter, L / 2 - 4, Wd / 2 - 8)
	MapKit.moving(ctx, ctx.diff.moving, L / 2 - 8, Wd / 2 - 10)
end

return MapsB
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00035">
				<Properties>
					<string name="Name">MatchXp</string>
					<ProtectedString name="Source"><![CDATA[-- XP after each match (Config.MatchXp): for where you placed, every coin you collected in the
-- match, every needle you found and every player you tagged out. Counted while the round runs
-- (RewardManager.track) and given at the results, where each player sees their own breakdown.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local RewardManager = require(script.Parent.RewardManager)

local MatchXp = {}
local stats = nil

function MatchXp.begin(round)
	stats = {}
	for p in pairs(round.participants) do
		stats[p] = { coins = 0, needles = 0, elims = 0 }
	end
	RewardManager.tracker = function(player, what, amount)
		local s = stats and stats[player]
		if s and s[what] then
			s[what] += amount
		end
	end
end

-- Gives everyone their match XP. Returns each player's breakdown, keyed by tostring(userId).
function MatchXp.finish(round)
	local X = Config.MatchXp
	local out = {}
	RewardManager.tracker = nil
	for p, s in pairs(stats or {}) do
		if p.Parent and round.participants[p] then
			local place = table.find(round.order, p)
			local placeXp = (if place then X.place[math.min(place, #X.place)] else 0) + X.played
			local row = {
				place = place, placeXp = placeXp,
				coins = s.coins, coinXp = math.floor(s.coins * X.perCoin + 0.5),
				needles = s.needles, needleXp = s.needles * X.perNeedle,
				elims = s.elims, elimXp = s.elims * X.perElimination,
			}
			row.total = row.placeXp + row.coinXp + row.needleXp + row.elimXp
			RewardManager.grant(p, 0, row.total, nil)
			out[tostring(p.UserId)] = row
		end
	end
	stats = nil
	return out
end

-- A round that ended early (an error): nothing more is counted.
function MatchXp.cancel()
	RewardManager.tracker = nil
	stats = nil
end

return MatchXp
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00036">
				<Properties>
					<string name="Name">MazeKit</string>
					<ProtectedString name="Source"><![CDATA[-- Mazes for the maps: a grid of cells carved into a maze (a random depth-first walk, so every cell
-- can be reached), then a few extra walls knocked through so there are loops (no long dead
-- walks back), and a few 2x2 clearings opened up for big props. Walls are built in a style:
--   hedge   tall clipped hedges          bales   hay bales stacked four high
--   planks  wooden stall partitions      crates  stacked wooden boxes
--   thicket dark, uneven bushes (forest)
-- Every wall is taller than a jump, so you search corridor by corridor. Dead ends get hiding
-- spots at their back wall, and some corridors get spots along a wall's foot.
-- MazeKit.build(ctx, opts) -> maze. opts: cols, rows, size (cell width), height, style,
--   loops (share of extra walls removed), rooms (how many clearings), ox, oz (centre offset).
-- maze.cellCentre(c, r), maze.cells, maze.deadEnds, maze.rooms ({ centre, cells }),
-- maze.randomCell(), maze.spawns(n).
local MapKit = require(script.Parent.MapKit)

local MazeKit = {}
local T = 2 -- wall thickness

local function wall(ctx, style, a, b, height)
	local mid, len = (a + b) / 2, (b - a).Magnitude + T
	local along = CFrame.lookAt(mid, mid + (b - a))
	if style == "hedge" or style == "thicket" then
		local colour = if style == "hedge" then { 58, 112, 56 } else { 34, 64, 40 }
		MapKit.part(ctx, { Name = "MazeWall", Size = Vector3.new(T, height, len), CFrame = along * CFrame.new(0, height / 2, 0), Color = colour, Material = "LeafyGrass" })
		if style == "thicket" then -- an uneven top
			for i = 0, math.floor(len / 5) do
				local s = ctx.rng:NextNumber(2.5, 4)
				MapKit.part(ctx, { Name = "Bush", Shape = "Ball", Size = Vector3.one * s, CFrame = along * CFrame.new(0, height - 0.3, -len / 2 + i * 5 + 2), Color = { 40, 76, 46 }, Material = "LeafyGrass", CanCollide = false })
			end
		end
	elseif style == "bales" then
		local straw = ctx.def.straw
		for level = 0, 3 do
			local shade = 0.86 + ((level % 2) * 0.1)
			local skew = if level % 2 == 0 then 0 else 1 -- bricked, like a real stack
			MapKit.part(ctx, { Name = "MazeWall", Size = Vector3.new(T + 0.5, 2.5, len - skew), CFrame = along * CFrame.new(0, 1.25 + level * 2.5, 0), Color = { straw[1] * shade, straw[2] * shade, straw[3] * shade }, Material = "Grass" })
			for i = 0, math.floor(len / 4) - 1 do -- the twine round each bale
				MapKit.part(ctx, { Name = "Twine", Size = Vector3.new(T + 0.56, 2.52, 0.15), CFrame = along * CFrame.new(0, 1.25 + level * 2.5, -len / 2 + skew / 2 + 2 + i * 4), Color = { 150, 100, 60 }, Material = "Fabric", CanCollide = false, CanQuery = false })
			end
		end
	elseif style == "planks" then
		MapKit.part(ctx, { Name = "MazeWall", Size = Vector3.new(T * 0.6, height, len), CFrame = along * CFrame.new(0, height / 2, 0), Color = { 128, 82, 50 }, Material = "WoodPlanks" })
		for _, z in ipairs({ -len / 2 + 0.4, len / 2 - 0.4 }) do
			MapKit.part(ctx, { Name = "Post", Size = Vector3.new(1.2, height + 0.6, 1.2), CFrame = along * CFrame.new(0, (height + 0.6) / 2, z), Color = { 96, 62, 38 }, Material = "Wood" })
		end
	else -- crates
		local n = math.max(1, math.floor(len / 3))
		local s = len / n
		for i = 0, n - 1 do
			for level = 0, math.floor(height / s) do
				local turn = CFrame.Angles(0, ctx.rng:NextNumber(-0.08, 0.08), 0)
				MapKit.part(ctx, { Name = "MazeWall", Size = Vector3.new(T + 0.6, s, s), CFrame = along * CFrame.new(0, s / 2 + level * s, -len / 2 + s / 2 + i * s) * turn, Color = { 150 - level * 8, 106 - level * 6, 64 }, Material = "WoodPlanks" })
			end
		end
	end
end

function MazeKit.build(ctx, o)
	local cols, rows, size, rng = o.cols, o.rows, o.size, ctx.rng
	local east, south, seen = {}, {}, {}
	for c = 1, cols do
		east[c], south[c], seen[c] = {}, {}, {}
		for r = 1, rows do
			east[c][r], south[c][r] = c < cols, r < rows
		end
	end
	-- carve: a random depth-first walk
	local stack = { { rng:NextInteger(1, cols), rng:NextInteger(1, rows) } }
	seen[stack[1][1]][stack[1][2]] = true
	while #stack > 0 do
		local c, r = stack[#stack][1], stack[#stack][2]
		local options = {}
		for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local nc, nr = c + d[1], r + d[2]
			if nc >= 1 and nc <= cols and nr >= 1 and nr <= rows and not seen[nc][nr] then
				table.insert(options, { nc, nr, d })
			end
		end
		if #options == 0 then
			table.remove(stack)
		else
			local nc, nr, d = table.unpack(options[rng:NextInteger(1, #options)])
			if d[1] == 1 then east[c][r] = false elseif d[1] == -1 then east[nc][nr] = false elseif d[2] == 1 then south[c][r] = false else south[nc][nr] = false end
			seen[nc][nr] = true
			table.insert(stack, { nc, nr })
		end
	end
	-- loops: knock out a share of the remaining inner walls
	for c = 1, cols do
		for r = 1, rows do
			if east[c][r] and rng:NextNumber() < (o.loops or 0.15) then east[c][r] = false end
			if south[c][r] and rng:NextNumber() < (o.loops or 0.15) then south[c][r] = false end
		end
	end
	-- clearings: 2x2 blocks with no walls inside, spread out
	local rooms, taken = {}, {}
	for _ = 1, (o.rooms or 0) * 6 do
		if #rooms >= (o.rooms or 0) then break end
		local c, r = rng:NextInteger(1, cols - 1), rng:NextInteger(1, rows - 1)
		local free = true
		for _, q in ipairs(taken) do
			if math.abs(q[1] - c) < 3 and math.abs(q[2] - r) < 3 then free = false end
		end
		if free then
			east[c][r], east[c][r + 1], south[c][r], south[c + 1][r] = false, false, false, false
			table.insert(taken, { c, r })
			table.insert(rooms, { c = c, r = r })
		end
	end
	local maze = { cols = cols, rows = rows, size = size, cells = {}, deadEnds = {}, rooms = {} }
	ctx.maze = maze -- for server/Powerups
	local x0, z0 = (o.ox or 0) - cols * size / 2, (o.oz or 0) - rows * size / 2
	function maze.cellCentre(c, r)
		return x0 + (c - 0.5) * size, z0 + (r - 0.5) * size
	end
	local function at(x, z)
		return MapKit.at(ctx, x, 0, z)
	end
	-- the walls: inner ones, then the outside
	for c = 1, cols do
		for r = 1, rows do
			local x, z = x0 + c * size, z0 + r * size
			if east[c][r] then wall(ctx, o.style, at(x, z - size), at(x, z), o.height) end
			if south[c][r] then wall(ctx, o.style, at(x - size, z), at(x, z), o.height) end
		end
	end
	local x1, z1 = x0 + cols * size, z0 + rows * size
	for _, w in ipairs({ { x0, z0, x1, z0 }, { x0, z1, x1, z1 }, { x0, z0, x0, z1 }, { x1, z0, x1, z1 } }) do
		wall(ctx, o.style, at(w[1], w[2]), at(w[3], w[4]), o.height)
	end
	-- cells, dead ends and their hiding spots
	local inRoom = {}
	for _, room in ipairs(rooms) do
		local cx, cz = maze.cellCentre(room.c, room.r)
		table.insert(maze.rooms, { x = cx + size / 2, z = cz + size / 2 })
		for _, d in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
			inRoom[(room.c + d[1]) .. "," .. (room.r + d[2])] = true
		end
	end
	for c = 1, cols do
		for r = 1, rows do
			local x, z = maze.cellCentre(c, r)
			local walls = {
				{ c == cols or east[c][r], 1, 0 }, { c == 1 or east[c - 1][r], -1, 0 },
				{ r == rows or south[c][r], 0, 1 }, { r == 1 or south[c][r - 1], 0, -1 },
			}
			local closed = {}
			for _, w in ipairs(walls) do
				if w[1] then table.insert(closed, w) end
			end
			if not inRoom[c .. "," .. r] then
				table.insert(maze.cells, { c = c, r = r, x = x, z = z })
			end
			local reach = size / 2 - T / 2 - 0.9
			if #closed == 3 then -- a dead end: two spots against its back wall
				table.insert(maze.deadEnds, { x = x, z = z })
				for _, w in ipairs(closed) do
					if rng:NextNumber() < 0.7 then
						local side = rng:NextNumber(-0.3, 0.3) * size
						MapKit.spot(ctx, at(x + w[2] * reach + w[3] * side, z + w[3] * reach + w[2] * side))
					end
				end
			elseif #closed > 0 and rng:NextNumber() < 0.35 then -- a corridor: one along a wall's foot
				local w = closed[rng:NextInteger(1, #closed)]
				local side = rng:NextNumber(-0.35, 0.35) * size
				MapKit.spot(ctx, at(x + w[2] * reach + w[3] * side, z + w[3] * reach + w[2] * side))
			end
		end
	end
	function maze.randomCell()
		return maze.cells[rng:NextInteger(1, #maze.cells)]
	end
	-- n spawn cells spread through the maze (every other cell of a shuffled list, far apart)
	function maze.spawns(n)
		local list = table.clone(maze.cells)
		for i = #list, 2, -1 do
			local j = rng:NextInteger(1, i)
			list[i], list[j] = list[j], list[i]
		end
		local picked = {}
		for _, cell in ipairs(list) do
			local ok = true
			for _, p in ipairs(picked) do
				if math.abs(p.c - cell.c) + math.abs(p.r - cell.r) < 3 then ok = false end
			end
			if ok then table.insert(picked, cell) end
			if #picked >= n then break end
		end
		for _, cell in ipairs(picked) do
			MapKit.spawnAt(ctx, cell.x, cell.z)
		end
	end
	return maze
end

return MazeKit
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00037">
				<Properties>
					<string name="Name">NeedleModel</string>
					<ProtectedString name="Source"><![CDATA[-- The owner's own needle model (Config.NeedleModel.asset): a model imported into Studio with its
-- textures, saved to Roblox, and loaded here once with InsertService (it must belong to the
-- game's owner, or be public). It's turned so its longest side runs along X, centred, then each
-- round a copy is scaled to that round's needle length and laid flat on the hiding spot.
-- Camouflage and Golden rounds, and decoys, keep the built needle (a textured model can't change
-- colour). With no asset set, or if loading fails, every needle is the built one.
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local NeedleModel = {}
local template = nil

function NeedleModel.load()
	local id = Config.NeedleModel and Config.NeedleModel.asset or 0
	if id == 0 then
		return
	end
	task.spawn(function()
		local ok, asset = pcall(InsertService.LoadAsset, InsertService, id)
		if not ok or not asset then
			warn("[NeedleModel] couldn't load model " .. id .. ": " .. tostring(asset) .. " (it must be owned by the game's owner or be public)")
			return
		end
		local model = asset:FindFirstChildWhichIsA("Model") or asset
		local parts = 0
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow, p.Massless = true, false, false, false, false, true
				parts += 1
			end
		end
		if parts == 0 then
			warn("[NeedleModel] model " .. id .. " has no parts")
			return
		end
		-- centre it and turn its longest side along X; then make that the pivot
		local cf, size = model:GetBoundingBox()
		model.WorldPivot = cf
		local turn = CFrame.new()
		if size.Y >= size.X and size.Y >= size.Z then
			turn = CFrame.Angles(0, 0, math.rad(90))
		elseif size.Z >= size.X and size.Z >= size.Y then
			turn = CFrame.Angles(0, math.rad(90), 0)
		end
		model:PivotTo(turn)
		model.WorldPivot = CFrame.new()
		model.Name = "Needle"
		template = model
	end)
end

-- A copy laid on a surface at `base` (the surface point, turned), `length` studs long; or nil.
function NeedleModel.place(base, length)
	if not template then
		return nil
	end
	local m = template:Clone()
	local _, size = m:GetBoundingBox()
	m:ScaleTo(m:GetScale() * length / math.max(size.X, size.Y, size.Z))
	local _, scaled = m:GetBoundingBox()
	m:PivotTo(base * CFrame.new(0, scaled.Y / 2, 0)) -- resting on the surface
	return m
end

return NeedleModel
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00038">
				<Properties>
					<string name="Name">NeedleSpawner</string>
					<ProtectedString name="Source"><![CDATA[-- Hides the needle(s) each round and decides, on the server, who found them.
-- A spot is used only if (1) there's a real surface just under it, (2) nothing solid is in the
-- way where the needle would lie, and (3) it's within jumping height of the floor unless the map
-- marked it reachable by stairs (climb). The needle then moves a little (Config.Find.jitter) and
-- turns, so spots can't be memorised.
-- Claims come from a ClickDetector (mouse or tap) or walking into the needle, and only count if
-- RoundManager's canClaim(player) agrees, the character is within reach, the player isn't
-- clicking too fast or locked out by a decoy, and AntiCheat hasn't flagged them.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapKit = require(script.Parent.MapKit)
local AntiCheat = require(script.Parent.AntiCheat)
local NeedleModel = require(script.Parent.NeedleModel)

local NeedleSpawner = {}
NeedleSpawner.onClaim = function(_player, _needle) end -- RoundManager sets these
NeedleSpawner.canClaim = function(_player)
	return false
end

local folder = nil
local needles = {} -- { model, hitbox, position, golden, index }
local clicks = {} -- [player] = { times }
local lockedUntil = {} -- [player] = os.clock() a decoy locks them out until

local function validSpot(spot, ctx)
	local pos = spot.cf.Position
	if not spot.climb and pos.Y - (ctx.centre.Y + ctx.floorY) > Config.Find.maxSpotHeight then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ctx.model }
	local hit = workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -2.5, 0), params)
	if not hit then
		return false -- nothing to lie on
	end
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { ctx.model }
	local inside = workspace:GetPartBoundsInBox(CFrame.new(hit.Position + Vector3.new(0, 0.35, 0)), Vector3.new(1.4, 0.4, 1.4), overlap)
	for _, part in ipairs(inside) do
		if part.CanCollide and part ~= hit.Instance then
			return false -- inside a wall or another prop
		end
	end
	return true, hit.Position
end

local function rate(player)
	local now, list = os.clock(), clicks[player] or {}
	local kept = {}
	for _, t in ipairs(list) do
		if now - t < 1 then
			table.insert(kept, t)
		end
	end
	table.insert(kept, now)
	clicks[player] = kept
	return #kept <= Config.Find.clicksPerSecond
end

local function claim(player, needle, decoy)
	if not rate(player) or (lockedUntil[player] or 0) > os.clock() or not NeedleSpawner.canClaim(player) or AntiCheat.flagged(player) then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - needle.position).Magnitude > Config.Find.reach + 2 then
		return -- too far: the click came from somewhere it couldn't
	end
	if decoy then
		lockedUntil[player] = os.clock() + Config.Find.decoyLockout
		ReplicatedStorage.Remotes.Notify:FireClient(player, { text = "A decoy! Your hands are shaking for " .. Config.Find.decoyLockout .. " seconds...", tone = "bad" })
		return
	end
	NeedleSpawner.onClaim(player, needle)
end

-- Builds one needle (or a decoy) lying at `pos`: a thin shaft, an eye, and an invisible hitbox
-- you click, tap or walk into.
local function build(pos, diff, round, ctx, decoy)
	local rng = ctx.rng
	local turn = CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
	local base = CFrame.new(pos + Vector3.new(0, 0.06, 0)) * turn
	local length = diff.needle
	local colour, material = Color3.fromRGB(205, 210, 220), Enum.Material.Metal
	if round.golden and not decoy then
		colour = Color3.fromRGB(255, 205, 70)
	elseif round.modifiers.camo or decoy then
		colour, material = MapKit.rgb(ctx.def.straw), Enum.Material.SmoothPlastic
	end
	-- the owner's own needle model when there is one (plain rounds only: it can't change colour)
	local own = not decoy and not round.golden and not round.modifiers.camo and NeedleModel.place(CFrame.new(pos) * turn, length)
	local model = own or Instance.new("Model")
	model.Name = if decoy then "Decoy" else "Needle"
	local shaft = nil
	if not own then
		shaft = MapKit.part(ctx, { Name = "Shaft", Shape = "Cylinder", Size = Vector3.new(length, Config.Find.thickness, Config.Find.thickness), CFrame = base, Color = colour, Material = material, CanCollide = false, Parent = model })
		MapKit.part(ctx, { Name = "Eye", Size = Vector3.new(0.35, Config.Find.thickness * 0.6, Config.Find.thickness * 1.6), CFrame = base * CFrame.new(-length / 2 + 0.17, 0, 0), Color = colour:Lerp(Color3.new(0, 0, 0), 0.25), Material = material, CanCollide = false, Parent = model })
	end
	local hitbox = MapKit.part(ctx, { Name = "Hitbox", Size = Vector3.new(length + 0.5, Config.Find.hitbox, Config.Find.hitbox), CFrame = base, Transparency = 0.99, CanCollide = false, Parent = model })
	local detector = Instance.new("ClickDetector")
	detector.MaxActivationDistance = Config.Find.reach
	detector.Parent = hitbox
	if (diff.glint or round.golden) and not decoy then
		local e = Instance.new("ParticleEmitter")
		e.Rate, e.Lifetime, e.Speed = if round.golden then 3 else 0.6, NumberRange.new(0.4, 0.7), NumberRange.new(0)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
		e.Color, e.LightEmission = ColorSequence.new(if round.golden then Color3.fromRGB(255, 230, 140) else Color3.new(1, 1, 1)), 0.8
		e.Parent = shaft or hitbox
	end
	model.Parent = folder
	if not decoy and RunService:IsStudio() and Config.Testing.revealNeedle then -- testing only
		local h = Instance.new("Highlight")
		h.DepthMode, h.FillColor, h.OutlineColor = Enum.HighlightDepthMode.AlwaysOnTop, Color3.fromRGB(255, 60, 60), Color3.new(1, 1, 1)
		h.Parent = model
		print("[Testing] needle hidden at " .. tostring(hitbox.Position))
	end
	local record = { model = model, position = hitbox.Position, golden = round.golden and not decoy, index = #needles + 1 }
	detector.MouseClick:Connect(function(player)
		claim(player, record, decoy)
	end)
	hitbox.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			claim(player, record, decoy)
		end
	end)
	return record
end

-- Hides the round's needles (two for Double Needle) and Hard round decoys. Returns the needles.
function NeedleSpawner.spawn(ctx, diff, round)
	NeedleSpawner.clear()
	folder = Instance.new("Folder")
	folder.Name = "Needles"
	folder.Parent = ctx.model
	local spots = table.clone(ctx.spots)
	local function take()
		while #spots > 0 do
			local spot = table.remove(spots, ctx.rng:NextInteger(1, #spots))
			local j = Config.Find.jitter
			spot = { cf = spot.cf * CFrame.new((ctx.rng:NextNumber() - 0.5) * 2 * j, 0, (ctx.rng:NextNumber() - 0.5) * 2 * j), climb = spot.climb }
			local ok, at = validSpot(spot, ctx)
			if ok then
				return at
			end
		end
		return nil
	end
	for _ = 1, if round.modifiers.double then 2 else 1 do
		local at = take()
		if at then
			table.insert(needles, build(at, diff, round, ctx, false))
		end
	end
	for _ = 1, diff.decoys do
		local at = take()
		if at then
			build(at, diff, round, ctx, true)
		end
	end
	return needles
end

-- A hint for `player`: roughly where the nearest needle they haven't found is.
function NeedleSpawner.hint(player, foundBy)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local best, dist = nil, math.huge
	for _, n in ipairs(needles) do
		local d = (n.position - root.Position).Magnitude
		if not (foundBy[n.index] and foundBy[n.index][player]) and d < dist then
			best, dist = n, d
		end
	end
	if not best then
		return nil
	end
	local offset = best.position - root.Position
	local rel = root.CFrame:VectorToObjectSpace(offset) -- relative to where you face: -Z is ahead
	local dirs = { "straight ahead", "ahead, to your right", "to your right", "behind you, to the right", "behind you", "behind you, to the left", "to your left", "ahead, to your left" }
	local angle = math.atan2(rel.X, -rel.Z)
	local dir = dirs[(math.floor((angle / (math.pi * 2)) * 8 + 0.5) % 8) + 1]
	local far = if dist < Config.Hints.nearStuds then "very close" elseif dist < Config.Hints.farStuds then "not far" else "a long way off"
	local height = if offset.Y > 4 then ", up high" elseif offset.Y < -4 then ", down low" else ""
	return "The needle is " .. far .. ", " .. dir .. height .. "."
end

function NeedleSpawner.clear()
	if folder then
		folder:Destroy()
	end
	folder, needles = nil, {}
end

Players.PlayerRemoving:Connect(function(player)
	clicks[player], lockedUntil[player] = nil, nil
end)

return NeedleSpawner
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00039">
				<Properties>
					<string name="Name">Powerups</string>
					<ProtectedString name="Source"><![CDATA[-- Power-ups on the maps (Config.Powerups). When a round's search starts, glowing orbs float in
-- random maze cells; walk into one to take it (the server checks you're in the round, it's the
-- search, and you're really there), and a new one appears somewhere else a little later. What it
-- does is decided here; Remotes.Powerup tells your screen what to show (client/PowerupFx):
--   speed     faster walking for a while (set here, on your character)
--   compass   where the nearest needle you haven't found is (your screen shows an arrow)
--   birdseye  your camera rises above the maze for a few seconds (your screen only)
--   glint     where the needles and decoys near you are (your screen makes them sparkle)
--   coins     a pouch of coins, paid here
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MapKit = require(script.Parent.MapKit)
local RewardManager = require(script.Parent.RewardManager)

local Powerups = {}
local P = Config.Powerups
local active = nil -- { ctx, round, folder, token }
local rng = Random.new()

local function needlesNear(position, range)
	local out = {}
	local folder = active and active.ctx.model:FindFirstChild("Needles")
	for _, m in ipairs(folder and folder:GetChildren() or {}) do
		local hitbox = m:FindFirstChild("Hitbox")
		if hitbox and (hitbox.Position - position).Magnitude <= range then
			table.insert(out, hitbox.Position)
		end
	end
	return out
end

local function nearestUnfound(player, position)
	local best, dist = nil, math.huge
	for _, n in ipairs(active.round.needles) do
		local mine = active.round.foundBy[n.index] and active.round.foundBy[n.index][player]
		local d = (n.position - position).Magnitude
		if not mine and d < dist then
			best, dist = n.position, d
		end
	end
	return best
end

local function apply(player, kind, root)
	local message = { kind = kind.id, name = kind.name, seconds = kind.seconds }
	if kind.id == "speed" then
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then
			h.WalkSpeed = kind.walkSpeed
			local token = (player:GetAttribute("SpeedToken") or 0) + 1
			player:SetAttribute("SpeedToken", token)
			task.delay(kind.seconds, function()
				if player:GetAttribute("SpeedToken") == token and h.Parent and h.WalkSpeed == kind.walkSpeed then
					h.WalkSpeed = 16
				end
			end)
		end
	elseif kind.id == "compass" then
		message.target = nearestUnfound(player, root.Position)
	elseif kind.id == "birdseye" then
		message.height = kind.height
	elseif kind.id == "glint" then
		message.points = needlesNear(root.Position, kind.range)
	elseif kind.id == "coins" then
		local coins = kind.coins * (if RewardManager.hasPass(player, "DoubleCoins") then 2 else 1)
		RewardManager.grant(player, coins, kind.xp, nil)
		message.coins = coins
	end
	Remotes.Powerup:FireClient(player, message)
end

local spawnOne

local function take(orb, kind, hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not active or not orb.Parent or not active.round.participants[player] or ReplicatedStorage:GetAttribute("Phase") ~= "search" then
		return
	end
	if (root.Position - orb.Position).Magnitude > 8 then
		return -- too far from the orb: a touch that can't be real
	end
	orb.Parent:Destroy()
	apply(player, kind, root)
	local token = active.token
	task.delay(P.respawn, function()
		if active and active.token == token then
			spawnOne()
		end
	end)
end

spawnOne = function() -- (declared above, so take() can call it)
	local maze = active and active.ctx.maze
	if not maze or #maze.cells == 0 then
		return
	end
	local ctx = active.ctx
	local kind = Rules.pick(P.kinds, rng)
	local cell = maze.cells[rng:NextInteger(1, #maze.cells)]
	local pos = MapKit.at(ctx, cell.x, 2.6, cell.z)
	local model = Instance.new("Model")
	model.Name = "Powerup"
	local colour = Color3.fromRGB(kind.colour[1], kind.colour[2], kind.colour[3])
	local orb = MapKit.part(ctx, { Name = "Orb", CanQuery = false, Shape = "Ball", Size = Vector3.one * 2.2, CFrame = CFrame.new(pos), Color = kind.colour, Material = "Neon", CanCollide = false, Transparency = 0.15, Parent = model })
	local ring = MapKit.part(ctx, { Name = "Ring", Shape = "Cylinder", Size = Vector3.new(0.2, 3.4, 3.4), CFrame = CFrame.new(pos - Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = kind.colour, Material = "Neon", CanCollide = false, CanQuery = false, Transparency = 0.4, Parent = model })
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = colour, 12, 1.4
	light.Parent = orb
	local tag = Instance.new("BillboardGui")
	tag.Size, tag.StudsOffset, tag.MaxDistance, tag.AlwaysOnTop = UDim2.fromOffset(120, 70), Vector3.new(0, 2.4, 0), 60, false
	tag.Parent = orb
	for i, t in ipairs({ { kind.icon, 40 }, { kind.name, 20 } }) do
		local picture = i == 1 and (kind.image or 0) > 0 -- the owner's icon, once uploaded
		local l = Instance.new(if picture then "ImageLabel" else "TextLabel")
		l.BackgroundTransparency, l.Size, l.Position = 1, UDim2.new(1, 0, 0, if i == 1 then 44 else 24), UDim2.fromOffset(0, if i == 1 then 0 else 44)
		if picture then
			l.Image, l.ScaleType = "rbxassetid://" .. kind.image, Enum.ScaleType.Fit
		else
			l.Text, l.Font, l.TextScaled, l.TextColor3, l.TextStrokeTransparency = t[1], Enum.Font.BuilderSansBold, true, Color3.new(1, 1, 1), 0.3
		end
		l.Parent = tag
	end
	TweenService:Create(orb, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = CFrame.new(pos + Vector3.new(0, 0.8, 0)) }):Play()
	TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.8 }):Play()
	model.Parent = active.folder
	orb.Touched:Connect(function(hit)
		take(orb, kind, hit)
	end)
end

-- Starts a round's power-ups (call as the search begins).
function Powerups.start(ctx, round)
	Powerups.stop()
	local folder = Instance.new("Folder")
	folder.Name = "Powerups"
	folder.Parent = ctx.model
	active = { ctx = ctx, round = round, folder = folder, token = rng:NextInteger(1, 2 ^ 30) }
	for _ = 1, P.count do
		spawnOne()
	end
end

-- Ends them: orbs go, and anyone still sped up walks normally again.
function Powerups.stop()
	if active then
		active.folder:Destroy()
		for p in pairs(active.round.participants) do
			local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if h and h.WalkSpeed > 16 then
				h.WalkSpeed = 16
			end
		end
	end
	active = nil
end

return Powerups
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003A">
				<Properties>
					<string name="Name">QuestManager</string>
					<ProtectedString name="Source"><![CDATA[-- Daily quests: three a day, the same for everyone (shared/Quests.forDay). Progress is saved;
-- a new day (UTC) starts fresh. When a quest is done its reward is paid straight away (coins,
-- XP and sometimes a cosmetic) and the player is told.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared:WaitForChild("Quests"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)

local QuestManager = {}
QuestManager.grant = function(_player, _coins, _xp, _why) end -- RewardManager sets this (no circular require)

-- Starts a new day's quests if the saved ones are from an earlier day.
local function fresh(d)
	local today = Quests.today()
	if d.quests.day ~= today then
		d.quests = { day = today, progress = {}, done = {} }
	end
end

-- Records progress of `kind` (see shared/Quests) for today's quests. info.seconds for "fast".
function QuestManager.record(player, kind, amount, info)
	local d = DataManager.get(player)
	if not d then
		return
	end
	local finished = {}
	DataManager.update(player, function(data)
		fresh(data)
		for _, q in ipairs(Quests.forDay(data.quests.day)) do
			local counts = q.kind == kind and not data.quests.done[q.id] and (kind ~= "fast" or (info and info.seconds < q.under))
			if counts then
				local now = math.min(q.n, (data.quests.progress[q.id] or 0) + amount)
				data.quests.progress[q.id] = now
				if now >= q.n then
					data.quests.done[q.id] = true
					table.insert(finished, q)
					if q.cosmetic and Cosmetics.get(q.cosmetic) then
						data.owned[q.cosmetic] = true
					end
				end
			end
		end
	end)
	for _, q in ipairs(finished) do
		QuestManager.grant(player, q.coins, q.xp, "Quest done: " .. q.text)
		if q.cosmetic and Cosmetics.get(q.cosmetic) then
			Remotes.Notify:FireClient(player, { text = "New cosmetic: " .. Cosmetics.get(q.cosmetic).name .. "! Equip it in your Inventory.", tone = "good" })
		end
	end
end

function QuestManager.init()
	DataManager.onLoaded(function(player)
		DataManager.update(player, fresh)
	end)
end

return QuestManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003B">
				<Properties>
					<string name="Name">Requests</string>
					<ProtectedString name="Source"><![CDATA[-- Small requests from players, checked on the server: a hint (Remotes.Hint) and saving their
-- settings (Remotes.SaveSettings: only known settings, only true/false).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local NeedleSpawner = require(script.Parent.NeedleSpawner)
local RewardManager = require(script.Parent.RewardManager)
local RoundManager = require(script.Parent.RoundManager)

local Requests = {}

-- A hint: one free a day (two with the Extra Hint pass), only during a round you're in.
local function hint(player)
	local r = RoundManager.current()
	local d = DataManager.get(player)
	if not r or not d or not r.participants[player] or ReplicatedStorage:GetAttribute("Phase") ~= "search" then
		return nil, "Hints work during a round."
	end
	local today = math.floor(os.time() / 86400)
	local used = if d.hintsDay == today then d.hintsUsed else 0
	local allowed = Config.Hints.free + (if RewardManager.hasPass(player, "ExtraHint") then Config.Hints.pass else 0)
	if used >= allowed then
		return nil, "No hints left today. They come back tomorrow."
	end
	local text = NeedleSpawner.hint(player, r.foundBy)
	if not text then
		return nil, "You've found them all!"
	end
	DataManager.update(player, function(data)
		data.hintsDay, data.hintsUsed = today, used + 1
	end)
	return text, nil
end

function Requests.init()
	Remotes.Hint.OnServerInvoke = hint
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		if type(settings) ~= "table" then
			return
		end
		DataManager.update(player, function(d)
			for key, value in pairs(settings) do
				if type(value) == "boolean" and d.settings[key] ~= nil then
					d.settings[key] = value
				end
			end
		end)
	end)
end

return Requests
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003C">
				<Properties>
					<string name="Name">RewardManager</string>
					<ProtectedString name="Source"><![CDATA[-- Every coin and XP point is given here, on the server: needle finds (faster = more), places,
-- playing a round to the end, win streaks, the daily login streak and quest rewards. Level-ups
-- and rewards are announced to the player. Stats for the leaderboards are kept up to date.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Quests = require(Shared:WaitForChild("Quests"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local QuestManager = require(script.Parent.QuestManager)
local LeaderboardManager = require(script.Parent.LeaderboardManager)

local RewardManager = {}

-- Match stats (server/MatchXp sets this while a round runs): track(player, "coins" | "needles" |
-- "elims", amount). Does nothing between rounds.
RewardManager.tracker = nil
function RewardManager.track(player, what, amount)
	if RewardManager.tracker then
		RewardManager.tracker(player, what, amount)
	end
end

local function hasPass(player, name)
	return player:GetAttribute("Pass_" .. name) == true
end
RewardManager.hasPass = hasPass

-- Gives coins and XP (already multiplied) and announces any level-up. Returns the levels gained.
function RewardManager.grant(player, coins, xp, why)
	local gained = 0
	if coins > 0 then
		RewardManager.track(player, "coins", coins)
	end
	DataManager.update(player, function(d)
		d.coins += coins
		d.coinsEarned += coins
		d.level, d.xp, gained = Rules.addXp(d.level, d.xp, xp)
	end)
	LeaderboardManager.mark(player)
	if why then
		Remotes.Notify:FireClient(player, { text = why .. ": +" .. Rules.commas(coins) .. " coins, +" .. xp .. " XP", tone = "good" })
	end
	if gained > 0 then
		Remotes.Notify:FireClient(player, { text = "LEVEL UP! You're level " .. player:GetAttribute("Level") .. ".", tone = "level" })
	end
	return gained
end

-- A needle claimed (each needle counts, so two in a Double Needle round).
function RewardManager.found(player, elapsed, golden)
	DataManager.update(player, function(d)
		d.needles += 1
		if d.bestTime == 0 or elapsed < d.bestTime then
			d.bestTime = math.floor(elapsed * 10 + 0.5) / 10
		end
	end)
	LeaderboardManager.mark(player)
	RewardManager.track(player, "needles", 1)
	QuestManager.record(player, "find", 1)
	QuestManager.record(player, "fast", 1, { seconds = elapsed })
	if golden then
		QuestManager.record(player, "golden", 1)
	end
end

-- A player finished the round in `place` (1 = first to find every needle). Returns coins, xp.
function RewardManager.placed(player, place, elapsed, duration, diff, golden, playerCount)
	local d = DataManager.get(player)
	if not d then
		return 0, 0
	end
	local coins, xp = Rules.findReward(place, elapsed, duration, diff, golden, d.winStreak, hasPass(player, "DoubleCoins"))
	if place == 1 and playerCount >= Config.Round.winsNeedPlayers then
		DataManager.update(player, function(data)
			data.wins += 1
			data.winStreak += 1
			local week = Rules.week()
			if data.weekly.week ~= week then
				data.weekly = { week = week, wins = 0 }
			end
			data.weekly.wins += 1
		end)
		QuestManager.record(player, "win", 1)
	end
	RewardManager.grant(player, coins, xp, nil)
	return coins, xp
end

-- Everyone still in the map at the end of a round. `won` = they placed first.
function RewardManager.played(player, diff, won)
	local mult = if hasPass(player, "DoubleCoins") then 2 else 1
	DataManager.update(player, function(d)
		d.rounds += 1
		if not won then
			d.winStreak = 0
		end
	end)
	RewardManager.grant(player, Config.Rewards.playCoins * mult, Config.Rewards.playXp, nil)
	QuestManager.record(player, "play", 1)
	if diff.id == "hard" then
		QuestManager.record(player, "hard", 1)
	end
end

-- The daily login streak: the first visit each day (UTC) pays loginCoins x the streak day.
local function login(player, d)
	local today = Quests.today()
	if d.lastDay == today then
		return
	end
	local streak = if d.lastDay == today - 1 then d.loginStreak + 1 else 1
	DataManager.update(player, function(data)
		data.loginStreak, data.lastDay = streak, today
	end)
	local coins = Config.Rewards.loginCoins * math.min(streak, Config.Rewards.loginStreakMax)
	RewardManager.grant(player, coins, 0, "Day " .. streak .. " login bonus")
end

function RewardManager.init()
	DataManager.onLoaded(login)
	QuestManager.grant = RewardManager.grant
end

return RewardManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003D">
				<Properties>
					<string name="Name">RoundExtras</string>
					<ProtectedString name="Source"><![CDATA[-- What runs alongside a round's search, started and stopped together by server/RoundManager:
-- the power-ups (server/Powerups), needle combat (server/Combat) and the match XP count
-- (server/MatchXp).
local Powerups = require(script.Parent.Powerups)
local Combat = require(script.Parent.Combat)
local MatchXp = require(script.Parent.MatchXp)

local RoundExtras = {}

function RoundExtras.start(ctx, round)
	MatchXp.begin(round)
	Combat.start(round)
	Powerups.start(ctx, round)
end

-- At the results: the match XP for everyone (returns the breakdowns), then combat stops.
function RoundExtras.finish(round)
	Combat.stop()
	return MatchXp.finish(round)
end

function RoundExtras.stop()
	Combat.stop()
	MatchXp.cancel()
	Powerups.stop()
end

return RoundExtras
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003E">
				<Properties>
					<string name="Name">RoundManager</string>
					<ProtectedString name="Source"><![CDATA[-- The round loop, all on the server:
--   lobby (Config.Round.lobbyCountdown) -> loading: pick a map, difficulty, modifier and maybe a
--   Golden Needle, build the map, hide the needle(s), move everyone in -> countdown (3, 2, 1;
--   nobody moves) -> search (the timer runs; a player "finishes" when they've found every
--   needle; after the first finish, everyone else has Config.Round.grace seconds) -> results ->
--   back to the lobby. A lone player still gets rounds (practice).
-- The phase is published as attributes on ReplicatedStorage (Phase, EndsAt, MapName,
-- Difficulty, Modifiers, Golden, NeedleCount) and announced with Remotes.RoundState.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Maps = require(Shared:WaitForChild("Maps"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local NeedleSpawner = require(script.Parent.NeedleSpawner)
local RewardManager = require(script.Parent.RewardManager)
local CollectionManager = require(script.Parent.CollectionManager)
local AntiCheat = require(script.Parent.AntiCheat)
local MapKit = require(script.Parent.MapKit)
local RoundExtras = require(script.Parent.RoundExtras)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local builders = require(script.Parent.MapsA)
for name, fn in pairs(require(script.Parent.MapsB)) do
	builders[name] = fn
end

local RoundManager = {}
local rng = Random.new()
local round = nil -- the round in play: { participants, finished, foundBy, needles, started, duration, diff, golden, ... }
local lastMap = nil

local function now()
	return workspace:GetServerTimeNow()
end

local function phase(name, seconds, extra)
	ReplicatedStorage:SetAttribute("Phase", name)
	ReplicatedStorage:SetAttribute("EndsAt", now() + (seconds or 0))
	Remotes.RoundState:FireAllClients({ phase = name, endsAt = now() + (seconds or 0), extra = extra })
end

local function light(spec, dim)
	for key, value in pairs(spec) do
		Lighting[key] = if type(value) == "table" then Color3.fromRGB(value[1], value[2], value[3]) else value
	end
	if dim and dim > 0 then
		Lighting.Brightness *= 1 - dim
		Lighting.Ambient = Lighting.Ambient:Lerp(Color3.new(0, 0, 0), dim)
		Lighting.OutdoorAmbient = Lighting.OutdoorAmbient:Lerp(Color3.new(0, 0, 0), dim)
	end
end

local function humanoid(player)
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid"), c
end

local function freeze(player, on)
	local h = humanoid(player)
	if h then
		h.WalkSpeed = if on then 0 else 16
		h.JumpHeight = if on then 0 else 7.2
	end
end

local function move(player, cf)
	local h, c = humanoid(player)
	if h and c and h.Health > 0 then
		AntiCheat.allow(player, 3)
		c:PivotTo(cf)
	end
end

-- Players who'll play this round: loaded, alive, and not sitting out (Settings: Auto-join).
local function players()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local d = DataManager.get(p)
		local h = humanoid(p)
		if d and d.settings.autoJoin and h and h.Health > 0 then
			table.insert(list, p)
		end
	end
	return list
end

-- A claim on needle `n` by `player` (already checked by NeedleSpawner).
local function onClaim(player, n)
	local r = round
	if not r or not r.participants[player] or r.finished[player] then
		return
	end
	r.foundBy[n.index] = r.foundBy[n.index] or {}
	if r.foundBy[n.index][player] then
		return
	end
	r.foundBy[n.index][player] = true
	local elapsed = now() - r.started
	RewardManager.found(player, elapsed, n.golden)
	local count = 0
	for i = 1, #r.needles do
		if r.foundBy[i] and r.foundBy[i][player] then
			count += 1
		end
	end
	player:SetAttribute("Found", count)
	if count < #r.needles then
		Remotes.Notify:FireClient(player, { text = "One down! " .. (#r.needles - count) .. " to go.", tone = "good" })
		return
	end
	table.insert(r.order, player)
	r.finished[player] = elapsed
	local place = #r.order
	local coins, xp = RewardManager.placed(player, place, elapsed, r.duration, r.diff, r.golden, r.count)
	local kept = CollectionManager.award(player, place, r.diff, r.golden)
	r.rewards[player] = { coins = coins, xp = xp, kept = kept }
	Remotes.Found:FireAllClients({ userId = player.UserId, name = player.DisplayName, place = place, seconds = elapsed, golden = r.golden, position = n.position, coins = coins, xp = xp, kept = kept })
	if place == 1 then
		r.graceEnds = now() + Config.Round.grace
		ReplicatedStorage:SetAttribute("EndsAt", math.min(r.ends, r.graceEnds))
	end
end

local function pickModifiers()
	local mods = {}
	if rng:NextNumber() < Config.ModifierChance then
		mods[Rules.pick(Config.Modifiers, rng).id] = true
	end
	return mods
end

local function playRound()
	-- choose and build
	local options = {}
	for _, m in ipairs(Maps.list) do
		if m.id ~= lastMap or #Maps.list == 1 then
			table.insert(options, m)
		end
	end
	local def = Rules.pick(options, rng)
	lastMap = def.id
	local diff = Rules.pick(Config.Difficulty, rng)
	local mods = pickModifiers()
	local golden = rng:NextNumber() < Config.GoldenChance
	local old = workspace:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	MapKit.clearTerrain(Config.ArenaCentre) -- the last map's haystacks
	local model = Instance.new("Model")
	model.Name = "Arena"
	model.Parent = workspace
	local ctx = { model = model, rng = Random.new(rng:NextInteger(1, 2 ^ 30)), centre = Config.ArenaCentre, def = def, spots = {}, spawns = {}, floorY = 0, diff = diff }
	local modNames = {}
	for _, m in ipairs(Config.Modifiers) do
		if mods[m.id] then
			table.insert(modNames, m.name)
		end
	end
	ReplicatedStorage:SetAttribute("MapName", def.name)
	ReplicatedStorage:SetAttribute("Difficulty", diff.name)
	ReplicatedStorage:SetAttribute("Modifiers", table.concat(modNames, ", "))
	ReplicatedStorage:SetAttribute("Golden", golden)
	phase("loading", 3)
	builders[def.builder](ctx)
	local needles = NeedleSpawner.spawn(ctx, diff, { modifiers = mods, golden = golden })
	ReplicatedStorage:SetAttribute("NeedleCount", #needles)
	light(def.lighting, diff.dim + (if mods.lowlight then 0.45 else 0))
	-- move everyone in
	local list = players()
	if #list == 0 or #needles == 0 then
		light(Maps.lobbyLighting)
		model:Destroy()
		MapKit.clearTerrain(Config.ArenaCentre)
		return
	end
	local duration = if mods.speed then Config.Round.speedDuration else Config.Round.duration
	round = { participants = {}, finished = {}, foundBy = {}, order = {}, rewards = {}, needles = needles, diff = diff, golden = golden, duration = duration, count = #list, spawns = ctx.spawns }
	for i, p in ipairs(list) do
		round.participants[p] = true
		p:SetAttribute("Found", 0)
		move(p, ctx.spawns[(i - 1) % #ctx.spawns + 1])
		freeze(p, true)
	end
	phase("countdown", Config.Round.loadCountdown)
	task.wait(Config.Round.loadCountdown)
	for p in pairs(round.participants) do
		freeze(p, false)
	end
	round.started = now()
	round.ends = round.started + duration
	phase("search", duration)
	RoundExtras.start(ctx, round)
	-- search until time is up, the grace window closes or everyone has finished
	while true do
		task.wait(0.25)
		local remaining = 0
		for p in pairs(round.participants) do
			if p.Parent and not round.finished[p] then
				remaining += 1
			end
		end
		local t = now()
		if t >= round.ends or (round.graceEnds and t >= round.graceEnds) or remaining == 0 then
			break
		end
	end
	-- results and rewards for playing
	local rows = {}
	for place, p in ipairs(round.order) do
		local r = round.rewards[p] or { coins = 0, xp = 0 }
		table.insert(rows, { name = p.DisplayName, userId = p.UserId, place = place, seconds = round.finished[p], coins = r.coins, xp = r.xp, kept = r.kept })
	end
	for p in pairs(round.participants) do
		if p.Parent then
			RewardManager.played(p, diff, round.order[1] == p)
		end
	end
	local xp = RoundExtras.finish(round) -- everyone's match XP, with their breakdown for the results
	phase("results", Config.Round.results, { rows = rows, map = def.name, golden = golden, xp = xp })
	NeedleSpawner.clear()
	RoundExtras.stop()
	task.wait(Config.Round.results)
	for i, p in ipairs(Players:GetPlayers()) do
		if round.participants[p] then
			move(p, LobbyBuilder.spawnPoint(i))
		end
	end
	round = nil
	model:Destroy()
	MapKit.clearTerrain(Config.ArenaCentre)
	light(Maps.lobbyLighting)
end

-- The round in play (nil between rounds), for server/Requests.
function RoundManager.current()
	return round
end

function RoundManager.start()
	NeedleSpawner.onClaim = onClaim
	NeedleSpawner.canClaim = function(player)
		return round ~= nil and round.participants[player] == true and ReplicatedStorage:GetAttribute("Phase") == "search"
	end
	Players.PlayerRemoving:Connect(function(player)
		if round then
			round.participants[player] = nil
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.3) -- a participant who respawns goes back into the round's map
			if round and round.participants[player] and round.spawns and #round.spawns > 0 then
				move(player, round.spawns[rng:NextInteger(1, #round.spawns)])
			end
		end)
	end)
	light(Maps.lobbyLighting)
	task.spawn(function()
		while true do
			phase("lobby", Config.Round.lobbyCountdown)
			task.wait(Config.Round.lobbyCountdown)
			if #players() >= Config.Round.minPlayers then
				local ok, err = pcall(playRound)
				if not ok then
					warn("[Round] " .. tostring(err))
					for i, p in ipairs(Players:GetPlayers()) do -- nobody is left in a broken map
						freeze(p, false)
						move(p, LobbyBuilder.spawnPoint(i))
					end
					round = nil
					NeedleSpawner.clear()
					RoundExtras.stop()
					light(Maps.lobbyLighting)
				end
			end
		end
	end)
end

return RoundManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0003F">
				<Properties>
					<string name="Name">ShopManager</string>
					<ProtectedString name="Source"><![CDATA[-- Cosmetics and purchases. With Haystack Coins: buy a cosmetic (Remotes.Shop "buy"), and wear
-- what you own ("equip"); the server checks the price, your coins and that you own it. With
-- Robux (MarketplaceService): game passes (2x Coins, Extra Hint, Grand Booth, Supporter) are
-- checked on join and after a purchase; products (Starter Bundle, coin packs, Coin Shower) go
-- through ProcessReceipt (and the Harvest and Starlight Boxes, via server/BoxManager), which records
-- each receipt in the save so a repeated receipt is never paid twice, and only reports success
-- once the save has been written. What you wear shows on your character: a trail and a title.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local BoxManager = require(script.Parent.BoxManager)
local CollectionManager = require(script.Parent.CollectionManager)

local ShopManager = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Puts on (or takes off) the trail and title a player wears.
function ShopManager.dress(player)
	local d = DataManager.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local head = character and character:FindFirstChild("Head")
	if not d or not root or not head then
		return
	end
	for _, name in ipairs({ "CosmeticTrail", "CosmeticA0", "CosmeticA1" }) do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local trail = Cosmetics.get(d.equipped.trail or "")
	if trail then
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Name, a1.Name = "CosmeticA0", "CosmeticA1"
		a0.Position, a1.Position = Vector3.new(0, 0.8, 0.4), Vector3.new(0, -0.8, 0.4)
		a0.Parent, a1.Parent = root, root
		local t = Instance.new("Trail")
		t.Name = "CosmeticTrail"
		t.Attachment0, t.Attachment1 = a0, a1
		t.Color = ColorSequence.new(rgb(trail.colours[1]), rgb(trail.colours[2]))
		t.Transparency = NumberSequence.new(0.3, 1)
		t.Lifetime, t.LightEmission = 0.6, 0.4
		t.Parent = root
	end
	local old = head:FindFirstChild("CosmeticTitle")
	if old then
		old:Destroy()
	end
	local title = Cosmetics.get(d.equipped.title or "")
	if title then
		local board = Instance.new("BillboardGui")
		board.Name = "CosmeticTitle"
		board.Size, board.StudsOffset, board.MaxDistance = UDim2.fromOffset(200, 30), Vector3.new(0, 2.4, 0), 60
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Font, label.TextScaled, label.Text = Enum.Font.BuilderSansBold, true, title.name
		label.TextColor3, label.TextStrokeTransparency = rgb(title.colours[1]), 0.4
		label.Parent = board
		board.Parent = head
	end
end

local function buy(player, id)
	local item = Cosmetics.get(id)
	local d = DataManager.get(player)
	if not item or not d then
		return false, "That isn't for sale."
	elseif d.owned[id] then
		return false, "You already own " .. item.name .. "."
	elseif item.price <= 0 then
		return false, item.name .. " comes from " .. (item.source or "somewhere else") .. "."
	elseif d.coins < item.price then
		return false, "You need " .. (item.price - d.coins) .. " more coins."
	end
	DataManager.update(player, function(data)
		data.coins -= item.price
		data.owned[id] = true
		data.equipped[item.kind] = id
	end)
	ShopManager.dress(player)
	return true, "You bought " .. item.name .. "!"
end

local function equip(player, id)
	local item = Cosmetics.get(id)
	local d = DataManager.get(player)
	if not item or not d or not d.owned[id] then
		return false, "You don't own that."
	end
	DataManager.update(player, function(data)
		data.equipped[item.kind] = if data.equipped[item.kind] == id and not Cosmetics.defaults[item.kind] then nil else id
	end)
	ShopManager.dress(player)
	return true, nil
end

-- Game passes: owned ones become attributes (Pass_DoubleCoins...) the rest of the game reads.
local function passOwned(player, name, owned)
	player:SetAttribute("Pass_" .. name, owned)
	if owned and name == "Supporter" then
		DataManager.update(player, function(d)
			d.owned.t_supporter, d.owned.ti_supporter = true, true
		end)
	end
end

local function checkPasses(player)
	for name, id in pairs(Config.GamePasses) do
		if id ~= 0 then
			local ok, owned = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			passOwned(player, name, ok and owned)
		end
	end
end

-- What each Robux product gives (by its name in Config.Products). Bought coins never count
-- towards the Most Coins Earned board. Returns the thank-you line.
local function give(player, name, data)
	if name == "StarterBundle" then
		local bundle = Config.StarterBundle
		data.coins += bundle.coins
		data.starterBought = true
		if Cosmetics.get(bundle.cosmetic) then
			data.owned[bundle.cosmetic] = true
		end
		return "Starter Bundle: +" .. bundle.coins .. " coins and the " .. (Cosmetics.get(bundle.cosmetic) or { name = "new" }).name .. ". Thank you!"
	elseif Config.CoinPacks[name] then
		data.coins += Config.CoinPacks[name]
		return "+" .. Rules.commas(Config.CoinPacks[name]) .. " coins. Thank you!"
	elseif name == "CoinShower" then
		data.coins += Config.CoinShower.coins
		return "Your Coin Shower: +" .. Config.CoinShower.coins .. " coins for everyone here. Thank you!"
	end
	for _, box in ipairs(Config.Boxes.list) do
		if box.product == name then -- a box opened with Robux: the reel shows what came out
			local result = BoxManager.openInto(data, box)
			return "Thank you! Your " .. box.name .. " is opening...", result
		end
	end
	return nil
end

local function productName(id)
	for name, pid in pairs(Config.Products) do
		if pid ~= 0 and pid == id then
			return name
		end
	end
	return nil
end

-- A Coin Shower: everyone else in the server gets the coins too (the buyer's are in the receipt).
local function shower(buyer)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= buyer and DataManager.get(p) then
			DataManager.update(p, function(data)
				data.coins += Config.CoinShower.coins
			end)
		end
		Remotes.Notify:FireClient(p, { text = buyer.DisplayName .. " shared a Coin Shower: +" .. Config.CoinShower.coins .. " coins for everyone!", tone = "good" })
	end
end

-- Robux products: grant once per receipt, then save before telling Roblox it's done.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local d = player and DataManager.get(player)
	local name = productName(receipt.ProductId)
	if not d or not name then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- tried again when they're back
	end
	if table.find(d.receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already given
	end
	local thanks, opened
	DataManager.update(player, function(data)
		thanks, opened = give(player, name, data)
		table.insert(data.receipts, receipt.PurchaseId)
		while #data.receipts > 50 do
			table.remove(data.receipts, 1)
		end
	end)
	-- not saved (or a session that can't save): Roblox offers the receipt again later, and the
	-- receipt list above stops it paying twice in this session
	if DataManager.unsaved(player) or not DataManager.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if name == "CoinShower" then
		shower(player)
	end
	if opened then
		CollectionManager.after(player, opened)
		Remotes.BoxResult:FireClient(player, opened)
	end
	Remotes.Notify:FireClient(player, { text = thanks or "Thank you!", tone = "good" })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopManager.init()
	Remotes.Shop.OnServerInvoke = function(player, action, id)
		if type(action) ~= "string" or type(id) ~= "string" then
			return false, "?"
		end
		if action == "buy" then
			return buy(player, id)
		elseif action == "equip" then
			return equip(player, id)
		end
		return false, "?"
	end
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
		for name, id in pairs(Config.GamePasses) do
			if bought and id == passId then
				passOwned(player, name, true)
				Remotes.Notify:FireClient(player, { text = "Thank you! Your pass is active.", tone = "good" })
			end
		end
	end)
	DataManager.onLoaded(function(player)
		checkPasses(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			ShopManager.dress(player)
		end)
		if player.Character then
			ShopManager.dress(player)
		end
	end)
end

return ShopManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00040">
				<Properties>
					<string name="Name">TradeManager</string>
					<ProtectedString name="Source"><![CDATA[-- Trading needles between two players in the lobby (Config.Trading). Remotes.Trade asks; the
-- server keeps every trade and sends each side its state (Remotes.TradeState). Protections:
--   only in the lobby (never during a round), one trade at a time, a cooldown on asking;
--   any change to either offer un-readies both, and stops the countdown;
--   once both press Ready, a countdown runs before anything moves, and either can still cancel;
--   at the end the server checks both still own everything offered, then swaps and saves both.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local DataManager = require(script.Parent.DataManager)
local LeaderboardManager = require(script.Parent.LeaderboardManager)
local RoundManager = require(script.Parent.RoundManager)

local TradeManager = {}
local TR = Config.Trading
local trades = {} -- player -> the trade they're in
local invites = {} -- target -> { [from] = os.clock() }
local lastAsk = {}

local function other(t, p)
	return if t.a == p then t.b else t.a
end

local function count(offer)
	local n = 0
	for _, c in pairs(offer) do
		n += c
	end
	return n
end

local function list(offer)
	local out = {}
	for key, c in pairs(offer) do
		table.insert(out, { key = key, count = c })
	end
	return out
end

local function send(t)
	for _, p in ipairs({ t.a, t.b }) do
		local o = other(t, p)
		Remotes.TradeState:FireClient(p, {
			kind = "trade", countdownEnds = t.countdownEnds,
			you = { offer = list(t.offer[p]), ready = t.ready[p] == true },
			them = { userId = o.UserId, name = o.DisplayName, offer = list(t.offer[o]), ready = t.ready[o] == true },
		})
	end
end

local function finish(t, text)
	trades[t.a], trades[t.b] = nil, nil
	t.over = true
	for _, p in ipairs({ t.a, t.b }) do
		if p.Parent then
			Remotes.TradeState:FireClient(p, { kind = "closed", text = text })
		end
	end
end

local function inLobby(player) -- not playing in the round going on (if one is)
	local round = RoundManager.current()
	return not (round and round.participants[player])
end

-- Both still own what they offered? Then swap, fix showcases, and save both.
local function execute(t)
	local da, db = DataManager.get(t.a), DataManager.get(t.b)
	if not da or not db or DataManager.unsaved(t.a) or DataManager.unsaved(t.b) then
		return finish(t, "Trade cancelled: a save isn't working right now.")
	end
	for _, side in ipairs({ { t.a, da }, { t.b, db } }) do
		for key, c in pairs(t.offer[side[1]]) do
			if (side[2].collection[key] or 0) < c then
				return finish(t, "Trade cancelled: something offered isn't there any more.")
			end
		end
	end
	local function move(from, to)
		DataManager.update(from, function(data)
			for key, c in pairs(t.offer[from]) do
				data.collection[key] -= c
				if data.collection[key] <= 0 then
					data.collection[key] = nil
					if data.showcase == key then
						data.showcase = ""
					end
				end
			end
		end)
		DataManager.update(to, function(data)
			for key, c in pairs(t.offer[from]) do
				data.collection[key] = (data.collection[key] or 0) + c
			end
		end)
	end
	move(t.a, t.b)
	move(t.b, t.a)
	for _, p in ipairs({ t.a, t.b }) do
		DataManager.update(p, function(data) -- nothing on show? Your best needle goes up
			if data.showcase == "" then
				local best, value = "", -1
				for key in pairs(data.collection) do
					local ty, sk = Needles.split(key)
					if ty and Needles.value(ty, sk) > value then
						best, value = key, Needles.value(ty, sk)
					end
				end
				data.showcase = best
			end
		end)
		DataManager.save(p)
		LeaderboardManager.mark(p)
	end
	print(string.format("[Trade] %s <-> %s: %d for %d needles", t.a.Name, t.b.Name, count(t.offer[t.a]), count(t.offer[t.b])))
	finish(t, "Trade done! Enjoy your new needles.")
end

local function unready(t)
	t.ready, t.countdownEnds, t.token = {}, nil, (t.token or 0) + 1
end

local actions = {}

function actions.request(player, userId)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	if not target or target == player then
		return false, "They aren't here."
	elseif not inLobby(player) or not inLobby(target) then
		return false, "Trades happen in the lobby, between rounds."
	elseif trades[player] or trades[target] then
		return false, "One of you is already trading."
	elseif os.clock() - (lastAsk[player] or 0) < TR.requestCooldown then
		return false, "Wait a moment before asking again."
	end
	lastAsk[player] = os.clock()
	invites[target] = invites[target] or {}
	invites[target][player] = os.clock()
	Remotes.TradeState:FireClient(target, { kind = "invite", from = player.UserId, name = player.DisplayName })
	return true, "Asked " .. target.DisplayName .. " to trade."
end

function actions.respond(player, userId, accept)
	local from = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	local asked = from and invites[player] and invites[player][from]
	if invites[player] and from then
		invites[player][from] = nil
	end
	if not asked or os.clock() - asked > 30 then
		return false, "That invite has run out."
	elseif not accept then
		Remotes.Notify:FireClient(from, { text = player.DisplayName .. " said no thanks to a trade.", tone = "bad" })
		return true, nil
	elseif trades[player] or trades[from] or not inLobby(player) or not inLobby(from) then
		return false, "That trade can't start right now."
	end
	local t = { a = from, b = player, offer = { [from] = {}, [player] = {} }, ready = {} }
	trades[from], trades[player] = t, t
	send(t)
	return true, nil
end

function actions.offer(player, key, add)
	local t = trades[player]
	local d = DataManager.get(player)
	if not t or not d or type(key) ~= "string" or not Needles.split(key) then
		return false, "?"
	end
	local mine = t.offer[player]
	if add then
		if (mine[key] or 0) >= (d.collection[key] or 0) then
			return false, "You don't have another of those."
		elseif count(mine) >= TR.maxItems then
			return false, "Up to " .. TR.maxItems .. " needles a trade."
		end
		mine[key] = (mine[key] or 0) + 1
	elseif mine[key] then
		mine[key] = if mine[key] > 1 then mine[key] - 1 else nil
	end
	unready(t) -- any change: both have to look again
	send(t)
	return true, nil
end

function actions.ready(player, on)
	local t = trades[player]
	if not t then
		return false, "?"
	end
	t.ready[player] = on == true
	if t.ready[t.a] and t.ready[t.b] then
		if count(t.offer[t.a]) + count(t.offer[t.b]) == 0 then
			t.ready = {}
			send(t)
			return false, "Put something in the trade first."
		end
		t.token = (t.token or 0) + 1
		local token = t.token
		t.countdownEnds = workspace:GetServerTimeNow() + TR.countdown
		task.delay(TR.countdown, function()
			if not t.over and t.token == token and t.ready[t.a] and t.ready[t.b] then
				execute(t)
			end
		end)
	else
		t.countdownEnds, t.token = nil, (t.token or 0) + 1
	end
	send(t)
	return true, nil
end

function actions.cancel(player)
	local t = trades[player]
	if t then
		finish(t, player.DisplayName .. " cancelled the trade.")
	end
	return true, nil
end

function TradeManager.init()
	Remotes.Trade.OnServerInvoke = function(player, action, a, b)
		local fn = type(action) == "string" and actions[action]
		if not fn then
			return false, "?"
		end
		return fn(player, a, b)
	end
	Players.PlayerRemoving:Connect(function(player)
		local t = trades[player]
		if t then
			finish(t, player.DisplayName .. " left, so the trade was cancelled.")
		end
		invites[player], lastAsk[player] = nil, nil
	end)
	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		if ReplicatedStorage:GetAttribute("Phase") == "countdown" then -- a round is starting
			local seen = {}
			for _, t in pairs(trades) do
				if not seen[t] then
					seen[t] = true
					finish(t, "A round is starting, so the trade was cancelled. Nothing moved.")
				end
			end
		end
	end)
end

return TradeManager
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerStorage" referent="RBX00041">
		<Properties>
			<string name="Name">ServerStorage</string>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX00042">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00043">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX00044">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00045">
					<Properties>
						<string name="Name">BoxReel</string>
						<ProtectedString name="Source"><![CDATA[-- The box opening on your screen: a strip of needle cards slides along under a gold marker,
-- slows and stops on the needle the server already chose, then the needle turns in 3D with its
-- rarity, value and whether it's new. The other cards are picked by the same odds (shared/Boxes)
-- and nothing is arranged to look like a near miss. Reduce effects in Settings makes it shorter.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Needles = require(Shared:WaitForChild("Needles"))
local Boxes = require(Shared:WaitForChild("Boxes"))
local Rules = require(Shared:WaitForChild("Rules"))
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)
local NeedleView = require(script.Parent.NeedleView)

local BoxReel = {}
local CARD, GAP, COUNT, LAND = 132, 10, 46, 40 -- card width, gap, cards on the strip, the winning card
local rng = Random.new()

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- A card: the needle's colours as a little needle, its name, and a bar in its rarity colour.
local function card(parent, i, typeId, skinId)
	local skin = Needles.skin(skinId)
	local rarity = Needles.rarity(skin.rarity)
	local c = UiKit.make("Frame", { Position = UDim2.fromOffset((i - 1) * (CARD + GAP), 0), Size = UDim2.fromOffset(CARD, 150), BackgroundColor3 = UiKit.colors.card, ZIndex = 62, Parent = parent }, { UiKit.corner(10), UiKit.stroke(rgb(rarity.colour), 2) })
	local glow = UiKit.make("Frame", { Size = UDim2.new(1, 0, 0, 96), BackgroundColor3 = rgb(rarity.colour), BackgroundTransparency = 0.8, ZIndex = 62, Parent = c }, { UiKit.corner(10) })
	local shaft = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(92, 9), Rotation = -30, BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = glow }, { UiKit.corner(4) })
	local a, b = rgb(skin.colours[1]), rgb(skin.colours[2] or skin.colours[1])
	UiKit.make("UIGradient", { Color = if skin.pattern == "rainbow" then ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0.6, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.4, 0.6, 1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(0.8, 0.6, 1)) }) else ColorSequence.new(a, b), Parent = shaft })
	UiKit.label({ Text = skin.name, Font = UiKit.bold, Size = UDim2.new(1, -10, 0, 22), Position = UDim2.fromOffset(5, 98), ZIndex = 63, Parent = c }, 18)
	UiKit.label({ Text = Needles.type(typeId).name, Size = UDim2.new(1, -10, 0, 18), Position = UDim2.fromOffset(5, 120), TextColor3 = UiKit.colors.soft, ZIndex = 63, Parent = c }, 14)
	UiKit.make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = rgb(rarity.colour), ZIndex = 64, Parent = c }, { UiKit.corner(3) })
	return c
end

-- The reveal under the reel: the needle in 3D, what it is and what it's worth.
local function reveal(panel, result, again, close)
	local rarity = Needles.rarity(result.rarityId)
	local box = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 236), Size = UDim2.fromOffset(560, 250), BackgroundColor3 = UiKit.colors.panel, ZIndex = 62, Parent = panel }, { UiKit.corner(16), UiKit.stroke(rgb(rarity.colour), 3) })
	NeedleView.make(box, result.type, result.skin, { Size = UDim2.fromOffset(220, 200), Position = UDim2.fromOffset(10, 24), ZIndex = 63 }, true)
	UiKit.label({ Text = rarity.name:upper() .. (if result.new then "  ·  NEW!" else ""), Font = UiKit.bold, TextColor3 = rgb(rarity.colour), Size = UDim2.new(1, -250, 0, 30), Position = UDim2.fromOffset(240, 26), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 63, Parent = box }, 26)
	UiKit.label({ Text = result.name, Font = UiKit.bold, Size = UDim2.new(1, -250, 0, 56), Position = UDim2.fromOffset(240, 60), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 63, Parent = box }, 26)
	UiKit.label({ Text = "Worth " .. Rules.commas(result.value) .. (if result.new then "" else "  ·  you have more than one now: trade it!"), Size = UDim2.new(1, -250, 0, 40), Position = UDim2.fromOffset(240, 118), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, ZIndex = 63, Parent = box }, 18)
	local more = UiKit.button("Open another", UiKit.colors.green, { Position = UDim2.fromOffset(240, 178), Size = UDim2.fromOffset(150, 46), ZIndex = 63, Parent = box })
	local done = UiKit.button("Done", UiKit.colors.card, { Position = UDim2.fromOffset(400, 178), Size = UDim2.fromOffset(140, 46), ZIndex = 63, Parent = box })
	more.Activated:Connect(again)
	done.Activated:Connect(close)
	UiKit.pop(box, 0.8)
	Effects.sound("found", if rarity.mult >= 40 then 1.25 else 1)
end

-- Plays the opening for `result` (from the server) in `parent` (the Boxes window). again() opens
-- another of the same box; close() returns to the boxes.
function BoxReel.play(parent, result, again, close)
	local box = Boxes.get(result.box) or Boxes.get("hay")
	local panel = UiKit.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UiKit.colors.panel, ZIndex = 60, Parent = parent }, { UiKit.corner(18) })
	UiKit.label({ Text = "Opening the " .. box.name .. "...", Font = UiKit.bold, Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 18), TextColor3 = rgb(box.colour), ZIndex = 61, Parent = panel }, 28)
	local window = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70), Size = UDim2.new(1, -40, 0, 150), BackgroundColor3 = Color3.fromRGB(70, 52, 34), ClipsDescendants = true, ZIndex = 61, Parent = panel }, { UiKit.corner(12), UiKit.stroke(Color3.fromRGB(150, 110, 64), 3) })
	local strip = UiKit.make("Frame", { Size = UDim2.fromOffset(COUNT * (CARD + GAP), 150), BackgroundTransparency = 1, ZIndex = 61, Parent = window })
	for i = 1, COUNT do
		if i == LAND then
			card(strip, i, result.type, result.skin)
		else
			card(strip, i, Boxes.filler(box, rng))
		end
	end
	UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = UiKit.colors.gold, ZIndex = 70, Parent = window }) -- the marker
	local width = window.AbsoluteSize.X
	local stopAt = (LAND - 1) * (CARD + GAP) + CARD / 2 + rng:NextNumber(-CARD * 0.35, CARD * 0.35) -- somewhere on the card, never its edge
	local seconds = if Effects.settings.reduceEffects then 2 else 5.5
	strip.Position = UDim2.fromOffset(width / 2 - CARD / 2, 0)
	local tween = UiKit.ease(strip, seconds, { Position = UDim2.fromOffset(width / 2 - stopAt, 0) }, Enum.EasingStyle.Quint)
	local last = 0
	local conn = RunService.RenderStepped:Connect(function() -- a soft tick as each card passes the marker
		local passed = math.floor((width / 2 - strip.Position.X.Offset) / (CARD + GAP))
		if passed ~= last then
			last = passed
			Effects.sound("click", 1.4)
		end
	end)
	tween.Completed:Wait()
	conn:Disconnect()
	if panel.Parent then
		reveal(panel, result, function()
			panel:Destroy()
			again()
		end, function()
			panel:Destroy()
			close()
		end)
	end
end

return BoxReel
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00046">
					<Properties>
						<string name="Name">BoxScreen</string>
						<ProtectedString name="Source"><![CDATA[-- The Boxes screen: each box with its price (coins; the dearer ones also Robux), and below them
-- the exact odds of every rarity and the skins inside each box, always on show, and how many opens until
-- the Rare-or-better guarantee. Opening asks the server (Remotes.Box), which decides; Robux opens
-- come back through Remotes.BoxResult. Where paid random items are restricted, the screen says
-- boxes aren't available and shows nothing to buy.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Boxes = require(Shared:WaitForChild("Boxes"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Hud = require(script.Parent.Hud)
local BoxReel = require(script.Parent.BoxReel)

local player = Players.LocalPlayer
local BoxScreen = {}
local win, body
local prices = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function clear()
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function robuxPrice(id, button)
	if prices[id] then
		button.Text = prices[id]
		return
	end
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, Enum.InfoType.Product)
		if ok and info and info.PriceInRobux then
			prices[id] = "R$ " .. info.PriceInRobux
			if button.Parent then
				button.Text = prices[id]
			end
		end
	end)
end

local function open(box)
	local ok, result = Remotes.Box:InvokeServer("open", box.id)
	if not ok then
		Hud.toast(tostring(result), "bad")
		return
	end
	BoxReel.play(win, result, function()
		open(box)
	end, BoxScreen.refresh)
end

-- What's inside: each rarity's chance, and the skins it can be.
local function contents(order, box)
	local panel = UiKit.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UiKit.colors.card, Parent = body }, {
		UiKit.corner(12), UiKit.pad(12), UiKit.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	UiKit.label({ Text = "Inside the " .. box.name .. " (exact odds)", Font = UiKit.bold, Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = panel }, 22)
	for i, row in ipairs(Boxes.odds(box)) do
		local names = {}
		for _, s in ipairs(Boxes.skins(box, row.rarity.id)) do
			table.insert(names, s.name)
		end
		local line = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = panel })
		UiKit.label({ Text = string.format("%s  %.1f%%", row.rarity.name, row.percent), Font = UiKit.bold, TextColor3 = rgb(row.rarity.colour), Size = UDim2.new(0, 200, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = line }, 18)
		local _, fill = UiKit.bar(line, { Size = UDim2.new(1, -210, 0, 8), Position = UDim2.fromOffset(210, 8) }, rgb(row.rarity.colour))
		fill.Size = UDim2.fromScale(math.max(row.percent / 100, 0.01), 1)
		UiKit.label({ Text = table.concat(names, ", "), Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, Parent = line }, 14)
	end
	UiKit.label({ LayoutOrder = 99, Text = "Any needle type (Sewing Needle to Sailmaker's Needle) by its usual chance. A needle you already have still counts: keep it or trade it.", Size = UDim2.new(1, 0, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, Parent = panel }, 15)
end

function BoxScreen.refresh()
	if not win or not win.Visible then
		return
	end
	clear()
	local info = Remotes.Box:InvokeServer("info") or {}
	if not info.allowed then
		UiKit.label({ Text = "Boxes aren't available where you are. Every needle can still be found in rounds!", Size = UDim2.new(1, -8, 0, 60), Parent = body }, 22)
		return
	end
	local left = info.pityAt - info.pity
	UiKit.label({ LayoutOrder = 1, Text = "Rare or better guaranteed within " .. left .. (if left == 1 then " open" else " opens") .. ".  You have ● " .. Rules.commas(info.coins), Size = UDim2.new(1, -8, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, Parent = body }, 20)
	local row = UiKit.make("Frame", { LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 222), BackgroundTransparency = 1, Parent = body }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, box in ipairs(Config.Boxes.list) do
		local colour = rgb(box.colour)
		local c = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1 / 3, -7, 1, 0), BackgroundColor3 = UiKit.colors.card, Parent = row }, { UiKit.corner(14), UiKit.stroke(colour, 2) })
		local crate = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(96, 72), BackgroundColor3 = colour, Parent = c }, { UiKit.corner(8), UiKit.stroke(Color3.fromRGB(90, 62, 36), 3) })
		UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22), Size = UDim2.new(1, 8, 0, 8), BackgroundColor3 = Color3.fromRGB(90, 62, 36), Parent = crate }) -- the lid's band
		UiKit.label({ Text = box.name, Font = UiKit.bold, Size = UDim2.new(1, -12, 0, 28), Position = UDim2.fromOffset(6, 92), Parent = c }, 22)
		local coinsButton = UiKit.button("● " .. Rules.commas(box.coins), if info.coins >= box.coins then UiKit.colors.green else UiKit.colors.line, { Position = UDim2.new(0, 10, 0, 128), Size = UDim2.new(1, -20, 0, 42), Parent = c })
		coinsButton.Activated:Connect(function()
			open(box)
		end)
		local productId = box.product and Config.Products[box.product] or 0
		if productId ~= 0 then
			local r = UiKit.button("R$", UiKit.colors.blue, { Position = UDim2.new(0, 10, 0, 176), Size = UDim2.new(1, -20, 0, 34), Parent = c })
			robuxPrice(productId, r)
			r.Activated:Connect(function()
				MarketplaceService:PromptProductPurchase(player, productId)
			end)
		end
	end
	for i, box in ipairs(Config.Boxes.list) do -- every box's odds, always on show below
		contents(2 + i, box)
	end
end

function BoxScreen.mount(gui)
	win, body = UiKit.window(gui, "Boxes", 820, 580)
	Remotes.BoxResult.OnClientEvent:Connect(function(result) -- a box opened with Robux
		win.Visible = true
		BoxReel.play(win, result, BoxScreen.refresh, BoxScreen.refresh)
	end)
	return { Boxes = win }, { Boxes = BoxScreen.refresh }
end

return BoxScreen
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00047">
					<Properties>
						<string name="Name">CombatFx</string>
						<ProtectedString name="Source"><![CDATA[-- Needle combat on your screen (server/Combat decides every hit):
--   click or tap with the Needle out to poke the nearest player in front of you (Remotes.Poke;
--   throwing it is client/ThrowFx);
--   your hearts, top left under your level, while you're in a round's search;
--   a sparkle and a soft "POP!" where a poke lands; a gentle red edge when you're hit (no flash);
--   F (or the Inspect button while the Needle is out) to inspect it: it lifts and turns in your
--   hand for everyone to see (Remotes.Inspect).
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local CombatFx = {}
local C = Config.Combat
local taggedOut

-- The nearest other player within reach, roughly where you're facing.
local function target()
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not me then
		return nil
	end
	local look = workspace.CurrentCamera.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z).Unit
	local best, bestDist = nil, C.reach
	for _, p in ipairs(Players:GetPlayers()) do
		local root = p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local offset = root.Position - me.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if offset.Magnitude <= bestDist and (flat.Magnitude < 0.5 or look:Dot(flat.Unit) > 0.3) then
				best, bestDist = p, offset.Magnitude
			end
		end
	end
	return best
end

local function hookTool(tool, inspectButton)
	if tool.Name ~= "Needle" or tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	tool.Activated:Connect(function()
		local t = target()
		Remotes.Poke:FireServer(t and t.UserId)
	end)
	tool.Equipped:Connect(function()
		inspectButton.Visible = true
	end)
	tool.Unequipped:Connect(function()
		inspectButton.Visible = false
	end)
end

local function pop(position, colour, amount)
	Effects.burst(position + Vector3.new(0, 1.5, 0), { colour, Color3.new(1, 1, 1) }, 18)
	local anchor = UiKit.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(position + Vector3.new(0, 3, 0)), Parent = workspace })
	local gui = UiKit.make("BillboardGui", { Size = UDim2.fromOffset(120, 84), AlwaysOnTop = true, Parent = anchor })
	local label = UiKit.label({ Text = "POP!", Font = UiKit.bold, TextColor3 = colour, TextStrokeTransparency = 0.3, Size = UDim2.new(1, 0, 0, 50), Parent = gui }, 36)
	UiKit.label({ Text = "-" .. amount .. " ♥", Font = UiKit.bold, TextStrokeTransparency = 0.3, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 50), Parent = gui }, 24) -- hearts lost
	UiKit.pop(label, 0.6)
	UiKit.ease(gui, 0.9, { StudsOffset = Vector3.new(0, 2, 0) })
	task.delay(0.9, function()
		anchor:Destroy()
	end)
end

-- Tagged out: a calm panel in the middle counting down to your return.
taggedOut = function(gui)
	local box = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 120), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.1, ZIndex = 35, Parent = gui }, { UiKit.corner(18), UiKit.stroke(Color3.fromRGB(255, 150, 160), 2) })
	UiKit.autoScale(box)
	UiKit.label({ Text = "TAGGED OUT", Font = UiKit.bold, TextColor3 = Color3.fromRGB(255, 150, 160), Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 14), ZIndex = 36, Parent = box }, 34)
	local line = UiKit.label({ Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 70), ZIndex = 36, Parent = box }, 22)
	UiKit.pop(box, 0.85)
	for n = C.respawn, 1, -1 do
		line.Text = "Back at a maze start in " .. n .. "  ·  your finds stay found"
		task.wait(1)
	end
	box:Destroy()
end

function CombatFx.start(gui)
	-- hearts, under the coins/level chip
	local hearts = UiKit.make("Frame", { Position = UDim2.fromOffset(16, 104), Size = UDim2.fromOffset(160, 40), BackgroundTransparency = 1, Visible = false, Parent = gui }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	UiKit.autoScale(hearts)
	local icons = {}
	for i = 1, C.hearts do
		icons[i] = UiKit.label({ LayoutOrder = i, Text = "♥", Font = UiKit.bold, TextColor3 = Color3.fromRGB(240, 90, 110), TextStrokeTransparency = 0.4, Size = UDim2.fromOffset(40, 40), Parent = hearts }, 36)
	end
	local edge = UiKit.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 40, Parent = gui }, { UiKit.stroke(Color3.fromRGB(230, 80, 80), 0) })
	local function show()
		local n = player:GetAttribute("Hearts") or C.hearts
		hearts.Visible = ReplicatedStorage:GetAttribute("Phase") == "search" and (player:GetAttribute("Found") ~= nil)
		for i, icon in ipairs(icons) do
			icon.TextTransparency = if i <= n then 0 else 0.75
		end
	end
	player:GetAttributeChangedSignal("Hearts"):Connect(show)
	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(show)
	show()
	-- hits: a sparkle and a pop where they land; your own, a soft red edge that fades
	Remotes.Hit.OnClientEvent:Connect(function(m)
		pop(m.position, if m.hearts == 0 then UiKit.colors.gold elseif (m.amount or 1) > 1 then Color3.fromRGB(255, 150, 60) else Color3.fromRGB(255, 120, 150), m.amount or 1)
		Effects.sound("click", 0.8)
		if m.to == player.UserId then
			local stroke = edge:FindFirstChildOfClass("UIStroke")
			stroke.Thickness, stroke.Transparency = 18, 0.3
			UiKit.ease(stroke, 0.8, { Transparency = 1 })
			if m.hearts == 0 then
				task.spawn(taggedOut, gui)
			end
		end
	end)
	-- inspect: F, or the button while the Needle is out
	local inspectButton = UiKit.button("Inspect (F)", UiKit.colors.card, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -150), Size = UDim2.fromOffset(150, 46), Visible = false, Parent = gui })
	UiKit.autoScale(inspectButton)
	local lastInspect = 0
	local function doInspect()
		if os.clock() - lastInspect > Config.NeedleTool.inspect then
			lastInspect = os.clock()
			Remotes.Inspect:FireServer()
		end
	end
	inspectButton.Activated:Connect(doInspect)
	ContextActionService:BindAction("InspectNeedle", function(_, state)
		if state == Enum.UserInputState.Begin and player.Character and player.Character:FindFirstChild("Needle") then
			doInspect()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	local function watch(holder)
		for _, t in ipairs(holder:GetChildren()) do
			if t:IsA("Tool") then
				hookTool(t, inspectButton)
			end
		end
		holder.ChildAdded:Connect(function(t)
			if t:IsA("Tool") then
				hookTool(t, inspectButton)
			end
		end)
	end
	player.CharacterAdded:Connect(function(character)
		inspectButton.Visible = false
		watch(character)
		watch(player:WaitForChild("Backpack"))
	end)
	if player.Character then
		watch(player.Character)
		watch(player:WaitForChild("Backpack"))
	end
end

return CombatFx
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00048">
					<Properties>
						<string name="Name">DashFx</string>
						<ProtectedString name="Source"><![CDATA[-- Dashing (Config.Dash): C, B on a controller, or the Dash button on a phone. Your character
-- bursts along the way you're moving, or the way the camera faces if you're standing still,
-- with a soft whoosh, a short streak behind you and a little widening of the view (eased, no
-- flash). A bar under your hearts refills as the next dash comes back. Movement is your own (Roblox moves your character from your device), so the dash is
-- done here; server/AntiCheat still checks speed, and Remotes.Dash lets everyone see a puff of
-- dust where you set off.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local DashFx = {}
local D = Config.Dash
local last = -math.huge

local function dash()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 or humanoid.Sit or root.Anchored or os.clock() - last < D.cooldown then
		return
	end
	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		local look = workspace.CurrentCamera.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	if dir.Magnitude < 0.1 then
		return
	end
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	last = os.clock()
	-- a push along the ground for a moment; gravity and jumping carry on as normal
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local push = Instance.new("LinearVelocity")
	push.Attachment0, push.RelativeTo = attachment, Enum.ActuatorRelativeTo.World
	push.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	push.PrimaryTangentAxis, push.SecondaryTangentAxis = Vector3.xAxis, Vector3.zAxis
	push.PlaneVelocity = Vector2.new(dir.X, dir.Z) * D.speed
	push.MaxForce = 1e6
	push.Parent = root
	local trail = Instance.new("Trail")
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)
	a0.Parent, a1.Parent = root, root
	trail.Attachment0, trail.Attachment1, trail.Lifetime, trail.LightEmission = a0, a1, 0.3, 0.3
	trail.Transparency = NumberSequence.new(0.5, 1)
	trail.Parent = root
	Effects.sound("whoosh", 1.1)
	if not Effects.settings.reduceEffects then
		local camera = workspace.CurrentCamera
		local fov = camera.FieldOfView
		UiKit.ease(camera, D.seconds, { FieldOfView = fov + 8 }, Enum.EasingStyle.Sine)
		task.delay(D.seconds, function()
			UiKit.ease(camera, 0.35, { FieldOfView = fov }, Enum.EasingStyle.Sine)
		end)
	end
	Remotes.Dash:FireServer()
	task.delay(D.seconds, function()
		push:Destroy()
		attachment:Destroy()
	end)
	task.delay(D.seconds + 0.35, function()
		trail:Destroy()
		a0:Destroy()
		a1:Destroy()
	end)
end

function DashFx.start(gui)
	local button = UiKit.button("Dash (C)", UiKit.colors.blue, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -258), Size = UDim2.fromOffset(150, 46), Visible = UserInputService.TouchEnabled, Parent = gui })
	UiKit.autoScale(button)
	button.Activated:Connect(dash)
	ContextActionService:BindAction("Dash", function(_, state)
		if state == Enum.UserInputState.Begin then
			dash()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
	-- the dash bar, top left under your hearts: it empties when you dash and fills back up over
	-- Config.Dash.cooldown; full (and bright) means ready
	local holder = UiKit.make("Frame", { Position = UDim2.fromOffset(16, 150), Size = UDim2.fromOffset(170, 26), BackgroundTransparency = 1, Parent = gui })
	UiKit.autoScale(holder)
	local tag = UiKit.label({ Text = "DASH", Font = UiKit.bold, Size = UDim2.fromOffset(52, 26), TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.5, Parent = holder }, 16)
	local back, fill = UiKit.bar(holder, { Size = UDim2.fromOffset(112, 12), Position = UDim2.fromOffset(54, 7) }, UiKit.colors.blue)
	local edge = UiKit.stroke(Color3.fromRGB(240, 236, 220), 1.5)
	edge.Parent = back
	RunService.RenderStepped:Connect(function()
		local charge = math.clamp((os.clock() - last) / D.cooldown, 0, 1)
		fill.Size = UDim2.fromScale(charge, 1)
		local ready = charge >= 1
		fill.BackgroundColor3 = if ready then UiKit.colors.blue else Color3.fromRGB(110, 130, 170)
		tag.TextColor3 = if ready then UiKit.colors.text else UiKit.colors.soft
		edge.Transparency = if ready then 0.1 else 0.6
		button.Text = if ready then "Dash (C)" else string.format("Dash  %.0f", math.ceil((1 - charge) * D.cooldown))
		button.BackgroundColor3 = if ready then UiKit.colors.blue else UiKit.colors.line
	end)
	Remotes.Dash.OnClientEvent:Connect(function(userId, position) -- someone else dashed: a puff of dust
		if userId ~= player.UserId then
			Effects.burst(position, { Color3.fromRGB(220, 200, 160), Color3.fromRGB(250, 240, 220) }, 10)
		end
	end)
end

return DashFx
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00049">
					<Properties>
						<string name="Name">Effects</string>
						<ProtectedString name="Source"><![CDATA[-- Feedback you can see and hear, on your own screen only: sounds, a burst of particles where a
-- needle was found, a soft flash and a little camera kick. "Reduce effects" in Settings turns the
-- flash, the kick and the big bursts off. Nothing here strobes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UiKit = require(script.Parent.UiKit)

local Effects = {}
Effects.settings = { sfx = true, reduceEffects = false, music = true }
local gui = nil

function Effects.mount(screen)
	gui = screen
end

function Effects.sound(name, pitch)
	local id = Config.Sounds[name]
	if not Effects.settings.sfx or type(id) ~= "string" or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed = id, 0.6, pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

-- A burst of sparkles in a cosmetic's colours at a world position.
function Effects.burst(position, colours, count)
	if Effects.settings.reduceEffects then
		count = math.floor((count or 40) / 4)
	end
	local anchor = UiKit.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(position), Parent = workspace })
	local e = UiKit.make("ParticleEmitter", {
		Rate = 0, Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(10, 22), SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -24, 0), Drag = 2, LightEmission = 0.5,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(colours[1], colours[2] or colours[1]), Parent = anchor,
	})
	e:Emit(count or 40)
	Debris:AddItem(anchor, 2)
end

-- A soft white glow over the screen that fades out (not a strobe), and a small FOV kick.
function Effects.flash()
	if Effects.settings.reduceEffects or not gui then
		return
	end
	local f = UiKit.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55, ZIndex = 50, Parent = gui })
	UiKit.ease(f, 0.5, { BackgroundTransparency = 1 })
	Debris:AddItem(f, 0.6)
	local camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = 62
		UiKit.ease(camera, 0.4, { FieldOfView = 70 }, Enum.EasingStyle.Back)
	end
end

-- Confetti falling across the screen.
function Effects.confetti()
	if not gui or Effects.settings.reduceEffects then
		return
	end
	local colours = { UiKit.colors.gold, UiKit.colors.red, UiKit.colors.green, UiKit.colors.blue }
	for i = 1, 36 do
		local bit = UiKit.make("Frame", { Size = UDim2.fromOffset(8, 14), Position = UDim2.new(math.random(), 0, 0, -20), Rotation = math.random(0, 360), BackgroundColor3 = colours[i % 4 + 1], ZIndex = 40, Parent = gui }, { UiKit.corner(3) })
		UiKit.ease(bit, 1.6 + math.random() * 1.2, { Position = UDim2.new(bit.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.05, 0), Rotation = bit.Rotation + math.random(-360, 360) }, Enum.EasingStyle.Sine)
		Debris:AddItem(bit, 3)
	end
end

return Effects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0004A">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- The always-on screen: your coins and level (with an XP bar) at the top left; the round's
-- banner at the top centre (what's happening, the timer, the map, difficulty and modifiers);
-- the menu buttons down the right; the Hint button during a round; and toasts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local Hud = {}
local toasts = nil

local TONES = { good = UiKit.colors.green, bad = UiKit.colors.red, level = UiKit.colors.gold }

function Hud.toast(text, tone)
	if not toasts then
		return
	end
	local card = UiKit.make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.1, Parent = toasts }, {
		UiKit.corner(10), UiKit.stroke(TONES[tone] or UiKit.colors.line, 2), UiKit.pad(10),
	})
	UiKit.make("TextLabel", { Text = text, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = UiKit.font, TextSize = 18, TextWrapped = true, TextColor3 = UiKit.colors.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	UiKit.pop(card, 0.85)
	task.delay(5, function()
		card:Destroy()
	end)
	local n = 0
	for _, c in ipairs(toasts:GetChildren()) do
		if c:IsA("Frame") then
			n += 1
		end
	end
	if n > 4 then
		for _, c in ipairs(toasts:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
end

function Hud.mount(gui, open)
	-- coins and level, top left
	local chip = UiKit.make("Frame", { Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(250, 84), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.15, Parent = gui }, { UiKit.corner(14), UiKit.stroke() })
	UiKit.autoScale(chip)
	local coins = UiKit.label({ Font = UiKit.bold, Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, Parent = chip }, 26)
	local level = UiKit.label({ Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(14, 40), TextXAlignment = Enum.TextXAlignment.Left, Parent = chip }, 18)
	local _, xpFill = UiKit.bar(chip, { Size = UDim2.new(1, -28, 0, 8), Position = UDim2.fromOffset(14, 66) }, UiKit.colors.gold)
	local function stats()
		coins.Text = "● " .. Rules.commas(player:GetAttribute("Coins") or 0) .. " Haystack Coins"
		local xp, need = player:GetAttribute("XP") or 0, player:GetAttribute("XPNeed") or 1
		level.Text = "Level " .. (player:GetAttribute("Level") or 1) .. "  ·  " .. Rules.commas(xp) .. " / " .. Rules.commas(need) .. " XP"
		UiKit.ease(xpFill, 0.3, { Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1) })
	end
	player.AttributeChanged:Connect(stats)
	stats()
	-- the round banner, top centre
	local banner = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(460, 104), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.15, Parent = gui }, { UiKit.corner(16), UiKit.stroke() })
	UiKit.autoScale(banner)
	local headline = UiKit.label({ Font = UiKit.bold, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 6), Parent = banner }, 30)
	local timer = UiKit.label({ Font = UiKit.bold, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 40), TextColor3 = UiKit.colors.gold, Parent = banner }, 28)
	local info = UiKit.label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 74), TextColor3 = UiKit.colors.soft, Parent = banner }, 18)
	-- the menu, down the right
	local menu = UiKit.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(150, 522), BackgroundTransparency = 1, Parent = gui }, {
		UiKit.make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }),
	})
	UiKit.autoScale(menu)
	for i, item in ipairs({ { "Collection", Color3.fromRGB(230, 120, 170) }, { "Boxes", Color3.fromRGB(230, 120, 50) }, { "Trade", Color3.fromRGB(70, 170, 190) }, { "Shop", UiKit.colors.gold }, { "Inventory", UiKit.colors.purple }, { "Quests", UiKit.colors.green }, { "Leaderboard", UiKit.colors.blue }, { "Settings", UiKit.colors.card } }) do
		local b = UiKit.button(item[1], item[2], { LayoutOrder = i, Size = UDim2.fromOffset(150, 54), Parent = menu })
		b.Activated:Connect(function()
			Effects.sound("click")
			open(item[1])
		end)
	end
	-- the hint button, bottom centre, only while you're searching
	local hint = UiKit.button("💡 Hint", UiKit.colors.purple, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(170, 54), Visible = false, Parent = gui })
	UiKit.autoScale(hint)
	hint.Activated:Connect(function()
		local text, why = Remotes.Hint:InvokeServer()
		Hud.toast(text or why or "No hint.", if text then "good" else "bad")
	end)
	-- toasts, under the banner
	toasts = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 130), Size = UDim2.fromOffset(440, 260), BackgroundTransparency = 1, Parent = gui }, {
		UiKit.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	UiKit.autoScale(toasts)
	-- keep the banner up to date
	task.spawn(function()
		while true do
			local phase = ReplicatedStorage:GetAttribute("Phase") or "lobby"
			local left = (ReplicatedStorage:GetAttribute("EndsAt") or 0) - workspace:GetServerTimeNow()
			local mods = ReplicatedStorage:GetAttribute("Modifiers") or ""
			local golden = ReplicatedStorage:GetAttribute("Golden")
			local inRound = player.Character and player.Character.PrimaryPart and (player.Character.PrimaryPart.Position - Config.ArenaCentre).Magnitude < 200
			if phase == "lobby" then
				headline.Text, timer.Text = "Next round in", Rules.clock(left)
				info.Text = if #game:GetService("Players"):GetPlayers() == 1 then "Practice round: invite friends to race!" else "Get ready to search!"
			elseif phase == "loading" or phase == "countdown" then
				headline.Text, timer.Text = ReplicatedStorage:GetAttribute("MapName") or "Loading...", if phase == "countdown" then tostring(math.max(1, math.ceil(left))) else "..."
				info.Text = (ReplicatedStorage:GetAttribute("Difficulty") or "") .. (if mods ~= "" then "  ·  " .. mods else "") .. (if golden then "  ·  ✦ GOLDEN NEEDLE ✦" else "")
			elseif phase == "search" then
				local count = ReplicatedStorage:GetAttribute("NeedleCount") or 1
				local found = player:GetAttribute("Found") or 0
				headline.Text = (if count > 1 then "Find both needles!" else "Find the needle!") .. "  " .. found .. "/" .. count
				timer.Text = Rules.clock(left)
				timer.TextColor3 = if left < 15 then UiKit.colors.red else UiKit.colors.gold
				info.Text = (ReplicatedStorage:GetAttribute("MapName") or "") .. "  ·  " .. (ReplicatedStorage:GetAttribute("Difficulty") or "") .. (if mods ~= "" then "  ·  " .. mods else "") .. (if golden then "  ·  ✦ GOLDEN ✦" else "")
			else
				headline.Text, timer.Text, info.Text = "Round over", Rules.clock(left), "Back to the lobby soon"
			end
			hint.Visible = phase == "search" and inRound == true
			task.wait(0.2)
		end
	end)
	Remotes.Notify.OnClientEvent:Connect(function(message)
		Hud.toast(message.text, message.tone)
		if message.tone == "level" then
			Effects.sound("found", 1.3)
			Effects.confetti()
		end
	end)
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0004B">
					<Properties>
						<string name="Name">LobbyUi</string>
						<ProtectedString name="Source"><![CDATA[-- The lobby and finding, on your screen:
--   Hover: when your mouse is over a needle (or a decoy) within reach, it lights up with a white
--     outline and "Click to grab!" follows the cursor, so you know you've found it.
--   Found: the needle you found vanishes from your screen (it's in your Collection now; others
--     still see theirs).
--   Join banner: a few seconds after you arrive, who in this lobby has the most valuable needle,
--     shown in 3D.
--   Show off: a button in the lobby that holds your showcase needle up for everyone to see.
--   Booths: a booth's "View collection" prompt opens that player's Collection.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local NeedleView = require(script.Parent.NeedleView)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local LobbyUi = {}

local function hover(gui)
	local mouse = player:GetMouse()
	local glow = Instance.new("Highlight")
	glow.FillColor, glow.FillTransparency, glow.OutlineColor = Color3.new(1, 1, 1), 0.5, Color3.new(1, 1, 1)
	glow.DepthMode, glow.Enabled = Enum.HighlightDepthMode.Occluded, false
	glow.Parent = gui
	local hint = UiKit.label({ Font = UiKit.bold, Text = "Click to grab!", Size = UDim2.fromOffset(170, 30), TextColor3 = UiKit.colors.gold, TextStrokeTransparency = 0.3, Visible = false, ZIndex = 40, Parent = gui }, 24)
	RunService.RenderStepped:Connect(function()
		local target = mouse.Target
		local model = target and target.Name == "Hitbox" and target.Parent
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local near = model and root and (target.Position - root.Position).Magnitude <= Config.Find.reach
		if near and (model.Name == "Needle" or model.Name == "Decoy") and ReplicatedStorage:GetAttribute("Phase") == "search" then
			glow.Adornee, glow.Enabled = model, true
			hint.Visible = true
			hint.Position = UDim2.fromOffset(mouse.X + 18, mouse.Y + 8)
		else
			glow.Enabled, hint.Visible = false, false
		end
	end)
end

-- The needle at `position` disappears from your screen once you've found it.
local function hideFound(position)
	local arena = workspace:FindFirstChild("Arena")
	local folder = arena and arena:FindFirstChild("Needles")
	for _, model in ipairs(folder and folder:GetChildren() or {}) do
		local hitbox = model:FindFirstChild("Hitbox")
		if hitbox and (hitbox.Position - position).Magnitude < 1 then
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = 1
					part.Transparency = 1
				elseif part:IsA("ParticleEmitter") then
					part.Enabled = false
				end
			end
		end
	end
end

local function joinBanner(gui)
	task.wait(4) -- once you've had a moment to look round
	local best = Remotes.LobbyInfo:InvokeServer("best")
	local card = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.fromOffset(520, 150), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.05, ZIndex = 20, Parent = gui }, { UiKit.corner(16), UiKit.stroke(UiKit.colors.gold, 2) })
	UiKit.autoScale(card)
	if best then
		NeedleView.make(card, best.type, best.skin, { Size = UDim2.fromOffset(170, 130), Position = UDim2.fromOffset(10, 10), ZIndex = 21 }, true)
		UiKit.label({ Font = UiKit.bold, Text = "MOST VALUABLE NEEDLE IN THIS LOBBY", Size = UDim2.new(1, -200, 0, 24), Position = UDim2.fromOffset(186, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, ZIndex = 21, Parent = card }, 20)
		UiKit.label({ Font = UiKit.bold, Text = best.needle, Size = UDim2.new(1, -200, 0, 50), Position = UDim2.fromOffset(186, 44), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = card }, 22)
		UiKit.label({ Text = (if best.userId == player.UserId then "That's yours!" else "owned by " .. best.name) .. "  ·  worth " .. Rules.commas(best.value), Size = UDim2.new(1, -200, 0, 22), Position = UDim2.fromOffset(186, 100), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, ZIndex = 21, Parent = card }, 18)
	else
		UiKit.label({ Font = UiKit.bold, Text = "Nobody here has found a needle yet. Win a round and the Champion's Needle podium is yours!", Size = UDim2.new(1, -40, 1, -30), Position = UDim2.fromOffset(20, 15), ZIndex = 21, Parent = card }, 22)
	end
	UiKit.pop(card, 0.6)
	Effects.sound("whoosh")
	task.wait(8)
	UiKit.ease(card, 0.4, { BackgroundTransparency = 1 })
	task.wait(0.4)
	card:Destroy()
end

function LobbyUi.start(gui, openCollection)
	hover(gui)
	Remotes.Found.OnClientEvent:Connect(function(m)
		if m.userId == player.UserId then
			hideFound(m.position)
		end
	end)
	task.spawn(joinBanner, gui)
	local show = UiKit.button("Show off!", Color3.fromRGB(230, 120, 170), { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -20), Size = UDim2.fromOffset(170, 54), Parent = gui })
	UiKit.autoScale(show)
	show.Activated:Connect(function()
		Remotes.ShowOff:FireServer()
	end)
	task.spawn(function()
		while true do
			local phase = ReplicatedStorage:GetAttribute("Phase")
			show.Visible = phase ~= "search" and phase ~= "countdown"
			task.wait(0.5)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local userId = prompt:GetAttribute("ViewUser")
		if userId then
			openCollection(userId)
		end
	end)
end

return LobbyUi
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX0004C">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[-- Starts the client: the whole UI (UIController). The client only shows things and asks the
-- server; it never decides who found the needle or what anyone earns.
local UIController = require(script.Parent:WaitForChild("UIController"))
UIController.start()
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0004D">
					<Properties>
						<string name="Name">NeedleView</string>
						<ProtectedString name="Source"><![CDATA[-- A needle in 3D inside the UI: a ViewportFrame with the needle (shared/NeedleLook) lit and
-- framed, tilted a little so its shape reads. spin = true turns it slowly (the reveal popup).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))

local NeedleView = {}

function NeedleView.make(parent, typeId, skinId, props, spin)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency, vp.Ambient, vp.LightColor, vp.LightDirection = 1, Color3.fromRGB(150, 150, 160), Color3.new(1, 1, 1), Vector3.new(-0.4, -1, -0.6)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local model = NeedleLook.build(typeId, skinId, 1, 2.2) -- thickened to read well at UI size
	model:PivotTo(CFrame.Angles(0, 0, math.rad(25)))
	model.Parent = vp
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, 5.4), Vector3.zero)
	camera.Parent = vp
	vp.CurrentCamera = camera
	vp.Parent = parent
	if spin then
		local turn = 0
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not vp.Parent then
				conn:Disconnect()
				return
			end
			turn += dt * 0.9
			model:PivotTo(CFrame.Angles(0, turn, math.rad(25)))
		end)
	end
	return vp
end

return NeedleView
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0004E">
					<Properties>
						<string name="Name">PowerupFx</string>
						<ProtectedString name="Source"><![CDATA[-- Power-ups on your screen (server/Powerups decides; Remotes.Powerup says what you got):
--   a toast, and a chip above the bottom of the screen counting down while it lasts;
--   compass   a big arrow under the round banner pointing at the needle, with how far it is;
--   birdseye  your camera glides up above the maze, looks down, and glides back;
--   glint     the needles and decoys near you sparkle and glow (only on your screen);
--   speed and coins need nothing more than the chip and the toast.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)
local Hud = require(script.Parent.Hud)

local player = Players.LocalPlayer
local PowerupFx = {}
local chips, arrow, distance

local function kindOf(id)
	for _, k in ipairs(Config.Powerups.kinds) do
		if k.id == id then
			return k
		end
	end
	return nil
end

local function chip(kind, seconds)
	local c = UiKit.make("Frame", { Size = UDim2.fromOffset(200, 40), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.1, Parent = chips }, { UiKit.corner(10), UiKit.stroke(Color3.fromRGB(kind.colour[1], kind.colour[2], kind.colour[3]), 2) })
	local picture = (kind.image or 0) > 0
	if picture then -- the owner's round icon at the chip's left
		UiKit.make("ImageLabel", { Image = "rbxassetid://" .. kind.image, BackgroundTransparency = 1, Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(6, 1), Parent = c })
	end
	UiKit.label({ Font = UiKit.bold, Text = if picture then kind.name else kind.icon .. "  " .. kind.name, Size = UDim2.new(1, if picture then -48 else -16, 0, 26), Position = UDim2.fromOffset(if picture then 40 else 8, 2), TextXAlignment = Enum.TextXAlignment.Left, Parent = c }, 18)
	local _, fill = UiKit.bar(c, { Size = UDim2.new(1, -16, 0, 5), Position = UDim2.new(0, 8, 1, -9) }, Color3.fromRGB(kind.colour[1], kind.colour[2], kind.colour[3]))
	fill.Size = UDim2.fromScale(1, 1)
	UiKit.ease(fill, seconds, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
	UiKit.pop(c, 0.7)
	Debris:AddItem(c, seconds)
end

local function compass(target, seconds)
	if not target then
		Hud.toast("You've already found every needle!", "good")
		return
	end
	arrow.Visible, distance.Visible = true, true
	local ends = os.clock() + seconds
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local camera, root = workspace.CurrentCamera, player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if os.clock() > ends or not camera or not root then
			arrow.Visible, distance.Visible = false, false
			conn:Disconnect()
			return
		end
		local v = camera.CFrame:PointToObjectSpace(target)
		arrow.Rotation = math.deg(math.atan2(v.X, -v.Z)) -- the glyph points up: 0 = straight ahead
		distance.Text = math.floor((target - root.Position).Magnitude) .. " studs"
	end)
end

local function birdseye(height, seconds)
	local camera, root = workspace.CurrentCamera, player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not camera or not root then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	local from = camera.CFrame
	local above = CFrame.lookAt(root.Position + Vector3.new(0, height, 6), root.Position)
	UiKit.ease(camera, 1, { CFrame = above }, Enum.EasingStyle.Sine)
	task.delay(seconds - 1, function()
		local tween = UiKit.ease(camera, 1, { CFrame = from }, Enum.EasingStyle.Sine)
		tween.Completed:Wait()
		camera.CameraType = Enum.CameraType.Custom
	end)
end

local function glint(points, seconds)
	if #points == 0 then
		Hud.toast("No needles nearby... try another corridor.", "bad")
	end
	for _, pos in ipairs(points) do
		local spark = UiKit.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos), Parent = workspace })
		UiKit.make("ParticleEmitter", {
			Rate = 14, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(180, 180), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 250, 200)), Parent = spark,
		})
		UiKit.make("PointLight", { Color = Color3.fromRGB(255, 240, 160), Range = 8, Brightness = 2, Parent = spark })
		Debris:AddItem(spark, seconds)
	end
end

function PowerupFx.start(gui)
	chips = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -86), Size = UDim2.fromOffset(620, 40), BackgroundTransparency = 1, Parent = gui }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8) }),
	})
	UiKit.autoScale(chips)
	arrow = UiKit.label({ Font = UiKit.bold, Text = "▲", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 180), Size = UDim2.fromOffset(90, 90), TextColor3 = Color3.fromRGB(table.unpack((kindOf("compass") or { colour = { 240, 130, 40 } }).colour)), TextStrokeTransparency = 0.2, Visible = false, ZIndex = 30, Parent = gui }, 80)
	distance = UiKit.label({ Font = UiKit.bold, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 228), Size = UDim2.fromOffset(160, 26), TextStrokeTransparency = 0.3, Visible = false, ZIndex = 30, Parent = gui }, 22)
	Remotes.Powerup.OnClientEvent:Connect(function(m)
		local kind = kindOf(m.kind)
		if not kind then
			return
		end
		Effects.sound("found", 1.5)
		if m.kind == "coins" then
			Hud.toast(kind.icon .. "  " .. kind.name .. ": +" .. (m.coins or 0) .. " coins", "good")
			return
		end
		Hud.toast(kind.icon .. "  " .. kind.name .. "!", "good")
		chip(kind, m.seconds or 5)
		if m.kind == "compass" then
			compass(m.target, m.seconds)
		elseif m.kind == "birdseye" then
			birdseye(m.height or 50, m.seconds)
		elseif m.kind == "glint" then
			glint(m.points or {}, m.seconds)
		end
	end)
end

return PowerupFx
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0004F">
					<Properties>
						<string name="Name">Results</string>
						<ProtectedString name="Source"><![CDATA[-- The round's big moments on screen: the 3, 2, 1 before searching; NEEDLE FOUND! when you find it
-- (the needle you get to keep turning in 3D, its rarity and value, your place, time and rewards,
-- your found effect where it was); a note telling everyone what someone found; and the results.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Needles = require(Shared:WaitForChild("Needles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)
local Hud = require(script.Parent.Hud)
local NeedleView = require(script.Parent.NeedleView)

local player = Players.LocalPlayer
local Results = {}
local PLACES = { "1st", "2nd", "3rd" }

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function placeName(n)
	return PLACES[n] or (n .. "th")
end

function Results.mount(gui, getProfile)
	-- the 3, 2, 1
	local count = UiKit.label({ Font = UiKit.bold, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(300, 200), TextColor3 = UiKit.colors.gold, TextStrokeTransparency = 0.4, Visible = false, ZIndex = 30, Parent = gui }, 180)
	-- the NEEDLE FOUND! popup
	local popup = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(560, 300), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.05, Visible = false, ZIndex = 30, Parent = gui }, { UiKit.corner(22), UiKit.stroke(UiKit.colors.gold, 3) })
	UiKit.autoScale(popup)
	local art = UiKit.make("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundTransparency = 1, ZIndex = 31, Parent = popup })
	local big = UiKit.label({ Font = UiKit.bold, Text = "NEEDLE FOUND!", Size = UDim2.new(1, -30, 0, 56), Position = UDim2.fromOffset(15, 108), TextColor3 = UiKit.colors.gold, ZIndex = 31, Parent = popup }, 54)
	local kept = UiKit.label({ Font = UiKit.bold, Size = UDim2.new(1, -30, 0, 34), Position = UDim2.fromOffset(15, 166), ZIndex = 31, Parent = popup }, 26)
	local line = UiKit.label({ Size = UDim2.new(1, -30, 0, 40), Position = UDim2.fromOffset(15, 206), ZIndex = 31, Parent = popup }, 22)
	local keep = UiKit.label({ Size = UDim2.new(1, -30, 0, 26), Position = UDim2.fromOffset(15, 252), TextColor3 = UiKit.colors.soft, ZIndex = 31, Parent = popup }, 18)
	-- the results screen
	local results, body = UiKit.window(gui, "Round results", 560, 440)
	results.ZIndex = 25

	Remotes.Found.OnClientEvent:Connect(function(m)
		local mine = m.userId == player.UserId
		local k = m.kept
		if not mine then
			local what = if k then " found a " .. k.rarity .. " " .. k.name .. "!" else " found it!"
			Hud.toast(m.name .. what .. " (" .. placeName(m.place) .. ")" .. (if m.place == 1 then "  " .. Config.Round.grace .. " seconds left for everyone else!" else ""), "level")
			Effects.sound("whoosh")
			return
		end
		local profile = getProfile() or {}
		local equipped = profile.equipped or {}
		local effect = Cosmetics.get(equipped.effect or "e_confetti") or Cosmetics.get("e_confetti")
		for _, c in ipairs(art:GetChildren()) do
			c:Destroy()
		end
		if k then
			NeedleView.make(art, k.type, k.skin, { Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(20, 0), ZIndex = 32 }, true)
			local rarity = Needles.rarity(k.rarityId)
			kept.Text = (if k.new then "NEW!  " else "") .. k.rarity .. " " .. k.name
			kept.TextColor3 = Color3.fromRGB(rarity.colour[1], rarity.colour[2], rarity.colour[3])
			keep.Text = "It's yours to keep: worth " .. Rules.commas(k.value) .. " in your Collection."
		end
		big.Text = if m.golden then "GOLDEN NEEDLE!" else "NEEDLE FOUND!"
		line.Text = placeName(m.place) .. "  ·  " .. string.format("%.1f s", m.seconds) .. "  ·  +" .. Rules.commas(m.coins) .. " coins  ·  XP at the end"
		popup.Visible = true
		UiKit.pop(popup, 0.5)
		Effects.sound("found")
		Effects.flash()
		Effects.burst(m.position, { rgb(effect.colours[1]), rgb(effect.colours[2] or effect.colours[1]) }, if m.golden then 90 else 50)
		Effects.confetti()
		task.delay(4.5, function()
			popup.Visible = false
		end)
	end)

	Remotes.RoundState.OnClientEvent:Connect(function(state)
		if state.phase == "countdown" then
			count.Visible = true
			for n = Config.Round.loadCountdown, 1, -1 do
				count.Text = tostring(n)
				UiKit.pop(count, 1.6)
				Effects.sound("countdown")
				task.wait(1)
			end
			count.Text = "GO!"
			UiKit.pop(count, 1.6)
			task.delay(0.8, function()
				count.Visible = false
			end)
		elseif state.phase == "results" then
			for _, c in ipairs(body:GetChildren()) do
				if c:IsA("GuiObject") then
					c:Destroy()
				end
			end
			local extra = state.extra or {}
			local rows = extra.rows or {}
			UiKit.label({ LayoutOrder = 0, Text = (extra.map or "") .. (if extra.golden then "  ·  Golden Needle round" else ""), Size = UDim2.new(1, 0, 0, 26), TextColor3 = UiKit.colors.soft, Parent = body }, 20)
			if #rows == 0 then
				UiKit.label({ LayoutOrder = 1, Text = "Nobody found it this time. The hay wins!", Size = UDim2.new(1, 0, 0, 40), Parent = body }, 24)
			end
			for i, r in ipairs(rows) do
				local card = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 52), BackgroundColor3 = if r.userId == player.UserId then UiKit.colors.line else UiKit.colors.card, Parent = body }, { UiKit.corner(10) })
				local medal = if r.place == 1 then UiKit.colors.gold elseif r.place == 2 then Color3.fromRGB(200, 206, 216) elseif r.place == 3 then Color3.fromRGB(205, 140, 90) else UiKit.colors.soft
				UiKit.label({ Font = UiKit.bold, Text = placeName(r.place), Size = UDim2.new(0, 70, 1, 0), TextColor3 = medal, Parent = card }, 24)
				UiKit.label({ Text = r.name, Size = UDim2.new(0.45, 0, 1, 0), Position = UDim2.fromOffset(76, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card }, 22)
				UiKit.label({ Text = string.format("%.1f s  ·  +%d coins", r.seconds or 0, r.coins or 0), Size = UDim2.new(0.42, 0, 0.5, 0), Position = UDim2.new(0.58, -10, 0, 2), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UiKit.colors.soft, Parent = card }, 18)
				if r.kept then -- the needle they keep, in its rarity colour
					local rarity = Needles.rarity(r.kept.rarityId)
					UiKit.label({ Text = r.kept.rarity .. " " .. r.kept.name, Size = UDim2.new(0.62, 0, 0.5, 0), Position = UDim2.new(0.38, -10, 0.5, -2), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(rarity.colour[1], rarity.colour[2], rarity.colour[3]), Parent = card }, 16)
				end
			end
			local mine = (extra.xp or {})[tostring(player.UserId)] -- your match XP and where it came from
			if mine then
				local box = UiKit.make("Frame", { LayoutOrder = 100, Size = UDim2.new(1, -8, 0, 76), BackgroundColor3 = UiKit.colors.card, Parent = body }, { UiKit.corner(10), UiKit.stroke(UiKit.colors.gold, 2) })
				UiKit.label({ Font = UiKit.bold, Text = "MATCH XP  +" .. Rules.commas(mine.total), TextColor3 = UiKit.colors.gold, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = box }, 24)
				local parts = {
					(if mine.place then placeName(mine.place) else "Played") .. " +" .. mine.placeXp,
					mine.coins .. " coins +" .. mine.coinXp,
					mine.needles .. (if mine.needles == 1 then " needle +" else " needles +") .. mine.needleXp,
					mine.elims .. " tagged out +" .. mine.elimXp,
				}
				UiKit.label({ Text = table.concat(parts, "   ·   "), TextColor3 = UiKit.colors.soft, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 40), TextXAlignment = Enum.TextXAlignment.Left, Parent = box }, 18)
			end
			results.Visible = true
			UiKit.pop(results, 0.8)
		elseif state.phase == "lobby" then
			results.Visible = false
		end
	end)
end

return Results
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00050">
					<Properties>
						<string name="Name">Screens</string>
						<ProtectedString name="Source"><![CDATA[-- The Shop and Inventory screens. The Shop sells cosmetics for Haystack Coins (needle skins,
-- trails, found effects) and shows the optional Robux items (shared/Robux) when they're on sale; the Inventory
-- lists what you own to wear. Every buy and equip is asked of the server (Remotes.Shop), which
-- decides.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Robux = require(Shared:WaitForChild("Robux"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local Screens = {}
local shop, shopBody, inv, invBody
local getProfile = function()
	return {}
end

-- An item's Robux price as Roblox has it ("R$ 99"), looked up once; "Buy" until it's known.
local prices = {}
local function priceOf(id, pass, button)
	if prices[id] then
		button.Text = prices[id]
		return
	end
	button.Text = "Buy"
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, if pass then Enum.InfoType.GamePass else Enum.InfoType.Product)
		if ok and info and info.PriceInRobux then
			prices[id] = "R$ " .. info.PriceInRobux
			if button.Parent then
				button.Text = prices[id]
			end
		end
	end)
end

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- A small picture of an item: a needle, a trail streak, a title tag or a burst of colour.
local function swatch(parent, item)
	local box = UiKit.make("Frame", { Size = UDim2.fromOffset(64, 64), BackgroundColor3 = UiKit.colors.panel, Parent = parent }, { UiKit.corner(10) })
	local a, b = rgb(item.colours[1]), rgb(item.colours[2] or item.colours[1])
	if item.kind == "needle" then
		local shaft = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(52, 7), Rotation = -35, BackgroundColor3 = a, Parent = box }, { UiKit.corner(4) })
		UiKit.make("Frame", { Size = UDim2.fromOffset(12, 9), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = b, Parent = shaft }, { UiKit.corner(4) })
	elseif item.kind == "trail" then
		UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(50, 14), BackgroundColor3 = Color3.new(1, 1, 1), Parent = box }, {
			UiKit.corner(7), UiKit.make("UIGradient", { Color = ColorSequence.new(a, b), Transparency = NumberSequence.new(0, 0.8) }),
		})
	else
		UiKit.label({ Text = if item.kind == "title" then "Aa" else "✦", Font = UiKit.bold, Size = UDim2.fromScale(1, 1), TextColor3 = a, Parent = box }, 34)
	end
	return box
end

local function card(parent, order, item, buttonText, buttonColour, onPress)
	local c = UiKit.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 80), BackgroundColor3 = UiKit.colors.card, Parent = parent }, { UiKit.corner(12) })
	local s = swatch(c, item)
	s.Position = UDim2.fromOffset(8, 8)
	UiKit.label({ Font = UiKit.bold, Text = item.name, Size = UDim2.new(0.5, -80, 0, 30), Position = UDim2.fromOffset(84, 10), TextXAlignment = Enum.TextXAlignment.Left, Parent = c }, 22)
	UiKit.label({ Text = Cosmetics.kindNames[item.kind], Size = UDim2.new(0.5, -80, 0, 22), Position = UDim2.fromOffset(84, 44), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, Parent = c }, 16)
	local b = UiKit.button(buttonText, buttonColour, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(160, 50), Parent = c })
	b.Activated:Connect(onPress)
end

local function ask(action, id)
	Effects.sound("click")
	local ok, message = Remotes.Shop:InvokeServer(action, id)
	if message then
		Hud.toast(message, if ok then "good" else "bad")
	end
end

local function heading(parent, order, text)
	UiKit.label({ LayoutOrder = order, Font = UiKit.bold, Text = text, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, Parent = parent }, 22)
end

local function clear(body)
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function Screens.refresh()
	local profile = getProfile()
	local owned, equipped = profile.owned or {}, profile.equipped or {}
	local coins = player:GetAttribute("Coins") or 0
	if shop.Visible then
		clear(shopBody)
		local order = 0
		for _, kind in ipairs(Cosmetics.kinds) do
			local any = false
			for _, item in ipairs(Cosmetics.items) do
				if item.kind == kind and item.price > 0 then
					if not any then
						order += 1
						heading(shopBody, order, Cosmetics.kindNames[kind])
						any = true
					end
					order += 1
					if owned[item.id] then
						card(shopBody, order, item, if equipped[kind] == item.id then "Equipped" else "Equip", UiKit.colors.purple, function()
							ask("equip", item.id)
						end)
					else
						card(shopBody, order, item, "● " .. Rules.commas(item.price), if coins >= item.price then UiKit.colors.green else UiKit.colors.red, function()
							ask("buy", item.id)
						end)
					end
				end
			end
		end
		-- optional Robux items (only those that are on sale), each saying exactly what it gives
		for _, r in ipairs(Robux.items) do
			local id = Robux.id(r)
			local have = r.pass and player:GetAttribute("Pass_" .. r.key) == true
			if id ~= 0 and not r.box and not (r.once and getProfile().starterBought) then -- boxes sell in the Boxes screen, beside their odds
				if order < 100 then
					order = 100
					heading(shopBody, order, "Support the game (Robux)")
				end
				order += 1
				local c = UiKit.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = UiKit.colors.card, Parent = shopBody }, { UiKit.corner(12) })
				UiKit.label({ Font = UiKit.bold, Text = r.name .. (if r.pass then "  (pass)" else ""), Size = UDim2.new(1, -160, 0, 28), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = c }, 20)
				UiKit.label({ Text = r.text, Size = UDim2.new(1, -160, 0, 24), Position = UDim2.fromOffset(14, 38), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, Parent = c }, 16)
				local b = UiKit.button("Owned", if have then UiKit.colors.panel else UiKit.colors.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(130, 46), Parent = c })
				if not have then
					priceOf(id, r.pass, b)
				end
				b.Activated:Connect(function()
					if have then
						return
					elseif r.pass then
						MarketplaceService:PromptGamePassPurchase(player, id)
					else
						MarketplaceService:PromptProductPurchase(player, id)
					end
				end)
			end
		end
	end
	if inv.Visible then
		clear(invBody)
		local order = 0
		for _, kind in ipairs(Cosmetics.kinds) do
			order += 1
			heading(invBody, order, Cosmetics.kindNames[kind])
			for _, item in ipairs(Cosmetics.items) do
				if item.kind == kind and owned[item.id] then
					order += 1
					local on = equipped[kind] == item.id
					card(invBody, order, item, if on then "Equipped ✓" else "Equip", if on then UiKit.colors.green else UiKit.colors.purple, function()
						ask("equip", item.id)
					end)
				end
			end
		end
	end
end

function Screens.mount(gui, profileGetter)
	getProfile = profileGetter
	shop, shopBody = UiKit.window(gui, "Shop", 620, 500)
	inv, invBody = UiKit.window(gui, "Inventory", 620, 500)
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if shop.Visible then
			Screens.refresh()
		end
	end)
	return { Shop = shop, Inventory = inv }
end

return Screens
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00051">
					<Properties>
						<string name="Name">Screens2</string>
						<ProtectedString name="Source"><![CDATA[-- The Quests, Leaderboard and Settings screens.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Quests = require(Shared:WaitForChild("Quests"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)

local Screens2 = {}
local quests, questBody, boards, boardBody, settings, settingsBody
local getProfile = function()
	return {}
end
local boardId, scope = "needles", "global"

local function clear(body)
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function questsPage()
	clear(questBody)
	local profile = getProfile()
	local q = profile.quests or {}
	local today = Quests.today()
	local progress = if q.day == today then q.progress or {} else {}
	local done = if q.day == today then q.done or {} else {}
	local left = 86400 - os.time() % 86400
	UiKit.label({ LayoutOrder = 0, Text = string.format("New quests in %dh %02dm", left // 3600, left % 3600 // 60), Size = UDim2.new(1, 0, 0, 24), TextColor3 = UiKit.colors.soft, Parent = questBody }, 18)
	for i, quest in ipairs(Quests.forDay(today)) do
		local have = math.min(quest.n, progress[quest.id] or 0)
		local c = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 96), BackgroundColor3 = UiKit.colors.card, Parent = questBody }, { UiKit.corner(12) })
		UiKit.label({ Font = UiKit.bold, Text = (if done[quest.id] then "✓ " else "") .. quest.text, Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = if done[quest.id] then UiKit.colors.green else UiKit.colors.text, Parent = c }, 22)
		local reward = "+" .. quest.coins .. " coins · +" .. quest.xp .. " XP" .. (if quest.cosmetic and Cosmetics.get(quest.cosmetic) then " · " .. Cosmetics.get(quest.cosmetic).name else "")
		UiKit.label({ Text = reward, Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(14, 38), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, Parent = c }, 18)
		local _, fill = UiKit.bar(c, { Size = UDim2.new(1, -110, 0, 12), Position = UDim2.fromOffset(14, 70) }, UiKit.colors.green)
		fill.Size = UDim2.fromScale(have / quest.n, 1)
		UiKit.label({ Text = have .. " / " .. quest.n, Size = UDim2.fromOffset(80, 22), Position = UDim2.new(1, -90, 0, 64), Parent = c }, 18)
	end
end

local function boardsPage()
	clear(boardBody)
	local tabs = UiKit.make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = boardBody }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	for _, b in ipairs(Config.Boards) do
		local t = UiKit.button(b.name, if b.id == boardId then UiKit.colors.gold else UiKit.colors.card, { Size = UDim2.new(1 / #Config.Boards, -6, 1, 0), Parent = tabs })
		t.Activated:Connect(function()
			boardId = b.id
			boardsPage()
		end)
	end
	local scopes = UiKit.make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = boardBody }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	for _, s in ipairs({ { "global", "Everyone" }, { "server", "This server (friends)" } }) do
		local b = UiKit.button(s[2], if scope == s[1] then UiKit.colors.blue else UiKit.colors.card, { Size = UDim2.new(0.5, -6, 1, 0), Parent = scopes })
		b.Activated:Connect(function()
			scope = s[1]
			boardsPage()
		end)
	end
	local data = Remotes.Boards:InvokeServer(boardId) or {}
	local rows = data[scope] or {}
	local seconds = false
	for _, b in ipairs(Config.Boards) do
		if b.id == boardId then
			seconds = b.seconds == true
		end
	end
	if #rows == 0 then
		UiKit.label({ LayoutOrder = 2, Text = "No one here yet. Be the first!", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UiKit.colors.soft, Parent = boardBody }, 20)
	end
	for i, r in ipairs(rows) do
		local c = UiKit.make("Frame", { LayoutOrder = 1 + i, Size = UDim2.new(1, -8, 0, 40), BackgroundColor3 = UiKit.colors.card, Parent = boardBody }, { UiKit.corner(8) })
		UiKit.label({ Font = UiKit.bold, Text = i .. ".", Size = UDim2.fromOffset(50, 40), TextColor3 = if i <= 3 then UiKit.colors.gold else UiKit.colors.soft, Parent = c }, 20)
		UiKit.label({ Text = r.name, Size = UDim2.new(0.6, -50, 1, 0), Position = UDim2.fromOffset(54, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = c }, 20)
		UiKit.label({ Text = if seconds then string.format("%.1f s", r.value) else Rules.commas(r.value), Size = UDim2.new(0.35, 0, 1, 0), Position = UDim2.new(0.62, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UiKit.colors.gold, Parent = c }, 20)
	end
end

local LABELS = { { "music", "Music" }, { "sfx", "Sound effects" }, { "reduceEffects", "Reduce effects (no flash or shake)" }, { "autoJoin", "Join rounds automatically" } }

local function settingsPage()
	clear(settingsBody)
	local current = getProfile().settings or {}
	for i, row in ipairs(LABELS) do
		local key = row[1]
		local on = current[key] == true
		local c = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 64), BackgroundColor3 = UiKit.colors.card, Parent = settingsBody }, { UiKit.corner(12) })
		UiKit.label({ Text = row[2], Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(16, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = c }, 22)
		local b = UiKit.button(if on then "On" else "Off", if on then UiKit.colors.green else UiKit.colors.line, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(110, 46), Parent = c })
		b.Activated:Connect(function()
			Effects.sound("click")
			current[key] = not on
			Remotes.SaveSettings:FireServer({ [key] = not on })
			Effects.settings[key] = not on
			settingsPage()
		end)
	end
end

function Screens2.refresh()
	if quests.Visible then
		questsPage()
	end
	if settings.Visible then
		settingsPage()
	end
end

function Screens2.mount(gui, profileGetter)
	getProfile = profileGetter
	quests, questBody = UiKit.window(gui, "Daily Quests", 560, 440)
	boards, boardBody = UiKit.window(gui, "Leaderboard", 680, 520)
	settings, settingsBody = UiKit.window(gui, "Settings", 520, 400)
	return { Quests = quests, Leaderboard = boards, Settings = settings }, { Leaderboard = boardsPage }
end

return Screens2
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00052">
					<Properties>
						<string name="Name">Screens3</string>
						<ProtectedString name="Source"><![CDATA[-- The Collection screen: every needle you've found, by type, shown in 3D with its rarity, value
-- and how many you have; ones you haven't found yet are "???" outlined in their rarity colour.
-- Look at anyone else's collection in the server with the buttons along the top. On your own,
-- click a needle to put it on show (your showcase: on the lobby's pedestals and next to your name).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Needles = require(Shared:WaitForChild("Needles"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local NeedleView = require(script.Parent.NeedleView)
local Hud = require(script.Parent.Hud)

local player = Players.LocalPlayer
local Screens3 = {}
local win, body
local viewing = nil -- userId whose collection is open (nil = yours)
local typeId = "sewing"

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function clear()
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function row(order, height)
	return UiKit.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, height), BackgroundTransparency = 1, Parent = body }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

function Screens3.refresh()
	if not win or not win.Visible then
		return
	end
	clear()
	local data = Remotes.Collection:InvokeServer("get", viewing)
	if not data then
		UiKit.label({ LayoutOrder = 1, Text = "That collection isn't available right now.", Size = UDim2.new(1, 0, 0, 40), Parent = body }, 22)
		return
	end
	local mine = data.userId == player.UserId
	-- whose collection: you, or anyone else here
	local people = row(1, 40)
	for i, p in ipairs(Remotes.Collection:InvokeServer("list") or {}) do
		local b = UiKit.button((if p.userId == player.UserId then "You" else p.name) .. " · " .. Rules.commas(p.value), if p.userId == data.userId then UiKit.colors.gold else UiKit.colors.card, { LayoutOrder = i, Size = UDim2.fromOffset(170, 40), Parent = people })
		b.Activated:Connect(function()
			viewing = if p.userId == player.UserId then nil else p.userId
			Screens3.refresh()
		end)
	end
	local found, total = 0, #Needles.types * #Needles.skins
	for _ in pairs(data.entries) do
		found += 1
	end
	local st, ss = Needles.split(data.showcase)
	UiKit.label({ LayoutOrder = 2, Font = UiKit.bold, Text = (if mine then "Your collection" else data.name .. "'s collection") .. ":  " .. Rules.commas(data.value) .. " value  ·  " .. found .. " / " .. total .. " needles", Size = UDim2.new(1, -8, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.gold, Parent = body }, 22)
	UiKit.label({ LayoutOrder = 3, Text = if st then "On show: " .. Needles.name(st, ss) .. (if mine then "  (click any needle you own to show it instead)" else "") else "Nothing on show yet.", Size = UDim2.new(1, -8, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UiKit.colors.soft, Parent = body }, 17)
	-- the types, as tabs
	local tabs = UiKit.make("ScrollingFrame", { LayoutOrder = 4, Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), Parent = body }, {
		UiKit.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, t in ipairs(Needles.types) do
		local have = 0
		for _, s in ipairs(Needles.skins) do
			if data.entries[Needles.key(t.id, s.id)] then
				have += 1
			end
		end
		local b = UiKit.button(t.name .. "  " .. have .. "/" .. #Needles.skins, if t.id == typeId then UiKit.colors.blue else UiKit.colors.card, { LayoutOrder = i, Size = UDim2.fromOffset(220, 40), Parent = tabs })
		b.Activated:Connect(function()
			typeId = t.id
			Screens3.refresh()
		end)
	end
	-- every skin of this type
	local grid = UiKit.make("Frame", { LayoutOrder = 5, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body }, {
		UiKit.make("UIGridLayout", { CellSize = UDim2.fromOffset(132, 150), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, s in ipairs(Needles.skins) do
		local key = Needles.key(typeId, s.id)
		local count = data.entries[key] or 0
		local rarity = Needles.rarity(s.rarity)
		local cell = UiKit.make("TextButton", { LayoutOrder = i, Text = "", AutoButtonColor = count > 0 and mine, BackgroundColor3 = UiKit.colors.card, Parent = grid }, {
			UiKit.corner(10), UiKit.stroke(rgb(rarity.colour), if key == data.showcase then 3 else 1.5),
		})
		if count > 0 then
			NeedleView.make(cell, typeId, s.id, { Size = UDim2.new(1, -8, 0, 84), Position = UDim2.fromOffset(4, 4) })
			UiKit.label({ Font = UiKit.bold, Text = s.name .. (if count > 1 then "  x" .. count else ""), Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 88), Parent = cell }, 16)
			UiKit.label({ Text = rarity.name .. " · " .. Rules.commas(Needles.value(typeId, s.id)), Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 112), TextColor3 = rgb(rarity.colour), Parent = cell }, 14)
			if key == data.showcase then
				UiKit.label({ Text = "ON SHOW", Font = UiKit.bold, Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 132), TextColor3 = UiKit.colors.gold, Parent = cell }, 12)
			end
			if mine then
				cell.Activated:Connect(function()
					if Remotes.Collection:InvokeServer("showcase", key) then
						Hud.toast(Needles.name(typeId, s.id) .. " is on show.", "good")
						Screens3.refresh()
					end
				end)
			end
		else
			UiKit.label({ Font = UiKit.bold, Text = "???", Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 14), TextColor3 = UiKit.colors.line, Parent = cell }, 34)
			UiKit.label({ Text = rarity.name, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 112), TextColor3 = rgb(rarity.colour), Parent = cell }, 14)
		end
	end
end

-- Opens on a given player's collection next time it refreshes (nil = yours).
function Screens3.view(userId)
	viewing = if userId == player.UserId then nil else userId
end

function Screens3.mount(gui)
	win, body = UiKit.window(gui, "Collection", 760, 560)
	return { Collection = win }, { Collection = Screens3.refresh }
end

return Screens3
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00053">
					<Properties>
						<string name="Name">ThrowFx</string>
						<ProtectedString name="Source"><![CDATA[-- Throwing your needle on your screen (server/CombatThrow decides): Q, or the Throw button while
-- the Needle is out, throws it where you're aiming (the mouse, or the middle of the screen on a
-- phone). The button shows when it's ready again. Every throw anyone makes is drawn here: the
-- needle flies point first from their head to where it stops, and if it hits a wall it sticks
-- there for a moment before fading.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local NeedleLook = require(Shared:WaitForChild("NeedleLook"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local ThrowFx = {}
local T = Config.Throw
local lastThrow = -math.huge

-- Where you're aiming: along the mouse (or the screen's middle on touch) from the camera.
local function aim()
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local camera = workspace.CurrentCamera
	local point = if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then camera.ViewportSize / 2 else UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { player.Character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	local target = if hit then hit.Position else ray.Origin + ray.Direction * 300
	return (target - head.Position).Unit
end

local function throw()
	if not (player.Character and player.Character:FindFirstChild("Needle")) or os.clock() - lastThrow < T.cooldown then
		return
	end
	local dir = aim()
	if dir then
		lastThrow = os.clock()
		Remotes.Throw:FireServer(dir)
	end
end

-- Draws one throw: the thrower's needle, point first, from origin to finish.
local function flight(m)
	local typeId, skinId = Needles.split(m.key)
	local model = NeedleLook.build(typeId or "sewing", skinId or "steel", Config.NeedleTool.scale, 2)
	local dir = (m.finish - m.origin).Unit
	local face = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, math.rad(90), 0) -- the needle's +X (its point) along the flight
	model:PivotTo(CFrame.new(m.origin) * face)
	model.Parent = workspace
	Effects.sound("whoosh", 1.3)
	local value = Instance.new("NumberValue")
	value.Changed:Connect(function(t)
		model:PivotTo(CFrame.new(m.origin:Lerp(m.finish, t)) * face)
	end)
	local tween = UiKit.ease(value, math.max(m.seconds, 0.05), { Value = 1 }, Enum.EasingStyle.Linear)
	tween.Completed:Wait()
	value:Destroy()
	if m.hitPlayer then
		model:Destroy() -- the hit shows as a POP (client/CombatFx)
		return
	end
	task.wait(0.8) -- stuck in the wall for a moment
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			UiKit.ease(part, 0.4, { Transparency = 1 })
		end
	end
	task.delay(0.45, function()
		model:Destroy()
	end)
end

function ThrowFx.start(gui)
	local button = UiKit.button("Throw (Q)", Color3.fromRGB(230, 120, 50), { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -204), Size = UDim2.fromOffset(150, 46), Visible = false, Parent = gui })
	UiKit.autoScale(button)
	button.Activated:Connect(throw)
	ContextActionService:BindAction("ThrowNeedle", function(_, state)
		if state == Enum.UserInputState.Begin then
			throw()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	task.spawn(function() -- the button: only with the Needle out in a round, and when it's ready
		while true do
			local holding = player.Character and player.Character:FindFirstChild("Needle") ~= nil
			button.Visible = holding and ReplicatedStorage:GetAttribute("Phase") == "search" and player:GetAttribute("Found") ~= nil
			local wait = T.cooldown - (os.clock() - lastThrow)
			button.Text = if wait > 0 then string.format("Throw  %.0f", math.ceil(wait)) else "Throw (Q)"
			button.BackgroundColor3 = if wait > 0 then UiKit.colors.line else Color3.fromRGB(230, 120, 50)
			task.wait(0.2)
		end
	end)
	Remotes.Thrown.OnClientEvent:Connect(function(m)
		task.spawn(flight, m)
	end)
end

return ThrowFx
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00054">
					<Properties>
						<string name="Name">TradeScreen</string>
						<ProtectedString name="Source"><![CDATA[-- The Trade screen (server/TradeManager decides everything). Not trading: everyone in the server
-- with an "Ask to trade" button. Asked: a card with Accept / No thanks. Trading: your offer and
-- theirs side by side with each needle's rarity and value and both totals, your needles to add
-- from, and Ready. Any change un-readies you both; when both are ready a countdown runs, and you
-- can still cancel until it ends.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Needles = require(Shared:WaitForChild("Needles"))
local Rules = require(Shared:WaitForChild("Rules"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Hud = require(script.Parent.Hud)

local player = Players.LocalPlayer
local TradeScreen = {}
local win, body, getProfile
local state = nil -- the trade in progress (Remotes.TradeState), or nil

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function clear()
	for _, c in ipairs(body:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function ask(...)
	local ok, why = Remotes.Trade:InvokeServer(...)
	if why then
		Hud.toast(why, if ok then "good" else "bad")
	end
	return ok
end

-- One needle line: rarity colour, name, value, how many; a button if `action` is given.
local function needleRow(parent, order, key, n, label, action)
	local t, s = Needles.split(key)
	if not t then
		return 0
	end
	local skin, value = Needles.skin(s), Needles.value(t, s)
	local rarity = Needles.rarity(skin.rarity)
	local r = UiKit.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = UiKit.colors.card, Parent = parent }, { UiKit.corner(8) })
	UiKit.make("Frame", { Size = UDim2.new(0, 6, 1, 0), BackgroundColor3 = rgb(rarity.colour), Parent = r }, { UiKit.corner(3) })
	UiKit.label({ Text = Needles.name(t, s) .. (if n > 1 then "  ×" .. n else ""), Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(14, 2), TextXAlignment = Enum.TextXAlignment.Left, Parent = r }, 17)
	UiKit.label({ Text = rarity.name .. "  ·  " .. Rules.commas(value), TextColor3 = rgb(rarity.colour), Size = UDim2.new(1, -150, 0, 16), Position = UDim2.fromOffset(14, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = r }, 14)
	if action then
		local b = UiKit.button(label, UiKit.colors.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(110, 32), Parent = r })
		b.Activated:Connect(action)
	end
	return value * n
end

local function column(x, title)
	local col = UiKit.make("Frame", { Position = UDim2.new(x, 0, 0, 0), Size = UDim2.new(0.5, -6, 1, 0), BackgroundTransparency = 1 })
	UiKit.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
	UiKit.label({ LayoutOrder = 0, Text = title, Font = UiKit.bold, Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = col }, 20)
	return col
end

local function drawTrade()
	local top = UiKit.make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 300), BackgroundTransparency = 1, Parent = body })
	local yours, theirs = column(0, "You give"), column(0.5, state.them.name .. " gives")
	yours.Parent, theirs.Parent = top, top
	local give, get = 0, 0
	for i, e in ipairs(state.you.offer) do
		give += needleRow(yours, i, e.key, e.count, "Take back", function()
			ask("offer", e.key, false)
		end)
	end
	for i, e in ipairs(state.them.offer) do
		get += needleRow(theirs, i, e.key, e.count)
	end
	UiKit.label({ LayoutOrder = 98, Text = "Value " .. Rules.commas(give) .. (if state.you.ready then "  ·  READY" else ""), Font = UiKit.bold, TextColor3 = UiKit.colors.gold, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = yours }, 18)
	UiKit.label({ LayoutOrder = 98, Text = "Value " .. Rules.commas(get) .. (if state.them.ready then "  ·  READY" else ""), Font = UiKit.bold, TextColor3 = UiKit.colors.gold, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = theirs }, 18)
	local bar = UiKit.make("Frame", { LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 50), BackgroundTransparency = 1, Parent = body })
	local ready = UiKit.button(if state.you.ready then "Not ready" else "Ready", if state.you.ready then UiKit.colors.line else UiKit.colors.green, { Size = UDim2.fromOffset(160, 46), Parent = bar })
	ready.Activated:Connect(function()
		ask("ready", not state.you.ready)
	end)
	local cancel = UiKit.button("Cancel trade", UiKit.colors.red, { Position = UDim2.fromOffset(170, 0), Size = UDim2.fromOffset(160, 46), Parent = bar })
	cancel.Activated:Connect(function()
		ask("cancel")
	end)
	local note = UiKit.label({ Text = "Check both sides before you press Ready.", TextColor3 = UiKit.colors.soft, Position = UDim2.fromOffset(340, 0), Size = UDim2.new(1, -340, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = bar }, 18)
	if state.countdownEnds then
		task.spawn(function()
			while note.Parent and state and state.countdownEnds do
				note.Text = "Trading in " .. math.max(0, math.ceil(state.countdownEnds - workspace:GetServerTimeNow())) .. "...  (cancel to stop it)"
				note.TextColor3 = UiKit.colors.gold
				task.wait(0.2)
			end
		end)
	end
	UiKit.label({ LayoutOrder = 3, Text = "Your needles (up to " .. Config.Trading.maxItems .. " in a trade)", Font = UiKit.bold, Size = UDim2.new(1, -8, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = body }, 20)
	local offered = {}
	for _, e in ipairs(state.you.offer) do
		offered[e.key] = e.count
	end
	local order = 4
	for key, n in pairs(getProfile().collection or {}) do
		local left = n - (offered[key] or 0)
		if left > 0 then
			order += 1
			needleRow(body, order, key, left, "Add", function()
				ask("offer", key, true)
			end)
		end
	end
end

local function drawPlayers()
	UiKit.label({ LayoutOrder = 0, Text = "Swap needles with anyone in this server, in the lobby between rounds.", TextColor3 = UiKit.colors.soft, Size = UDim2.new(1, -8, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = body }, 18)
	for i, p in ipairs(Remotes.Collection:InvokeServer("list") or {}) do
		if p.userId ~= player.UserId then
			local r = UiKit.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 50), BackgroundColor3 = UiKit.colors.card, Parent = body }, { UiKit.corner(10) })
			UiKit.label({ Text = p.name .. "  ·  collection " .. Rules.commas(p.value), Size = UDim2.new(1, -200, 1, 0), Position = UDim2.fromOffset(14, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = r }, 20)
			local b = UiKit.button("Ask to trade", UiKit.colors.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(170, 40), Parent = r })
			b.Activated:Connect(function()
				ask("request", p.userId)
			end)
		end
	end
end

function TradeScreen.refresh()
	if not win or not win.Visible then
		return
	end
	clear()
	if state then
		drawTrade()
	else
		drawPlayers()
	end
end

-- Someone asked: a card under the banner with Accept / No thanks, gone after 30 seconds.
local function invite(gui, m)
	local card = UiKit.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 140), Size = UDim2.fromOffset(420, 110), BackgroundColor3 = UiKit.colors.panel, ZIndex = 30, Parent = gui }, { UiKit.corner(14), UiKit.stroke(UiKit.colors.blue, 2) })
	UiKit.autoScale(card)
	UiKit.label({ Text = m.name .. " wants to trade needles", Font = UiKit.bold, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 10), ZIndex = 31, Parent = card }, 22)
	local yes = UiKit.button("Accept", UiKit.colors.green, { Position = UDim2.fromOffset(20, 54), Size = UDim2.fromOffset(180, 44), ZIndex = 31, Parent = card })
	local no = UiKit.button("No thanks", UiKit.colors.card, { Position = UDim2.fromOffset(220, 54), Size = UDim2.fromOffset(180, 44), ZIndex = 31, Parent = card })
	yes.Activated:Connect(function()
		card:Destroy()
		if ask("respond", m.from, true) then
			win.Visible = true
		end
	end)
	no.Activated:Connect(function()
		card:Destroy()
		ask("respond", m.from, false)
	end)
	UiKit.pop(card, 0.8)
	task.delay(30, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function TradeScreen.mount(gui, profileFn)
	getProfile = profileFn
	win, body = UiKit.window(gui, "Trade", 820, 600)
	Remotes.TradeState.OnClientEvent:Connect(function(m)
		if m.kind == "invite" then
			invite(gui, m)
		elseif m.kind == "trade" then
			state = m
			win.Visible = true
			TradeScreen.refresh()
		elseif m.kind == "closed" then
			state = nil
			Hud.toast(m.text or "Trade closed.", "good")
			TradeScreen.refresh()
		end
	end)
	return { Trade = win }, { Trade = TradeScreen.refresh }
end

return TradeScreen
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00055">
					<Properties>
						<string name="Name">UIController</string>
						<ProtectedString name="Source"><![CDATA[-- Puts the whole UI together: one ScreenGui with the HUD, the round moments (Results), and the
-- Shop, Inventory, Quests, Leaderboard and Settings windows. It keeps your latest profile (sent
-- by the server on every change), opens one window at a time from the menu or a lobby stall's
-- prompt, and applies your settings (sound, effects, music).
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UiKit = require(script.Parent.UiKit)
local Effects = require(script.Parent.Effects)
local Hud = require(script.Parent.Hud)
local Results = require(script.Parent.Results)
local Screens = require(script.Parent.Screens)
local Screens2 = require(script.Parent.Screens2)
local Screens3 = require(script.Parent.Screens3)
local LobbyUi = require(script.Parent.LobbyUi)
local PowerupFx = require(script.Parent.PowerupFx)
local BoxScreen = require(script.Parent.BoxScreen)
local CombatFx = require(script.Parent.CombatFx)
local ThrowFx = require(script.Parent.ThrowFx)
local DashFx = require(script.Parent.DashFx)
local TradeScreen = require(script.Parent.TradeScreen)

local player = Players.LocalPlayer
local UIController = {}
local profile = {}
local windows, openers = {}, {}
local music = nil

local function getProfile()
	return profile
end

function UIController.open(name)
	for n, w in pairs(windows) do
		if n ~= name then
			w.Visible = false
		end
	end
	local w = windows[name]
	if not w then
		return
	end
	w.Visible = not w.Visible
	if w.Visible then
		UiKit.pop(w, 0.9)
		if openers[name] then
			task.spawn(openers[name])
		end
		Screens.refresh()
		Screens2.refresh()
	end
end

local function applySettings()
	local s = profile.settings or {}
	Effects.settings.sfx = s.sfx ~= false
	Effects.settings.reduceEffects = s.reduceEffects == true
	Effects.settings.music = s.music ~= false
	if music then
		music.Volume = if Effects.settings.music then 0.3 else 0
	end
end

function UIController.start()
	local gui = UiKit.make("ScreenGui", { Name = "NeedleUi", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	Effects.mount(gui)
	Hud.mount(gui, UIController.open)
	Results.mount(gui, getProfile)
	for name, w in pairs(Screens.mount(gui, getProfile)) do
		windows[name] = w
	end
	local more, extra = Screens2.mount(gui, getProfile)
	for name, w in pairs(more) do
		windows[name] = w
	end
	for name, fn in pairs(extra) do
		openers[name] = fn
	end
	local col, colOpen = Screens3.mount(gui)
	for name, w in pairs(col) do
		windows[name] = w
	end
	for name, fn in pairs(colOpen) do
		openers[name] = fn
	end
	for _, screen in ipairs({ BoxScreen, TradeScreen }) do
		local w, opener = screen.mount(gui, getProfile)
		for name, frame in pairs(w) do
			windows[name], openers[name] = frame, opener[name]
		end
	end
	PowerupFx.start(gui)
	CombatFx.start(gui)
	ThrowFx.start(gui)
	DashFx.start(gui)
	LobbyUi.start(gui, function(userId) -- a booth's prompt: that player's collection
		Screens3.view(userId)
		if windows.Collection.Visible then
			Screens3.refresh()
		else
			UIController.open("Collection")
		end
	end)
	Remotes.Profile.OnClientEvent:Connect(function(p)
		profile = p
		applySettings()
		Screens.refresh()
		Screens2.refresh()
		TradeScreen.refresh()
	end)
	-- the lobby's Shop stall and Wardrobe open their screens
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local opens = prompt:GetAttribute("Opens")
		if opens and windows[opens] and not windows[opens].Visible then
			UIController.open(opens)
		end
	end)
	if Config.Music ~= "" then
		music = UiKit.make("Sound", { SoundId = Config.Music, Looped = true, Volume = 0.3, Parent = SoundService })
		music:Play()
	end
	applySettings()
end

return UIController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00056">
					<Properties>
						<string name="Name">UiKit</string>
						<ProtectedString name="Source"><![CDATA[-- The UI's look in one place: a clean, modern dark-glass style with warm gold accents, big
-- readable text and large touch targets. Every screen builds from these helpers.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UiKit = {}

UiKit.colors = {
	panel = Color3.fromRGB(24, 28, 38), -- window backgrounds (slightly see-through)
	card = Color3.fromRGB(38, 44, 58),
	line = Color3.fromRGB(70, 78, 96),
	text = Color3.fromRGB(240, 242, 248),
	soft = Color3.fromRGB(168, 176, 196),
	gold = Color3.fromRGB(255, 200, 70),
	green = Color3.fromRGB(80, 190, 120),
	red = Color3.fromRGB(230, 90, 80),
	blue = Color3.fromRGB(90, 150, 240),
	purple = Color3.fromRGB(160, 120, 240),
}
UiKit.font = Enum.Font.BuilderSans
UiKit.bold = Enum.Font.BuilderSansBold

function UiKit.make(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

function UiKit.corner(r)
	return UiKit.make("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

function UiKit.stroke(colour, thickness)
	return UiKit.make("UIStroke", { Color = colour or UiKit.colors.line, Thickness = thickness or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UiKit.pad(px)
	return UiKit.make("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end

function UiKit.label(props, maxSize)
	local defaults = { BackgroundTransparency = 1, Font = UiKit.font, TextColor3 = UiKit.colors.text, TextScaled = true, TextWrapped = true, Text = "" }
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UiKit.make("TextLabel", defaults, { UiKit.make("UITextSizeConstraint", { MaxTextSize = maxSize or 28 }) })
end

function UiKit.button(text, colour, props)
	local defaults = { Text = text, Font = UiKit.bold, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = colour or UiKit.colors.blue, AutoButtonColor = true, Size = UDim2.fromOffset(140, 44) }
	for k, v in pairs(props or {}) do
		defaults[k] = v
	end
	local b = UiKit.make("TextButton", defaults, { UiKit.corner(10), UiKit.make("UITextSizeConstraint", { MaxTextSize = 22 }), UiKit.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
	b.Activated:Connect(function()
		UiKit.pop(b, 0.92)
	end)
	return b
end

-- A soft spring: scales from `from` back to 1.
function UiKit.pop(obj, from)
	local s = obj:FindFirstChildOfClass("UIScale") or UiKit.make("UIScale", { Parent = obj })
	s.Scale = from
	TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function UiKit.ease(obj, seconds, goal, style)
	local t = TweenService:Create(obj, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- True on phones and tablets (no mouse): screens use bigger targets there.
function UiKit.touch()
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

-- Keeps a frame readable on every screen: scales it with the viewport (0.65x on a small phone,
-- up to 1.15x on a big monitor).
function UiKit.autoScale(frame)
	local scale = frame:FindFirstChild("AutoScale") or UiKit.make("UIScale", { Name = "AutoScale", Parent = frame })
	local function fit()
		local v = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(v.X / 1280, v.Y / 720), 0.65, 1.15)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	return scale
end

-- A centred window (a little below the middle, clear of the round banner) with a title and a
-- close button. Returns the window and its body.
function UiKit.window(gui, title, w, h)
	local win = UiKit.make("Frame", { Name = title, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.57), Size = UDim2.fromOffset(w or 620, h or 460), BackgroundColor3 = UiKit.colors.panel, BackgroundTransparency = 0.06, Visible = false, ZIndex = 10, Parent = gui }, { UiKit.corner(18), UiKit.stroke() })
	UiKit.autoScale(win)
	UiKit.label({ Text = title, Font = UiKit.bold, Size = UDim2.new(1, -100, 0, 40), Position = UDim2.fromOffset(22, 14), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, Parent = win }, 30)
	local close = UiKit.button("X", UiKit.colors.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(44, 40), ZIndex = 11, Parent = win })
	close.Activated:Connect(function()
		win.Visible = false
	end)
	local body = UiKit.make("ScrollingFrame", { Size = UDim2.new(1, -36, 1, -78), Position = UDim2.fromOffset(18, 64), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 11, Parent = win }, {
		UiKit.make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	return win, body
end

-- A rounded progress bar; returns the bar and its fill.
function UiKit.bar(parent, props, colour)
	local back = UiKit.make("Frame", props, { UiKit.corner(6) })
	back.BackgroundColor3 = UiKit.colors.line
	back.Parent = parent
	local fill = UiKit.make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = colour or UiKit.colors.gold, ZIndex = back.ZIndex + 1, Parent = back }, { UiKit.corner(6) })
	return back, fill
end

UiKit.player = Players.LocalPlayer
return UiKit
