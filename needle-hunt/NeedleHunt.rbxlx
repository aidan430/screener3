<roblox version="4">
	<Item class="ReplicatedStorage" referent="RBX00000">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX00001">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00002">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- Every tunable number for A Needle in a Haystack. Change values here; nothing else needs to
-- change. Maps, cosmetics and quests have their own data modules (Maps, Cosmetics, Quests).
local Config = {}

-- Rounds (server/RoundManager). Seconds.
Config.Round = {
	lobbyCountdown = 15, -- in the lobby before a round
	loadCountdown = 3, -- 3, 2, 1 in the map before searching starts
	duration = 180, -- a normal round
	speedDuration = 90, -- a Speed Round
	grace = 10, -- after the first find, everyone else still has this long (2nd, 3rd...)
	results = 10, -- the results screen
	minPlayers = 1, -- 1 = a solo player still gets (practice) rounds
	winsNeedPlayers = 2, -- a win counts towards wins and weekly winners only with this many playing
}

-- Difficulty: picked each round by weight. needle = its length in studs; glint = a soft sparkle
-- (easy only); clutter = loose straws scattered round the map; decoys = fake needles; dim =
-- how much darker the light is; moving = tumbling hay bundles that drift about.
Config.Difficulty = {
	{ id = "easy", name = "Easy", weight = 30, needle = 3.6, glint = true, clutter = 160, decoys = 0, dim = 0, moving = 0, coins = 1.0 },
	{ id = "normal", name = "Normal", weight = 50, needle = 2.8, glint = false, clutter = 260, decoys = 0, dim = 0, moving = 0, coins = 1.25 },
	{ id = "hard", name = "Hard", weight = 20, needle = 2.0, glint = false, clutter = 380, decoys = 4, dim = 0.35, moving = 4, coins = 1.6 },
}

-- Modifiers: a round gets one with this chance (then by weight). The Golden Needle is a
-- separate, rarer roll on top.
Config.ModifierChance = 0.35
Config.Modifiers = {
	{ id = "double", name = "Double Needle", text = "Two needles: both must be found", weight = 30 },
	{ id = "speed", name = "Speed Round", text = "Half the time!", weight = 30 },
	{ id = "lowlight", name = "Low Light", text = "The lights are low", weight = 20 },
	{ id = "camo", name = "Camouflage", text = "The needle matches the hay", weight = 20 },
}
Config.GoldenChance = 0.05 -- a Golden Needle: triple rewards, and the needle you keep is Golden

-- The needle collection (shared/Needles, server/CollectionManager): extra luck for a better skin
-- (added to 1, multiplying every rarity above Common) for 1st place and for Hard rounds.
Config.Collection = { firstLuck = 0.5, hardLuck = 0.5 }

-- The owner's own needle model (server/NeedleModel): its asset ID once the imported model is
-- saved to Roblox (Studio: right-click the model > Save to Roblox). 0 = use the built needle.
Config.NeedleModel = { asset = 0 }

-- Haystacks (MapKit.haystack): smooth, lumpy terrain domes in `material`, recoloured `colour`
-- (the arena's terrain is cleared between rounds). model = the owner's haystack model's asset ID
-- (server/HaystackModel; saved to Roblox from Studio): when it loads, every haystack uses it.
-- The textures uploaded with that model, for reference (the saved model carries them itself):
--   material0: 139923378561945, 82802973824193, 131881570420382, 134403754765000
--   material1: 125383755787779, 83696294561694, 117010844111225, 87942777253086
Config.Haystacks = { material = "Sand", colour = { 226, 186, 88 }, model = 0 }

-- Finding (server/NeedleSpawner). Studs and seconds.
Config.Find = {
	reach = 14, -- how close your character must be to claim the needle (clicks and taps)
	hitbox = 1.6, -- the invisible box round the needle you click or tap (the same on every device)
	thickness = 0.2, -- how thick the needle's shaft is (studs): thick enough to spot, thin enough to hide
	decoyLockout = 3, -- clicking a decoy: no claims for this long
	clicksPerSecond = 6, -- more than this and the extra clicks are ignored
	jitter = 0.6, -- the needle moves this far from its hiding spot, so spots can't be memorised
	maxSpotHeight = 6.5, -- spots higher than this above the floor need `climb = true` (a reachable loft)
}

-- Anti-exploit (server/AntiCheat).
-- Testing (Roblox Studio only, never in a live game): revealNeedle = true outlines the hidden
-- needle through walls and prints where it is, so you can test finding it.
Config.Testing = { revealNeedle = false }

Config.AntiCheat = {
	checkEvery = 0.5, -- seconds between movement checks
	maxSpeed = 70, -- studs a second a character may move (walking, jumping, falling) outside a teleport
	strikesToKick = 0, -- 0 = never kick; just put them back where they were
	fallY = -40, -- below this height (a fall off a map) a character respawns
}

-- Rewards (server/RewardManager). Coins and XP.
Config.Rewards = {
	findCoins = 60, findXp = 80, -- the first finder, at the very start of a round (halves by the end)
	place = { 1, 0.6, 0.4, 0.25 }, -- 1st, 2nd, 3rd, the rest
	top3Coins = 15, top3Xp = 20,
	playCoins = 5, playXp = 10, -- for being there at the end of a round
	golden = 3, -- times everything for a Golden Needle
	winStreakStep = 0.1, winStreakMax = 0.5, -- +10% per win in a row, up to +50%
	loginCoins = 25, loginStreakMax = 7, -- daily login: 25 x streak day, up to day 7
}

-- Levels: level L needs xpBase + xpStep x (L - 1) XP.
Config.Levels = { xpBase = 100, xpStep = 25, max = 500 }

-- Hints: a free hint a day (two with the Extra Hint pass). A hint says roughly where the
-- needle is: its compass direction, how far and whether it's high or low.
Config.Hints = { free = 1, pass = 1, nearStuds = 15, farStuds = 45 }

-- Saving (server/DataManager). Change DataStoreName to start everyone afresh.
Config.DataStoreName = "NeedleHunt_v1"
Config.AutosaveSeconds = 60
Config.LoadRetries = 3

-- Leaderboards (server/LeaderboardManager): OrderedDataStore names. weekly gets the week
-- number added. Writes are batched every flushSeconds; boards re-read every readSeconds.
Config.Boards = {
	{ id = "needles", name = "Most Needles", store = "NH_Needles_v1", ascending = false },
	{ id = "fastest", name = "Fastest Find", store = "NH_Fastest_v1", ascending = true, seconds = true },
	{ id = "level", name = "Highest Level", store = "NH_Level_v1", ascending = false },
	{ id = "coins", name = "Most Coins Earned", store = "NH_Coins_v1", ascending = false },
	{ id = "weekly", name = "This Week's Winners", store = "NH_WeeklyWins_v1_", ascending = false, weekly = true },
	{ id = "collection", name = "Most Valuable Collection", store = "NH_Collection_v1", ascending = false },
}
Config.BoardRows = 10
Config.BoardFlushSeconds = 120
Config.BoardReadSeconds = 180

-- Robux (server/ShopManager). 0 = not on sale yet: create the pass or product on the Creator
-- Dashboard, then put its ID here. Nothing here is a random reward.
Config.GamePasses = { DoubleCoins = 0, ExtraHint = 0, Supporter = 0 }
Config.Products = { StarterBundle = 0 }
Config.StarterBundle = { coins = 500, cosmetic = "t_sparkle" } -- what the Starter Bundle gives (never a collectible needle)

-- Sounds: Roblox's built-in sounds; swap in your own Toolbox IDs ("rbxassetid://...").
Config.Sounds = {
	found = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/button.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
	countdown = "rbxasset://sounds/clickfast.wav",
}
Config.Music = "" -- a looping lobby track ID, or "" for none

-- Where things are. The lobby sits at the origin; maps are built far away, one at a time.
Config.LobbyCentre = Vector3.new(0, 0, 0)
Config.ArenaCentre = Vector3.new(0, 0, 600)

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00003">
				<Properties>
					<string name="Name">Cosmetics</string>
					<ProtectedString name="Source"><![CDATA[-- Cosmetics for Haystack Coins: looks only, never an advantage. Needles are not sold here: every
-- needle you find is yours to keep (shared/Needles, the collection). Add an item by adding a line.
--   kind: trail | title | effect
--   price: Haystack Coins in the shop (0 = not sold for coins: a starting item, a quest reward
--     or from a Robux pass, named by `source`)
--   colours: { r, g, b } (trail: start, end)
local Cosmetics = {}

Cosmetics.items = {
	-- trails
	{ id = "t_straw", kind = "trail", name = "Straw Trail", price = 700, colours = { { 240, 200, 90 }, { 255, 240, 190 } } },
	{ id = "t_sparkle", kind = "trail", name = "Sparkle Trail", price = 1800, colours = { { 255, 255, 255 }, { 170, 220, 255 } } },
	{ id = "t_supporter", kind = "trail", name = "Supporter Trail", price = 0, source = "Supporter pass", colours = { { 255, 200, 80 }, { 255, 120, 60 } } },
	-- titles above your head
	{ id = "ti_finder", kind = "title", name = "Needle Finder", price = 0, source = "quest", colours = { { 220, 225, 235 } } },
	{ id = "ti_eagle", kind = "title", name = "Eagle Eye", price = 0, source = "quest", colours = { { 255, 214, 90 } } },
	{ id = "ti_supporter", kind = "title", name = "Supporter", price = 0, source = "Supporter pass", colours = { { 255, 160, 70 } } },
	-- found effects: the burst when you find a needle
	{ id = "e_confetti", kind = "effect", name = "Confetti Pop", price = 0, source = "start", colours = { { 255, 206, 70 }, { 110, 170, 240 } } },
	{ id = "e_stars", kind = "effect", name = "Starburst", price = 1200, colours = { { 255, 250, 220 }, { 255, 214, 90 } } },
}

Cosmetics.kinds = { "trail", "title", "effect" }
Cosmetics.kindNames = { trail = "Trails", title = "Titles", effect = "Found Effects" }
Cosmetics.starting = { "e_confetti" } -- everyone owns these
Cosmetics.defaults = { effect = "e_confetti" } -- and wears these

local byId = {}
for _, item in ipairs(Cosmetics.items) do
	byId[item.id] = item
end

function Cosmetics.get(id)
	return byId[id]
end

return Cosmetics
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00004">
				<Properties>
					<string name="Name">Maps</string>
					<ProtectedString name="Source"><![CDATA[-- The maps: what each is called, its light and its colours. server/MapsA and server/MapsB build
-- them (`builder` names the function) and list their hiding spots as they place each prop, so
-- every spot sits on a real surface in reach. Add a map: a line here plus a builder.
--   lighting: Lighting's ClockTime, Brightness, Ambient, OutdoorAmbient, FogEnd, FogColor.
--   straw: the colour of loose straw (and of a camouflaged needle); clutter tints vary round it.
local Maps = {}

Maps.list = {
	{ id = "field", name = "Classic Haystack Field", builder = "field", weight = 25,
		lighting = { ClockTime = 14, Brightness = 2.6, Ambient = { 120, 116, 104 }, OutdoorAmbient = { 150, 146, 134 }, FogEnd = 900, FogColor = { 200, 225, 245 } },
		straw = { 226, 188, 92 }, ground = { 104, 160, 76 } },
	{ id = "barn", name = "Barn Interior", builder = "barn", weight = 20,
		lighting = { ClockTime = 13, Brightness = 1.4, Ambient = { 120, 96, 70 }, OutdoorAmbient = { 110, 90, 66 }, FogEnd = 400, FogColor = { 120, 96, 70 } },
		straw = { 214, 172, 80 }, ground = { 120, 86, 56 } },
	{ id = "sunset", name = "Farm at Sunset", builder = "sunset", weight = 20,
		lighting = { ClockTime = 17.7, Brightness = 2.2, Ambient = { 130, 96, 80 }, OutdoorAmbient = { 170, 120, 96 }, FogEnd = 700, FogColor = { 250, 170, 120 } },
		straw = { 232, 170, 84 }, ground = { 120, 150, 70 } },
	{ id = "forest", name = "Night Forest", builder = "forest", weight = 15,
		lighting = { ClockTime = 0.5, Brightness = 1.1, Ambient = { 70, 80, 110 }, OutdoorAmbient = { 90, 100, 140 }, FogEnd = 260, FogColor = { 30, 40, 64 } },
		straw = { 196, 170, 100 }, ground = { 52, 84, 52 } },
	{ id = "attic", name = "Abandoned Attic", builder = "attic", weight = 20,
		lighting = { ClockTime = 15, Brightness = 1.2, Ambient = { 110, 100, 90 }, OutdoorAmbient = { 100, 92, 84 }, FogEnd = 300, FogColor = { 110, 100, 90 } },
		straw = { 206, 176, 112 }, ground = { 112, 86, 64 } },
}

-- The lobby's light, between rounds.
Maps.lobbyLighting = { ClockTime = 14.5, Brightness = 2.5, Ambient = { 120, 116, 104 }, OutdoorAmbient = { 150, 146, 134 }, FogEnd = 1200, FogColor = { 200, 225, 245 } }

local byId = {}
for _, m in ipairs(Maps.list) do
	byId[m.id] = m
end

function Maps.get(id)
	return byId[id]
end

return Maps
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00005">
				<Properties>
					<string name="Name">NeedleLook</string>
					<ProtectedString name="Source"><![CDATA[-- Builds a needle of any type in any skin out of parts (shared/Needles): for the NEEDLE FOUND!
-- reveal, the Collection screen (inside ViewportFrames) and the lobby's showcase pedestals.
-- The needle lies along X, eye end at -X, point at +X, about 2-3 studs long at scale 1.
-- The shaft is cut into segments so patterns (stripes, gradient, rainbow) show along it.
-- fat (1 = true to life) thickens it for display: the UI and pedestals use about 2, so a needle
-- reads as a bold little trophy instead of a hairline.
local Needles = require(script.Parent.Needles)

local NeedleLook = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- The colour of shaft segment i of n for a skin.
local function colourAt(skin, i, n)
	local a, b = rgb(skin.colours[1]), rgb(skin.colours[2] or skin.colours[1])
	local t = (i - 0.5) / n
	if skin.pattern == "stripes" then
		return if i % 2 == 1 then a else b
	elseif skin.pattern == "gradient" then
		return a:Lerp(b, t)
	elseif skin.pattern == "rainbow" then
		return Color3.fromHSV(t * 0.85, 0.65, 1)
	end
	return a
end

local function accent(skin)
	if skin.pattern == "rainbow" then
		return Color3.fromHSV(0.85, 0.5, 1)
	end
	return if skin.pattern == "solid" then rgb(skin.colours[1]) else rgb(skin.colours[2] or skin.colours[1])
end

function NeedleLook.build(typeId, skinId, scale, fat)
	scale, fat = scale or 1, fat or 1
	local skin = Needles.skin(skinId) or Needles.skin("steel")
	local model = Instance.new("Model")
	model.Name = Needles.name(typeId, skin.id)
	local material = Enum.Material[skin.material] or Enum.Material.Metal
	local root = Instance.new("Part")
	root.Name, root.Size, root.Transparency, root.Anchored = "Root", Vector3.one * 0.1, 1, true
	root.CanCollide, root.CanQuery, root.CanTouch = false, false, false
	root.Parent = model
	model.PrimaryPart = root

	local function part(size, cf, colour, shape, onCurve)
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Shape = Enum.PartType[shape or "Block"]
		if shape == "Ball" then
			p.Size = size * scale * fat
		else
			p.Size = Vector3.new(size.X, size.Y * fat, size.Z * fat) * scale
		end
		local y = if onCurve then cf.Position.Y else cf.Position.Y * fat -- a curve keeps its shape
		p.CFrame = CFrame.new(Vector3.new(cf.Position.X, y, cf.Position.Z) * scale) * cf.Rotation
		p.Color, p.Material = colour, material
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	-- a shaft from x0 to x1, d thick, in n patterned segments (y offsets it sideways)
	local function shaft(x0, x1, d, n, y, flat)
		local len = (x1 - x0) / n
		for i = 1, n do
			local cf = CFrame.new(x0 + (i - 0.5) * len, y or 0, 0)
			if flat then
				part(Vector3.new(len + 0.01, d, flat), cf, colourAt(skin, i, n))
			else
				part(Vector3.new(len + 0.01, d, d), cf, colourAt(skin, i, n), "Cylinder")
			end
		end
	end
	local function tip(x, d, steps)
		for i = 1, steps do
			local k = 1 - i / (steps + 1)
			part(Vector3.new(0.08, d * k, d * k), CFrame.new(x + i * 0.07, 0, 0), colourAt(skin, 6, 6), "Cylinder")
		end
	end
	local function eye(x, len, gap, d)
		for _, s in ipairs({ -1, 1 }) do
			part(Vector3.new(len, d * 0.45, d * 0.45), CFrame.new(x, s * gap, 0), accent(skin), "Cylinder")
		end
		part(Vector3.new(d * 0.6, gap * 2 + d * 0.45, d * 0.5), CFrame.new(x - len / 2, 0, 0), accent(skin))
	end
	local function ball(x, d, y, onCurve)
		part(Vector3.one * d, CFrame.new(x, y or 0, 0), accent(skin), "Ball", onCurve)
	end

	if typeId == "pin" then
		shaft(-0.75, 0.85, 0.06, 6)
		tip(0.85, 0.06, 2)
		ball(-0.85, 0.28)
	elseif typeId == "quilting" then
		shaft(-0.6, 0.6, 0.07, 5)
		tip(0.6, 0.07, 2)
		eye(-0.7, 0.18, 0.03, 0.07)
	elseif typeId == "darning" then
		shaft(-1.15, 1.1, 0.12, 7)
		tip(1.1, 0.12, 3)
		eye(-1.3, 0.34, 0.07, 0.12)
	elseif typeId == "embroidery" then
		shaft(-0.85, 0.85, 0.09, 6)
		tip(0.85, 0.09, 3)
		eye(-1.02, 0.34, 0.08, 0.1)
	elseif typeId == "tapestry" then
		shaft(-0.95, 1.0, 0.11, 6)
		ball(1.03, 0.13)
		eye(-1.12, 0.34, 0.07, 0.11)
	elseif typeId == "safety" then
		shaft(-0.9, 0.85, 0.06, 6, 0.13)
		shaft(-0.75, 0.85, 0.06, 6, -0.13)
		for i = 0, 7 do -- the coil
			local a = i / 8 * math.pi * 2
			part(Vector3.new(0.06, 0.06, 0.06), CFrame.new(-0.95 + math.cos(a) * 0.13, math.sin(a) * 0.13, 0), accent(skin), "Ball")
		end
		part(Vector3.new(0.24, 0.38, 0.12), CFrame.new(0.95, 0, 0), accent(skin))
	elseif typeId == "knitting" then
		shaft(-1.45, 1.3, 0.18, 8)
		tip(1.3, 0.18, 4)
		ball(-1.6, 0.4)
	elseif typeId == "crochet" then
		shaft(-1.3, 1.1, 0.16, 7)
		part(Vector3.new(0.6, 0.24, 0.1), CFrame.new(-0.2, 0, 0), accent(skin))
		part(Vector3.new(0.22, 0.12, 0.12), CFrame.new(1.21, 0, 0), colourAt(skin, 7, 7), "Cylinder")
		part(Vector3.new(0.16, 0.07, 0.08), CFrame.new(1.28, 0.07, 0) * CFrame.Angles(0, 0, math.rad(-40)), colourAt(skin, 7, 7))
	elseif typeId == "bodkin" then
		shaft(-1.1, 1.0, 0.2, 7, 0, 0.05)
		ball(1.05, 0.16)
		part(Vector3.new(0.3, 0.06, 0.07), CFrame.new(-0.85, 0, 0), Color3.fromRGB(30, 30, 36))
	elseif typeId == "curved" then
		local n, r = 9, 0.95
		for i = 1, n do -- an arc, the point at one end and the eye at the other
			local a = math.rad(20 + (i - 0.5) * 140 / n)
			part(Vector3.new(r * math.rad(140 / n) + 0.02, 0.08, 0.08), CFrame.new(-math.cos(a) * r, math.sin(a) * r - 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2 - a), colourAt(skin, i, n), "Cylinder", true) -- along the curve
		end
		ball(-math.cos(math.rad(20)) * r, 0.1, math.sin(math.rad(20)) * r - 0.5, true)
	elseif typeId == "sailmaker" then
		shaft(-1.2, 0.9, 0.14, 7)
		tip(0.9, 0.16, 3)
		part(Vector3.new(1.6, 0.03, 0.03), CFrame.new(-0.2, 0.08, 0), accent(skin))
		eye(-1.36, 0.3, 0.07, 0.13)
	else -- sewing
		shaft(-0.9, 0.85, 0.08, 6)
		tip(0.85, 0.08, 3)
		eye(-1.03, 0.24, 0.05, 0.09)
	end
	if skin.glow then
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness = rgb(skin.colours[1]), 6 * scale, 1
		light.Parent = root
	end
	if skin.sparkle then
		local e = Instance.new("ParticleEmitter")
		e.Rate, e.Lifetime, e.Speed = 4, NumberRange.new(0.5, 0.9), NumberRange.new(0.2, 0.6)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.12 * scale), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission, e.Color = 1, ColorSequence.new(Color3.new(1, 1, 1), rgb(skin.colours[2] or skin.colours[1]))
		e.Shape, e.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
		root.Size = Vector3.new(2.4, 0.4, 0.4) * scale
		e.Parent = root
	end
	return model
end

return NeedleLook
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00006">
				<Properties>
					<string name="Name">Needles</string>
					<ProtectedString name="Source"><![CDATA[-- The needle collection. Everyone hunts the same plain needle (fair); when you find it, it turns
-- out to be one TYPE (its shape) in one SKIN (its look), and it's yours to keep. Every type comes
-- in every skin, so the collection has types x skins entries (12 x 32 = 384).
--   value: what one is worth = type.value x the skin's rarity multiplier. A collection's value
--   is the sum of the different needles in it (duplicates show as x2, x3 but add nothing).
-- Skins are recipes, not pictures: colours, a material and a pattern, drawn by shared/NeedleLook.
--   pattern: solid | two (eye/tip in the second colour) | stripes | gradient | rainbow
--   glow = true lights it up; sparkle = true adds twinkles. Add a skin or a type with a line.
-- Collectibles are only earned by finding needles: never sold, never from anything paid.
local Needles = {}

Needles.rarities = {
	{ id = "common", name = "Common", weight = 55, mult = 1, colour = { 190, 196, 206 } },
	{ id = "uncommon", name = "Uncommon", weight = 25, mult = 2, colour = { 110, 200, 120 } },
	{ id = "rare", name = "Rare", weight = 12, mult = 5, colour = { 90, 150, 240 } },
	{ id = "epic", name = "Epic", weight = 6, mult = 12, colour = { 170, 110, 240 } },
	{ id = "legendary", name = "Legendary", weight = 1.8, mult = 40, colour = { 255, 190, 60 } },
	{ id = "mythic", name = "Mythic", weight = 0.2, mult = 150, colour = { 255, 110, 170 } },
}

-- Types: the needle's shape (see NeedleLook). weight = how often it turns up; value = its base worth.
Needles.types = {
	{ id = "sewing", name = "Sewing Needle", weight = 20, value = 10 },
	{ id = "pin", name = "Dressmaker's Pin", weight = 16, value = 8 },
	{ id = "quilting", name = "Quilting Needle", weight = 12, value = 12 },
	{ id = "darning", name = "Darning Needle", weight = 10, value = 14 },
	{ id = "embroidery", name = "Embroidery Needle", weight = 9, value = 16 },
	{ id = "tapestry", name = "Tapestry Needle", weight = 8, value = 18 },
	{ id = "safety", name = "Safety Pin", weight = 8, value = 15 },
	{ id = "knitting", name = "Knitting Needle", weight = 6, value = 22 },
	{ id = "crochet", name = "Crochet Hook", weight = 5, value = 24 },
	{ id = "bodkin", name = "Bodkin", weight = 3, value = 26 },
	{ id = "curved", name = "Curved Upholstery Needle", weight = 2, value = 30 },
	{ id = "sailmaker", name = "Sailmaker's Needle", weight = 1, value = 36 },
}

Needles.skins = {
	-- Common
	{ id = "steel", name = "Steel", rarity = "common", colours = { { 200, 205, 215 }, { 150, 156, 168 } }, material = "Metal", pattern = "solid" },
	{ id = "iron", name = "Iron", rarity = "common", colours = { { 120, 124, 132 }, { 90, 92, 100 } }, material = "Metal", pattern = "solid" },
	{ id = "brass", name = "Brass", rarity = "common", colours = { { 214, 176, 90 }, { 180, 140, 60 } }, material = "Metal", pattern = "solid" },
	{ id = "copper", name = "Copper", rarity = "common", colours = { { 196, 116, 70 }, { 150, 84, 50 } }, material = "Metal", pattern = "solid" },
	{ id = "bone", name = "Bone", rarity = "common", colours = { { 236, 228, 206 }, { 200, 188, 160 } }, material = "SmoothPlastic", pattern = "solid" },
	{ id = "oak", name = "Oak", rarity = "common", colours = { { 160, 118, 74 }, { 120, 86, 52 } }, material = "Wood", pattern = "solid" },
	{ id = "pewter", name = "Pewter", rarity = "common", colours = { { 160, 164, 170 }, { 200, 204, 210 } }, material = "Metal", pattern = "two" },
	{ id = "ink", name = "Ink", rarity = "common", colours = { { 40, 44, 56 }, { 90, 96, 110 } }, material = "SmoothPlastic", pattern = "two" },
	-- Uncommon
	{ id = "rosegold", name = "Rose Gold", rarity = "uncommon", colours = { { 236, 170, 160 }, { 200, 130, 120 } }, material = "Metal", pattern = "solid" },
	{ id = "bronze", name = "Bronze", rarity = "uncommon", colours = { { 176, 120, 60 }, { 230, 190, 120 } }, material = "Metal", pattern = "two" },
	{ id = "jade", name = "Jade", rarity = "uncommon", colours = { { 90, 170, 120 }, { 160, 220, 180 } }, material = "Glass", pattern = "gradient" },
	{ id = "cobalt", name = "Cobalt", rarity = "uncommon", colours = { { 50, 90, 200 }, { 150, 180, 255 } }, material = "Metal", pattern = "two" },
	{ id = "mint", name = "Mint", rarity = "uncommon", colours = { { 170, 240, 210 }, { 255, 255, 255 } }, material = "SmoothPlastic", pattern = "stripes" },
	{ id = "lavender", name = "Lavender", rarity = "uncommon", colours = { { 190, 160, 230 }, { 240, 220, 255 } }, material = "SmoothPlastic", pattern = "gradient" },
	{ id = "bumblebee", name = "Bumblebee", rarity = "uncommon", colours = { { 255, 210, 50 }, { 40, 36, 40 } }, material = "SmoothPlastic", pattern = "stripes" },
	-- Rare
	{ id = "frost", name = "Frost", rarity = "rare", colours = { { 170, 225, 255 }, { 255, 255, 255 } }, material = "Ice", pattern = "gradient", sparkle = true },
	{ id = "ember", name = "Ember", rarity = "rare", colours = { { 255, 120, 40 }, { 120, 30, 20 } }, material = "Neon", pattern = "gradient" },
	{ id = "ocean", name = "Ocean", rarity = "rare", colours = { { 40, 120, 200 }, { 120, 230, 240 } }, material = "Glass", pattern = "gradient" },
	{ id = "sakura", name = "Sakura", rarity = "rare", colours = { { 255, 190, 210 }, { 255, 240, 245 } }, material = "SmoothPlastic", pattern = "stripes", sparkle = true },
	{ id = "zebra", name = "Zebra", rarity = "rare", colours = { { 245, 245, 245 }, { 30, 30, 30 } }, material = "SmoothPlastic", pattern = "stripes" },
	{ id = "toxic", name = "Toxic", rarity = "rare", colours = { { 120, 255, 80 }, { 40, 80, 30 } }, material = "Neon", pattern = "two" },
	-- Epic
	{ id = "midnight", name = "Midnight", rarity = "epic", colours = { { 50, 40, 110 }, { 140, 120, 255 } }, material = "Neon", pattern = "gradient", sparkle = true },
	{ id = "aurora", name = "Aurora", rarity = "epic", colours = { { 80, 255, 180 }, { 160, 90, 255 } }, material = "Neon", pattern = "gradient" },
	{ id = "lava", name = "Lava", rarity = "epic", colours = { { 255, 80, 20 }, { 40, 20, 20 } }, material = "Neon", pattern = "stripes" },
	{ id = "candycane", name = "Candy Cane", rarity = "epic", colours = { { 230, 40, 50 }, { 255, 255, 255 } }, material = "SmoothPlastic", pattern = "stripes" },
	{ id = "galaxy", name = "Galaxy", rarity = "epic", colours = { { 40, 20, 80 }, { 230, 120, 255 } }, material = "Neon", pattern = "gradient", sparkle = true },
	-- Legendary
	{ id = "golden", name = "Golden", rarity = "legendary", colours = { { 255, 205, 70 }, { 255, 240, 170 } }, material = "Metal", pattern = "two", glow = true, sparkle = true },
	{ id = "diamond", name = "Diamond", rarity = "legendary", colours = { { 220, 245, 255 }, { 255, 255, 255 } }, material = "Glass", pattern = "solid", sparkle = true },
	{ id = "phoenix", name = "Phoenix", rarity = "legendary", colours = { { 255, 200, 60 }, { 255, 60, 30 } }, material = "Neon", pattern = "gradient", sparkle = true },
	{ id = "rainbow", name = "Rainbow", rarity = "legendary", colours = { { 255, 255, 255 }, { 255, 255, 255 } }, material = "Neon", pattern = "rainbow" },
	-- Mythic
	{ id = "starlight", name = "Starlight", rarity = "mythic", colours = { { 255, 255, 255 }, { 180, 220, 255 } }, material = "Neon", pattern = "gradient", glow = true, sparkle = true },
	{ id = "prism", name = "Prism", rarity = "mythic", colours = { { 255, 255, 255 }, { 255, 255, 255 } }, material = "Glass", pattern = "rainbow", glow = true, sparkle = true },
}

local byType, bySkin, byRarity = {}, {}, {}
for _, t in ipairs(Needles.types) do
	byType[t.id] = t
end
for _, s in ipairs(Needles.skins) do
	bySkin[s.id] = s
end
for _, r in ipairs(Needles.rarities) do
	byRarity[r.id] = r
end
function Needles.type(id)
	return byType[id]
end

function Needles.skin(id)
	return bySkin[id]
end

function Needles.rarity(id)
	return byRarity[id]
end

-- "darning:ember" for a type and a skin (how a collection saves them), and back.
function Needles.key(typeId, skinId)
	return typeId .. ":" .. skinId
end

function Needles.split(key)
	local t, s = string.match(key or "", "^(%w+):(%w+)$")
	if byType[t] and bySkin[s] then
		return t, s
	end
	return nil, nil
end

function Needles.name(typeId, skinId)
	return bySkin[skinId].name .. " " .. byType[typeId].name
end

function Needles.value(typeId, skinId)
	return byType[typeId].value * byRarity[bySkin[skinId].rarity].mult
end

-- A collection's total value: each different needle once.
function Needles.total(collection)
	local sum = 0
	for key in pairs(collection) do
		local t, s = Needles.split(key)
		if t then
			sum += Needles.value(t, s)
		end
	end
	return sum
end

local function pick(list, weightOf, rng)
	local total = 0
	for _, row in ipairs(list) do
		total += weightOf(row)
	end
	local roll = rng:NextNumber() * total
	for _, row in ipairs(list) do
		roll -= weightOf(row)
		if roll <= 0 then
			return row
		end
	end
	return list[#list]
end

-- Which needle a find turns out to be. luck (1 = normal) multiplies the chance of every rarity
-- above Common; golden = the Golden Needle event, which is always a Golden skin.
function Needles.roll(rng, luck, golden)
	local t = pick(Needles.types, function(row)
		return row.weight
	end, rng)
	if golden then
		return t.id, "golden"
	end
	local rarity = pick(Needles.rarities, function(row)
		return if row.id == "common" then row.weight else row.weight * luck
	end, rng)
	local skins = {}
	for _, s in ipairs(Needles.skins) do
		if s.rarity == rarity.id then
			table.insert(skins, s)
		end
	end
	return t.id, skins[rng:NextInteger(1, #skins)].id
end

return Needles
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00007">
				<Properties>
					<string name="Name">Quests</string>
					<ProtectedString name="Source"><![CDATA[-- Daily quests: every day (UTC) everyone gets the same three, picked from this pool, so the
-- lobby's Daily Challenge board can show them. Add a quest by adding a line.
--   kind: what counts (server/QuestManager records these)
--     find      a needle you found            win     a round you won (1st)
--     play      a round you were in at the end fast    a find in under `under` seconds
--     hard      a Hard round you were in at the end    golden  a Golden Needle you found
--     collect   a needle new to your collection        rare    a Rare (or better) needle found
--   n: how many. Rewards: coins, xp, and sometimes a cosmetic (Cosmetics id).
local Quests = {}

Quests.pool = {
	{ id = "find5", kind = "find", n = 5, text = "Find 5 needles", coins = 150, xp = 200 },
	{ id = "find3", kind = "find", n = 3, text = "Find 3 needles", coins = 90, xp = 120 },
	{ id = "win2", kind = "win", n = 2, text = "Win 2 rounds", coins = 160, xp = 220 },
	{ id = "win1", kind = "win", n = 1, text = "Win a round", coins = 80, xp = 110 },
	{ id = "play10", kind = "play", n = 10, text = "Play 10 rounds", coins = 120, xp = 180 },
	{ id = "play5", kind = "play", n = 5, text = "Play 5 rounds", coins = 60, xp = 90 },
	{ id = "fast60", kind = "fast", n = 1, under = 60, text = "Find a needle in under 60 seconds", coins = 120, xp = 160, cosmetic = "ti_eagle" },
	{ id = "fast30", kind = "fast", n = 1, under = 30, text = "Find a needle in under 30 seconds", coins = 200, xp = 260 },
	{ id = "hard1", kind = "hard", n = 1, text = "Complete a Hard round", coins = 100, xp = 150 },
	{ id = "golden1", kind = "golden", n = 1, text = "Find a Golden Needle", coins = 300, xp = 400 },
	{ id = "finder10", kind = "find", n = 10, text = "Find 10 needles", coins = 260, xp = 350, cosmetic = "ti_finder" },
	{ id = "collect3", kind = "collect", n = 3, text = "Add 3 new needles to your collection", coins = 140, xp = 180 },
	{ id = "rare1", kind = "rare", n = 1, text = "Find a Rare (or better) needle", coins = 160, xp = 220 },
}

Quests.perDay = 3

-- Today's day number (UTC).
function Quests.today(now)
	return math.floor((now or os.time()) / 86400)
end

-- The three quests for `day`: a fixed shuffle of the pool seeded by the day, so every server
-- agrees. Golden-needle quests are rarer: they're only picked on every fourth day.
function Quests.forDay(day)
	local rng = Random.new(day * 7919 + 17)
	local pool = {}
	for _, q in ipairs(Quests.pool) do
		if q.kind ~= "golden" or day % 4 == 0 then
			table.insert(pool, q)
		end
	end
	local picked, kinds = {}, {}
	while #picked < Quests.perDay and #pool > 0 do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		if not kinds[q.kind] then -- three different kinds of quest
			kinds[q.kind] = true
			table.insert(picked, q)
		end
	end
	return picked
end

local byId = {}
for _, q in ipairs(Quests.pool) do
	byId[q.id] = q
end

function Quests.get(id)
	return byId[id]
end

return Quests
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00008">
				<Properties>
					<string name="Name">Rules</string>
					<ProtectedString name="Source"><![CDATA[-- The game's arithmetic in one place, shared by the server (which decides) and the client
-- (which only shows): levels, round rewards, and weighted picks. dev/test_rules.py mirrors it.
local Config = require(script.Parent.Config)

local Rules = {}

-- XP needed to go from `level` to the next.
function Rules.xpNeed(level)
	return Config.Levels.xpBase + Config.Levels.xpStep * (level - 1)
end

-- Adds xp to a level/xp pair; returns the new level, the new xp and how many levels it gained.
function Rules.addXp(level, xp, gain)
	xp += gain
	local before = level
	while level < Config.Levels.max and xp >= Rules.xpNeed(level) do
		xp -= Rules.xpNeed(level)
		level += 1
	end
	return level, xp, level - before
end

-- Coins and XP for finding a needle: `place` (1 = first), `elapsed` seconds into a round of
-- `duration`, at difficulty `diff` (a Config.Difficulty row), golden or not, with a win streak.
-- Faster finds pay more: the time bonus falls from 100% to 50% over the round.
function Rules.findReward(place, elapsed, duration, diff, golden, streak, doubleCoins)
	local R = Config.Rewards
	local placeMult = R.place[math.min(place, #R.place)]
	local speed = 0.5 + 0.5 * math.clamp(1 - elapsed / math.max(duration, 1), 0, 1)
	local streakMult = 1 + math.min(R.winStreakMax, R.winStreakStep * math.max(0, streak))
	local mult = placeMult * speed * (diff.coins or 1) * (if golden then R.golden else 1)
	local coins = math.floor(R.findCoins * mult * streakMult * (if doubleCoins then 2 else 1) + 0.5)
	local xp = math.floor(R.findXp * mult + 0.5)
	if place <= 3 then
		coins += R.top3Coins * (if doubleCoins then 2 else 1)
		xp += R.top3Xp
	end
	return coins, xp
end

-- Picks one row from a list of tables with `weight` fields.
function Rules.pick(list, rng)
	local total = 0
	for _, row in ipairs(list) do
		total += row.weight
	end
	local roll = rng:NextNumber() * total
	for _, row in ipairs(list) do
		roll -= row.weight
		if roll <= 0 then
			return row
		end
	end
	return list[#list]
end

-- The ISO-ish week number (weeks since 1970, starting Mondays, UTC): the weekly board's key.
function Rules.week(now)
	return math.floor(((now or os.time()) / 86400 + 3) / 7)
end

-- "1:05" from seconds.
function Rules.clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- "12,345".
function Rules.commas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

return Rules
]]></ProtectedString>
				</Properties>
			</Item>
