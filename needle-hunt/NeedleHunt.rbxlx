		{ "p", 0.074, 0.04, 0.06, -1.59, 0.025, 0, 0, 0, 112.5, { 236, 186, 80 }, "B", 3 }, { "p", 0.074, 0.04, 0.06, -1.625, 0.06, 0, 0, 0, 157.5, { 236, 186, 80 }, "B", 3 },
		{ "p", 0.074, 0.04, 0.06, -1.675, 0.06, 0, 0, 0, -157.5, { 236, 186, 80 }, "B", 3 }, { "p", 0.074, 0.04, 0.06, -1.71, 0.025, 0, 0, 0, -112.5, { 236, 186, 80 }, "B", 3 },
		{ "p", 0.074, 0.04, 0.06, -1.71, -0.025, 0, 0, 0, -67.5, { 236, 186, 80 }, "B", 3 }, { "p", 0.074, 0.04, 0.06, -1.675, -0.06, 0, 0, 0, -22.5, { 236, 186, 80 }, "B", 3 },
