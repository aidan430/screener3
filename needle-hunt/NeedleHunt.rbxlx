<roblox version="4">
	<Item class="ReplicatedStorage" referent="RBX00000">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX00001">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00002">
				<Properties>
					<string name="Name">AimSettings</string>
					<ProtectedString name="Source"><![CDATA[-- The aim settings a player can choose (Config.Aim), and the check every saved value goes through
-- (server/DataManager on load, server/Requests on save): numbers are clamped to their range and
-- step, and shapes and colours must be on the list. Anything else is ignored.
local Config = require(script.Parent.Config)

local AimSettings = {}
local A = Config.Aim

AimSettings.defaults = {
	sensitivity = A.sensitivity[4], fov = A.fov[4], reticleSize = A.reticleSize[4], reticleThickness = A.reticleThickness[4],
	reticleOpacity = A.reticleOpacity[4], reticleOutlineThickness = A.reticleOutlineThickness[4],
	reticle = A.reticles[1], reticleColour = A.colours[1][1], reticleOutline = A.outlines[1],
}
local NUMBERS = { sensitivity = true, fov = true, reticleSize = true, reticleThickness = true, reticleOpacity = true, reticleOutlineThickness = true }

local function listed(list, value, at)
	for _, row in ipairs(list) do
		if (if at then row[at] else row) == value then
			return true
		end
	end
	return false
end

-- The value to keep for `key`, or nil if it isn't an aim setting or the value isn't allowed.
function AimSettings.clean(key, value)
	if NUMBERS[key] then
		local r = A[key]
		if type(value) ~= "number" or value ~= value then
			return nil
		end
		value = math.clamp(value, r[1], r[2])
		return math.floor((value - r[1]) / r[3] + 0.5) * r[3] + r[1]
	elseif key == "reticle" then
		return if type(value) == "string" and listed(A.reticles, value) then value else nil
	elseif key == "reticleOutline" then
		return if type(value) == "string" and listed(A.outlines, value) then value else nil
	elseif key == "reticleColour" then
		return if type(value) == "string" and listed(A.colours, value, 1) then value else nil
	end
	return nil
end

function AimSettings.colour(name)
	for _, row in ipairs(A.colours) do
		if row[1] == name then
			return Color3.fromRGB(row[2], row[3], row[4])
		end
	end
	return Color3.new(1, 1, 1)
end

return AimSettings
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00003">
				<Properties>
					<string name="Name">Boxes</string>
					<ProtectedString name="Source"><![CDATA[-- Boxes (Config.Boxes): what's inside each, the exact odds, and the roll. Shared so the Boxes
-- screen shows the same odds and the same skins the server uses. The server rolls; the reel on
-- your screen only shows the result it was given.
local Config = require(script.Parent.Config)
local Needles = require(script.Parent.Needles)

local Boxes = {}

local byId = {}
for _, box in ipairs(Config.Boxes.list) do
	byId[box.id] = box
end

function Boxes.get(id)
	return byId[id]
end

-- The skins a box can give at a rarity: its series' own, or the regular ones if the series has
-- none at that rarity (and the Hay Box, which has no series, always gives regular ones).
function Boxes.skins(box, rarityId)
	local own, regular = {}, {}
	for _, s in ipairs(Needles.skins) do
		if s.rarity == rarityId then
			if box.series and s.series == box.series then
				table.insert(own, s)
			elseif not s.series then
				table.insert(regular, s)
			end
		end
	end
	return if #own > 0 then own else regular
end

-- Each rarity's chance in percent, in rarity order (the odds shown before opening).
function Boxes.odds(box)
	local total = 0
	for _, r in ipairs(Needles.rarities) do
		total += box.odds[r.id] or 0
	end
	local out = {}
	for _, r in ipairs(Needles.rarities) do
		local w = box.odds[r.id] or 0
		if w > 0 then
			table.insert(out, { rarity = r, percent = w / total * 100 })
		end
	end
	return out
end

-- A tiered box (box.tiers, the Heirloom Box): each tier's chance and what it holds, for the odds
-- shown before opening. A grade tier lists its shapes, each with its own chance in the box.
function Boxes.tiers(box)
	local out = {}
	for _, tier in ipairs(box.tiers or {}) do
		local row = { tier = tier, percent = tier.percent, shapes = {} }
		if tier.grade then
			row.grade = Needles.grade(tier.grade)
			local total = 0
			for _, t in ipairs(Needles.types) do
				total += if t.grade == tier.grade then t.weight else 0
			end
			for _, t in ipairs(Needles.types) do
				if t.grade == tier.grade then
					table.insert(row.shapes, { type = t, percent = tier.percent * t.weight / total })
				end
			end
		else
			row.rarity = Needles.rarity(tier.rarity)
		end
		table.insert(out, row)
	end
	return out
end

local function skinRoll(box, rarityId, rng, pityHit)
	local rareMult = Needles.rarity("rare").mult
	local rarity = rarityId and Needles.rarity(rarityId) or Needles.pick(Needles.rarities, function(r)
		local w = box.odds[r.id] or 0
		return if pityHit and r.mult < rareMult then 0 else w
	end, rng)
	local skins = Boxes.skins(box, rarity.id)
	return skins[rng:NextInteger(1, #skins)].id
end

-- Rolls a box. pityHit = this open is guaranteed Rare or better (Config.Boxes.pity). Returns
-- typeId, skinId, and for a tiered box how likely that pull was (percent, for announcements).
function Boxes.roll(box, rng, pityHit)
	if box.tiers then
		local row = Needles.pick(Boxes.tiers(box), function(r)
			return r.percent
		end, rng)
		if row.grade then
			local pick = Needles.pick(row.shapes, function(sh)
				return sh.percent
			end, rng)
			return pick.type.id, skinRoll(box, nil, rng, pityHit), pick.percent
		end
		local t = Needles.pick(Needles.types, function(r)
			return r.weight
		end, rng)
		return t.id, skinRoll(box, row.rarity.id, rng, pityHit), row.percent
	end
	local t = Needles.pick(Needles.types, function(row)
		return row.weight
	end, rng)
	return t.id, skinRoll(box, nil, rng, pityHit)
end

-- A filler card for the reel (looks only), by the same odds.
function Boxes.filler(box, rng)
	return Boxes.roll(box, rng, false)
end

return Boxes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00004">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- Every tunable number for A Needle in a Haystack. Change values here; nothing else needs to
-- change. Maps, cosmetics and quests have their own data modules (Maps, Cosmetics, Quests).
local Config = {}

-- Rounds (server/RoundManager). Seconds.
Config.Round = {
	loadCountdown = 3, -- 3, 2, 1 in the map before the round starts
	duration = 180, -- a normal round (a map can set its own: Hayfield Farm's is 300)
	onlyMap = "bigfarm", -- play just this map (shared/Maps); nil = all of them in turn
	speedDuration = 90, -- a Speed Round
	grace = 15, -- once the last chest is open, this long to finish fights before the results
	results = 10, -- the results screen
	minPlayers = 1, -- 1 = a solo player still gets (practice) rounds
	maxPlayers = 10, -- players on one map (set the place's Max Players to 10 in Game Settings too)
	winsNeedPlayers = 2, -- a win counts towards wins and weekly winners only with this many playing
}

-- Difficulty: picked each round by weight. clutter = loose straws scattered round the map; dim =
-- how much darker the light is; moving = tumbling hay bundles that drift about; coins = times
-- the coins in every chest and the place coins.
Config.Difficulty = {
	{ id = "easy", name = "Easy", weight = 30, clutter = 160, dim = 0, moving = 0, coins = 1.0 },
	{ id = "normal", name = "Normal", weight = 50, clutter = 260, dim = 0, moving = 0, coins = 1.25 },
	{ id = "hard", name = "Hard", weight = 20, clutter = 380, dim = 0.35, moving = 4, coins = 1.6 },
}

-- Modifiers: a round gets one with this chance (then by weight). The Golden Chest is a
-- separate, rarer roll on top.
Config.ModifierChance = 0.35
Config.Modifiers = {
	{ id = "speed", name = "Speed Round", text = "Half the time!", weight = 35 },
	{ id = "lowlight", name = "Low Light", text = "The lights are low", weight = 30 },
	{ id = "powers", name = "Power Round", text = "Every chest holds a power-up", weight = 15 },
	{ id = "brawl", name = "Brawl", text = "Tag-outs pay double", weight = 20 },
}
Config.GoldenChance = 0.08 -- one chest is a Golden Chest: big coins and a power-up

-- Chests (server/ChestSpawner): `count` on every map, worth fighting for. They go in the dead ends
-- furthest from where players start, at least `spread` studs apart, each up on a perch `perch`
-- studs high (min, max; never above the maze's walls) reached by jumping up a few steps; a Golden
-- Chest stands on the tallest perch in the middle of a clearing. You must be up on the perch,
-- within `reach`, and hold E for `hold` seconds; a poke or a throw stops you, and for `hitLock`
-- seconds after a hit you can't open one. Inside, never a needle: a power-up (one of
-- Config.Powerups' kinds, used at once) with `powerupChance`, otherwise `coins` (min, max; times
-- the difficulty's coins). The Golden Chest holds `goldenCoins` and a power-up. `keys` are the box
-- keys players already have from before (chests no longer hold them; the Boxes screen still opens
-- one with each).
Config.Chests = {
	count = 5, spread = 30, hold = 3, reach = 8, hitLock = 1.5, perch = { 4.5, 8 }, goldenPerch = 9.5,
	powerupChance = 0.4, coins = { 30, 90 }, goldenCoins = { 200, 300 },
	keys = {
		{ id = "hay", name = "Hay Key", weight = 70 },
		{ id = "harvest", name = "Harvest Key", weight = 25 },
		{ id = "starlight", name = "Starlight Key", weight = 5 },
	},
}

-- The 1 of 1s (server/OneOfOne): paper-thin, nearly invisible Sewing Needles, one of each in the
-- whole game. Every box opened (coins, a key or Robux: server/BoxManager) has each one's `chance` of
-- holding it, shown with the box's odds, but only one can ever exist: the first to open it claims it
-- (`record`) in a DataStore shared by every server (Studio uses its own store, so testing never
-- claims the real ones). Thrown, any of them takes `throwDamage` hearts: an instant tag-out. Chests
-- never hold one. Found: announced on every server.
Config.OneOfOne = { store = "NH_OneOfOne_v1", throwDamage = 3, list = {
	{ key = "sewing:gossamer", chance = 1 / 12000000, record = "owner", odds = "1 in 12,000,000" }, -- the rarer is rolled first
	{ key = "sewing:galaxygossamer", chance = 1 / 5000000, record = "galaxy", odds = "1 in 5,000,000" },
} }

-- Places at the end of a round: by chests opened, then tag-outs, then coins collected. Places
-- pay coins (placeCoins, 1st to 4th, the rest get the last; times the difficulty's coins).

-- Haystacks (MapKit.haystack): smooth, lumpy terrain domes in `material`, recoloured `colour`
-- (the arena's terrain is cleared between rounds). model = the owner's haystack model's asset ID
-- (server/HaystackModel; saved to Roblox from Studio): when it loads, every haystack uses it.
-- The textures uploaded with that model, for reference (the saved model carries them itself):
--   material0: 139923378561945, 82802973824193, 131881570420382, 134403754765000
--   material1: 125383755787779, 83696294561694, 117010844111225, 87942777253086
Config.Haystacks = { material = "Sand", colour = { 226, 186, 88 }, model = 0 }

-- Anti-exploit (server/AntiCheat).
-- Testing (Roblox Studio only, never in a live game): revealChests = true outlines the chests
-- through walls, so you can test opening them.
Config.Testing = { revealChests = false }

-- Power-ups (server/Powerups): `count` glowing pickups float in the maze's corridors each round;
-- walk into one to take it, and another appears somewhere else `respawn` seconds later. Only
-- helpful ones (nothing slows or blinds anyone else), picked by weight. icon = shown on the orb.
--   speed: walk at `walkSpeed` for `seconds`     compass: an arrow to the nearest unopened chest
--   birdseye: a look down from above the maze    glint: unopened chests within `range` sparkle
--   coins: a pouch of coins (doubled with 2x Coins) and a little XP
-- image = the uploaded icon's asset ID (assets/powerups/<id>.png: Studio > Asset Manager > Images,
-- or Creator Dashboard > Decals; copy its ID here). 0 = show the `icon` glyph instead.
Config.Powerups = { count = 8, respawn = 20, kinds = {
	{ id = "speed", name = "Hay Boots", icon = "»", image = 78113734507119, colour = { 110, 190, 70 }, weight = 30, seconds = 12, walkSpeed = 26 },
	{ id = "compass", name = "Compass", icon = "▲", image = 90767287093904, colour = { 240, 130, 40 }, weight = 20, seconds = 6 },
	{ id = "birdseye", name = "Bird's Eye", icon = "◉", image = 79032355368145, colour = { 70, 160, 240 }, weight = 15, seconds = 5, height = 55 },
	{ id = "glint", name = "Glint", icon = "✦", image = 127033997986783, colour = { 170, 110, 240 }, weight = 20, seconds = 8, range = 40 },
	{ id = "coins", name = "Coin Pouch", icon = "●", image = 133288309337957, colour = { 255, 205, 70 }, weight = 15, coins = 25, xp = 10 },
} }

-- XP after each match (server/MatchXp), shown as a breakdown on the results screen.
--   place: 1st, 2nd, 3rd, then everyone else (by chests, tag-outs, coins); played: everyone at the end
--   perCoin: for each coin collected in the match; perChest: each chest opened; perElimination
Config.MatchXp = { place = { 120, 90, 70, 50 }, played = 20, perCoin = 0.5, perChest = 40, perElimination = 25 }

-- Tag-out streaks (server/Combat, client/StreakFx): each tag-out in a row without being tagged out
-- yourself raises your multiplier on that tag-out's coins and XP by `step`, up to `max`
-- (1x, 1.5x, 2x, 2.5x, then 3x). Being tagged out, or the round ending, resets it. From `announceAt`
-- in a row everyone in the round hears about it. names = the callout for that streak (and above).
-- marked: at `at` in a row you're Marked (server/Streaks) until you're tagged out or the round ends:
-- a `colour` outline everyone sees through walls, but you walk `speed` x faster.
-- feed = how many lines the tag-out feed shows (client/FeedFx), and for how many seconds.
Config.Streak = { step = 0.5, max = 3, announceAt = 3, names = { "TAGGED OUT!", "DOUBLE TAG!", "TRIPLE TAG!", "UNSTOPPABLE!", "HAYSTACK HERO!" },
	marked = { at = 10, speed = 1.5, colour = { 255, 0, 0 } }, feed = { lines = 5, seconds = 7 } }

-- Needle combat (server/Combat, client/CombatFx): during the search everyone carries their
-- showcase needle and can poke others. Three pokes and you're tagged out: you pop back at a maze
-- start after `respawn` seconds, with `safe` seconds when nobody can poke you. Hearts come back one
-- every `regen` seconds. Every skin pokes the same (looks only). reach is in studs.
Config.Combat = { hearts = 3, regen = 8, cooldown = 0.7, reach = 8, respawn = 5, safe = 3, eliminationCoins = 10 }
-- Throwing your needle (Q, or the Throw button): it flies straight where you aim at `speed`
-- studs a second, up to `range`; walls stop it. A hit takes `damage` hearts. Your needle is out of
-- your hand (no pokes) until it comes back, `back` seconds after the throw; `cooldown` between throws.
Config.Throw = { damage = 2, range = 45, speed = 90, radius = 1.2, back = 1.2, cooldown = 4 }
-- Dashing (C, B on a controller, or the Dash button): a quick burst along the way you're moving
-- (or facing) at `speed` studs a second for `seconds`, then `cooldown` before the next. Kept well
-- under Config.AntiCheat.maxSpeed, so a dash never looks like cheating.
Config.Dash = { speed = 55, seconds = 0.22, cooldown = 3 }
-- How the Needle tool sits in the hand, in degrees (X, Y, Z), as CFrame.Angles: { 0, 180, 90 } turns
-- the needle's length (its +X, point at the end) to the grip's up, so it points out of the hand the
-- way a sword does. Turn it here if it points the wrong way in Studio. scale = the needle's size in the hand. (How long the inspect lasts comes from the
-- first-person rig, shared/FirstPerson: anims.inspect.length.)
-- Classic studs (server/MapKit): parts with these names (floors, walls, platforms) are made plain
-- Plastic with studs on top and inlets underneath (Roblox draws studs on Plastic only). Parts in a
-- `keep` material (see-through glass and ice) stay as they are. Props keep their own materials.
-- Off while the maps go for a realistic look (studs need plain Plastic); `on = true` brings them back.
Config.Studs = { on = false, names = { "Ground", "Countryside", "Road", "Plaza", "Path", "PadPaving", "PadRim", "Deck", "StartPad", "MazeWall", "Hedge", "Wall", "Perch", "Step", "Climb", "Shelf" }, keep = { "Glass", "Ice" } }

Config.NeedleTool = { grip = { 0, 180, 90 }, scale = 1.6 }

-- The Heirloom aura (shared/NeedleAura): energy round every Heirloom-shaped needle, in its skin's
-- colours. shell = a shimmering ForceField skin round every piece (shellGrow x its size + shellPad
-- studs at scale 1); wisps and
-- sparks = particles a second; rise = how fast wisps float up; lift = how much the colours are
-- brightened towards white (so dark skins glow too); light = the glow's brightness and range.
-- gradient = the aura's own colours, from the eye end to the point (remove it to use the skin's).
Config.Aura = { gradient = { { 70, 0, 0 }, { 190, 0, 0 } }, shell = true, shellGrow = 1.14, shellPad = 0.07, wisps = 16, wispSize = 0.45, sparks = 10, rise = 1.8, lift = 0.12, light = 2.2, lightRange = 8 }

-- Boxes (server/BoxManager, client/BoxScreen): open one for a needle for your collection. odds are
-- each rarity's chance in percent (shown in the game before you open one). series = the box's own
-- skins (Needles.skins with that series); a rarity the series doesn't have comes from the regular
-- skins. product = the Config.Products name that opens it for Robux (nil = coins only). pity:
-- every this many opens without Rare or better, the next is Rare or better (also shown). Keys from
-- chests open a box free. announceAt: a needle whose rarity had this % chance or less in its box
-- is announced to the whole server.
Config.Boxes = { pity = 10, announceAt = 0.5, list = {
	{ id = "hay", name = "Hay Box", coins = 400, colour = { 226, 186, 88 }, odds = { common = 60, uncommon = 25, rare = 10, epic = 4, legendary = 0.9, mythic = 0.1 } },
	{ id = "harvest", name = "Harvest Box", coins = 1500, product = "HarvestBox", series = "harvest", colour = { 230, 120, 50 }, odds = { common = 40, uncommon = 30, rare = 18, epic = 8, legendary = 3.5, mythic = 0.5 } },
	{ id = "starlight", name = "Starlight Box", coins = 5000, product = "StarlightBox", series = "starlight", colour = { 120, 110, 240 }, odds = { common = 0, uncommon = 45, rare = 30, epic = 16, legendary = 7, mythic = 2 } },
	-- tiers: the box first picks a tier by percent. A grade tier gives a shape of that grade
	-- (by the shapes' own weights) in a skin rolled by `odds`; a rarity tier gives a skin of that
	-- rarity on any shape (by the usual shape odds). Every tier, and every Heirloom shape's own
	-- chance, is shown before opening. Robux price: 1,000 (set on the HeirloomBox product).
	{ id = "heirloom", name = "Heirloom Box", coins = 100000, product = "HeirloomBox", colour = { 230, 160, 110 }, odds = { uncommon = 45, rare = 30, epic = 16, legendary = 7, mythic = 2 },
		tiers = { { grade = "heirloom", percent = 10 }, { rarity = "mythic", percent = 40 }, { grade = "exotic", percent = 50 } } },
} }

-- Trading (server/TradeManager, client/TradeScreen): in the lobby, two players swap needles.
-- Both must press Ready; any change un-readies both; then a `countdown` before it happens.
Config.Trading = { maxItems = 6, countdown = 5, requestCooldown = 10 }

Config.AntiCheat = {
	checkEvery = 0.5, -- seconds between movement checks
	maxSpeed = 70, -- studs a second a character may move (walking, jumping, falling) outside a teleport
	strikesToKick = 0, -- 0 = never kick; just put them back where they were
	fallY = -40, -- below this height (a fall off a map) a character respawns
}

-- Rewards (server/RewardManager). Coins and XP.
Config.Rewards = {
	placeCoins = { 60, 40, 25, 10 }, -- 1st, 2nd, 3rd, the rest (who opened a chest or tagged someone)
	playCoins = 5, -- for being there at the end of a round
	winStreakStep = 0.1, winStreakMax = 0.5, -- +10% place coins per win in a row, up to +50%
	loginCoins = 25, loginStreakMax = 7, -- daily login: 25 x streak day, up to day 7
}

-- Levels: level L needs xpBase + xpStep x (L - 1) XP.
Config.Levels = { xpBase = 100, xpStep = 25, max = 500 }

-- Hints: a free hint a day (two with the Extra Hint pass). A hint says roughly where the nearest
-- unopened chest is: its direction and how far.
Config.Hints = { free = 1, pass = 1, nearStuds = 15, farStuds = 45 }

-- Saving (server/DataManager). Change DataStoreName to start everyone afresh.
Config.DataStoreName = "NeedleHunt_v1"
Config.AutosaveSeconds = 60
Config.LoadRetries = 3

-- Leaderboards (server/LeaderboardManager): OrderedDataStore names. weekly gets the week
-- number added. Writes are batched every flushSeconds; boards re-read every readSeconds.
Config.Boards = {
	{ id = "chests", name = "Most Chests Opened", store = "NH_Chests_v1", ascending = false },
	{ id = "tagouts", name = "Most Tag-outs", store = "NH_TagOuts_v1", ascending = false },
	{ id = "level", name = "Highest Level", store = "NH_Level_v1", ascending = false },
	{ id = "coins", name = "Most Coins Earned", store = "NH_Coins_v1", ascending = false },
	{ id = "weekly", name = "This Week's Winners", store = "NH_WeeklyWins_v1_", ascending = false, weekly = true },
	{ id = "collection", name = "Most Valuable Collection", store = "NH_Collection_v1", ascending = false },
	{ id = "trial", name = "Fastest Time Trial", store = "NH_TimeTrial_v1", ascending = true, seconds = true }, -- stored in tenths
}
Config.BoardRows = 10
Config.BoardFlushSeconds = 120
Config.BoardReadSeconds = 180

-- Robux (server/ShopManager, shared/Robux for what the shop says). 0 = not on sale yet: create the
-- pass or product on the Creator Dashboard (README: Selling with Robux), then put its ID here.
-- The only random things Robux can buy are boxes (Config.Boxes: odds always shown, hidden where
-- paid random items are restricted). Robux never buys a power-up, a hint mid-round or combat power.
Config.GamePasses = { DoubleCoins = 0, ExtraHint = 0, Supporter = 0, GrandBooth = 0 }
Config.Products = { StarterBundle = 0, CoinsSmall = 0, CoinsMedium = 0, CoinsLarge = 0, CoinShower = 0, HarvestBox = 0, StarlightBox = 0, HeirloomBox = 0 }
Config.CoinPacks = { CoinsSmall = 500, CoinsMedium = 1500, CoinsLarge = 4000 } -- coins each pack gives
Config.CoinShower = { coins = 100 } -- every player in the server gets this, the buyer too
Config.GrandBooth = { needles = 6 } -- needles on show at a Grand Booth (3 otherwise)
Config.StarterBundle = { coins = 500, cosmetic = "t_sparkle" } -- what the Starter Bundle gives (never a collectible needle)

-- Sounds: Roblox's built-in sounds; swap in your own Toolbox IDs ("rbxassetid://...").
Config.Sounds = {
	found = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/button.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
	countdown = "rbxasset://sounds/clickfast.wav",
}
Config.Music = "" -- a looping lobby track ID, or "" for none

-- Where things are. The lobby sits at the origin; maps are built far away, one at a time.
Config.LobbyCentre = Vector3.new(0, 0, 0)
Config.ArenaCentre = Vector3.new(0, 0, 600)

-- The game platforms in the lobby (server/GamePads): `count` of them, each for a game of up to
-- `size` players. Stand on one to join (PLAY takes you to the fullest). At `size` it starts after
-- `fullCountdown` seconds; with at least `minPlayers` (`studioMinPlayers` in Studio) a `countdown`
-- starts and the game goes with whoever is on it. A game gets its own server (a private server of
-- this place, server/GameServer), plays one round and sends everyone back to the lobby. In Studio,
-- where teleports don't work, the round is played in this server instead. Each is `radius` studs
-- across the middle, `spacing` apart in a row at z = `z`. `portal`: the column's height, its slow
-- breath (seconds), sparks a second when empty and when full, its light's range, and the size in studs of the
-- board above it (game, count, status).
Config.Pads = { count = 4, size = 10, minPlayers = 2, studioMinPlayers = 1, countdown = 60, fullCountdown = 5, radius = 9, spacing = 22, z = 8,
	portal = { height = 9, breathe = 2.5, rate = 12, fullRate = 45, light = 20, boardWidth = 6, boardHeight = 3.2 },
	colours = { { 255, 206, 80 }, { 110, 200, 120 }, { 90, 160, 240 }, { 230, 120, 170 } } }

-- A game's own server (server/GameServer): it waits up to `wait` seconds for the players a platform
-- sent, plays one round, then `afterRound` seconds later sends everyone back to the lobby.
Config.GameServer = { wait = 20, afterRound = 2 }

-- The Practice Yard's Time Trial (server/Practice, server/PracticeYard, client/PracticeFx): your own
-- yard of straw dummies and chests on perches. A countdown, then `seconds` to tag out every dummy
-- and open every chest. Practice only: no coins, XP or keys, but a full clear goes on the Fastest
-- Time Trial board. Dummies have `hearts` (a poke takes 1, a throw Config.Throw.damage); `moving`
-- of them slide to and fro. Chests sit `perch` studs up and open with Config.Chests.hold. Each
-- player's yard is built at centre + (slot - 1) x spacing on Z, and gone when they leave.
-- Aim settings each player picks (Settings, Aim; shared/AimSettings checks them, client/Aim applies
-- them): mouse sensitivity, field of view, the reticle's size (x its normal size) and thickness (its
-- lines, in pixels), opacity (1 = solid) and outline thickness (pixels) as { min, max, step,
-- default }; the reticle's shape (none hides it), colour and outline colour (none for no outline).
Config.Aim = {
	sensitivity = { 0.2, 3, 0.1, 1 },
	fov = { 60, 100, 5, 70 },
	reticleSize = { 0.5, 2.5, 0.1, 1 },
	reticleThickness = { 1, 6, 1, 2 },
	reticleOpacity = { 0.2, 1, 0.1, 1 },
	reticleOutlineThickness = { 1, 3, 1, 1 },
	outlines = { "black", "white", "none" },
	reticles = { "crossdot", "dot", "cross", "circle", "none" },
	colours = { { "white", 255, 255, 255 }, { "red", 235, 40, 45 }, { "yellow", 255, 214, 60 }, { "green", 80, 230, 110 }, { "cyan", 70, 220, 240 }, { "pink", 255, 110, 200 } },
}

Config.Practice = { seconds = 180, countdown = 3, dummies = 8, moving = 3, hearts = 3, chests = 5, perch = { 3.5, 7 },
	size = 100, centre = Vector3.new(-700, 0, 0), spacing = 180, backAfter = 10 }

Config.Look = require(script.Parent.ConfigLook) -- the sun, sky, haze and wind presets

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00005">
				<Properties>
					<string name="Name">ConfigLook</string>
					<ProtectedString name="Source"><![CDATA[-- The look of the world (server/Look): the sun, sky, haze, clouds, glow, colour grade and wind for
-- each kind of map, as presets. A map names one in shared/Maps (`look = "harvest"`); the lobby uses
-- Maps.lobbyLook. Config.luau merges this in as Config.Look. Colours are { r, g, b }.
-- These are starting points chosen on paper: tune them in Studio (Play, graphics level at maximum).
--
-- The place file (default.project.json) sets what scripts cannot: realistic lighting, the modern
-- materials and 3D grass on terrain. Look only warns if that didn't load.
local Look = {}

-- sunElevation (degrees above the horizon): if given, Look picks the clock time between Sun.from
-- and Sun.to whose sun is nearest that height (a low sun would black out the maze corridors).
Look.Sun = { from = 12.5, to = 17.5, step = 0.05 }

-- A darker round (the difficulty's dim, plus a Low Light round): per 1.0 of dim, exposure drops by
-- `exposure`, both ambients lose `ambient` of themselves, the haze thickens by `density`, colour
-- fades by `saturation` and the tint moves `tint` of the way to `tintTo`.
Look.Dim = { exposure = 1.6, ambient = 0.5, density = 0.1, saturation = 0.15, tint = 0.5, tintTo = { 200, 214, 255 } }

-- The wind gusts: every `every` seconds (a random time between the two) it is the preset's wind
-- times a random amount between `strength`'s two numbers. It moves grass, clouds and particles.
Look.Gust = { every = { 6, 10 }, strength = { 0.7, 1.3 } }

Look.Sky = { SunAngularSize = 14, MoonAngularSize = 9, StarCount = 3000 }

local function preset(t)
	return t
end

Look.presets = {
	harvest = preset({ ClockTime = 15, sunElevation = 36, Brightness = 3, ExposureCompensation = 0.05, ShadowSoftness = 0.2,
		Ambient = { 58, 54, 62 }, OutdoorAmbient = { 108, 104, 116 }, ColorShift_Top = { 52, 32, 10 },
		atmosphere = { Density = 0.3, Offset = 0.25, Haze = 1.5, Glare = 0.3, Color = { 228, 198, 148 }, Decay = { 116, 104, 120 } },
		clouds = { Cover = 0.52, Density = 0.35, Color = { 255, 240, 222 } },
		bloom = { Intensity = 0.6, Size = 28, Threshold = 1.7 },
		grade = { Contrast = 0.12, Saturation = 0.08, TintColor = { 255, 245, 232 } },
		sunRays = { Intensity = 0.1, Spread = 0.6 }, wind = { 9, 0, 4 } }),
	gold = preset({ ClockTime = 16.2, Brightness = 3, ExposureCompensation = 0.1, ShadowSoftness = 0.25,
		Ambient = { 58, 52, 62 }, OutdoorAmbient = { 104, 98, 112 }, ColorShift_Top = { 60, 38, 12 },
		atmosphere = { Density = 0.3, Offset = 0.25, Haze = 1.6, Glare = 0.35, Color = { 232, 196, 140 }, Decay = { 120, 98, 110 } },
		clouds = { Cover = 0.55, Density = 0.35, Color = { 255, 236, 214 } },
		bloom = { Intensity = 0.8, Size = 28, Threshold = 1.8 },
		grade = { Contrast = 0.12, Saturation = 0.1, TintColor = { 255, 244, 230 } },
		sunRays = { Intensity = 0.12, Spread = 0.6 }, wind = { 9, 0, 4 } }),
	noon = preset({ ClockTime = 13.5, Brightness = 3, ExposureCompensation = 0, ShadowSoftness = 0.15,
		Ambient = { 60, 62, 66 }, OutdoorAmbient = { 95, 100, 108 }, ColorShift_Top = { 12, 8, 0 },
		atmosphere = { Density = 0.28, Offset = 0.25, Haze = 0.6, Glare = 0.1, Color = { 199, 206, 214 }, Decay = { 106, 112, 125 } },
		clouds = { Cover = 0.5, Density = 0.3, Color = { 255, 255, 255 } },
		bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
		grade = { Contrast = 0.08, Saturation = 0.05, TintColor = { 255, 255, 255 } },
		sunRays = { Intensity = 0.05, Spread = 0.4 }, wind = { 6, 0, 3 } }),
	overcast = preset({ ClockTime = 12.5, Brightness = 1.3, ExposureCompensation = 0.25, ShadowSoftness = 1,
		Ambient = { 96, 100, 106 }, OutdoorAmbient = { 150, 154, 160 }, ColorShift_Top = { 0, 0, 0 },
		atmosphere = { Density = 0.42, Offset = 0.1, Haze = 2.4, Glare = 0, Color = { 190, 196, 204 }, Decay = { 120, 126, 134 } },
		clouds = { Cover = 0.92, Density = 0.55, Color = { 200, 204, 210 } },
		bloom = { Intensity = 0.3, Size = 24, Threshold = 2 },
		grade = { Contrast = 0.05, Saturation = -0.12, TintColor = { 236, 242, 255 } },
		wind = { 12, 0, 5 } }),
	dusk = preset({ ClockTime = 17.5, Brightness = 2.4, ExposureCompensation = 0.25, ShadowSoftness = 0.4,
		Ambient = { 70, 54, 66 }, OutdoorAmbient = { 124, 96, 104 }, ColorShift_Top = { 110, 56, 18 },
		atmosphere = { Density = 0.36, Offset = 0.3, Haze = 2.2, Glare = 0.8, Color = { 250, 170, 120 }, Decay = { 96, 70, 120 } },
		clouds = { Cover = 0.6, Density = 0.4, Color = { 255, 190, 150 } },
		bloom = { Intensity = 0.9, Size = 32, Threshold = 1.6 },
		grade = { Contrast = 0.14, Saturation = 0.14, TintColor = { 255, 232, 214 } },
		sunRays = { Intensity = 0.2, Spread = 0.7 }, wind = { 5, 0, 2 } }),
	night = preset({ ClockTime = 0.5, Brightness = 1.6, ExposureCompensation = 0.6, ShadowSoftness = 0.5,
		Ambient = { 38, 46, 72 }, OutdoorAmbient = { 64, 76, 112 }, ColorShift_Top = { 0, 8, 30 },
		atmosphere = { Density = 0.42, Offset = 0.1, Haze = 1.2, Glare = 0, Color = { 60, 74, 110 }, Decay = { 20, 26, 44 } },
		clouds = { Cover = 0.35, Density = 0.3, Color = { 120, 130, 160 } },
		bloom = { Intensity = 1, Size = 30, Threshold = 1.2 },
		grade = { Contrast = 0.1, Saturation = -0.1, TintColor = { 214, 226, 255 } },
		wind = { 3, 0, 1 } }),
	interior = preset({ ClockTime = 15, Brightness = 2, ExposureCompensation = 0.4, ShadowSoftness = 0.5,
		Ambient = { 104, 88, 70 }, OutdoorAmbient = { 120, 104, 86 }, ColorShift_Top = { 40, 26, 8 },
		atmosphere = { Density = 0.2, Offset = 0, Haze = 0.8, Glare = 0, Color = { 190, 160, 120 }, Decay = { 90, 76, 60 } },
		clouds = { Cover = 0.4, Density = 0.3, Color = { 255, 255, 255 } },
		bloom = { Intensity = 0.6, Size = 24, Threshold = 1.6 },
		grade = { Contrast = 0.08, Saturation = 0, TintColor = { 255, 240, 220 } },
		wind = { 0, 0, 0 } }),
}

return Look
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00006">
				<Properties>
					<string name="Name">Cosmetics</string>
					<ProtectedString name="Source"><![CDATA[-- Cosmetics for Haystack Coins: looks only, never an advantage. Needles are not sold here: every
-- needle you find is yours to keep (shared/Needles, the collection). Add an item by adding a line.
--   kind: trail | title | effect
--   price: Haystack Coins in the shop (0 = not sold for coins: a starting item, a quest reward
--     or from a Robux pass, named by `source`)
--   colours: { r, g, b } (trail: start, end)
local Cosmetics = {}

Cosmetics.items = {
	-- trails
	{ id = "t_straw", kind = "trail", name = "Straw Trail", price = 700, colours = { { 240, 200, 90 }, { 255, 240, 190 } } },
	{ id = "t_sparkle", kind = "trail", name = "Sparkle Trail", price = 1800, colours = { { 255, 255, 255 }, { 170, 220, 255 } } },
	{ id = "t_meadow", kind = "trail", name = "Meadow Trail", price = 900, colours = { { 120, 200, 90 }, { 230, 250, 180 } } },
	{ id = "t_sunset", kind = "trail", name = "Sunset Trail", price = 1400, colours = { { 255, 140, 70 }, { 255, 90, 140 } } },
	{ id = "t_ocean", kind = "trail", name = "Ocean Trail", price = 2200, colours = { { 60, 150, 230 }, { 150, 240, 230 } } },
	{ id = "t_rainbow", kind = "trail", name = "Rainbow Thread", price = 4000, colours = { { 255, 90, 110 }, { 110, 140, 255 } } },
	{ id = "t_golden", kind = "trail", name = "Golden Thread", price = 6000, colours = { { 255, 214, 90 }, { 255, 250, 220 } } },
	{ id = "t_supporter", kind = "trail", name = "Supporter Trail", price = 0, source = "Supporter pass", colours = { { 255, 200, 80 }, { 255, 120, 60 } } },
	-- titles above your head
	{ id = "ti_finder", kind = "title", name = "Needle Finder", price = 0, source = "quest", colours = { { 220, 225, 235 } } },
	{ id = "ti_eagle", kind = "title", name = "Eagle Eye", price = 0, source = "quest", colours = { { 255, 214, 90 } } },
	{ id = "ti_hero", kind = "title", name = "Haystack Hero", price = 1000, colours = { { 255, 200, 90 } } },
	{ id = "ti_sharp", kind = "title", name = "Sharp Eyes", price = 1500, colours = { { 140, 220, 255 } } },
	{ id = "ti_collector", kind = "title", name = "Needle Collector", price = 2500, colours = { { 200, 150, 255 } } },
	{ id = "ti_legend", kind = "title", name = "Straw Legend", price = 5000, colours = { { 255, 170, 60 } } },
	{ id = "ti_supporter", kind = "title", name = "Supporter", price = 0, source = "Supporter pass", colours = { { 255, 160, 70 } } },
	-- found effects: the burst when you find a needle
	{ id = "e_confetti", kind = "effect", name = "Confetti Pop", price = 0, source = "start", colours = { { 255, 206, 70 }, { 110, 170, 240 } } },
	{ id = "e_stars", kind = "effect", name = "Starburst", price = 1200, colours = { { 255, 250, 220 }, { 255, 214, 90 } } },
	{ id = "e_hay", kind = "effect", name = "Hay Burst", price = 800, colours = { { 240, 200, 90 }, { 200, 150, 70 } } },
	{ id = "e_petals", kind = "effect", name = "Petal Shower", price = 2000, colours = { { 255, 150, 190 }, { 255, 240, 245 } } },
	{ id = "e_fireflies", kind = "effect", name = "Fireflies", price = 3000, colours = { { 220, 255, 120 }, { 255, 230, 120 } } },
}

Cosmetics.kinds = { "trail", "title", "effect" }
Cosmetics.kindNames = { trail = "Trails", title = "Titles", effect = "Found Effects" }
Cosmetics.starting = { "e_confetti" } -- everyone owns these
Cosmetics.defaults = { effect = "e_confetti" } -- and wears these

local byId = {}
for _, item in ipairs(Cosmetics.items) do
	byId[item.id] = item
end

function Cosmetics.get(id)
	return byId[id]
end

return Cosmetics
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00007">
				<Properties>
					<string name="Name">FirstPerson</string>
					<ProtectedString name="Source"><![CDATA[-- The first-person view of your needle (client/ViewModel): the arms and the needle drawn in
-- front of the camera. Made in the Needle Hand Rig artifact; paste a new rig over this file.
-- pos in studs, rot in degrees (CFrame.Angles order). right/left: each arm from the camera;
-- needle: from the right hand. Animation keys are offsets from the hold pose:
-- { t, right = { x, y, z, rx, ry, rz }, left = {...}, needle = {...} }, eased between keys.
return {
	pose = {
		right = { pos = { 1.382, -0.385, -0.759 }, rot = { -148, 62, -122.8 } },
		left = { pos = { -1.382, -1.685, -0.759 }, rot = { -148, -62, 122.8 } },
		needle = { pos = { 0.1, -0.365, -0.045 }, rot = { 0, 0, -30 } },
	},
	arm = { size = { 0.3, 1.5, 0.25 }, sleeve = 0.93, sleeveColour = { 70, 110, 170 } },
	needleLook = { scale = 0.45, fat = 1.3 },
	motion = { bob = 0.045, bobSpeed = 9, sway = 0.08 },
	anims = {
		inspect = { length = 6, keys = {
			{ t = 0, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.7, right = { -0.35, 0.05, 0.25, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 8 } },
			{ t = 2.2, right = { -0.4, 0.08, 0.3, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, -10 } },
			{ t = 3.4, right = { -0.35, 0.06, 0.25, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 10 } },
			{ t = 4, right = { -0.38, 0.08, 0.27, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, -6 } },
			{ t = 4.6, right = { -0.35, 0.05, 0.25, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 6 } },
			{ t = 5.2, right = { -0.35, 0.05, 0.25, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 6, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
		} },
		jab = { length = 0.34, keys = {
			{ t = 0, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.05, right = { 0.07, -0.04, 0.16, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.12, right = { -0.4, 0.23, -0.74, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.18, right = { -0.35, 0.2, -0.64, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.34, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
		} },
		throw = { length = 0.5, keys = {
			{ t = 0, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.14, right = { 0.18, 0.2, 0.5, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.24, right = { -0.3, 0.2, -0.6, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.34, right = { -0.38, 0.1, -0.7, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.5, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
		} },
	},
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00008">
				<Properties>
					<string name="Name">FirstPersonRig</string>
					<ProtectedString name="Source"><![CDATA[-- The rest of the first-person view (client/ViewModel): everything the Needle Hand Rig tool
-- doesn't know. The tool writes shared/FirstPerson.luau (the arms' and the needle's hold pose, the
-- arm's size, the bob and sway amounts, and the inspect, jab and throw); this file is hand-edited
-- data: the wrist, the hand's boxes, the grip rule, the extra motion and the extra animations.
-- Check any change on the preview sheets: node dev/preview/shoot_viewmodel.js (see its header).
--
-- Studs and degrees. Camera space: +X right, +Y up, -Z ahead. A "row" is six numbers
-- { x, y, z, rx, ry, rz } added to a pose: x y z to its pos, rx ry rz to its rot (CFrame.Angles
-- order: rx turns about the parent's X, rz about the part's own Z). A layer or key may leave a
-- part's row out. With the hold as it is now:
--   right, left: a forearm about its centre, in camera space. -z reaches ahead, +rx tips the
--     hand and the needle's point up, +rz swings them to the left.
--   needle: the needle in the hand, about its grip point. -rx tips its point up (to the back of
--     the hand), ry spins it about its own length, +rz swings its point to the thumb side.
--   wrist: the right hand about the wrist (only here, not in FirstPerson's animations).
--     +rx bends it down, ry rolls it about the forearm, +rz swings it to the thumb side.
-- The hand's own axes (the right hand; the left is its mirror image): -Y to the fingertips,
-- +X the thumb side, +Z the back of the hand.
return {
	-- The framing is made at refFov. At another field of view the whole view slides along the
	-- camera's axis by pivot * (1 - tan(refFov / 2) / tan(fov / 2)), which looks exactly like
	-- scaling it by tan(fov / 2) about a point `pivot` studs ahead: keep pivot near the grip's depth.
	-- firstPerson: the view shows when the camera is within this many studs of your head.
	-- scale: the whole view is drawn this much smaller and that much nearer the camera. It looks
	-- the same on screen but stays out of walls: every other number here is at full size.
	view = { refFov = 70, pivot = 1.3, firstPerson = 1.5, scale = 0.4 },
	-- skin: the colour when your character has none. sleeveWidth: the sleeve is this much wider
	-- than the arm (FirstPerson.arm.size).
	look = { skin = { 234, 184, 146 }, skinMaterial = "SmoothPlastic", sleeveMaterial = "Fabric", sleeveWidth = 1.08 },
	-- The hand hangs from the wrist, the wrist from the forearm's hand end. FirstPerson.pose.needle
	-- is in the hand's frame, so the needle follows the wrist.
	wrist = { pos = { 0, 0, 0 }, rot = { 0, 0, -40 } },
	-- Boxes that stay on the forearm, from its hand end (+Y runs up the arm).
	--   colour: "skin", "sleeve" (FirstPerson.arm.sleeveColour) or { r, g, b }; shade multiplies it
	--   (under 1 darker, over 1 lighter); shape = "Ball" or "Cylinder" (along X) if not a block.
	cuff = {
		{ name = "Cuff", colour = "sleeve", shade = 1.15, size = { 0.37, 0.11, 0.31 }, pos = { 0, 0.15, 0 }, rot = { 0, 0, 0 } },
	},
	-- The hand's boxes, from the wrist: pos is a box's centre, its long side is Y. `open` is the
	-- same box with the hand open (the needle thrown): boxes ease between the two.
	hand = {
		{ name = "Palm", colour = "skin", size = { 0.4, 0.37, 0.16 }, pos = { 0, -0.175, 0 }, rot = { 0, 0, 0 } },
		{ name = "Index1", colour = "skin", shade = 1, size = { 0.094, 0.22, 0.115 }, pos = { 0.148, -0.41, -0.004 }, rot = { 82, 0, 0 }, open = { pos = { 0.148, -0.498, 0.067 }, rot = { 20, 0, 0 } } },
		{ name = "Index2", colour = "skin", shade = 0.95, size = { 0.094, 0.2, 0.105 }, pos = { 0.148, -0.323, -0.066 }, rot = { 190, 0, 0 }, open = { pos = { 0.148, -0.644, -0.031 }, rot = { 45, 0, 0 } } },
		{ name = "Middle1", colour = "skin", shade = 0.95, size = { 0.094, 0.23, 0.115 }, pos = { 0.049, -0.411, -0.009 }, rot = { 82, 0, 0 }, open = { pos = { 0.049, -0.503, 0.066 }, rot = { 20, 0, 0 } } },
		{ name = "Middle2", colour = "skin", shade = 0.9, size = { 0.094, 0.21, 0.105 }, pos = { 0.049, -0.319, -0.075 }, rot = { 190, 0, 0 }, open = { pos = { 0.049, -0.657, -0.038 }, rot = { 45, 0, 0 } } },
		{ name = "Ring1", colour = "skin", shade = 1, size = { 0.094, 0.22, 0.115 }, pos = { -0.049, -0.41, -0.004 }, rot = { 82, 0, 0 }, open = { pos = { -0.049, -0.498, 0.067 }, rot = { 20, 0, 0 } } },
		{ name = "Ring2", colour = "skin", shade = 0.95, size = { 0.094, 0.2, 0.105 }, pos = { -0.049, -0.323, -0.066 }, rot = { 190, 0, 0 }, open = { pos = { -0.049, -0.644, -0.031 }, rot = { 45, 0, 0 } } },
		{ name = "Pinky1", colour = "skin", shade = 0.95, size = { 0.094, 0.2, 0.115 }, pos = { -0.148, -0.409, 0.006 }, rot = { 82, 0, 0 }, open = { pos = { -0.148, -0.489, 0.071 }, rot = { 20, 0, 0 } } },
		{ name = "Pinky2", colour = "skin", shade = 0.9, size = { 0.094, 0.18, 0.105 }, pos = { -0.148, -0.33, -0.048 }, rot = { 190, 0, 0 }, open = { pos = { -0.148, -0.618, -0.017 }, rot = { 45, 0, 0 } } },
		{ name = "Thumb1", colour = "skin", shade = 0.97, size = { 0.12, 0.2, 0.12 }, pos = { 0.21, -0.3, -0.03 }, rot = { 0, 0, -40 }, open = { pos = { 0.27, -0.12, -0.03 }, rot = { 0, 0, 35 } } },
		{ name = "Thumb2", colour = "skin", shade = 0.92, size = { 0.105, 0.17, 0.105 }, pos = { 0.33, -0.4, -0.03 }, rot = { 0, 0, -30 }, open = { pos = { 0.375, -0.29, -0.03 }, rot = { 0, 0, 30 } } },
	},
	-- The left hand holds nothing: how open it is (0 a fist, 1 open). Its hold (FirstPerson.pose.left)
	-- is the right's mirror image 1.3 studs lower, out of view: lift it with `left` rows.
	left = { open = 0.7 },
	-- The grip rule, for every needle whatever its shape: the point `back` studs along from the
	-- needle's back end sits at FirstPerson.pose.needle in the hand, and the needle is scaled so
	-- its whole length is between minLength and maxLength.
	grip = { back = 0.45, minLength = 1.7, maxLength = 2.1 },
	-- A throw: the needle leaves the hand `release` seconds into FirstPerson's throw. The hand is
	-- empty until the server brings it back, or `wait` seconds on if the server never took the throw.
	throw = { release = 0.24, wait = 0.6 },
	-- Motion: each layer's rows times its weight, added to the hold and whatever is playing.
	motion = {
		-- weight sin(time * speed): -1 to 1
		breathe = { speed = 1.5, right = { 0, 0.014, 0.004, 0.6, 0, 0 }, needle = { 0, 0, 0, 0.8, 0, 0 } },
		-- the walk, per stud of FirstPerson.motion.bob: step swings side to side (weight
		-- sin(stride)), dip is each footfall (weight |cos(stride)|); eased in and out at `rate` a second.
		-- You count as walking above `least` of full speed.
		walk = { rate = 9, least = 0.1, step = { right = { 0.6, 0, 0, 0, 0, 30 }, left = { 0.6, 0, 0, 0, 0, 0 } }, dip = { right = { 0, -1, 0, -25, 0, 0 }, left = { 0, -1, 0, 0, 0, 0 } } },
		-- turning: the view lags. sway (studs) = turn speed (radians a second) * FirstPerson.motion.sway
		-- * gain, at most `max`, eased at `rate`; yaw rows per stud of sideways sway (turning left
		-- is +), pitch rows per stud of up-and-down sway (looking up is -). A negative gain leads.
		turn = { gain = 0.3, max = 0.12, rate = 10, yaw = { right = { 1, 0, 0, 0, 0, -30 }, left = { 1, 0, 0, 0, 0, 0 } }, pitch = { right = { 0, 1, 0, 30, 0, 0 }, left = { 0, 1, 0, 0, 0, 0 } } },
		-- landing: a dip that bottoms out `time` seconds after touching down and eases away; full
		-- strength from a fall of `speed` studs a second, never less than `least`
		land = { time = 0.09, speed = 45, least = 0.3, right = { 0, -0.16, 0.03, -7, 0, 0 }, left = { 0, -0.16, 0, 0, 0, 0 } },
		-- in the air (weight eased to 1 at `rate`)
		air = { rate = 7, right = { 0, 0.05, 0, 3, 0, 0 }, left = { 0, 0.05, 0, 0, 0, 0 } },
		-- the needle is away (weight eased to 1 at `rate`; the hand's boxes open by the same weight)
		away = { rate = 14, right = { 0.05, -0.1, 0.06, -6, 0, 0 }, wrist = { 0, 0, 0, 8, 0, 0 } },
		-- a wall: one ray from the camera to where the needle's point would be. Weight 0 when the
		-- wall is `margin` beyond the point, 1 when it is `near` studs from the camera; in at
		-- rateIn a second, out at rateOut. The rows pull the hand in and stand the needle up.
		wall = { margin = 0.4, near = 0.5, rateIn = 28, rateOut = 9, right = { 0.15, -0.3, 0.6, 0, 0, 0 }, wrist = { 0, 0, 0, 0, 0, 70 } },
	},
	-- Animations, like FirstPerson.anims (keys may also carry a wrist row). ViewModel plays
	-- equip when the view comes up and catch when a thrown needle is back in the hand.
	anims = {
		equip = { length = 0.45, keys = {
			{ t = 0, right = { 0.2, -0.6, 0.2, -22, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.3, right = { -0.02, 0.04, -0.03, 3, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.45, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
		} },
		catch = { length = 0.4, keys = {
			{ t = 0, right = { -0.18, 0.2, -0.3, 8, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.12, right = { -0.05, 0.03, 0.08, -4, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
			{ t = 0.4, right = { 0, 0, 0, 0, 0, 0 }, left = { 0, 0, 0, 0, 0, 0 }, needle = { 0, 0, 0, 0, 0, 0 } },
		} },
	},
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00009">
				<Properties>
					<string name="Name">Maps</string>
					<ProtectedString name="Source"><![CDATA[-- The maps: what each is called, its light and its colours. server/MapsA and server/MapsB build
-- them (`builder` names the function) and list their hiding spots as they place each prop, so
-- every spot sits on a real surface in reach. Add a map: a line here plus a builder.
--   look: the name of a preset in shared/ConfigLook (sun, sky, haze, clouds, grade): server/Look.
--   lighting: the old plain light, kept for the dev previews (dev/preview/render.html) only.
--   straw: the colour of loose straw (and of a camouflaged needle); clutter tints vary round it.
local Maps = {}

Maps.list = {
	-- the big map (server/MapsBig): duration = its round length, powerups = orbs about, landmarkChests =
	-- how many chests go up on its climbable landmarks (the rest deep in its mazes)
	{ id = "bigfarm", name = "Hayfield Farm", builder = "bigfarm", look = "harvest", weight = 20, duration = 300, powerups = 18, landmarkChests = 3,
		lighting = { ClockTime = 14.5, Brightness = 2.7, Ambient = { 124, 118, 102 }, OutdoorAmbient = { 158, 150, 130 }, FogEnd = 1400, FogColor = { 205, 226, 246 } },
		straw = { 226, 188, 92 }, ground = { 100, 158, 72 } },
	{ id = "field", name = "Classic Haystack Field", builder = "field", look = "noon", weight = 25,
		lighting = { ClockTime = 14, Brightness = 2.6, Ambient = { 120, 116, 104 }, OutdoorAmbient = { 150, 146, 134 }, FogEnd = 900, FogColor = { 200, 225, 245 } },
		straw = { 226, 188, 92 }, ground = { 104, 160, 76 } },
	{ id = "barn", name = "Barn Interior", builder = "barn", look = "interior", weight = 20,
		lighting = { ClockTime = 13, Brightness = 1.4, Ambient = { 120, 96, 70 }, OutdoorAmbient = { 110, 90, 66 }, FogEnd = 400, FogColor = { 120, 96, 70 } },
		straw = { 214, 172, 80 }, ground = { 120, 86, 56 } },
	{ id = "sunset", name = "Farm at Sunset", builder = "sunset", look = "dusk", weight = 20,
		lighting = { ClockTime = 17.7, Brightness = 2.2, Ambient = { 130, 96, 80 }, OutdoorAmbient = { 170, 120, 96 }, FogEnd = 700, FogColor = { 250, 170, 120 } },
		straw = { 232, 170, 84 }, ground = { 120, 150, 70 } },
	{ id = "forest", name = "Night Forest", builder = "forest", look = "night", weight = 15,
		lighting = { ClockTime = 0.5, Brightness = 1.1, Ambient = { 70, 80, 110 }, OutdoorAmbient = { 90, 100, 140 }, FogEnd = 260, FogColor = { 30, 40, 64 } },
		straw = { 196, 170, 100 }, ground = { 52, 84, 52 } },
	{ id = "attic", name = "Abandoned Attic", builder = "attic", look = "interior", weight = 20,
		lighting = { ClockTime = 15, Brightness = 1.2, Ambient = { 110, 100, 90 }, OutdoorAmbient = { 100, 92, 84 }, FogEnd = 300, FogColor = { 110, 100, 90 } },
		straw = { 206, 176, 112 }, ground = { 112, 86, 64 } },
	-- from the owner's Gemini map sheets (server/MapsC)
	{ id = "pumpkin", name = "Pumpkin Patch", builder = "pumpkin", look = "gold", weight = 15,
		lighting = { ClockTime = 15, Brightness = 2.6, Ambient = { 124, 116, 100 }, OutdoorAmbient = { 156, 146, 128 }, FogEnd = 900, FogColor = { 205, 225, 245 } },
		straw = { 226, 188, 92 }, ground = { 96, 156, 70 } },
	{ id = "corn", name = "Harvest Corn Maze", builder = "corn", look = "gold", weight = 15,
		lighting = { ClockTime = 15.5, Brightness = 2.7, Ambient = { 132, 120, 96 }, OutdoorAmbient = { 168, 150, 118 }, FogEnd = 900, FogColor = { 220, 226, 236 } },
		straw = { 232, 196, 96 }, ground = { 170, 140, 84 } },
	{ id = "sunflower", name = "Sunflower Labyrinth", builder = "sunflower", look = "noon", weight = 15,
		lighting = { ClockTime = 13, Brightness = 2.8, Ambient = { 126, 120, 100 }, OutdoorAmbient = { 160, 152, 128 }, FogEnd = 900, FogColor = { 210, 230, 248 } },
		straw = { 226, 188, 92 }, ground = { 150, 112, 72 } },
	{ id = "orchard", name = "Apple Orchard", builder = "orchard", look = "noon", weight = 15,
		lighting = { ClockTime = 12.5, Brightness = 2.7, Ambient = { 120, 120, 104 }, OutdoorAmbient = { 150, 154, 134 }, FogEnd = 900, FogColor = { 205, 228, 248 } },
		straw = { 222, 190, 100 }, ground = { 104, 164, 74 } },
	{ id = "windmill", name = "Windmill Hill", builder = "windmill", look = "gold", weight = 15,
		lighting = { ClockTime = 16, Brightness = 2.6, Ambient = { 128, 118, 100 }, OutdoorAmbient = { 160, 148, 126 }, FogEnd = 900, FogColor = { 214, 226, 240 } },
		straw = { 226, 188, 92 }, ground = { 104, 158, 76 } },
	-- the second batch (server/MapsD)
	{ id = "frozen", name = "Frozen Farm", builder = "frozen", look = "overcast", weight = 15,
		lighting = { ClockTime = 13, Brightness = 2.4, Ambient = { 140, 146, 160 }, OutdoorAmbient = { 176, 184, 200 }, FogEnd = 900, FogColor = { 226, 236, 248 } },
		straw = { 226, 196, 120 }, ground = { 236, 242, 250 } },
	{ id = "greenhouse", name = "Rainy Greenhouse", builder = "greenhouse", look = "overcast", weight = 15,
		lighting = { ClockTime = 11, Brightness = 2.0, Ambient = { 120, 128, 132 }, OutdoorAmbient = { 148, 158, 166 }, FogEnd = 900, FogColor = { 196, 210, 220 } },
		straw = { 214, 184, 104 }, ground = { 150, 150, 156 } },
	{ id = "marsh", name = "Duck Pond Marsh", builder = "marsh", look = "overcast", weight = 15,
		lighting = { ClockTime = 14, Brightness = 2.6, Ambient = { 118, 124, 106 }, OutdoorAmbient = { 150, 158, 136 }, FogEnd = 900, FogColor = { 206, 228, 236 } },
		straw = { 214, 184, 104 }, ground = { 150, 112, 76 } },
	{ id = "market", name = "Hay Market", builder = "market", look = "noon", weight = 15,
		lighting = { ClockTime = 14.5, Brightness = 2.7, Ambient = { 128, 120, 102 }, OutdoorAmbient = { 162, 152, 128 }, FogEnd = 900, FogColor = { 214, 228, 244 } },
		straw = { 226, 188, 92 }, ground = { 200, 170, 120 } },
	{ id = "fair", name = "County Fair", builder = "fair", look = "noon", weight = 15,
		lighting = { ClockTime = 15, Brightness = 2.8, Ambient = { 130, 122, 112 }, OutdoorAmbient = { 166, 156, 144 }, FogEnd = 900, FogColor = { 218, 230, 248 } },
		straw = { 226, 188, 92 }, ground = { 214, 186, 140 } },
}

-- The lobby's light, between rounds.
Maps.lobbyLook = "noon"
Maps.lobbyLighting = { ClockTime = 14.5, Brightness = 2.5, Ambient = { 120, 116, 104 }, OutdoorAmbient = { 150, 146, 134 }, FogEnd = 1200, FogColor = { 200, 225, 245 } }

local byId = {}
for _, m in ipairs(Maps.list) do
	byId[m.id] = m
end

function Maps.get(id)
	return byId[id]
end

return Maps
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000A">
				<Properties>
					<string name="Name">NeedleAura</string>
					<ProtectedString name="Source"><![CDATA[-- The Heirloom aura (Config.Aura): every needle of an Heirloom shape gives off energy, in its own
-- skin's colours. Added by shared/NeedleLook to the needle wherever it appears in the world: in a
-- hand, in first person, flying, on a lobby pedestal. (ViewportFrames, like the Collection
-- screen's, don't draw particles, so there you see the needle without it.)
--   a shimmering energy skin round every piece (the ForceField material, which ripples on its own),
--   soft wisps rising off it, a few sparks flicking outwards, and a gentle light.
-- Soft and steady by design: nothing flashes.
local Config = require(script.Parent.Config)

local NeedleAura = {}
local A = Config.Aura

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- The aura's two colours: Config.Aura.gradient (eye end, point end) if it's set, otherwise the
-- skin's brightest colours, lifted a little, so a dark skin still glows.
local function colours(skin)
	if A.gradient then
		return rgb(A.gradient[1]), rgb(A.gradient[2])
	end
	if skin.pattern == "rainbow" then
		return Color3.fromHSV(0.8, 0.55, 1), Color3.fromHSV(0.45, 0.55, 1)
	end
	local list = {}
	for _, c in ipairs(skin.colours) do
		local col = rgb(c)
		local _, _, v = col:ToHSV()
		table.insert(list, { col = col, v = v })
	end
	table.sort(list, function(a, b)
		return a.v > b.v
	end)
	local main, second = list[1].col, (list[2] or list[1]).col
	return main:Lerp(Color3.new(1, 1, 1), A.lift), second:Lerp(Color3.new(1, 1, 1), A.lift)
end

local function seq(a, b)
	return ColorSequence.new(a, b)
end

function NeedleAura.add(model, skin, scale)
	local cf, size = model:GetBoundingBox()
	local main, second = colours(skin)
	local thick = math.max(size.Y, size.Z)
	local aura = Instance.new("Part") -- the space the energy fills
	aura.Name, aura.Anchored, aura.CanCollide, aura.CanQuery, aura.CanTouch, aura.CastShadow = "Aura", true, false, false, false, false
	aura.Size, aura.CFrame, aura.Transparency = Vector3.new(size.X * 1.05, thick * 1.2, thick * 1.2), cf, 1
	aura.Parent = model
	if A.shell then -- an energy skin hugging every piece of the needle, rippling on its own (ForceField)
		for _, part in ipairs(model:GetChildren()) do
			if part:IsA("BasePart") and part.Name ~= "Root" and part ~= aura then
				local shell = part:Clone()
				shell:ClearAllChildren()
				local along = math.clamp((part.Position.X - (cf.Position.X - size.X / 2)) / math.max(size.X, 0.01), 0, 1)
				shell.Name, shell.Material, shell.Color, shell.Transparency = "AuraShell", Enum.Material.ForceField, main:Lerp(second, along), 0 -- shaded along the needle
				shell.Size = part.Size * A.shellGrow + Vector3.one * A.shellPad * scale
				shell.CFrame = part.CFrame
				shell.Parent = model
			end
		end
	end
	local wisps = Instance.new("ParticleEmitter") -- soft energy rising off it
	wisps.Name, wisps.Texture = "AuraWisps", "rbxasset://textures/particles/smoke_main.dds"
	wisps.Shape, wisps.ShapeStyle, wisps.Rate = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume, A.wisps
	wisps.Lifetime, wisps.Speed = NumberRange.new(0.8, 1.6), NumberRange.new(0.2 * scale, 0.6 * scale)
	wisps.Acceleration = Vector3.new(0, A.rise * scale, 0)
	wisps.Rotation, wisps.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-60, 60)
	wisps.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.35, A.wispSize * scale), NumberSequenceKeypoint.new(1, 0) })
	wisps.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.25), NumberSequenceKeypoint.new(1, 1) })
	wisps.Color, wisps.LightEmission, wisps.LightInfluence = seq(second, main), 1, 0 -- bright as they leave, deeper as they fade
	wisps.Parent = aura
	local sparks = Instance.new("ParticleEmitter") -- little flicks of power outwards
	sparks.Name, sparks.Texture = "AuraSparks", "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Shape, sparks.ShapeStyle, sparks.Rate = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume, A.sparks
	sparks.Lifetime, sparks.Speed, sparks.SpreadAngle = NumberRange.new(0.35, 0.7), NumberRange.new(1.2 * scale, 2.6 * scale), Vector2.new(180, 180)
	sparks.Drag = 4
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12 * scale), NumberSequenceKeypoint.new(1, 0) })
	sparks.Transparency = NumberSequence.new(0.1, 1)
	sparks.Color, sparks.LightEmission, sparks.LightInfluence = seq(second, main), 1, 0
	sparks.Parent = aura
	local light = Instance.new("PointLight")
	light.Name, light.Color, light.Range, light.Brightness = "AuraLight", main:Lerp(second, 0.6), A.lightRange * scale, A.light
	light.Parent = aura
	return aura
end

return NeedleAura
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000B">
				<Properties>
					<string name="Name">NeedleLook</string>
					<ProtectedString name="Source"><![CDATA[-- Builds a needle of any type in any skin out of parts (shared/Needles): for the NEEDLE FOUND!
-- reveal, the Collection screen (inside ViewportFrames) and the lobby's showcase pedestals.
-- The needle lies along X, eye end at -X, point at +X, about 2-3 studs long at scale 1. The
-- novelty shapes (swordfish, firework, jackhammer, shooting star) keep that rule: their point (a
-- bill, a nose cone, a chisel, a star) is at +X.
-- The shaft is cut into segments so patterns (stripes, gradient, rainbow, bands, sheen, split,
-- tri, candy, fleck, wave) show along it.
-- fat (1 = true to life) thickens it for display: the UI and pedestals use about 2, so a needle
-- reads as a bold little trophy instead of a hairline.
local Needles = require(script.Parent.Needles)
local NeedleAura = require(script.Parent.NeedleAura)
local Shapes = {} -- shapes kept as data, in as many files as dev/shapes.py needed
for _, name in ipairs({ "ShapesA", "ShapesB", "ShapesC", "ShapesD", "ShapesE", "ShapesF" }) do
	local file = script.Parent:FindFirstChild(name)
	for id, ops in pairs(if file then require(file) else {}) do
		Shapes[id] = ops
	end
end
local PART = { B = nil, C = "Cylinder", S = "Ball" }

local NeedleLook = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- The colour of shaft segment i of n for a skin.
local function colourAt(skin, i, n)
	local a, b = rgb(skin.colours[1]), rgb(skin.colours[2] or skin.colours[1])
	local t = (i - 0.5) / n
	local pattern = skin.pattern
	if pattern == "stripes" then
		return if i % 2 == 1 then a else b
	elseif pattern == "gradient" then
		return a:Lerp(b, t)
	elseif pattern == "rainbow" then
		return Color3.fromHSV(t * 0.85, 0.65, 1)
	elseif pattern == "bands" then -- thin bands of the second colour
		return if i % 3 == 0 then b else a
	elseif pattern == "sheen" then -- light running along the middle
		return a:Lerp(b, 1 - math.abs(2 * t - 1))
	elseif pattern == "split" then
		return if t < 0.5 then a else b
	elseif pattern == "tri" then -- three colours along it (the third is also the eye)
		return rgb(skin.colours[math.min(3, math.floor(t * 2) + 1)] or skin.colours[1])
	elseif pattern == "candy" then -- every colour in turn
		return rgb(skin.colours[(i - 1) % #skin.colours + 1])
	elseif pattern == "fleck" then -- spots of the other colours, in a fixed scatter
		return if (i * 5) % 7 < 2 then rgb(skin.colours[2 + i % math.max(1, #skin.colours - 1)] or skin.colours[1]) else a
	elseif pattern == "wave" then -- the two colours swirling into each other
		return a:Lerp(b, 0.5 + 0.5 * math.sin(t * math.pi * 5))
	end
	return a
end

local function accent(skin)
	if skin.pattern == "rainbow" then
		return Color3.fromHSV(0.85, 0.5, 1)
	elseif skin.pattern == "tri" then
		return rgb(skin.colours[3] or skin.colours[2] or skin.colours[1])
	end
	return if skin.pattern == "solid" then rgb(skin.colours[1]) else rgb(skin.colours[2] or skin.colours[1])
end

function NeedleLook.build(typeId, skinId, scale, fat)
	scale, fat = scale or 1, fat or 1
	local skin = Needles.skin(skinId) or Needles.skin("steel")
	fat *= skin.thin or 1 -- a paper-thin skin (the 1 of 1)
	local model = Instance.new("Model")
	model.Name = Needles.name(typeId, skin.id)
	local material = Enum.Material[skin.material] or Enum.Material.Metal
	local root = Instance.new("Part")
	root.Name, root.Size, root.Transparency, root.Anchored = "Root", Vector3.one * 0.1, 1, true
	root.CanCollide, root.CanQuery, root.CanTouch = false, false, false
	root.Parent = model
	model.PrimaryPart = root

	-- onCurve: its position isn't thickened (a curve or a star keeps its shape); keep: nor is its
	-- size (a flat fin stays a fin)
	local function part(size, cf, colour, shape, onCurve, keep)
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Shape = Enum.PartType[shape or "Block"]
		if keep then
			p.Size = size * scale
		elseif shape == "Ball" then
			p.Size = size * scale * fat
		else
			p.Size = Vector3.new(size.X, size.Y * fat, size.Z * fat) * scale
		end
		local y = if onCurve then cf.Position.Y else cf.Position.Y * fat -- a curve keeps its shape
		p.CFrame = CFrame.new(Vector3.new(cf.Position.X, y, cf.Position.Z) * scale) * cf.Rotation
		p.Color, p.Material, p.Transparency = colour, material, skin.see or 0
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	-- a shaft from x0 to x1, d thick, in n patterned segments (y offsets it sideways)
	local function shaft(x0, x1, d, n, y, flat)
		local len = (x1 - x0) / n
		for i = 1, n do
			local cf = CFrame.new(x0 + (i - 0.5) * len, y or 0, 0)
			if flat then
				part(Vector3.new(len + 0.01, d, flat), cf, colourAt(skin, i, n))
			else
				part(Vector3.new(len + 0.01, d, d), cf, colourAt(skin, i, n), "Cylinder")
			end
		end
	end
	local function tip(x, d, steps)
		for i = 1, steps do
			local k = 1 - i / (steps + 1)
			part(Vector3.new(0.08, d * k, d * k), CFrame.new(x + i * 0.07, 0, 0), colourAt(skin, 6, 6), "Cylinder")
		end
	end
	local function eye(x, len, gap, d)
		for _, s in ipairs({ -1, 1 }) do
			part(Vector3.new(len, d * 0.45, d * 0.45), CFrame.new(x, s * gap, 0), accent(skin), "Cylinder")
		end
		part(Vector3.new(d * 0.6, gap * 2 + d * 0.45, d * 0.5), CFrame.new(x - len / 2, 0, 0), accent(skin))
	end
	local function ball(x, d, y, onCurve)
		part(Vector3.one * d, CFrame.new(x, y or 0, 0), accent(skin), "Ball", onCurve)
	end

	if typeId == "pin" then
		shaft(-0.75, 0.85, 0.06, 6)
		tip(0.85, 0.06, 2)
		ball(-0.85, 0.28)
	elseif typeId == "quilting" then
		shaft(-0.6, 0.6, 0.07, 5)
		tip(0.6, 0.07, 2)
		eye(-0.7, 0.18, 0.03, 0.07)
	elseif typeId == "darning" then
		shaft(-1.15, 1.1, 0.12, 7)
		tip(1.1, 0.12, 3)
		eye(-1.3, 0.34, 0.07, 0.12)
	elseif typeId == "embroidery" then
		shaft(-0.85, 0.85, 0.09, 6)
		tip(0.85, 0.09, 3)
		eye(-1.02, 0.34, 0.08, 0.1)
	elseif typeId == "tapestry" then
		shaft(-0.95, 1.0, 0.11, 6)
		ball(1.03, 0.13)
		eye(-1.12, 0.34, 0.07, 0.11)
	elseif typeId == "safety" then
		shaft(-0.9, 0.85, 0.06, 6, 0.13)
		shaft(-0.75, 0.85, 0.06, 6, -0.13)
		for i = 0, 7 do -- the coil
			local a = i / 8 * math.pi * 2
			part(Vector3.new(0.06, 0.06, 0.06), CFrame.new(-0.95 + math.cos(a) * 0.13, math.sin(a) * 0.13, 0), accent(skin), "Ball")
		end
		part(Vector3.new(0.24, 0.38, 0.12), CFrame.new(0.95, 0, 0), accent(skin))
	elseif typeId == "knitting" then
		shaft(-1.45, 1.3, 0.18, 8)
		tip(1.3, 0.18, 4)
		ball(-1.6, 0.4)
	elseif typeId == "crochet" then
		shaft(-1.3, 1.1, 0.16, 7)
		part(Vector3.new(0.6, 0.24, 0.1), CFrame.new(-0.2, 0, 0), accent(skin))
		part(Vector3.new(0.22, 0.12, 0.12), CFrame.new(1.21, 0, 0), colourAt(skin, 7, 7), "Cylinder")
		part(Vector3.new(0.16, 0.07, 0.08), CFrame.new(1.28, 0.07, 0) * CFrame.Angles(0, 0, math.rad(-40)), colourAt(skin, 7, 7))
	elseif typeId == "bodkin" then
		shaft(-1.1, 1.0, 0.2, 7, 0, 0.05)
		ball(1.05, 0.16)
		part(Vector3.new(0.3, 0.06, 0.07), CFrame.new(-0.85, 0, 0), Color3.fromRGB(30, 30, 36))
	elseif typeId == "curved" then
		local n, r = 9, 0.95
		for i = 1, n do -- an arc, the point at one end and the eye at the other
			local a = math.rad(20 + (i - 0.5) * 140 / n)
			part(Vector3.new(r * math.rad(140 / n) + 0.02, 0.08, 0.08), CFrame.new(-math.cos(a) * r, math.sin(a) * r - 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2 - a), colourAt(skin, i, n), "Cylinder", true) -- along the curve
		end
		ball(-math.cos(math.rad(20)) * r, 0.1, math.sin(math.rad(20)) * r - 0.5, true)
	elseif typeId == "sailmaker" then
		shaft(-1.2, 0.9, 0.14, 7)
		tip(0.9, 0.16, 3)
		part(Vector3.new(1.6, 0.03, 0.03), CFrame.new(-0.2, 0.08, 0), accent(skin))
		eye(-1.36, 0.3, 0.07, 0.13)
	elseif typeId == "swordfish" then -- the bill is the needle; a tapered body, a tall sail, a forked tail
		shaft(0.42, 1.55, 0.05, 6)
		tip(1.55, 0.05, 3)
		local body = { 0.07, 0.15, 0.24, 0.3, 0.31, 0.27, 0.18, 0.1 }
		for i, d in ipairs(body) do
			part(Vector3.new(0.23, d, d * 0.75), CFrame.new(-1.45 + i * 0.23, 0, 0), colourAt(i, #body), "Cylinder")
		end
		for k = 0, 5 do -- the sail: overlapping panels, tallest at the front, sweeping back
			local h = 0.6 - k * 0.09
			part(Vector3.new(0.16, h, 0.02), CFrame.new(-0.08 - k * 0.12, 0.28 + h / 2, 0) * CFrame.Angles(0, 0, math.rad(-14)), accent(skin), nil, true, true)
		end
		for _, s in ipairs({ -1, 1 }) do
			part(Vector3.new(0.55, 0.16, 0.02), CFrame.new(-1.42, s * 0.2, 0) * CFrame.Angles(0, 0, math.rad(s * 58)), accent(skin), nil, true, true) -- the tail
			part(Vector3.new(0.28, 0.06, 0.02), CFrame.new(-0.1, s * -0.18, 0) * CFrame.Angles(0, 0, math.rad(s * 25)), accent(skin), nil, true, true) -- side fins
		end
		part(Vector3.one * 0.07, CFrame.new(0.2, 0.06, 0.1), Color3.fromRGB(20, 20, 26), "Ball", true) -- an eye
	elseif typeId == "firework" then -- a rocket on its stick: striped tube, nose cone, fins, a spark at the end
		shaft(-1.65, -0.25, 0.05, 4)
		for i = 1, 5 do
			part(Vector3.new(0.22, 0.3, 0.3), CFrame.new(-0.2 + i * 0.2, 0, 0), colourAt(i, 5), "Cylinder")
		end
		for i = 1, 4 do -- the nose cone
			local k = 1 - i / 5
			part(Vector3.new(0.09, 0.3 * k, 0.3 * k), CFrame.new(0.94 + i * 0.08, 0, 0), accent(skin), "Cylinder")
		end
		for _, s in ipairs({ -1, 1 }) do
			part(Vector3.new(0.38, 0.34, 0.03), CFrame.new(0.0, s * 0.42, 0) * CFrame.Angles(0, 0, math.rad(s * -30)), accent(skin), nil, true, true)
		end
		for k = 0, 5 do -- sparks fizzing off the end of the stick
			local a = k / 6 * math.pi * 2
			part(Vector3.one * 0.07, CFrame.new(-1.72 + math.cos(a) * 0.16, math.sin(a) * 0.16, 0), Color3.fromRGB(255, 220, 120), "Ball", true, true)
		end
		ball(-1.72, 0.12)
	elseif typeId == "jackhammer" then -- a chisel bit for a point, a ribbed body, a motor and T-handles
		shaft(0.45, 1.45, 0.08, 4)
		part(Vector3.new(0.14, 0.14, 0.03), CFrame.new(1.52, 0, 0), colourAt(4, 4)) -- the flat chisel end
		part(Vector3.new(0.12, 0.22, 0.22), CFrame.new(0.4, 0, 0), accent(skin), "Cylinder") -- the collar
		for i = 1, 4 do
			part(Vector3.new(0.26, if i % 2 == 0 then 0.36 else 0.4, if i % 2 == 0 then 0.36 else 0.4), CFrame.new(0.4 - i * 0.25, 0, 0), colourAt(i, 4), "Cylinder")
		end
		part(Vector3.new(0.4, 0.46, 0.4), CFrame.new(-0.84, 0, 0), accent(skin)) -- the motor
		part(Vector3.new(0.22, 0.1, 0.1), CFrame.new(-1.12, 0, 0), accent(skin))
		part(Vector3.new(1.1, 0.1, 0.1), CFrame.new(-1.26, 0, 0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(40, 40, 46), "Cylinder", true, true) -- the handle bar
		for _, s in ipairs({ -1, 1 }) do
			part(Vector3.new(0.3, 0.18, 0.18), CFrame.new(-1.26, 0, s * 0.45) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(25, 25, 30), "Cylinder", true, true) -- grips
		end
	elseif typeId == "shootingstar" then -- a five-pointed star leading a long fading trail
		local n = 9
		for i = 1, n do -- the trail, thin at the eye end and widening towards the star
			local d = 0.03 + 0.1 * (i / n)
			part(Vector3.new(2.2 / n + 0.01, d, d), CFrame.new(-1.45 + (i - 0.5) * 2.2 / n, 0, 0), colourAt(i, n), "Cylinder")
		end
		for _, s in ipairs({ -1, 1 }) do -- two thinner streaks beside it
			part(Vector3.new(1.2, 0.025, 0.025), CFrame.new(0.1, s * 0.12, 0) * CFrame.Angles(0, 0, math.rad(s * 4)), colourAt(n, n), "Cylinder", true)
		end
		local centre = CFrame.new(1.1, 0, 0)
		for k = 0, 4 do -- the points, each a long and a short bar so it tapers, in the star's own plane
			local a = math.rad(90 + k * 72)
			part(Vector3.new(0.5, 0.15, 0.07), centre * CFrame.Angles(0, 0, a) * CFrame.new(0.25, 0, 0), accent(skin), nil, true, true)
			part(Vector3.new(0.26, 0.26, 0.08), centre * CFrame.Angles(0, 0, a) * CFrame.new(0.13, 0, 0), accent(skin), nil, true, true)
		end
		part(Vector3.one * 0.34, centre, accent(skin), "Ball", true, true)
	elseif Shapes[typeId] then -- a shape kept as data: each op a shaft, a tip or one part
		for _, op in ipairs(Shapes[typeId]) do
			if op[1] == "s" then
				shaft(op[2], op[3], op[4], op[5], op[6])
			elseif op[1] == "t" then
				tip(op[2], op[3], op[4])
			else -- { "p", size x/y/z, position x/y/z, turn x/y/z (degrees), colour, part, flags }
				local c = op[11]
				local colour = if type(c) == "table" then Color3.fromRGB(c[1], c[2], c[3]) elseif c == "a" then accent(skin) else colourAt(skin, tonumber(string.match(c, "^c(%d+)")), tonumber(string.match(c, "/(%d+)$")))
				local cf = CFrame.new(op[5], op[6], op[7]) * CFrame.Angles(math.rad(op[8]), math.rad(op[9]), math.rad(op[10]))
				part(Vector3.new(op[2], op[3], op[4]), cf, colour, PART[op[12]], op[13] % 2 == 1, op[13] >= 2) -- flags: 1 keep its place, 2 keep its size
			end
		end
	else -- sewing
		shaft(-0.9, 0.85, 0.08, 6)
		tip(0.85, 0.08, 3)
		eye(-1.03, 0.24, 0.05, 0.09)
	end
	if skin.glow then
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness = rgb(skin.colours[1]), 6 * scale, 1
		light.Parent = root
	end
	local t = Needles.type(typeId)
	if t and t.grade == "heirloom" then -- Heirloom shapes give off energy (shared/NeedleAura)
		NeedleAura.add(model, skin, scale)
	end
	if skin.sparkle then
		local e = Instance.new("ParticleEmitter")
		e.Rate, e.Lifetime, e.Speed = 4, NumberRange.new(0.5, 0.9), NumberRange.new(0.2, 0.6)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.12 * scale), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission, e.Color = 1, ColorSequence.new(Color3.new(1, 1, 1), rgb(skin.colours[2] or skin.colours[1]))
		e.Shape, e.ShapeStyle = Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
		root.Size = Vector3.new(2.4, 0.4, 0.4) * scale
		e.Parent = root
	end
	return model
end

return NeedleLook
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000C">
				<Properties>
					<string name="Name">NeedleSkins</string>
					<ProtectedString name="Source"><![CDATA[-- More needle skins (sheets 6-10 of the skin brief): food, nature, materials, space and magic,
-- and patterns. Same recipe format as Needles.skins (see shared/Needles), appended to it.
--   fleck: the first colour with spots of the others (sprinkles, chips, splatter, camo)
--   wave: the first two colours swirling into each other along the needle (marble, tie-dye)
return {
	-- Food
	{ id = "watermelon", name = "Watermelon", rarity = "common", colours = { { 240, 70, 90 }, { 250, 230, 220 }, { 70, 170, 80 } }, material = "SmoothPlastic", pattern = "tri" },
	{ id = "milkshake", name = "Strawberry Milkshake", rarity = "uncommon", colours = { { 255, 170, 190 }, { 255, 245, 240 } }, material = "SmoothPlastic", pattern = "wave" },
	{ id = "blueberry", name = "Blueberry", rarity = "common", colours = { { 70, 80, 200 }, { 150, 160, 245 } }, material = "SmoothPlastic", pattern = "sheen" },
	{ id = "chocolate", name = "Chocolate Drizzle", rarity = "uncommon", colours = { { 120, 70, 40 }, { 240, 220, 190 } }, material = "SmoothPlastic", pattern = "wave" },
	{ id = "lemonzest", name = "Lemon Zest", rarity = "common", colours = { { 255, 225, 50 }, { 255, 250, 200 } }, material = "SmoothPlastic", pattern = "bands" },
	{ id = "mintchip", name = "Mint Chip", rarity = "uncommon", colours = { { 170, 240, 200 }, { 70, 45, 30 } }, material = "SmoothPlastic", pattern = "fleck" },
	{ id = "bubblegum", name = "Bubblegum Swirl", rarity = "rare", colours = { { 255, 120, 200 }, { 120, 200, 255 }, { 255, 255, 255 } }, material = "SmoothPlastic", pattern = "candy" },
	{ id = "honeycomb", name = "Honeycomb", rarity = "rare", colours = { { 255, 180, 40 }, { 190, 110, 20 } }, material = "Glass", pattern = "bands" },
	{ id = "cookiescream", name = "Cookies and Cream", rarity = "uncommon", colours = { { 245, 245, 240 }, { 40, 36, 36 } }, material = "SmoothPlastic", pattern = "fleck" },
	{ id = "sprinkles", name = "Rainbow Sprinkles", rarity = "epic", colours = { { 255, 240, 250 }, { 255, 80, 90 }, { 60, 180, 255 }, { 255, 220, 50 }, { 120, 220, 90 } }, material = "SmoothPlastic", pattern = "fleck", sparkle = true },
	-- Nature
	{ id = "autumnleaves", name = "Autumn Leaves", rarity = "uncommon", colours = { { 220, 90, 30 }, { 240, 180, 40 }, { 150, 40, 30 } }, material = "SmoothPlastic", pattern = "tri" },
	{ id = "oceanwave", name = "Ocean Wave", rarity = "rare", colours = { { 30, 100, 190 }, { 200, 240, 255 } }, material = "Glass", pattern = "wave" },
	{ id = "desertsand", name = "Desert Sand", rarity = "common", colours = { { 230, 200, 140 }, { 200, 160, 100 } }, material = "Sand", pattern = "wave" },
	{ id = "mossystone", name = "Mossy Stone", rarity = "common", colours = { { 120, 124, 118 }, { 100, 150, 70 } }, material = "Slate", pattern = "fleck" },
	{ id = "cherryblossom", name = "Cherry Blossom", rarity = "rare", colours = { { 255, 200, 220 }, { 255, 250, 252 }, { 240, 120, 170 } }, material = "SmoothPlastic", pattern = "fleck" },
	{ id = "northernlights", name = "Northern Lights", rarity = "epic", colours = { { 60, 255, 170 }, { 25, 35, 85 } }, material = "Neon", pattern = "wave", sparkle = true },
	{ id = "thunderstorm", name = "Thunderstorm", rarity = "epic", colours = { { 60, 66, 90 }, { 255, 240, 120 } }, material = "SmoothPlastic", pattern = "fleck", glow = true, sparkle = true },
	{ id = "coralreef", name = "Coral Reef", rarity = "rare", colours = { { 255, 110, 100 }, { 40, 190, 200 }, { 240, 210, 160 } }, material = "SmoothPlastic", pattern = "candy" },
	{ id = "snowfall", name = "Snowfall", rarity = "uncommon", colours = { { 170, 205, 240 }, { 255, 255, 255 } }, material = "Ice", pattern = "fleck", sparkle = true },
	{ id = "sunrise", name = "Sunrise", rarity = "legendary", colours = { { 255, 90, 80 }, { 255, 210, 90 } }, material = "Neon", pattern = "gradient", glow = true, sparkle = true },
	-- Materials
	{ id = "brushedcopper", name = "Brushed Copper", rarity = "common", colours = { { 200, 120, 75 }, { 240, 180, 130 } }, material = "Metal", pattern = "sheen" },
	{ id = "marble", name = "Marble", rarity = "uncommon", colours = { { 240, 238, 232 }, { 140, 140, 152 } }, material = "Marble", pattern = "wave" },
	{ id = "stainedglass", name = "Stained Glass", rarity = "epic", colours = { { 220, 50, 60 }, { 40, 36, 50 }, { 40, 110, 220 }, { 40, 36, 50 }, { 250, 200, 40 }, { 40, 36, 50 }, { 60, 170, 80 }, { 40, 36, 50 } }, material = "Glass", pattern = "candy", glow = true },
	{ id = "rope", name = "Woven Rope", rarity = "common", colours = { { 200, 165, 110 }, { 150, 115, 70 } }, material = "Fabric", pattern = "stripes" },
	{ id = "imperialjade", name = "Imperial Jade", rarity = "rare", colours = { { 30, 150, 90 }, { 160, 235, 180 } }, material = "Glass", pattern = "wave" },
	{ id = "obsidian", name = "Obsidian", rarity = "rare", colours = { { 25, 22, 32 }, { 120, 100, 160 } }, material = "Glass", pattern = "sheen" },
	{ id = "pearl", name = "Pearl", rarity = "legendary", colours = { { 250, 245, 240 }, { 255, 210, 225 } }, material = "SmoothPlastic", pattern = "sheen", glow = true, sparkle = true },
	{ id = "goldleaf", name = "Gold Leaf", rarity = "legendary", colours = { { 240, 180, 50 }, { 255, 235, 150 } }, material = "Foil", pattern = "fleck", glow = true, sparkle = true },
	{ id = "frostedglass", name = "Frosted Glass", rarity = "uncommon", colours = { { 215, 232, 245 }, { 255, 255, 255 } }, material = "Ice", pattern = "sheen" },
	{ id = "woodgrain", name = "Polished Wood", rarity = "common", colours = { { 150, 80, 42 }, { 95, 50, 28 } }, material = "Wood", pattern = "wave" },
	-- Space and magic
	{ id = "nebulacloud", name = "Nebula Cloud", rarity = "rare", colours = { { 150, 60, 220 }, { 60, 140, 255 } }, material = "Neon", pattern = "wave" },
	{ id = "blackhole", name = "Black Hole", rarity = "mythic", colours = { { 12, 10, 22 }, { 160, 90, 255 }, { 255, 180, 80 } }, material = "Neon", pattern = "tri", glow = true, sparkle = true },
	{ id = "starfield", name = "Starfield", rarity = "rare", colours = { { 20, 24, 60 }, { 255, 255, 255 } }, material = "SmoothPlastic", pattern = "fleck", sparkle = true },
	{ id = "moondust", name = "Moon Dust", rarity = "uncommon", colours = { { 185, 185, 196 }, { 240, 240, 250 } }, material = "Slate", pattern = "fleck", sparkle = true },
	{ id = "comettrail", name = "Comet Trail", rarity = "epic", colours = { { 255, 120, 40 }, { 255, 230, 150 } }, material = "Neon", pattern = "gradient", sparkle = true },
	{ id = "crystalcave", name = "Crystal Cave", rarity = "epic", colours = { { 60, 110, 220 }, { 170, 230, 255 } }, material = "Glass", pattern = "sheen", sparkle = true },
	{ id = "runelight", name = "Rune Light", rarity = "legendary", colours = { { 40, 50, 80 }, { 90, 240, 255 } }, material = "Neon", pattern = "bands", glow = true },
	{ id = "auroragem", name = "Aurora Gem", rarity = "legendary", colours = { { 80, 255, 190 }, { 170, 100, 255 }, { 255, 255, 255 } }, material = "Glass", pattern = "tri", glow = true, sparkle = true },
	{ id = "plasma", name = "Plasma", rarity = "epic", colours = { { 190, 60, 255 }, { 255, 120, 220 } }, material = "Neon", pattern = "wave", glow = true },
	{ id = "enchantedfrost", name = "Enchanted Frost", rarity = "mythic", colours = { { 150, 220, 255 }, { 255, 255, 255 } }, material = "Ice", pattern = "wave", glow = true, sparkle = true },
	-- Patterns
	{ id = "zigzag", name = "Zig-Zag", rarity = "common", colours = { { 255, 140, 40 }, { 40, 40, 50 } }, material = "SmoothPlastic", pattern = "stripes" },
	{ id = "polkadot", name = "Polka Dot", rarity = "common", colours = { { 230, 60, 70 }, { 255, 255, 255 } }, material = "SmoothPlastic", pattern = "fleck" },
	{ id = "checkerboard", name = "Checkerboard", rarity = "uncommon", colours = { { 40, 180, 170 }, { 250, 250, 250 } }, material = "SmoothPlastic", pattern = "stripes" },
	{ id = "tiedye", name = "Tie-Dye", rarity = "rare", colours = { { 255, 80, 160 }, { 255, 220, 60 }, { 60, 200, 255 } }, material = "Fabric", pattern = "candy" },
	{ id = "plaid", name = "Plaid", rarity = "uncommon", colours = { { 200, 40, 40 }, { 40, 60, 120 }, { 240, 220, 120 } }, material = "Fabric", pattern = "tri" },
	{ id = "camo", name = "Camouflage", rarity = "uncommon", colours = { { 90, 110, 60 }, { 60, 70, 40 }, { 150, 140, 100 } }, material = "Fabric", pattern = "fleck" },
	{ id = "neonstripes", name = "Neon Stripes", rarity = "rare", colours = { { 255, 60, 200 }, { 60, 255, 200 } }, material = "Neon", pattern = "stripes" },
	{ id = "hextiles", name = "Hexagon Tiles", rarity = "uncommon", colours = { { 60, 70, 90 }, { 110, 220, 255 } }, material = "DiamondPlate", pattern = "bands" },
	{ id = "splatter", name = "Paint Splatter", rarity = "rare", colours = { { 250, 250, 250 }, { 255, 70, 90 }, { 60, 150, 255 }, { 255, 210, 50 } }, material = "SmoothPlastic", pattern = "fleck" },
	{ id = "glitterfade", name = "Glitter Fade", rarity = "epic", colours = { { 255, 120, 200 }, { 120, 90, 255 } }, material = "Foil", pattern = "gradient", glow = true, sparkle = true },
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000D">
				<Properties>
					<string name="Name">NeedleTypes</string>
					<ProtectedString name="Source"><![CDATA[-- The needle types: each needle's shape (drawn by shared/NeedleLook; the newer ones are data in
-- shared/ShapesA.. made by dev/shapes.py). weight = how often it turns up (out of all the weights
-- together); value = its base worth (times the skin's rarity); grade = how special it is
-- (Needles.grades). The Classic weights are high so the novelty shapes stay rare.
return {
	{ id = "sewing", name = "Sewing Needle", weight = 50, value = 10, grade = "classic" },
	{ id = "pin", name = "Dressmaker's Pin", weight = 40, value = 8, grade = "classic" },
	{ id = "quilting", name = "Quilting Needle", weight = 30, value = 12, grade = "classic" },
	{ id = "darning", name = "Darning Needle", weight = 25, value = 14, grade = "classic" },
	{ id = "embroidery", name = "Embroidery Needle", weight = 22.5, value = 16, grade = "classic" },
	{ id = "tapestry", name = "Tapestry Needle", weight = 20, value = 18, grade = "classic" },
	{ id = "safety", name = "Safety Pin", weight = 20, value = 15, grade = "classic" },
	{ id = "knitting", name = "Knitting Needle", weight = 15, value = 22, grade = "classic" },
	{ id = "crochet", name = "Crochet Hook", weight = 12.5, value = 24, grade = "classic" },
	{ id = "bodkin", name = "Bodkin", weight = 7.5, value = 26, grade = "classic" },
	{ id = "curved", name = "Curved Upholstery Needle", weight = 5, value = 30, grade = "classic" },
	{ id = "sailmaker", name = "Sailmaker's Needle", weight = 2.5, value = 36, grade = "classic" },
	{ id = "firework", name = "Firework Needle", weight = 2.5, value = 45, grade = "fancy" },
	{ id = "jackhammer", name = "Jackhammer Needle", weight = 2, value = 50, grade = "fancy" },
