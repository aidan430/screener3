				<Properties>
					<string name="Name">NeedleTypes</string>
					<ProtectedString name="Source"><![CDATA[-- The needle types: each needle's shape (drawn by shared/NeedleLook; the newer ones are data in
-- shared/ShapesA.. made by dev/shapes.py). weight = how often it turns up (out of all the weights
-- together); value = its base worth (times the skin's rarity); grade = how special it is
-- (Needles.grades). The Classic weights are high so the novelty shapes stay rare.
return {
	{ id = "sewing", name = "Sewing Needle", weight = 50, value = 10, grade = "classic" },
	{ id = "pin", name = "Dressmaker's Pin", weight = 40, value = 8, grade = "classic" },
	{ id = "quilting", name = "Quilting Needle", weight = 30, value = 12, grade = "classic" },
	{ id = "darning", name = "Darning Needle", weight = 25, value = 14, grade = "classic" },
	{ id = "embroidery", name = "Embroidery Needle", weight = 22.5, value = 16, grade = "classic" },
	{ id = "tapestry", name = "Tapestry Needle", weight = 20, value = 18, grade = "classic" },
	{ id = "safety", name = "Safety Pin", weight = 20, value = 15, grade = "classic" },
