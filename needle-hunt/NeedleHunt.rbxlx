		{ "p", 0.1, 0.19, 0.19, 0.7, 0, 0, 0, 0, 0, { 214, 184, 134 }, "C", 0 }, { "p", 0.1, 0.17, 0.17, 0.79, 0, 0, 0, 0, 0, { 214, 184, 134 }, "C", 0 },
