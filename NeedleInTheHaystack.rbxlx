<roblox version="4">
	<Item class="ReplicatedStorage" referent="RBX00000">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX00001">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00002">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- Every number you might want to tune lives here. Change it, rebuild, play-test.
-- It requires only its companion Config* files (more of the same numbers), so the server, the client and the checks can all read it.
local Config = {}

Config.Title = "Needle in the Haystack"
Config.FarmName = "Hollow Creek Farm"

-- Plots: each player gets one. All four are the SAME place, the middle of the farm, with the
-- haystack at its centre: everyone sees and digs only their own haystack, and only their own
-- buildings and hay (other players' are hidden and pass-through on your screen).
Config.PlotSize = 170 -- the build area round the haystack (the countryside starts at about 89)
Config.FarmScale = 0.55 -- the countryside, fence and ground are pulled in to this share of their size
Config.PlotCentres = { { 0, 0 }, { 0, 0 }, { 0, 0 }, { 0, 0 } }
Config.FarmEntrance = { 0, 0, 80 } -- where you arrive: south of the haystack, facing it
Config.TraderStart = { 0, 0, 58 } -- your trader's stall, between the haystack and where you arrive
Config.TruckStart = { 14, 0, 100 } -- trucks drive in from the south meadow, beside the arrival path
Config.BuildClear = 50 -- no part of anything can stand this close to the haystack's centre, below its top

-- The heap: 5,000,000 straws in clumps, one smooth terrain haystack 80 studs (22 m) high and
-- 88 across: steep sides and a rounded top, like a beehive haystack.
-- Each clump is one 4-stud terrain cell (the terrain grid size, so keep ClumpSize = 4).
Config.TotalStraws = 5000000
Config.Clumps = 5000 -- each holds TotalStraws / Clumps = 1,000 straws
Config.ClumpSize = 4
Config.PileLayers = 20 -- 20 layers x 4 studs = 80 studs
Config.PileRadiusBottom = 44
Config.PileRadiusTop = 4
-- radius at height share t: top + (bottom - top) x (1 - t ^ PileDome) ^ PileCurve
Config.PileDome = 2.5 -- above 1: the sides stay wide for longer, then round over
Config.PileCurve = 0.7 -- below 1: a fuller, rounder top
Config.HeapColour = { 238, 196, 66 } -- golden yellow
Config.HeapMaterial = "Limestone" -- the heap's own terrain material (nothing else uses it): pale, so it takes the gold well
Config.HeapSkirt = { from = 43, to = 49, height = 14 } -- the heap's drawn foot: hay sloping from `from` (`height` high) to the ground at `to`
Config.HeapLumpiness = 0.45 -- 0 = a smooth dome; higher = a lumpier, more hay-like surface
-- Your hay texture: upload it (and its normal map) in Studio (Asset Manager > Import), paste the IDs
-- here ("rbxassetid://123"), rebuild: the heap, hay on tools and bundles wear it. Empty = plain gold.
Config.HayTexture = ""
Config.HayNormal = ""
Config.HayTextureStuds = 5 -- how many studs one copy of the texture covers
-- The hay model you imported and uploaded (a Model or a mesh ID): lumps on tools, flying hay,
-- bundles, bales' neighbours and the mounds round the heap use it. 0 = rounded hay balls.
Config.HayModel = 0
-- Or a bare mesh ID and its texture (used only if HayModel is 0 or doesn't load).
Config.HayMesh = ""
Config.HayMeshTexture = ""
Config.HayTint = { 255, 246, 225 }
-- The fields and plot floors (terrain and parts of the LeafyGrass material), the same way.
Config.GroundTexture = "rbxassetid://92652087782912" -- the owner's grass (gltf_embedded_2)
Config.GroundNormal = "rbxassetid://81088945047843" -- its normal map (gltf_embedded_3)
Config.GroundTextureStuds = 16
Config.GroundTint = { 230, 236, 210 } -- the ground's colour with the texture on
-- Models the owner uploaded (0 / {} = the built-in look). Turn = degrees to spin a model so
-- its front faces the right way.
Config.TraderModel = { id = 108636101057161, width = 12, turn = 0 } -- the Barraca stall: every Trader's Stall
Config.TruckModel = { id = 116817249965623, turn = 0 } -- the owner's truck model: every truck wears it, scaled to its length
Config.TreeModels = { 132180459559700, 124134724279082, 115582622540743, 137807887477417 } -- white birches
Config.HeapMounds = 16 -- loose hay mounds round the foot of each heap (just for looks) -- the heap's colour with the texture on (white = the image as is)
Config.MaxSlopeAngle = 46 -- players can't walk up anything steeper: they build to climb
-- The needle hides deep inside the upper heap: between these shares of the height, and no
-- further from the middle than this share of the heap's width there. Machines peel the heap
-- from the outside in, so they reach it last; climbing up and digging in finds it sooner.
Config.NeedleHeight = { 0.5, 0.8 }
Config.NeedleCore = 0.4
Config.Reach = 18 -- studs from your head to a clump you can harvest
Config.SearchCooldown = 0.3 -- seconds between harvests (the Swift perk shortens it)

Config.CoinsPerStraw = 1

-- Tools: power = straws per click, capacity = straws you can carry before selling; shape =
-- the built look (server/ToolParts, ToolGadgets), or model = an uploaded model's ID.
-- Any tool can wear a model imported in Studio: model = its asset ID, length = studs long. It's
-- held straight out in front, working end forward. flip = false if it points backwards,
-- roll = degrees to turn it about its length (so a scoop faces up), bladeTop = studs from the
-- middle of the blade to where hay sits on it, loadAt = how far along the hay sits (0..0.5),
-- loadSize = how big the hay on it gets. Without a model a tool is built as a pitchfork.
Config.Tools = {
	{ name = "Garden Trowel", model = 139238222017221, length = 3, power = 1, capacity = 300, price = 0, shaft = { 112, 82, 58 }, head = { 128, 98, 78 }, material = "CorrodedMetal" },
	{ name = "Wooden Pitchfork", shape = "fork3", power = 2, capacity = 1000, price = 380, shaft = { 160, 116, 72 }, head = { 176, 128, 82 }, material = "Wood" },
	{ name = "Iron Pitchfork", shape = "fork4", power = 3, capacity = 2500, price = 2280, shaft = { 150, 108, 66 }, head = { 165, 170, 178 }, material = "Metal" },
	{ name = "Steel Rake", shape = "rake", power = 5, capacity = 5000, price = 9500, shaft = { 120, 84, 50 }, head = { 190, 196, 204 }, material = "Metal" },
	{ name = "Golden Rake", shape = "goldrake", power = 7, capacity = 9000, price = 38000, shaft = { 120, 84, 50 }, head = { 245, 200, 66 }, material = "Metal" },
	{ name = "Hay Blower", shape = "blower", power = 9, capacity = 18000, price = 114000, shaft = { 70, 72, 84 }, head = { 232, 92, 60 }, material = "SmoothPlastic" },
	{ name = "Super Sifter", shape = "sifter", power = 12, capacity = 32000, price = 304000, shaft = { 60, 64, 78 }, head = { 90, 200, 255 }, material = "Neon" },
	{ name = "Magnet Gloves", shape = "magnet", power = 15, capacity = 50000, price = 760000, shaft = { 200, 200, 210 }, head = { 220, 40, 40 }, material = "SmoothPlastic" },
	{ name = "Twin Turbines", shape = "turbines", power = 19, capacity = 75000, price = 1615000, shaft = { 40, 44, 52 }, head = { 255, 170, 40 }, material = "Metal" },
	{ name = "Needle Detector", shape = "detector", power = 22, capacity = 100000, price = 3230000, shaft = { 40, 44, 52 }, head = { 70, 255, 150 }, material = "Neon" },
}
Config.DetectorLevel = 10 -- from this tool on, the HUD shows how close the needle is
Config.LoadSize = 2.4 -- studs across the hay on a full tool

-- Buckets hang at your hip and carry what the tool can't: tool fills first, then the bucket.
Config.Buckets = {
	{ name = "No bucket", capacity = 0, price = 0, size = 0 },
	{ name = "Tin Pail", capacity = 600, price = 1425, size = 1.2 },
	{ name = "Hay Bucket", capacity = 2000, price = 8550, size = 1.6 },
	{ name = "Big Tub", capacity = 6000, price = 57000, size = 2 },
	{ name = "Hay Barrel", capacity = 20000, price = 380000, size = 2.4 },
	{ name = "Giant Basket", capacity = 60000, price = 2375000, size = 2.8 },
}

-- The silo on your plot holds what your machines harvest until you next sell.
Config.Silos = {
	{ name = "Hay Shed", size = 2000, price = 0 },
	{ name = "Small Silo", size = 10000, price = 14250 },
	{ name = "Big Silo", size = 40000, price = 142500 },
	{ name = "Twin Silos", size = 150000, price = 950000 },
	{ name = "Grain Tower", size = 500000, price = 4750000 },
}

-- Machines harvest the top of your pile into the silo, while you're in the game, if your
-- generators make enough power. rate = straws a second, draw = power used.
Config.Machines = {
	{ id = "hen", name = "Clockwork Hen", rate = 0.15, draw = 2, price = 1520, max = 10, size = { 4, 4, 4 }, color = { 236, 180, 70 } },
	{ id = "sieve", name = "Sorting Sieve", rate = 0.6, draw = 6, price = 19000, max = 10, size = { 5, 5, 5 }, color = { 150, 150, 160 } },
	{ id = "thresher", name = "Steam Thresher", rate = 1.5, draw = 12, price = 152000, max = 8, size = { 6, 6, 6 }, color = { 90, 70, 60 } },
	{ id = "vacuum", name = "Hay Vacuum", rate = 3.6, draw = 24, price = 855000, max = 6, size = { 7, 7, 7 }, color = { 200, 80, 60 } },
	{ id = "tornado", name = "Hay Tornado", rate = 10, draw = 0, price = 0, max = 1, robux = 1, size = { 6, 10, 6 }, color = { 240, 220, 150 } },
	{ id = "magnetron", name = "Needle Magnetron", rate = 7.5, draw = 45, price = 3800000, max = 4, size = { 8, 8, 8 }, color = { 70, 255, 150 } },
}

-- Generators power the machines. power = units made.
Config.Generators = {
	{ id = "crank", name = "Hand-Crank Dynamo", power = 4, price = 1140, max = 10, size = { 4, 4, 4 }, color = { 140, 110, 80 } },
	{ id = "diesel", name = "Diesel Generator", power = 15, price = 14250, max = 10, size = { 5, 5, 6 }, color = { 90, 120, 70 } },
	{ id = "wind", name = "Wind Turbine", power = 40, price = 104500, max = 8, size = { 4, 20, 4 }, color = { 236, 236, 230 } },
	{ id = "steam", name = "Steam Engine", power = 100, price = 665000, max = 6, size = { 7, 8, 9 }, color = { 120, 80, 60 } },
	{ id = "burner", name = "Hay Burner", power = 30, price = 7600, max = 6, burner = true, size = { 5, 6, 5 }, color = { 150, 80, 50 } },
	{ id = "lightning", name = "Lightning Rod Array", power = 260, price = 3800000, max = 4, size = { 6, 24, 6 }, color = { 120, 170, 255 } },
}

-- Building pieces for climbing your pile, placed anywhere on your plot.
Config.Pieces = {
	{ id = "ladder", name = "Ladder", price = 190, size = { 4, 20, 2 }, model = 111414262141412, text = "Climb 20 studs straight up. Stack them to go higher." },
	{ id = "stairs", name = "Stairs", price = 285, size = { 8, 10, 10 }, text = "Climbs 10 studs over 10 studs." },
	{ id = "landing", name = "Landing", price = 140, size = { 10, 1, 10 }, text = "A 10 by 10 floor to stand and turn on." },
	{ id = "pillar", name = "Pillar", price = 95, size = { 2, 10, 2 }, text = "A 10-stud post to hold things up." },
	{ id = "escalator", name = "Escalator", price = 3800, size = { 8, 10, 10 }, text = "Stairs that carry you up 10 studs." },
	{ id = "elevator", name = "Elevator", price = 28500, size = { 10, 51, 10 }, text = "A 50-stud lift. Press E at the bottom or top." },
	{ id = "teleporter", name = "Teleporter Pad", price = 23750, size = { 8, 1, 8 }, text = "Step on, press E, pick any of your other pads." },
	{ id = "conveyor", name = "Conveyor Belt", price = 760, size = { 6, 1, 12 }, text = "Carries dropped hay (G) along, towards its arrow." },
	{ id = "chute", name = "Conveyor Down", price = 1425, size = { 6, 10, 12 }, text = "A belt that carries hay down 10 studs, off a platform." },
	{ id = "baler", name = "Bale Maker", price = 57000, max = 3, size = { 8, 7, 10 }, text = "Feed it hay at the back; it pushes out bales. Trucks carry bales 3x as easily." },
	{ id = "trader", name = "Trader's Stall", price = 0, max = 1, size = { 12, 12, 8 }, text = "Your trader. Dump your hay in the basket. Move it anywhere, even up a platform." },
}
Config.BasketDrainSeconds = 4 -- how fast the basket's hay level eases down after a dump (just for show)

-- Hauling: what you dump waits in your trader's basket. The trader himself buys TraderRate
-- straws a second; trucks fetch more (rate = straws a second each, as one load a trip).
-- Baled hay packs tighter: a truck or the trader moves BaleCompaction times as much of it.
Config.TraderRate = 8
Config.TruckTripSeconds = 40
Config.Trucks = {
	{ id = "van", name = "Farm Van", rate = 15, price = 7600, max = 2, size = { 6, 6, 11 }, color = { 236, 236, 228 } },
	{ id = "mini", name = "Mini Truck", rate = 35, price = 57000, max = 2, size = { 6, 6, 13 }, color = { 70, 130, 200 } },
	{ id = "semi", name = "Semi Truck", rate = 90, price = 475000, max = 2, size = { 8, 9, 24 }, color = { 196, 72, 56 } },
	{ id = "big", name = "Large Truck", rate = 220, price = 2850000, max = 2, size = { 9, 10, 30 }, color = { 60, 120, 70 } },
}
Config.AutoDumpRange = 9 -- walk this close to your own basket and your load dumps itself
Config.BasketShowFull = 5000 -- straws waiting at which the basket looks full

-- Loose hay: press DropKey to drop what you carry as a bundle. Conveyors carry bundles; your
-- trader's basket and bale makers take them in. Bundles and bales left lying for
-- LooseHayMinutes go to your basket by themselves, and so does everything when you leave.
Config.DropKey = "G"
Config.HomeKey = "T" -- back to your own farm from anywhere
Config.HomeCooldown = 5
Config.MaxLooseHay = 40 -- bundles and bales on one plot at once
Config.LooseHayMinutes = 10
Config.ConveyorSpeed = 10 -- studs a second
Config.BaleStraws = 2000 -- straws in one bale
Config.BaleCompaction = 3
Config.BuildGrid = 1 -- placement snaps to this many studs
Config.MaxPlaced = 400 -- pieces, machines and generators on one plot

-- Perks are bought per tool (they reset when you buy a new tool).
Config.Perks = {
	{ id = "sharp", name = "Sharpened", per_level = 0.15, levels = 5, price = 115, growth = 1.6, text = "+15% straws a click per level" },
	{ id = "swift", name = "Swift", per_level = 0.10, levels = 5, price = 115, growth = 1.6, text = "-10% cooldown per level" },
	{ id = "lucky", name = "Lucky", per_level = 0.004, levels = 5, price = 140, growth = 1.6, text = "+0.4% chance of a lucky find per level" },
}

Config.LuckyChance = 0.006
Config.LuckyValueSearches = 60

-- Sounds: paste asset IDs from the Studio Toolbox (e.g. "rbxassetid://12345"). "" = silent.
-- The rbxasset://sounds/... files ship inside every Roblox client (the default character and
-- classic gear sounds), so they can't go private or be removed. Check them in Studio.
Config.Sounds = {
	harvest = "rbxasset://sounds/action_footsteps_plastic.mp3", -- a soft, muffled touch
	pop = "rbxasset://sounds/action_jump_land.mp3", -- a soft "fwump" when a clump empties
	coins = "rbxasset://sounds/electronicpingshort.wav", -- a short, gentle chime
	cheer = "rbxasset://sounds/electronicpingshort.wav", -- the same chime, lower and fuller
	spin = "",
	detector = "rbxasset://sounds/electronicpingshort.wav", -- the metal detector's beep
}
-- Per sound: volume (0-1), pitch multiplier, wobble = random pitch +/- so clicks don't tire.
Config.SoundSettings = {
	harvest = { volume = 0.25, pitch = 1.1, wobble = 0.06 },
	pop = { volume = 0.4, pitch = 0.85 },
	coins = { volume = 0.3, pitch = 1 },
	cheer = { volume = 0.35, pitch = 0.7 },
	detector = { volume = 0.18, pitch = 0.8 },
}

-- Background music: soft acoustic / country instrumentals, looping on each player's side
-- with a gentle fade between tracks and a music on/off button (top right). A track that
-- won't load is skipped quietly. Licensed library tracks Roblox uploaded for every game:
Config.Music = {
	{ id = "rbxassetid://1844140274", name = "Country Folk Picking" }, -- found online, check in Studio
	{ id = "rbxassetid://1842101902", name = "Acoustic Nomad" }, -- found online, check in Studio
}
Config.MusicVolume = 0.25
Config.MusicFadeSeconds = 3 -- fade out at a track's end, fade in the next
Config.MusicLoadSeconds = 10 -- a track that hasn't loaded by then is skipped

-- Jetpack (Robux game pass, Config.GamePasses.Jetpack). Hold Space in the air to rise, let go
-- to drift gently down, or press the hover key to stay put; steer with WASD as usual.
Config.Jetpack = {
	riseSpeed = 18, -- studs a second going up
	fallSpeed = 7, -- studs a second drifting down after you let go (a soft landing)
	thrust = 2.5, -- most force it pushes with, in body weights: it can never fling you
	ease = 5, -- how quickly the speed eases to its target (higher = snappier)
	ceiling = 275, -- no lift above this height (the haystack is 80 high; the loft starts at 300)
	fuelSeconds = 0, -- seconds of flight before you land to refuel; 0 = unlimited
	refuelSeconds = 4, -- seconds on the ground to refill a full tank
	hoverKey = "H", -- F already places things in build mode
}

-- One friendly Robux suggestion per session, after this many clumps harvested. It lists only
-- items whose ID is set, has a "No thanks" button as big as the others, and never comes back.
Config.OfferAfterClumps = 25

Config.DataStoreName = "NeedleHaystack_v5" -- v5: the lower, wider haystack numbers clumps differently
Config.AutosaveSeconds = 120

-- Robux. Nothing shows in the shop until you create the item on the Creator Dashboard
-- (after publishing) and paste its ID here. 0 = switched off.
Config.GamePasses = {
	AutoSell = 2075810331, -- when you're full, what you carry goes to your basket by itself
	VIP = 2075654337, -- +25% coins, and machines keep running up to an hour after you leave
	DoubleMachines = 2074994344, -- every machine works twice as fast (same power)
	Jetpack = 2074622358, -- hold Space in the air to fly up and hover over your pile (see Config.Jetpack)
	SuperTool = 0, -- whatever tool you hold lifts SuperToolBoost x the hay, carries that much more, and glows
	HayTornado = 0, -- a Hay Tornado machine for your farm: 10 straws a second, needs no power
	RainbowHay = 0, -- cosmetic: your hay shows in shifting rainbow colours
	SparkleTrail = 0, -- cosmetic: a soft golden sparkle trail follows you
}
Config.SuperToolBoost = 2
Config.Products = {
	SpeedBoost = 3728655884, -- 2x straws a click for 1 hour
	CoinBoost = 3728656281, -- 2x coins for all hay sold, for 1 hour
	MerchantWhistle = 3728724146, -- send your load to your basket from anywhere, 10 times
	StrawBlast = 3728723944, -- 100,000 straws off your haystack (outside first) into your basket
	LuckyCharm = 3728723863, -- 5x lucky finds for 1 hour
	WheelSpin = 3728724329, -- one spin of the Wheel of Fortune
}
Config.BoostSeconds = 3600
Config.WhistleUses = 10
Config.StrawBlastAmount = 100000
Config.VipCoinBonus = 0.25
Config.VipOfflineSeconds = 3600

-- The Wheel of Fortune (Robux). Every spin wins something. The odds are shown on the wheel
-- before buying, and the wheel is hidden where paid random items aren't allowed.
-- weight / total weight = chance. A skin you already own pays `WheelDuplicateSearches` instead.
Config.Wheel = {
	{ id = "rose", about = "A soft shine glides along it", pass = 0, flow = { 0.05, 0 }, gleam = 5, name = "Rose Gold skin", weight = 3000, texture = "", shaft = { 120, 70, 60 }, head = { 232, 160, 150 }, material = "Metal" },
	{ id = "ice", about = "Frost and twinkling stars", pass = 0, flow = { 0, 0.04 }, twinkle = 3, name = "Ice skin", weight = 2500, texture = "", shaft = { 180, 220, 240 }, head = { 210, 240, 255 }, material = "Ice" },
	{ id = "lava", about = "Glowing cracks that flow", pass = 0, flow = { 0, -0.3 }, pulse = 0.5, name = "Lava skin", weight = 2000, texture = "", shaft = { 60, 30, 20 }, head = { 255, 90, 30 }, material = "Neon" },
	{ id = "candy", about = "Rolling candy stripes", pass = 0, flow = { 0.4, 0 }, name = "Candy Cane skin", weight = 1500, texture = "", shaft = { 245, 245, 245 }, head = { 230, 40, 60 }, material = "SmoothPlastic" },
	{ id = "galaxy", about = "A drifting purple galaxy", pass = 0, flow = { 0.06, 0.04 }, pulse = 0.3, twinkle = 4, name = "Galaxy skin", weight = 700, texture = "", shaft = { 30, 20, 60 }, head = { 140, 90, 255 }, material = "Neon" },
	{ id = "diamond", about = "A gleam every few seconds", pass = 0, gleam = 3, twinkle = 2, name = "Diamond skin", weight = 299, texture = "", shaft = { 200, 230, 255 }, head = { 160, 220, 255 }, material = "Glass" },
	{ id = "needle", name = "NEEDLE REVEAL", weight = 1, reveal = true },
}
-- pass = the skin's own game pass ID (buy it directly; 0 = not on sale). Skin animation (client/SkinFx): flow = pattern drift (studs/s), pulse = glow swell, gleam = s between shines, twinkle = sparkles/s
Config.WheelDuplicateSearches = 200
Config.WheelMinSlice = 0.004 -- the thinnest slice on the wheel's face (of a turn), so the needle reveal shows
Config.SkinTextureStuds = 1.5 -- studs one copy of a patterned skin covers on the built tools

-- The Golden Loft: a secret golden haystack above the hub where straw pays 20x.
Config.Loft = { straws = 250000, coinMultiplier = 20, needleEarliest = 0.5 }

-- More numbers kept in companion files (to keep each under 300 lines): the factory line and
-- processing chain, the guided goals, and stamina and the metal detector. Their lists add to the ones above.
for _, file in ipairs({ "ConfigFactory", "ConfigGoals", "ConfigPlayer", "ConfigWorlds", "ConfigPads", "ConfigLobby" }) do
	for name, value in pairs(require(script.Parent:WaitForChild(file))) do
		if type(value) == "table" and type(Config[name]) == "table" and #value > 0 then
			for _, entry in ipairs(value) do
				table.insert(Config[name], entry)
			end
		else
			Config[name] = value
		end
	end
end

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00003">
				<Properties>
					<string name="Name">ConfigFactory</string>
					<ProtectedString name="Source"><![CDATA[-- The factory line and the processing chain's numbers (Config.luau merges this file in, so
-- read and tune these as Config.<Name>; lists here are added to the end of Config's lists).
local Config = {}

-- More pieces for the Build tab: belt corners and splitters, and the processing machines.
Config.Pieces = {
	{ id = "corner", name = "Belt Corner", price = 285, size = { 6, 1, 6 }, text = "Turns hay on a belt to the side. Press R until the arrows point the way you want." },
	{ id = "splitter", name = "Belt Splitter", price = 2375, size = { 6, 1, 6 }, text = "Sends hay left, then right, then left: feed two lines from one." },
	{ id = "wrapper", name = "Bale Wrapper", price = 142500, max = 3, size = { 8, 6, 10 }, text = "Bales in at the back, wrapped bales out: worth more, and orders ask for them." },
	{ id = "press", name = "Pellet Press", price = 380000, max = 3, size = { 8, 7, 10 }, text = "Bundles in at the back, sacks of hay pellets out: worth more again." },
}

-- Feeders take hay from your heap by themselves and put it on your belts as bundles, using
-- power like machines. amount = straws a go, every = seconds between goes, draw = power,
-- throw = how far a thrower flings its bundle forward (studs).
Config.Feeders = {
	{ id = "arm", name = "Hay Arm", amount = 8, every = 4, draw = 6, price = 47500, max = 8, size = { 4, 7, 4 } },
	{ id = "thrower", name = "Hay Thrower", amount = 30, every = 4, draw = 30, price = 855000, max = 6, size = { 5, 4, 6 }, throw = 22 },
}
Config.FeederReach = 30 -- a feeder only takes hay if your heap is this close (studs from its base)

-- Hay Burner (in the generator list): power while it has hay to burn, fed by belt or by hand.
Config.BurnerSecondsPerStraw = 0.25 -- 1,000 straws keep a burner going for about 4 minutes

-- Belt motors: every belt you own runs at the speed of your level (bought in Logistics).
Config.BeltSpeeds = {
	{ speed = 10, price = 0 },
	{ speed = 14, price = 19000 },
	{ speed = 19, price = 114000 },
	{ speed = 25, price = 665000 },
}

-- Processing: what each product is worth, as a multiple of the straws in it, and how tightly
-- trucks pack it (bales already pack 3x).
Config.Processing = {
	wrapped = { value = 1.4, name = "wrapped bale" },
	pellet = { value = 1.7, straws = 500, name = "pellet sack" },
}

-- Delivery orders: a truck driver asks for straws of one kind (loose bundles, bales, wrapped
-- bales, pellet sacks). Everything of that kind reaching your basket counts by its straws; the
-- reward is a bonus on top of the sale (about 0.2-0.5 coins a straw). Each full round of orders
-- asks for and pays OrderGrowth times more, so the bonus per straw stays the same.
Config.Orders = {
	{ kind = "bundle", straws = 2000, reward = 400 },
	{ kind = "bale", straws = 10000, reward = 3000 },
	{ kind = "bundle", straws = 20000, reward = 4000 },
	{ kind = "bale", straws = 40000, reward = 12000 },
	{ kind = "wrapped", straws = 40000, reward = 16000 },
	{ kind = "pellet", straws = 20000, reward = 10000 },
	{ kind = "wrapped", straws = 100000, reward = 40000 },
	{ kind = "pellet", straws = 100000, reward = 50000 },
}
Config.OrderGrowth = 1.5

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00004">
				<Properties>
					<string name="Name">ConfigGoals</string>
					<ProtectedString name="Source"><![CDATA[-- The guided goals and the secret achievements (Config.luau merges this file in: read and tune
-- them as Config.Goals, Config.Achievements etc.).
local Config = {}

-- Goals: a guided list, in order, each paying `reward` coins. kind: stat (d.stats[key]), tool / bucket / silo
-- (level n), clumps (harvested), placed (key on your plot), truck (key owned), machines / power (on your plot).
-- Saved by position (d.goal): add new goals at the end, or players skip or repeat one. Two a line (300-line limit).
Config.Goals = {
	{ id = "first_hay", text = "Aim at your haystack and click to lift some hay", kind = "stat", key = "searches", n = 1, reward = 25 }, { id = "fill_tool", text = "Keep harvesting until your tool is full", kind = "stat", key = "loads_filled", n = 1, reward = 50 },
	{ id = "dump", text = "Dump your hay in your trader's basket", kind = "stat", key = "dumps", n = 1, reward = 75 }, { id = "first_sale", text = "Let your trader sell 500 straws", kind = "stat", key = "straws_sold", n = 500, reward = 100 },
	{ id = "pitchfork", text = "Buy the Wooden Pitchfork in the shop (Q)", kind = "tool", n = 2, reward = 150 }, { id = "ladder", text = "Buy a Ladder and build it (B) by your heap", kind = "placed", key = "ladder", n = 1, reward = 100 },
	{ id = "clumps10", text = "Harvest 10 whole clumps", kind = "clumps", n = 10, reward = 200 }, { id = "bucket", text = "Buy a Tin Pail to carry more", kind = "bucket", n = 2, reward = 300 },
	{ id = "stairs", text = "Build some Stairs up your heap", kind = "placed", key = "stairs", n = 1, reward = 150 }, { id = "drop", text = "Press G to drop your hay as a bundle", kind = "stat", key = "drops", n = 1, reward = 150 },
	{ id = "belt", text = "Place a Conveyor Belt to carry bundles", kind = "placed", key = "conveyor", n = 1, reward = 300 }, { id = "dynamo", text = "Place a Hand-Crank Dynamo for power", kind = "placed", key = "crank", n = 1, reward = 400 },
	{ id = "hen", text = "Place a Clockwork Hen to harvest for you", kind = "placed", key = "hen", n = 1, reward = 500 }, { id = "iron", text = "Buy the Iron Pitchfork", kind = "tool", n = 3, reward = 600 },
	{ id = "clumps25", text = "Harvest 25 whole clumps", kind = "clumps", n = 25, reward = 800 }, { id = "van", text = "Buy a Farm Van to sell hay faster", kind = "truck", key = "van", n = 1, reward = 1500 },
	{ id = "sold10k", text = "Sell 10,000 straws", kind = "stat", key = "straws_sold", n = 10000, reward = 1500 }, { id = "power20", text = "Make 20 power with your generators", kind = "power", n = 20, reward = 2000 },
	{ id = "clumps50", text = "Harvest 50 whole clumps", kind = "clumps", n = 50, reward = 2500 }, { id = "machines3", text = "Have 3 machines on your plot", kind = "machines", n = 3, reward = 3000 },
	{ id = "rake", text = "Buy the Steel Rake", kind = "tool", n = 4, reward = 4000 }, { id = "silo", text = "Upgrade to a Small Silo", kind = "silo", n = 2, reward = 4000 },
	{ id = "baler", text = "Build a Bale Maker", kind = "placed", key = "baler", n = 1, reward = 10000 }, { id = "bale", text = "Feed it hay on a belt and make a bale", kind = "stat", key = "bales_made", n = 1, reward = 8000 },
	{ id = "clumps100", text = "Harvest 100 whole clumps", kind = "clumps", n = 100, reward = 15000 },
}
Config.GoalCheckSeconds = 2 -- how often the server looks at your current goal
Config.RateWindowSeconds = 60 -- the HUD's coins/min counts what you earned in this many seconds

-- Achievements stay hidden until you earn them. Any ten open the Golden Loft above the hub.
Config.Achievements = {
	{ id = "first_straw", name = "First Straw", text = "Harvest your first straw.", stat = "searches", goal = 1 },
	{ id = "full_load", name = "Full Load", text = "Fill your tool to the brim.", stat = "loads_filled", goal = 1 },
	{ id = "merchant", name = "Merchant's Friend", text = "Sell 100,000 straws to the merchant.", stat = "straws_sold", goal = 100000 },
	{ id = "collector", name = "Collector", text = "Own every tool, up to the Needle Detector.", stat = "tool", goal = 10 },
	{ id = "engineer", name = "Engineer", text = "Have 10 machines working on your plot.", stat = "machines", goal = 10 },
	{ id = "power_plant", name = "Power Plant", text = "Generate 500 power on your plot.", stat = "power", goal = 500 },
	{ id = "sky_high", name = "Sky High", text = "Stand on top of your haystack, 75 studs up.", stat = "best_height", goal = 75 },
	{ id = "perfectionist", name = "Perfectionist", text = "Max out all three perks on one tool.", stat = "perks_maxed", goal = 1 },
	{ id = "lucky", name = "Lucky Duck", text = "Make 25 lucky finds in the hay.", stat = "lucky_finds", goal = 25 },
	{ id = "needle", name = "Needle Finder", text = "Find the needle.", stat = "needles", goal = 1 },
	{ id = "golden_straw", name = "Hidden Straw", text = "Find the golden straw hidden on the farm.", stat = "secret_straw", goal = 1 },
}
Config.LoftAchievements = 10 -- this many achievements (any of them) open the Golden Loft
Config.SecretStraw = { -119, 0.7, 119 } -- the hidden golden straw: tucked behind the water tower
Config.BadgeIds = {} -- optional: { first_straw = 123456 } awards a Roblox badge too

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00005">
				<Properties>
					<string name="Name">ConfigLobby</string>
					<ProtectedString name="Source"><![CDATA[-- The lobby: a floating meadow island where everyone arrives, with a walk-in portal arch to the
-- farm and to each world (Config.luau merges this file in: read and tune them as
-- Config.Lobby, Config.LobbyPortals and the other Config.Lobby* numbers).
local Config = {}

Config.LobbyName = "Sky Meadow"
-- The island's centre (x, z; studs) and the height of its grass. Far from the farm (about 170
-- from the middle) and from the four worlds (2,500 out on each axis, 220 round each).
Config.Lobby = { x = 1300, floor = 0, z = 1300 }
Config.LobbyRadius = 70 -- the island is this many studs from its centre to its rim (140 across)
Config.LobbyInside = 130 -- within this many studs (flat) of the centre you are "in" the lobby
Config.LobbyArrival = { 0, 40 } -- where you arrive ({ x, z } from the centre), facing the arches (north)

-- The portal arches, in a semicircle 48 studs north of the centre, facing it. id "farm" is your
-- farm (free, always open); the others are Config.Worlds ids, opened once with coins.
-- at = { x, z } from the lobby's centre.
Config.LobbyPortals = {
	{ id = "moon", at = { -43.1, -21 } },
	{ id = "lava", at = { -25.4, -40.7 } },
	{ id = "farm", at = { 0, -48 } },
	{ id = "atlantis", at = { 25.4, -40.7 } },
	{ id = "field", at = { 43.1, -21 } },
}
Config.LobbyFarmColour = { 242, 196, 82 } -- the farm arch's glow (straw gold)
-- The arch on the farm that leads back here: x studs west of the middle, `past` studs beyond the
-- south edge of the build area (Config.PlotSize / 2), and never nearer than `behind` studs south
-- of where you arrive (Config.FarmEntrance). It faces the haystack.
Config.LobbyFarmPortal = { x = -26, past = 8, behind = 14 }
Config.PortalTexture = "" -- the portals' flowing light: upload assets/portal/portal-flow.png, paste "rbxassetid://..."
Config.PortalFlow = 2.5 -- studs a second the portals' light flows upwards
Config.LobbyPortalCooldown = 2 -- seconds between two trips through any arch
Config.LobbyFade = { into = 0.35, hold = 0.3, out = 0.9 } -- the soft fade round every trip (seconds)
Config.LobbyNudge = { back = 26, up = 12 } -- a locked arch eases you back out (studs/s)
Config.LobbyFallBelow = -60 -- anyone who drifts off the island below this height is set back on it

-- The lobby's light (eased in on your own screen, like a world's): a bright, soft sky morning.
Config.LobbyMood = { clock = 13, brightness = 2.6, ambient = { 112, 118, 132 }, outdoor = { 172, 182, 198 }, shift = { 255, 246, 232 }, color = { 214, 230, 255 }, decay = { 156, 182, 220 }, density = 0.3, haze = 1.2, glare = 0.2 }

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00006">
				<Properties>
					<string name="Name">ConfigPads</string>
					<ProtectedString name="Source"><![CDATA[-- The Robux corner: one holographic pad per Robux item, in the lobby (Config.luau
-- merges this file in: read and tune them as Config.RobuxPads and the other Config.RobuxPad*).
-- Stepping on a pad only offers its item; closing Roblox's prompt costs nothing.
local Config = {}

-- One row per pad. kind "pass" = Config.GamePasses[key], "product" = Config.Products[key]; a pad
-- whose ID is 0 isn't built. at = { x, z } studs from the lobby's centre (Config.Lobby; -z is
-- north, towards the portal arches), so the pads move with the lobby.
-- An arc of 10 along the lobby's east and south-east rim and 4 on the west rim, 56 studs out,
-- 10 degrees apart, clear of the arches (north) and of the arrival path (south).
Config.RobuxPads = {
	{ kind = "pass", key = "AutoSell", at = { 55.7, -5.9 } },
	{ kind = "pass", key = "DoubleMachines", at = { 55.9, 3.9 } },
	{ kind = "pass", key = "VIP", at = { 54.3, 13.5 } },
	{ kind = "pass", key = "Jetpack", at = { 51.2, 22.8 } },
	{ kind = "product", key = "MerchantWhistle", at = { 46.4, 31.3 } },
	{ kind = "product", key = "SpeedBoost", at = { 40.3, 38.9 } },
	{ kind = "product", key = "CoinBoost", at = { 32.9, 45.3 } },
	{ kind = "product", key = "LuckyCharm", at = { 24.5, 50.3 } },
	{ kind = "product", key = "StrawBlast", at = { 15.4, 53.8 } },
	{ kind = "product", key = "WheelSpin", at = { 5.9, 55.7 } }, -- opens the wheel's odds, never a prompt
	-- the extras and the just-for-fun passes, mirrored on the west rim
	{ kind = "pass", key = "SuperTool", at = { -55.7, -5.9 } },
	{ kind = "pass", key = "HayTornado", at = { -55.9, 3.9 } },
	{ kind = "pass", key = "RainbowHay", at = { -54.3, 13.5 } },
	{ kind = "pass", key = "SparkleTrail", at = { -51.2, 22.8 } },
}
Config.RobuxPadFacing = { 0, 0 } -- every pad faces this point ({ x, z } from the lobby's centre)
Config.RobuxPadSize = 7 -- studs across a pad
Config.RobuxPadPanelHeight = 7.5 -- studs from the ground to the middle of the floating panel
Config.RobuxPadHueSeconds = 24 -- the ring's colour takes this long to drift once round the rainbow
Config.RobuxPadBobSeconds = 3.5 -- one slow rise and fall of the panel
Config.RobuxPadBob = 0.35 -- studs the panel rises and falls
Config.RobuxPadSpinSeconds = 16 -- one slow turn of the icon's glow ring
Config.RobuxPadCooldown = 4 -- seconds between two purchase prompts from any pads
Config.RobuxPadLeave = 2 -- studs past a pad's edge before it can offer again

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00007">
				<Properties>
					<string name="Name">ConfigPlayer</string>
					<ProtectedString name="Source"><![CDATA[-- Stamina, fitness and the metal detector (Config.luau merges this file in: read and tune
-- them as Config.Stamina, Config.Fitness, Config.MetalDetector).
local Config = {}

-- Each swing carves a dent this big where you hit (on your screen), down to `floor` of how full
-- the clump really is, so you see the damage without the heap looking emptier than it is.
Config.Dent = { radius = 1.8, floor = 0.4 }

-- Sprinting (Shift / L3 / RUN): this many times your walking speed.
Config.Sprint = { multiplier = 1.6 }

-- Stamina: each harvest click spends perHarvest; it refills regenPerSecond all the time. Out of
-- breath (0), you rest regenDelay seconds, then until it's back to `recover`. Fitness upgrades
-- it (coins; level n costs price x growth^(n-1); stat: max, regen or walk = Humanoid.WalkSpeed).
Config.Stamina = { max = 100, perHarvest = 1, regenPerSecond = 2.5, regenDelay = 1, recover = 15, walkSpeed = 16 }
Config.Fitness = {
	{ id = "arms", name = "Stronger Arms", stat = "max", per_level = 50, levels = 5, price = 285, growth = 3, text = "+50 stamina per level" },
	{ id = "breath", name = "Second Wind", stat = "regen", per_level = 0.25, levels = 4, price = 475, growth = 3, text = "+0.25 stamina a second per level" },
	{ id = "boots", name = "Light Boots", stat = "walk", per_level = 1.5, levels = 4, price = 570, growth = 3, text = "+1.5 walking speed per level" },
}
-- Metal detector (bought once): hold `key` to sweep. Within `range` studs of your needle's clump
-- it beeps, faster and higher the closer your head is (signal 1-5; beep = seconds per signal).
Config.MetalDetector = { price = 855, range = 30, levels = 5, pollSeconds = 0.25, key = "V", beep = { 1.2, 0.9, 0.65, 0.45, 0.28 } }

-- Touch screens (phones, tablets). A touch that stays within dragPixels and lifts before
-- holdSeconds harvests once at the crosshair; one held still longer keeps harvesting; one that
-- moves further is looking around and never harvests. Touches starting in the bottom-left
-- stickArea (share of the screen's width, and of its height from the top) belong to the
-- thumbstick. minScale: the smallest UI scale on touch screens, so text stays readable and
-- buttons tappable. The action pad (right side, above the jump button): button size, gap, columns.
Config.Touch = {
	holdSeconds = 0.35,
	dragPixels = 14,
	stickArea = { 0.4, 1 / 3 },
	minScale = 0.68,
	padButton = { 76, 50 },
	padGap = 6,
	padColumns = 3,
}

Config.SkinPulseSeconds = 3 -- one slow swell and fade of an animated skin's glow
Config.SkinGleamSeconds = 0.9 -- how long a skin's shine takes to sweep along the tool
Config.ToolScale = 0.5 -- the built tools' size: 1 = the 6-stud pitchfork, which held out too far in first person
Config.ToolFanSpin = 9 -- radians a second the Twin Turbines' fans turn while held

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00008">
				<Properties>
					<string name="Name">ConfigWorlds</string>
					<ProtectedString name="Source"><![CDATA[-- The four portal worlds (Config.luau merges this file in: read and tune them as Config.Worlds,
-- Config.WorldMoods and the other Config.World* numbers).
local Config = {}

-- One row per world, in unlock order. price = coins to open its portal once (saved);
-- multiplier = coins per straw there, times the normal straw value (and your coin multiplier);
-- straws = how many straws its haystack holds before a fresh one (with a new needle) grows;
-- x, z = the world's centre (studs; stay far from the farm and from the lobby, Config.Lobby).
Config.Worlds = {
	{ id = "moon", name = "The Moon", price = 250000, multiplier = 3, straws = 60000, x = 0, z = 2500 },
	{ id = "lava", name = "Ember Lands", price = 2000000, multiplier = 6, straws = 120000, x = 2500, z = 0 },
	{ id = "atlantis", name = "Bubble City", price = 10000000, multiplier = 12, straws = 240000, x = 0, z = -2500 },
	{ id = "field", name = "Haystack Stadium", price = 50000000, multiplier = 25, straws = 480000, x = -2500, z = 0 },
}
Config.WorldSize = 300 -- each world is about this many studs across
Config.WorldInside = 220 -- within this many studs (flat) of a world's centre you are "in" it
Config.WorldNeedleEarliest = 0.25 -- a world's needle hides after this share of its straws
Config.WorldNeedleSearches = 5000 -- the needle pays this many clicks of straw at that world's rate
Config.WorldHaystackSize = 30 -- the haystack's main ball (studs)

-- The portal arches stand in the lobby (ConfigLobby.luau: Config.LobbyPortals).

-- Moon gravity: an upward push cancelling this share of normal gravity while you're there.
Config.MoonLift = 0.7
-- Lava never hurts: stepping on it nudges you back to the bank at this speed (studs/s).
Config.LavaPush = { out = 30, up = 50, every = 0.4, toastEvery = 4 }
Config.WorldFadeSeconds = 1.6 -- the light eases this long on arrival and on leaving
Config.WorldTitleSeconds = 3.5 -- the world's name stays on screen this long

-- The light in each world (applied on your own screen only, eased in and out).
Config.WorldMoods = {
	moon = { clock = 0, brightness = 2, ambient = { 90, 96, 112 }, outdoor = { 150, 156, 176 }, shift = { 196, 210, 255 }, color = { 10, 10, 18 }, decay = { 0, 0, 0 }, density = 0, haze = 0, glare = 0 },
	lava = { clock = 18.2, brightness = 1.6, ambient = { 110, 52, 40 }, outdoor = { 170, 86, 60 }, shift = { 255, 128, 64 }, color = { 255, 120, 70 }, decay = { 120, 34, 20 }, density = 0.42, haze = 2, glare = 0.4 },
	atlantis = { clock = 13, brightness = 1.4, ambient = { 60, 104, 134 }, outdoor = { 96, 156, 186 }, shift = { 120, 204, 255 }, color = { 60, 140, 190 }, decay = { 20, 64, 112 }, density = 0.5, haze = 2.4, glare = 0 },
	field = { clock = 14, brightness = 3, ambient = { 112, 112, 112 }, outdoor = { 176, 176, 176 }, shift = { 255, 250, 240 }, color = { 200, 222, 255 }, decay = { 150, 180, 220 }, density = 0.2, haze = 0.6, glare = 0.2 },
}

-- Each world's hay (three shades) for its haystack.
Config.WorldHay = {
	moon = { { 196, 200, 210 }, { 170, 176, 188 }, { 222, 226, 234 } },
	lava = { { 240, 124, 40 }, { 220, 96, 30 }, { 255, 160, 70 } },
	atlantis = { { 70, 170, 140 }, { 50, 140, 116 }, { 110, 200, 170 } },
	field = { { 96, 176, 70 }, { 76, 150, 56 }, { 130, 200, 96 } },
}

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00009">
				<Properties>
					<string name="Name">Economy</string>
					<ProtectedString name="Source"><![CDATA[-- Rates, prices, power and odds. Plain maths: no Roblox services.
-- Usage: local Economy = require(Shared.Economy)(Config)
return function(Config)
	local Economy = {}

	Economy.STRAWS_PER_CLUMP = Config.TotalStraws // Config.Clumps

	-- every buildable item by id: { def = ..., kind = "piece" | "machine" | "generator" }
	local items = {}
	for kind, list in pairs({ piece = Config.Pieces, machine = Config.Machines, generator = Config.Generators, feeder = Config.Feeders or {} }) do
		for _, def in ipairs(list) do
			items[def.id] = { def = def, kind = kind }
		end
	end

	function Economy.item(id)
		return items[id]
	end

	local function perkLevel(data, id)
		return (data.perks and data.perks[id]) or 0
	end

	function Economy.tool(level)
		return Config.Tools[math.clamp(level, 1, #Config.Tools)]
	end

	function Economy.silo(level)
		return Config.Silos[math.clamp(level, 1, #Config.Silos)]
	end

	-- straws one click takes, with the Sharpened perk and any speed boost
	function Economy.power(data, speedBoost)
		local p = Economy.tool(data.tool).power * (1 + Config.Perks[1].per_level * perkLevel(data, "sharp"))
		if speedBoost then
			p *= 2
		end
		if data.superTool then -- the Super Tool game pass
			p *= Config.SuperToolBoost
		end
		return math.max(1, math.floor(p + 0.5))
	end

	-- what you can carry: the tool fills first, then the bucket at your hip
	function Economy.capacity(data)
		local tool = Economy.tool(data.tool).capacity * (if data.superTool then Config.SuperToolBoost else 1)
		return tool + Economy.bucket(data.bucket or 1).capacity
	end

	-- straws a second leaving your basket: the trader plus every truck you own
	function Economy.haulRate(data)
		local rate = Config.TraderRate
		for _, truck in ipairs(Config.Trucks) do
			rate += truck.rate * ((data.trucks and data.trucks[truck.id]) or 0)
		end
		return rate
	end

	function Economy.bucket(level)
		return Config.Buckets[math.clamp(level, 1, #Config.Buckets)]
	end

	function Economy.cooldown(data)
		return Config.SearchCooldown * (1 - Config.Perks[2].per_level * perkLevel(data, "swift"))
	end

	function Economy.luckyChance(data, charm)
		local c = Config.LuckyChance + Config.Perks[3].per_level * perkLevel(data, "lucky")
		return if charm then c * 5 else c
	end

	-- Power made, power drawn, machines placed and straws a second, from the placed list.
	-- `fueled` = how many Hay Burners have hay to burn right now (they make power only then)
	function Economy.plot(placed, doubleMachines, fueled)
		local made, draw, rate, machines, free = 0, 0, 0, 0, 0
		local burning = fueled or 0
		for _, p in ipairs(placed or {}) do
			local item = items[p.k]
			if item and item.kind == "generator" and item.def.burner then
				if burning > 0 then
					burning -= 1
					made += item.def.power
				end
			elseif item and item.kind == "feeder" then
				draw += item.def.draw
			elseif item and item.kind == "generator" then
				made += item.def.power
			elseif item and item.kind == "machine" and item.def.robux then
				free += item.def.rate -- a Robux machine (Hay Tornado) needs no power
				machines += 1
			elseif item and item.kind == "machine" then
				draw += item.def.draw
				rate += item.def.rate
				machines += 1
			end
		end
		local share = if draw > 0 then math.min(1, made / draw) else 0
		rate = (rate * share + free) * (if doubleMachines then 2 else 1)
		return { made = made, draw = draw, rate = rate, machines = machines, share = share }
	end

	-- how many of an item a player has bought (in their inventory or placed)
	function Economy.owned(data, id)
		local n = (data.inventory and data.inventory[id]) or 0
		for _, p in ipairs(data.placed or {}) do
			if p.k == id then
				n += 1
			end
		end
		return n
	end

	-- perks are priced for the tool you hold: the free fork pays Wooden Pitchfork prices
	function Economy.perkPrice(data, perkIndex)
		local perk = Config.Perks[perkIndex]
		local level = perkLevel(data, perk.id)
		local scale = math.max(Economy.tool(data.tool).price, Config.Tools[2].price) / Config.Tools[2].price
		return math.floor(perk.price * perk.growth ^ level * scale + 0.5)
	end

	function Economy.perksMaxed(data)
		for _, perk in ipairs(Config.Perks) do
			if perkLevel(data, perk.id) < perk.levels then
				return false
			end
		end
		return true
	end

	function Economy.coinMultiplier(flags, needles)
		local m = 1 + 0.2 * (needles or 0)
		if flags.vip then
			m += Config.VipCoinBonus
		end
		if flags.coinBoost then
			m *= 2
		end
		return m
	end

	function Economy.coinsFor(straws, golden, multiplier)
		local each = Config.CoinsPerStraw * (if golden then Config.Loft.coinMultiplier else 1)
		return math.floor(straws * each * multiplier + 0.5)
	end

	-- the loft's golden haystack still hides its needle at a straw index
	function Economy.needleAt(total, earliest, rng)
		return math.floor(total * earliest + rng:NextNumber() * total * (1 - earliest)) + 1
	end

	-- the Needle Detector: how close (studs) you are to the needle's clump, in words
	function Economy.warmth(distance)
		if distance <= 15 then
			return "BURNING HOT! It's right here"
		elseif distance <= 40 then
			return "hot"
		elseif distance <= 90 then
			return "warm"
		end
		return "cold"
	end

	-- the Wheel of Fortune: total weight and each prize's chance (0-1)
	function Economy.wheelOdds()
		local total = 0
		for _, prize in ipairs(Config.Wheel) do
			total += prize.weight
		end
		local odds = {}
		for i, prize in ipairs(Config.Wheel) do
			odds[i] = prize.weight / total
		end
		return odds, total
	end

	function Economy.spin(rng)
		local _, total = Economy.wheelOdds()
		local roll = rng:NextInteger(1, total)
		for i, prize in ipairs(Config.Wheel) do
			roll -= prize.weight
			if roll <= 0 then
				return i, prize
			end
		end
		return #Config.Wheel, Config.Wheel[#Config.Wheel]
	end

	-- Where prize i sits on the wheel's face: its slice starts `start` turns clockwise from the
	-- top and takes up `size` turns (0..1), in proportion to its chance. The smallest prizes still
	-- get Config.WheelMinSlice of a turn so the pointer can stop on them.
	function Economy.wheelSlice(i)
		local total, sizes = 0, {}
		for n, prize in ipairs(Config.Wheel) do
			sizes[n] = prize.weight
			total += prize.weight
		end
		local spare, small = 1, 0
		for n, w in ipairs(sizes) do
			if w / total < Config.WheelMinSlice then
				spare -= Config.WheelMinSlice
				small += w
			end
		end
		local start, size = 0, 0
		for n, w in ipairs(sizes) do
			size = if w / total < Config.WheelMinSlice then Config.WheelMinSlice else w / (total - small) * spare
			if n == i then
				return start, size
			end
			start += size
		end
		return 0, 0
	end

	return Economy
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000A">
				<Properties>
					<string name="Name">Finds</string>
					<ProtectedString name="Source"><![CDATA[-- Generated from Finds.json
return {
	{
		name = "a brass button",
		story = "It is from Mrs Thimbleby's coat. So she did come to the haystack that night.",
	},
	{
		name = "a magpie feather",
		story = "Black and white, with a green shine. Pip the magpie has been here.",
	},
	{
		name = "a spool of golden thread",
		story = "The needle was threaded with this. It can't be far.",
	},
	{
		name = "an old horseshoe",
		story = "The merchant says it's lucky. He pays well for it anyway.",
	},
	{
		name = "a thimble",
		story = "Silver, and engraved with a T. The tailor's, for certain.",
	},
	{
		name = "a chewed corn cob",
		story = "Gertrude the goat got in here. She eats anything shiny... or not.",
	},
	{
		name = "a torn fair ticket",
		story = "Harvest Fair, Row 3. The night the needle went missing.",
	},
	{
		name = "a duck egg",
		story = "Still warm. The ducks have been nesting in the hay.",
	},
	{
		name = "a tiny bell",
		story = "From Biscuit the barn cat's collar. Everyone's been through this haystack.",
	},
	{
		name = "a rusty key",
		story = "It fits no lock on the farm. Or does it?",
	},
	{
		name = "a jar of honey",
		story = "The merchant's eyes light up. 'Rare,' he says, and pays double.",
		bonus = 2,
	},
	{
