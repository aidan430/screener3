			<Item class="ModuleScript" referent="RBX0000B">
				<Properties>
					<string name="Name">Format</string>
					<ProtectedString name="Source"><![CDATA[-- Number formatting for the UI. Plain Luau: no Roblox services.
local Format = {}

-- 5000000 -> "5,000,000"
function Format.commas(n)
	local digits = string.format("%.0f", math.floor(math.abs(n)))
	local grouped = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")))
	if string.sub(grouped, 1, 1) == "," then
		grouped = string.sub(grouped, 2)
	end
	if n < 0 then
		return "-" .. grouped
	end
	return grouped
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

local function fixed(value)
	if value >= 100 then
		return string.format("%.0f", value)
	elseif value >= 10 then
		return string.format("%.1f", value)
	end
	return string.format("%.2f", value)
end

-- 1234 -> "1.23K", 5000000 -> "5M", 950 -> "950"
function Format.short(n)
	local value = math.abs(n)
	if value < 1000 then
		return tostring(math.floor(n))
	end
	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text = fixed(value)
	if tonumber(text) >= 1000 and index < #SUFFIXES then -- 999.96K rounds up: show 1M
		value /= 1000
		index += 1
		text = fixed(value)
	end
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return (if n < 0 then "-" else "") .. text .. SUFFIXES[index]
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000C">
				<Properties>
					<string name="Name">HayLook</string>
					<ProtectedString name="Source"><![CDATA[-- One look for every loose bit of hay (on tools, in buckets and baskets, flying, dropped
-- bundles, the mounds round the heap): the imported hay model (Config.HayModel, which the
-- server shares as ReplicatedStorage.HayTemplate), else a mesh from Config.HayMesh, else a
-- rounded ball of the Grass material (which wears the hay texture if one is set).
-- Plain module: works on the server and the client.
return function(Config)
	local HayLook = {}
	local HAY = Color3.fromRGB(Config.HeapColour[1], Config.HeapColour[2], Config.HeapColour[3])
	local GOLD = Color3.fromRGB(255, 214, 90)

	-- A hay lump `size` studs across, `golden` for the Golden Loft's straw.
	function HayLook.lump(size, golden)
		local template = game:GetService("ReplicatedStorage"):FindFirstChild("HayTemplate")
		if template then
			local hay = template:Clone()
			hay.Name = "Hay"
			hay.Anchored, hay.CanCollide, hay.CanQuery, hay.CanTouch, hay.CastShadow = false, false, false, false, false
			hay:SetAttribute("BaseSize", template.Size)
			HayLook.resize(hay, size)
			return hay
		end
		local part = Instance.new("Part")
		part.Name = "Hay"
		part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false
		part.Material = Enum.Material.Grass
		part.Color = if golden then GOLD else HAY
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if Config.HayMesh ~= "" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = Config.HayMesh
			mesh.TextureId = Config.HayMeshTexture
			mesh.VertexColor = if golden then Vector3.new(1.3, 1.1, 0.4) else Vector3.new(1, 1, 1)
			mesh.Parent = part
		else
			part.Shape = Enum.PartType.Ball
		end
		HayLook.resize(part, size)
		return part
	end

	-- Sets a lump's size (the model is 1 stud across, so its mesh scales with the part).
	function HayLook.resize(part, size)
		local base = part:GetAttribute("BaseSize")
		if base then -- the imported model, 1 stud across at its widest
			part.Size = base * math.max(size, 0.05)
			return
		end
		local s = Vector3.new(size, size * 0.72, size)
		part.Size = Vector3.new(math.max(s.X, 0.05), math.max(s.Y, 0.05), math.max(s.Z, 0.05))
		local mesh = part:FindFirstChildOfClass("SpecialMesh")
		if mesh then
			mesh.Scale = Vector3.new(size, size, size) -- the model is 1 x 0.69 x 1 studs
		end
	end

	return HayLook
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000D">
				<Properties>
					<string name="Name">HeapTerrain</string>
					<ProtectedString name="Source"><![CDATA[-- Draws a player's haystack as terrain from their save. Each player's screen draws only its own
-- haystack (they all stand in the same place), so this runs on the client; the server keeps
-- the save and checks every harvest against it. Usage: require(HeapTerrain)(Config).
return function(Config)
	local Layout = require(script.Parent.Layout)(Config)
	local HeapTerrain = {}
	local HEAP = Enum.Material[Config.HeapMaterial] -- its own material, coloured gold by paint()
	local STEPS = 8 -- a clump shrinks in this many visible steps as it's harvested
	local PER_CLUMP = Config.TotalStraws // Config.Clumps
	HeapTerrain.MATERIAL = HEAP

	-- Colours the heap's material golden and drops any old material override left in the place
	-- (an earlier build's texture once turned the heap pink). Safe to call again and again.
	function HeapTerrain.paint(terrain)
		local c = if Config.HayTexture ~= "" then Config.HayTint else Config.HeapColour
		pcall(function()
			terrain:SetMaterialColor(HEAP, Color3.fromRGB(c[1], c[2], c[3]))
		end)
		if Config.HayTexture == "" then
			local materials = game:GetService("MaterialService")
			pcall(function()
				materials:SetBaseMaterialOverride(HEAP, HEAP.Name)
			end)
			pcall(function()
				materials[HEAP.Name .. "Name"] = HEAP.Name
			end)
		end
	end

	function HeapTerrain.origin(centreX, centreZ)
		local x, z = Layout.origin(centreX, centreZ)
		return Vector3.new(x, 0, z)
	end

	-- How full a clump's cell looks: the heap's rounded outside, shrinking as it's harvested.
	function HeapTerrain.fullness(index, left)
		if left <= 0 then
			return 0
		end
		local step = math.ceil(left / PER_CLUMP * STEPS) / STEPS
		return Layout.shape[index] * (0.3 + 0.7 * step)
	end

	local function leftOf(removed, partial, index)
		if string.sub(removed, index, index) == "1" then
			return 0
		end
		return partial[tostring(index)] or PER_CLUMP
	end

	local function span()
		local s = Config.ClumpSize
		return s, math.ceil(math.max(Config.PileRadiusBottom, Config.HeapSkirt.to) / s) + 1
	end

	-- How full the heap's foot is at grid cell (gx, layer, gz), where there's no clump (0..1):
	-- full near the heap, thinning to nothing at HeapSkirt.to, so the sides meet the ground in a
	-- smooth slope instead of a step.
	local function foot(gx, layer, gz)
		local skirt, s = Config.HeapSkirt, Config.ClumpSize
		local d = math.sqrt(gx * gx + gz * gz) * s
		if d >= skirt.to then
			return 0
		end
		local share = math.clamp((d - skirt.from) / (skirt.to - skirt.from), 0, 1)
		local height = skirt.height * (1 - share) ^ 1.6
		return math.clamp((height - layer * s) / s, 0, 1)
	end

	-- The whole heap, from the save's `removed` string and `partial` table.
	function HeapTerrain.draw(terrain, o, removed, partial)
		local s, n = span()
		local materials, amounts = {}, {}
		for x = 1, 2 * n + 1 do
			materials[x], amounts[x] = {}, {}
			for y = 1, Config.PileLayers do
				materials[x][y], amounts[x][y] = {}, {}
				for z = 1, 2 * n + 1 do
					materials[x][y][z], amounts[x][y][z] = Enum.Material.Air, 0
				end
			end
		end
		for index, cell in ipairs(Layout.cell) do
			local amount = HeapTerrain.fullness(index, leftOf(removed, partial, index))
			if amount > 0 then
				local x, y, z = cell[1] + n + 1, cell[2] + 1, cell[3] + n + 1
				materials[x][y][z], amounts[x][y][z] = HEAP, amount
			end
		end
		for gx = -n, n do -- the foot, in cells no clump uses (so a dug-out clump never refills)
			for gz = -n, n do
				for layer = 0, math.ceil(Config.HeapSkirt.height / s) - 1 do
					local amount = if Layout.lookup(gx, layer, gz) then 0 else foot(gx, layer, gz)
					if amount > 0.05 then
						materials[gx + n + 1][layer + 1][gz + n + 1], amounts[gx + n + 1][layer + 1][gz + n + 1] = HEAP, amount
					end
				end
			end
		end
		local corner = o - Vector3.new(n * s + s / 2, 0, n * s + s / 2)
		terrain:WriteVoxels(Region3.new(corner, corner + Vector3.new((2 * n + 1) * s, Config.PileLayers * s, (2 * n + 1) * s)), s, materials, amounts)
	end

	local function region(o, index)
		local c = Layout[index]
		if not c then
			return nil
		end
		local centre = o + Vector3.new(c[1], c[2], c[3])
		local half = Vector3.new(1, 1, 1) * (Config.ClumpSize / 2)
		return Region3.new(centre - half, centre + half)
	end

	-- How full a clump's cell looks on this screen right now (0..1).
	function HeapTerrain.occupancy(terrain, o, index)
		local r = region(o, index)
		if not r then
			return 0
		end
		local _, amounts = terrain:ReadVoxels(r, Config.ClumpSize)
		return amounts[1][1][1]
	end

	-- One clump, after a harvest or a machine took from it. `cap` (optional) keeps it from
	-- looking fuller than it does now (the dents you've made stay; it never grows back).
	function HeapTerrain.cell(terrain, o, index, left, cap)
		local r = region(o, index)
		if not r then
			return
		end
		local amount = HeapTerrain.fullness(index, left)
		if cap and amount > 0 then
			amount = math.min(amount, cap)
		end
		terrain:WriteVoxels(r, Config.ClumpSize, { { { if amount > 0 then HEAP else Enum.Material.Air } } }, { { { amount } } })
	end

	return HeapTerrain
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000E">
				<Properties>
					<string name="Name">Layout</string>
					<ProtectedString name="Source"><![CDATA[-- Where each clump sits in the heap: one cell of the 4-stud terrain grid each, in
-- Config.PileLayers layers that taper from PileRadiusBottom to a rounded top (PileDome, PileCurve), trimmed
-- at the bottom edge to exactly Config.Clumps. Always the same order (bottom to top), so a clump's
-- index means the same clump in every visit; saves refer to clumps by index.
-- Plain Luau: no Roblox services. Returns a list of { x, y, z } offsets from the heap's base centre,
-- with these extras:
--   .cell[i] = { gx, layer, gz }       .lookup(gx, layer, gz) -> index or nil
--   .shape[i] = terrain fullness 0..1 that rounds the heap's outside smoothly
--   .core[i] = how far out the clump is, 0 at the middle to 1 at the outside
--   .machineOrder = indices from the outside skin inwards (machines peel the heap evenly)
--   .needleSpots = indices deep inside the upper heap, where the needle hides
--   .origin(x, z) = the heap's base centre for a plot centre, on the terrain grid
return function(Config)
	local s = Config.ClumpSize
	local layerCount = Config.PileLayers
	local r0, r1, curve, dome = Config.PileRadiusBottom, Config.PileRadiusTop, Config.PileCurve, Config.PileDome
	local layers, radius = {}, {}
	local total = 0
	for i = 0, layerCount - 1 do
		local r = r1 + (r0 - r1) * math.max(0, 1 - (i / (layerCount - 1)) ^ dome) ^ curve
		radius[i] = r
		local n = math.floor(r / s)
		local layer = {}
		for gx = -n, n do
			for gz = -n, n do
				if (gx * s) ^ 2 + (gz * s) ^ 2 <= r * r then
					table.insert(layer, { gx, i, gz, gx * gx + gz * gz })
				end
			end
		end
		total += #layer
		layers[i + 1] = layer
	end
	-- too many: trim the outermost clumps of the lowest layers, a quarter of a layer at most
	local excess = total - Config.Clumps
	for _, layer in ipairs(layers) do
		if excess <= 0 then
			break
		end
		table.sort(layer, function(a, b)
			if a[4] ~= b[4] then
				return a[4] > b[4]
			elseif a[1] ~= b[1] then
				return a[1] < b[1]
			end
			return a[3] < b[3]
		end)
		local cut = math.min(excess, math.floor(#layer / 4))
		for _ = 1, cut do
			table.remove(layer, 1)
		end
		excess -= cut
	end
	local out = { cell = {}, shape = {}, core = {}, machineOrder = {}, needleSpots = {} }
	local grid = {}
	for _, layer in ipairs(layers) do
		table.sort(layer, function(a, b)
			if a[1] ~= b[1] then
				return a[1] < b[1]
			end
			return a[3] < b[3]
		end)
		for _, c in ipairs(layer) do
			table.insert(out, { c[1] * s, c[2] * s + s / 2, c[3] * s })
			local index = #out
			local r = radius[c[2]]
			local d = math.sqrt(c[4]) * s
			out.cell[index] = { c[1], c[2], c[3] }
			-- fullness rounds the outside smoothly, then a fixed random dent per cell makes the
			-- surface lumpy, like hay forked onto a pile, instead of a smooth dome of dirt
			local hash = bit32.bxor(c[1] * 73856093, c[2] * 19349663, c[3] * 83492791) % 1000 / 1000
			out.shape[index] = math.clamp(((r - d) / s + 0.5) * (1 - Config.HeapLumpiness * hash), 0.3, 1)
			out.core[index] = math.clamp(d / math.max(r, s), 0, 1)
			grid[c[1] .. "," .. c[2] .. "," .. c[3]] = index
		end
	end
	function out.lookup(gx, layer, gz)
		return grid[gx .. "," .. layer .. "," .. gz]
	end
	-- outside first (most exposed), then lower first, then by index, so the order never changes
	for i = 1, #out do
		out.machineOrder[i] = i
	end
	table.sort(out.machineOrder, function(a, b)
		local ca, cb = math.floor(out.core[a] * 8), math.floor(out.core[b] * 8)
		if ca ~= cb then
			return ca > cb
		elseif out.cell[a][2] ~= out.cell[b][2] then
			return out.cell[a][2] < out.cell[b][2]
		end
		return a < b
	end)
	local low, high = Config.NeedleHeight[1] * layerCount, Config.NeedleHeight[2] * layerCount
	for i = 1, #out do
		local layer = out.cell[i][2]
		if layer >= low and layer <= high and out.core[i] <= Config.NeedleCore then
			table.insert(out.needleSpots, i)
		end
	end
	function out.origin(x, z)
		return math.floor(x / s) * s + s / 2, math.floor(z / s) * s + s / 2
	end
	return out
end
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX0000F">
