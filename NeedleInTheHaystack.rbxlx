			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">false</bool>
		</Properties>
	</Item>
	<Item class="MaterialService" referent="RBX0007D">
		<Properties>
			<string name="Name">MaterialService</string>
			<bool name="Use2022Materials">true</bool>
			<string name="LeafyGrassName">Field</string>
		</Properties>
		<Item class="MaterialVariant" referent="RBX0007E">
			<Properties>
				<string name="Name">Field</string>
				<token name="BaseMaterial">1284</token>
				<token name="MaterialPattern">1</token>
				<float name="StudsPerTile">16.0</float>
				<Content name="ColorMap"><url>rbxassetid://92652087782912</url></Content>
				<Content name="NormalMap"><url>rbxassetid://81088945047843</url></Content>
			</Properties>
		</Item>
	</Item>
