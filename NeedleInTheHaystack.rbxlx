	<Item class="ServerScriptService" referent="RBX00013">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX00014">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00015">
				<Properties>
					<string name="Name">Achievements</string>
					<ProtectedString name="Source"><![CDATA[-- The ten achievements, secret until earned. Each watches one number; all ten open the Golden Loft.
-- Optional Roblox badges: put badge IDs into Config.BadgeIds.
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)

local Achievements = {}

-- The current value of each achievement's number for a player.
function Achievements.value(player, d, stat)
	if stat == "tool" then
		return d.tool
	elseif stat == "machines" then
		return Economy.plot(d.placed, false).machines
	elseif stat == "power" then
		return Economy.plot(d.placed, false).made
	elseif stat == "needles" then
		return d.needles
	end
	return d.stats[stat] or 0
end

local function award(player, achievement)
	PlayerData.update(player, function(data)
		data.achievements[achievement.id] = true
	end)
	Remotes.Achievement:FireClient(player, { id = achievement.id, name = achievement.name, text = achievement.text, done = player:GetAttribute("Achievements"), total = #Config.Achievements })
	local badge = Config.BadgeIds[achievement.id]
	if badge and badge ~= 0 then
		task.spawn(function()
			pcall(BadgeService.AwardBadge, BadgeService, player.UserId, badge)
		end)
	end
	if player:GetAttribute("LoftOpen") then
		Remotes.Announce:FireAllClients({ kind = "loft", finder = player.DisplayName, finderId = player.UserId })
	end
end

-- Call after anything that could complete an achievement. Cheap: ten comparisons.
function Achievements.check(player)
	local d = PlayerData.get(player)
	if not d then
		return
	end
	for _, a in ipairs(Config.Achievements) do
		if not d.achievements[a.id] and Achievements.value(player, d, a.stat) >= a.goal then
			award(player, a)
		end
	end
end

function Achievements.progress(player)
	local d = PlayerData.get(player)
	local out = {}
	for _, a in ipairs(Config.Achievements) do
		local done = d ~= nil and d.achievements[a.id] == true
		-- secret until earned: the client only learns an achievement once it is done
		table.insert(out, if done then { id = a.id, name = a.name, text = a.text, done = true } else { id = a.id, done = false })
	end
	return out
end

function Achievements.init()
	Remotes.GetAchievements.OnServerInvoke = Achievements.progress
	task.spawn(function() -- machines and power change by building, so check on a timer too
		while true do
			task.wait(15)
			for _, player in ipairs(Players:GetPlayers()) do
				Achievements.check(player)
			end
		end
	end)
end

return Achievements
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00016">
				<Properties>
					<string name="Name">Build</string>
					<ProtectedString name="Source"><![CDATA[-- Helpers for building the world out of simple anchored parts.
local Build = {}

function Build.rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- spec: name, size (Vector3), cframe, color ({r, g, b} or Color3), material ("Wood"),
-- shape ("Ball" | "Cylinder"), collide (default true), shadow (default true), transparency, class
function Build.part(spec)
	local p = Instance.new(spec.class or "Part")
	p.Name = spec.name or "Part"
	p.Anchored = true
	if spec.shape then
		p.Shape = Enum.PartType[spec.shape]
	end
	p.Size = spec.size
	p.CFrame = spec.cframe
	if typeof(spec.color) == "Color3" then
		p.Color = spec.color
	elseif spec.color then
		p.Color = Build.rgb(spec.color)
	end
	p.Material = Enum.Material[spec.material or "SmoothPlastic"]
	p.CanCollide = spec.collide ~= false
	p.CastShadow = spec.shadow ~= false
	p.Transparency = spec.transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if spec.collide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.Parent = spec.parent
	return p
end

-- A standing cylinder: bottom centre at `base` (CFrame), `height` tall.
function Build.post(spec, base, height, diameter)
	spec.shape = "Cylinder"
	spec.size = Vector3.new(height, diameter, diameter)
	spec.cframe = base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	return Build.part(spec)
end

-- A gable roof: a block turned 45 degrees, its lower half hidden inside the walls.
-- `top` is the CFrame of the ridge line's centre at wall height; the ridge runs along Z.
function Build.roof(spec, top, width, depth)
	local side = width / math.sqrt(2)
	spec.size = Vector3.new(side, side, depth)
	spec.cframe = top * CFrame.Angles(0, 0, math.rad(45))
	return Build.part(spec)
end

-- Text on one face of a part. Returns the TextLabel.
function Build.text(part, face, text, options)
	options = options or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = options.pixels or 40
	gui.LightInfluence = 0.6
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = options.font or Enum.Font.FredokaOne
	label.TextColor3 = options.color or Color3.fromRGB(58, 38, 22)
	label.TextWrapped = true
	label.Parent = gui
	return label
end

return Build
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00017">
				<Properties>
					<string name="Name">Carry</string>
					<ProtectedString name="Source"><![CDATA[-- What you carry, where everyone can see it: the hay on your tool grows with every harvest,
-- and once the tool is full your bucket (at your hip) fills up too. Dumping empties both.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local PlayerData = require(script.Parent.PlayerData)
local Build = require(script.Parent.Build)

local Carry = {}
local HAY, GOLD = { 222, 186, 92 }, { 255, 214, 90 }
local gear = Instance.new("Folder") -- outside the character, so first person doesn't hide it
gear.Name = "Gear"
gear.Parent = workspace

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = a, b
	w.Parent = b
end

-- A bucket at the hip: the pail, its rim and handle, and a mound of hay that grows inside.
local function makeBucket(player, root, level)
	local def = Economy.bucket(level)
	local model = Instance.new("Model")
	model.Name = player.Name
	model:SetAttribute("Level", level)
	local size = def.size
	local base = root.CFrame * CFrame.new(1.4, -0.9, 0.2)
	local parts = {
		Build.part({ name = "Pail", size = Vector3.new(size, size * 0.9, size * 0.9), cframe = base * CFrame.Angles(0, 0, math.rad(90)), color = { 150, 104, 58 }, material = "Fabric", shape = "Cylinder", collide = false, parent = model }),
		Build.part({ size = Vector3.new(0.15, size * 1.0, size * 1.0), cframe = base * CFrame.new(0, size / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), color = { 110, 76, 46 }, material = "Wood", shape = "Cylinder", collide = false, parent = model }),
		Build.part({ size = Vector3.new(0.12, size * 0.9, 0.12), cframe = base * CFrame.new(0, size * 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)), color = { 120, 120, 128 }, material = "Metal", collide = false, parent = model }),
		Build.part({ name = "Hay", size = Vector3.new(0.1, 0.1, 0.1), cframe = base * CFrame.new(0, size / 2, 0), color = HAY, material = "Grass", shape = "Ball", collide = false, transparency = 1, parent = model }),
	}
	for _, part in ipairs(parts) do
		part.Anchored = false
		part.Massless = true
		weld(root, part)
	end
	model.Parent = gear
	return model
end

local function bucketOf(player)
	return gear:FindFirstChild(player.Name)
end

-- Grows a hay mound to show how full something is (0..1), keeping its bottom where it sits.
local function mound(part, share, width, golden)
	if share <= 0 then
		part.Transparency = 1
		return
	end
	part.Transparency = 0
	part.Color = Build.rgb(if golden then GOLD else HAY)
	local w = width * (0.45 + 0.55 * math.sqrt(math.min(share, 1)))
	part.Size = Vector3.new(w, w * 0.7, w)
end

-- Shows the player's load on their tool and bucket. Cheap: call it whenever the load changes.
function Carry.show(player)
	local d = PlayerData.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not d or not root then
		return
	end
	local load = d.carried + d.carriedGolden
	local golden = d.carriedGolden > d.carried
	local toolCap = Economy.tool(d.tool).capacity
	local onTool = math.min(load, toolCap) / toolCap
	for _, container in ipairs({ character, player:FindFirstChildOfClass("Backpack") }) do
		for _, tool in ipairs(container and container:GetChildren() or {}) do
			local hay = tool:IsA("Tool") and tool:FindFirstChild("Load")
			if hay then
				mound(hay, onTool, Config.LoadSize, golden)
			end
		end
	end
	local bucket = bucketOf(player)
	if d.bucket <= 1 then
		if bucket then
			bucket:Destroy()
		end
		return
	end
	if bucket and bucket:GetAttribute("Level") ~= d.bucket then
		bucket:Destroy()
		bucket = nil
	end
	if bucket then -- still welded to this character?
		local pail = bucket:FindFirstChild("Pail")
		local w = pail and pail:FindFirstChildOfClass("WeldConstraint")
		if not w or w.Part0 ~= root then
			bucket:Destroy()
			bucket = nil
		end
	end
	bucket = bucket or makeBucket(player, root, d.bucket)
	local def = Economy.bucket(d.bucket)
	local hay = bucket:FindFirstChild("Hay")
	if hay then
		mound(hay, math.max(0, load - toolCap) / math.max(def.capacity, 1), def.size * 0.95, golden)
	end
end

function Carry.init()
	local function watch(player)
		for _, name in ipairs({ "Carried", "Capacity", "Bucket", "Tool" }) do
			player:GetAttributeChangedSignal(name):Connect(function()
				Carry.show(player)
			end)
		end
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			task.wait(1.5) -- the tool arrives from StarterGear
			Carry.show(player)
		end)
		local backpack = player:WaitForChild("Backpack", 10)
		if backpack then
			backpack.ChildAdded:Connect(function()
				task.defer(Carry.show, player)
			end)
		end
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(watch, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local bucket = bucketOf(player)
		if bucket then
			bucket:Destroy()
		end
	end)
end

return Carry
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00018">
				<Properties>
					<string name="Name">Haystack</string>
					<ProtectedString name="Source"><![CDATA[-- The Golden Loft: the secret level in the clouds above the hub, with its golden haystack.
-- (Each player's main pile is built on their plot by Piles.luau.)
local Build = require(script.Parent.Build)
local World = require(script.Parent.World)

local Haystack = {}

local GOLD = { { 250, 206, 70 }, { 240, 186, 50 }, { 255, 224, 110 } }

local function mound(centre, size, parent)
	local function ball(label, diameter, offset, colour)
		local part = Build.part({ name = label, shape = "Ball", size = Vector3.new(diameter, diameter, diameter), cframe = CFrame.new(centre + offset), color = colour, material = "Sand", parent = parent })
		part.Reflectance = 0.15
		return part
	end
	ball("GoldenCore", size, Vector3.new(0, size * 0.14, 0), GOLD[1])
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		ball("GoldenLump", size * (0.5 + (i % 3) * 0.06), Vector3.new(math.cos(a) * size * 0.36, size * 0.02, math.sin(a) * size * 0.36), GOLD[i % 3 + 1])
	end
	ball("GoldenTop", size * 0.42, Vector3.new(size * 0.04, size * 0.58, -size * 0.04), GOLD[3])
end

function Haystack.build()
	local loft = Instance.new("Model")
	loft.Name = "Loft"
	Build.part({ name = "LoftFloor", size = Vector3.new(90, 2, 90), cframe = CFrame.new(World.LOFT - Vector3.new(0, 1, 0)), color = { 214, 184, 130 }, material = "WoodPlanks", parent = loft })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		local cf = CFrame.new(World.LOFT + Vector3.new(math.cos(a) * 44, 2.5, math.sin(a) * 44)) * CFrame.Angles(0, -a, 0)
		Build.part({ name = "LoftRail", size = Vector3.new(1, 5, 90), cframe = cf, color = { 122, 86, 52 }, material = "Wood", parent = loft })
		local lamp = Build.part({ name = "LoftLamp", size = Vector3.new(2, 2, 2), cframe = cf * CFrame.new(0, 6, 0), color = { 255, 214, 90 }, material = "Neon", parent = loft })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 80)
		light.Range = 40
		light.Brightness = 1.2
		light.Parent = lamp
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Build.part({ name = "Cloud", shape = "Ball", size = Vector3.new(44, 44, 44), cframe = CFrame.new(World.LOFT + Vector3.new(math.cos(a) * 34, -22, math.sin(a) * 34)), color = { 255, 240, 220 }, material = "Sand", collide = false, shadow = false, transparency = 0.15, parent = loft })
	end
	local pad = Build.part({ name = "LoftPad", size = Vector3.new(8, 0.4, 8), cframe = CFrame.new(World.LOFT + Vector3.new(0, 0.2, 36)), color = { 245, 200, 66 }, material = "Neon", parent = loft })
	local back = Instance.new("ProximityPrompt")
	back.ActionText = "Go back down"
	back.ObjectText = "Golden Loft"
	back.HoldDuration = 0
	back.RequiresLineOfSight = false
	back:SetAttribute("Action", "down")
	back.Parent = pad
	mound(World.LOFT + Vector3.new(0, 0, -8), 34, loft)
	loft.Parent = workspace
end

return Haystack
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00019">
				<Properties>
					<string name="Name">Loft</string>
					<ProtectedString name="Source"><![CDATA[-- The Golden Loft: the secret level above the hub, open only to players with all ten
-- achievements. The golden door's prompt sends them up; the loft pad brings them down.
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local World = require(script.Parent.World)

local Loft = {}

local function teleport(player, position)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(position)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function Loft.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local action = prompt:GetAttribute("Action")
		if action == "loft" then
			if player:GetAttribute("LoftOpen") then
				teleport(player, World.LOFT + Vector3.new(0, 4, 30))
				Remotes.Announce:FireClient(player, { kind = "notice", text = "Welcome to the Golden Loft. Golden straw pays 20x!" })
			else
				Remotes.Announce:FireClient(player, { kind = "notice", text = "The golden door won't budge. Some say ten secret deeds open it..." })
			end
		elseif action == "down" then
			teleport(player, World.DOOR + Vector3.new(-8, 4, 0))
		end
	end)
end

return Loft
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001A">
				<Properties>
					<string name="Name">Machines</string>
					<ProtectedString name="Source"><![CDATA[-- Machines harvest the top of your pile into your silo every second, if your generators make
-- enough power. Also: the Straw Blast product, VIP offline harvesting, and height records.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)
local Piles = require(script.Parent.Piles)
local Structures = require(script.Parent.Structures)
local Achievements = require(script.Parent.Achievements)
local Search = require(script.Parent.Search)

local Machines = {}
local carry = {} -- [player] = machine straws not yet whole
local running = {} -- [player] = were the machines fully powered last tick

local function character(player)
	local c = player.Character
	local humanoid = c and c:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return c
end

-- Takes `amount` straws from the outside of the heap inwards (machines, Straw Blast). Returns straws taken.
local function fromTop(player, d, amount)
	local plotIndex = Plots.of(player)
	local taken = 0
	while plotIndex and amount > 0 do
		local top = Piles.next(d)
		if not top then
			break
		end
		local got, gone = Piles.take(plotIndex, d, top, amount)
		if got <= 0 then
			break
		end
		taken += got
		amount -= got
		if gone and top == d.needleClump then
			Search.needleFound(player, false, Piles.position(plotIndex, top))
			break
		end
	end
	d.stats.total_searched += taken
	return taken
end

function Machines.blast(player, amount)
	local d = PlayerData.get(player)
	if not d then
		return 0
	end
	local taken = fromTop(player, d, amount)
	PlayerData.update(player, function(data)
		data.carried += taken -- sold straight away below
	end)
	Search.sell(player, "auto")
	return taken
end

local function tickMachines()
	for _, player in ipairs(Players:GetPlayers()) do
		local d = PlayerData.get(player)
		if d and Plots.of(player) then
			local flags = PlayerData.flags(player)
			local plot = Economy.plot(d.placed, flags.doubleMachines)
			local powered = plot.machines > 0 and plot.share >= 1
			if running[player] ~= powered then
				running[player] = powered
				Structures.light(player, powered)
			end
			local space = Economy.silo(d.silo).size - d.siloStraw
			local rate = plot.rate + (carry[player] or 0)
			carry[player] = rate - math.floor(rate)
			local amount = math.min(math.floor(rate), space)
			if amount > 0 then
				local taken = fromTop(player, d, amount)
				PlayerData.update(player, function(data)
					data.siloStraw += taken
				end)
				if flags.autoSell and Economy.silo(d.silo).size - d.siloStraw <= 0 then
					Search.sell(player, "auto")
				end
			end
		end
	end
end

-- Records how high each player has stood on their own plot (the Sky High achievement).
local function tickHeights()
	for _, player in ipairs(Players:GetPlayers()) do
		local d, plotIndex, c = PlayerData.get(player), Plots.of(player), character(player)
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if d and plotIndex and root and Plots.contains(plotIndex, root.Position, 0) and root.Position.Y - 3 > d.stats.best_height then
			PlayerData.update(player, function(data)
				data.stats.best_height = math.floor(root.Position.Y - 3)
			end)
			Achievements.check(player)
		end
	end
end

-- VIP: machines kept working for up to an hour after the player left (call before building the pile).
function Machines.offline(player)
	local d = PlayerData.get(player)
	if not d or d.lastSeen <= 0 or not PlayerData.flags(player).vip then
		return
	end
	local seconds = math.clamp(os.time() - d.lastSeen, 0, Config.VipOfflineSeconds)
	local plot = Economy.plot(d.placed, PlayerData.flags(player).doubleMachines)
	local amount = math.min(math.floor(plot.rate * seconds), Economy.silo(d.silo).size - d.siloStraw)
	if amount > 0 then
		local taken = fromTop(player, d, amount)
		PlayerData.update(player, function(data)
			data.siloStraw += taken
		end)
		task.delay(8, function()
			Remotes.Announce:FireClient(player, { kind = "notice", text = "Your machines harvested " .. Format.commas(taken) .. " straws while you were away (VIP)." })
		end)
	end
end

function Machines.init()
	Players.PlayerRemoving:Connect(function(player)
		carry[player], running[player] = nil, nil
	end)
	task.spawn(function()
		local beat = 0
		while true do
			task.wait(1)
			beat += 1
			tickMachines()
			if beat % 2 == 0 then
				tickHeights()
			end
		end
	end)
end

return Machines
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX0001B">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[-- Starts the game. The ground and spawn point are built first, so nobody spawns into the void.
-- Strictly first person. Each player gets a plot, and their pile and buildings are rebuilt there.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local World = require(script.Parent.World)
World.ground()
StarterPlayer.CameraMode = Enum.CameraMode.LockFirstPerson

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

-- While testing in Studio, server errors also show on the players' screens.
if RunService:IsStudio() then
	game:GetService("ScriptContext").Error:Connect(function(message, trace)
		Remotes.Announce:FireAllClients({ kind = "error", text = "SERVER ERROR: " .. tostring(message) .. "\n" .. string.sub(tostring(trace), 1, 200) })
	end)
end

local Haystack = require(script.Parent.Haystack)
local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)
local Piles = require(script.Parent.Piles)
local Structures = require(script.Parent.Structures)
local Tools = require(script.Parent.Tools)
local Achievements = require(script.Parent.Achievements)
local Search = require(script.Parent.Search)
local Machines = require(script.Parent.Machines)
local Shop = require(script.Parent.Shop)
local Loft = require(script.Parent.Loft)
local Wheel = require(script.Parent.Wheel)
local Monetization = require(script.Parent.Monetization)
local Carry = require(script.Parent.Carry)

StarterPlayer.CharacterMaxSlopeAngle = Config.MaxSlopeAngle -- the steep heap needs building to climb

World.build()
Plots.build()
Plots.onRelease = Piles.clear
Haystack.build()

local function toPlot(player)
	local plotIndex = Plots.of(player)
	local root = player.Character and player.Character:WaitForChild("HumanoidRootPart", 10)
	if plotIndex and root then
		root.CFrame = CFrame.lookAt(Plots.entrance(plotIndex), Plots.centre(plotIndex) + Vector3.new(0, 4, 0))
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end)
for _, player in ipairs(Players:GetPlayers()) do
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

PlayerData.onLoaded(function(player, saveable)
	local data = PlayerData.get(player)
	local plotIndex = Plots.claim(player)
	if not plotIndex then
		player:Kick("This farm is full (four plots). Please join another server.")
		return
	end
	player:SetAttribute("Plot", plotIndex)
	Piles.build(plotIndex, data)
	Structures.build(plotIndex, data)
	Tools.give(player, data.tool, data.skin)
	Carry.show(player)
	Wheel.remind(player)
	toPlot(player)
	-- after every spawn: back to your plot, and make sure the tool arrived (it comes from StarterGear)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		toPlot(player)
		local current = PlayerData.get(player)
		if current and player.Parent and not Tools.has(player) then
			Tools.give(player, current.tool, current.skin)
		end
	end)
	if not saveable and not RunService:IsStudio() then
		task.wait(6) -- give the player's screen time to start listening
		Remotes.Announce:FireClient(player, { kind = "notice", text = "Saving isn't working right now, so progress in this server won't be kept." })
	end
end)

-- Each part starts on its own: if one breaks, its error shows in Output and the rest still run.
local parts = {
	{ "Search", Search.init }, -- harvesting first: it matters most
	{ "Plots", Plots.init },
	{ "Monetization", Monetization.init }, -- before PlayerData, so early players get their passes checked
	{ "PlayerData", PlayerData.init },
	{ "Achievements", Achievements.init },
	{ "Structures", Structures.init },
	{ "Machines", Machines.init },
	{ "Shop", Shop.init },
	{ "Loft", Loft.init },
	{ "Carry", Carry.init },
}
for _, part in ipairs(parts) do
	local ok, err = pcall(part[2])
	if not ok then
		warn("[Start] " .. part[1] .. " failed to start: " .. tostring(err))
	end
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001C">
				<Properties>
					<string name="Name">Monetization</string>
					<ProtectedString name="Source"><![CDATA[-- Robux items. Every ID in Config.GamePasses and Config.Products starts at 0 (switched off);
-- create the item on the Creator Dashboard after publishing, then paste its ID into Config.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Machines = require(script.Parent.Machines)
local Wheel = require(script.Parent.Wheel)

local Monetization = {}

local function nameOf(table_, id)
	for name, itemId in pairs(table_) do
		if itemId ~= 0 and itemId == id then
			return name
		end
	end
	return nil
end

local function checkPasses(player)
	for name, id in pairs(Config.GamePasses) do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				PlayerData.setPass(player, name, true)
			end
		end
	end
	Machines.offline(player)
end

local grants = {}

local function boost(name)
	return function(player)
		PlayerData.update(player, function(d)
			d.boosts[name] = math.max(d.boosts[name] or 0, os.time()) + Config.BoostSeconds
		end)
		return "Your " .. name .. " is on for an hour."
	end
end
grants.SpeedBoost = boost("SpeedBoost")
grants.CoinBoost = boost("CoinBoost")
grants.LuckyCharm = boost("LuckyCharm")

function grants.MerchantWhistle(player)
	PlayerData.update(player, function(d)
		d.whistles += Config.WhistleUses
	end)
	return "You have " .. Config.WhistleUses .. " more Merchant's Whistles: sell your bag anywhere."
end

function grants.StrawBlast(player)
	local blasted = Machines.blast(player, Config.StrawBlastAmount) or 0
	return "Straw Blast! " .. Format.commas(blasted) .. " straws blasted off the top of your pile and sold."
end

function grants.WheelSpin(player)
	return Wheel.spin(player)
end

-- Roblox calls this for every developer product purchase, retrying until we say granted.
local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not PlayerData.waitFor(player, 15) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if PlayerData.hasReceipt(player, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already given
	end
	local name = nameOf(Config.Products, info.ProductId)
	local grant = name and grants[name]
	if not grant then
		warn("[Monetization] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local message = grant(player)
	PlayerData.addReceipt(player, info.PurchaseId)
	PlayerData.save(player)
	Remotes.Announce:FireClient(player, { kind = "notice", text = message })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.init()
	PlayerData.onLoaded(checkPasses)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = nameOf(Config.GamePasses, passId)
		if purchased and name then
			PlayerData.setPass(player, name, true)
			Remotes.Announce:FireClient(player, { kind = "notice", text = "Thank you! Your " .. name .. " pass is active." })
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
end

return Monetization
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001D">
				<Properties>
					<string name="Name">Pieces</string>
					<ProtectedString name="Source"><![CDATA[-- What each buildable item looks like, built from parts around `cf`: the base centre on the
-- ground, facing -Z (stairs and escalators climb towards -Z). Returns the Model.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local Build = require(script.Parent.Build)

local Pieces = {}
local WOOD, DARK, METAL = { 168, 122, 74 }, { 110, 76, 46 }, { 140, 144, 150 }
local builders = {}

local function p(model, cf, size, color, material, shape)
	return Build.part({ size = size, cframe = cf, color = color, material = material or "WoodPlanks", shape = shape, parent = model })
end

function builders.stairs(model, cf)
	for i = 0, 9 do
		p(model, cf * CFrame.new(0, i + 0.5, 4.5 - i), Vector3.new(8, 1, 1), WOOD)
	end
	for _, x in ipairs({ -4.2, 4.2 }) do
		p(model, cf * CFrame.new(x, 5.5, 0) * CFrame.Angles(math.rad(45), 0, 0), Vector3.new(0.4, 1.2, 14.4), DARK, "Wood")
	end
end

function builders.landing(model, cf)
	p(model, cf * CFrame.new(0, 0.5, 0), Vector3.new(10, 1, 10), WOOD)
end

function builders.pillar(model, cf)
	p(model, cf * CFrame.new(0, 5, 0), Vector3.new(2, 10, 2), DARK, "Wood")
end

function builders.escalator(model, cf)
	-- a moving ramp: the parts' velocity carries anyone standing on them up the slope
	local slope = cf * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(45), 0, 0)
	local belt = p(model, slope, Vector3.new(6, 0.6, 14.4), { 70, 72, 80 }, "DiamondPlate")
	belt.AssemblyLinearVelocity = (cf.LookVector + cf.UpVector).Unit * 10 -- up the slope, towards -Z
	belt:SetAttribute("Conveyor", true)
	for _, x in ipairs({ -3.4, 3.4 }) do
		p(model, slope * CFrame.new(x, 1, 0), Vector3.new(0.6, 2, 14.4), METAL, "Metal")
	end
	p(model, cf * CFrame.new(0, 10.25, -6), Vector3.new(6, 0.5, 3), METAL, "DiamondPlate")
	p(model, cf * CFrame.new(0, 0.25, 6), Vector3.new(6, 0.5, 3), METAL, "DiamondPlate")
end

function builders.elevator(model, cf)
	for _, c in ipairs({ { -4.5, -4.5 }, { 4.5, -4.5 }, { -4.5, 4.5 }, { 4.5, 4.5 } }) do
		p(model, cf * CFrame.new(c[1], 25.5, c[2]), Vector3.new(1, 51, 1), METAL, "Metal")
	end
	p(model, cf * CFrame.new(0, 0.25, 0), Vector3.new(10, 0.5, 10), METAL, "DiamondPlate")
	local top = p(model, cf * CFrame.new(0, 50.5, 0), Vector3.new(10, 1, 10), WOOD)
	local bottom = p(model, cf * CFrame.new(0, 3, -4.6), Vector3.new(2, 2, 0.4), { 245, 200, 66 }, "Neon")
	local upper = p(model, cf * CFrame.new(0, 53, 4.6), Vector3.new(2, 2, 0.4), { 245, 200, 66 }, "Neon")
	top.Name = "Top"
	for _, pair in ipairs({ { bottom, "Ride up", "up" }, { upper, "Ride down", "down" } }) do
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = pair[2]
		prompt.ObjectText = "Elevator"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 6
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Direction", pair[3])
		prompt.Parent = pair[1]
	end
end

local function prompt(parent, action, text, object)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = text
	pr.ObjectText = object
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 10
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Action", action)
	pr.Parent = parent
	return pr
end

local function standing(model, cf, height, diameter, color, material, name)
	local c = p(model, cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(height, diameter, diameter), color, material, "Cylinder")
	c.Name = name or c.Name
	return c
end

-- Your trader: a market stall with a striped awning, the trader behind the counter, and a
-- big woven basket in front where you dump your hay (the basket's prompt sells it).
function builders.trader(model, cf)
	p(model, cf * CFrame.new(0, 1.5, 1), Vector3.new(10, 3, 3), WOOD)
	p(model, cf * CFrame.new(0, 3.1, 1), Vector3.new(10.4, 0.3, 3.4), DARK, "Wood")
	for _, c in ipairs({ { -4.8, -0.2 }, { 4.8, -0.2 }, { -4.8, 3.6 }, { 4.8, 3.6 } }) do
		p(model, cf * CFrame.new(c[1], 4.5, c[2]), Vector3.new(0.5, 9, 0.5), DARK, "Wood")
	end
	for i = 0, 5 do -- the striped awning, tipped towards the front
		local colour = if i % 2 == 0 then { 196, 72, 56 } else { 246, 232, 200 }
		p(model, cf * CFrame.new(-4.2 + i * 1.68, 9.3, 1.4) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(1.68, 0.3, 5.6), colour, "Fabric")
	end
	local sign = p(model, cf * CFrame.new(0, 10.8, -0.6), Vector3.new(6, 1.6, 0.3), WOOD)
	Build.text(sign, Enum.NormalId.Front, "TRADER")
	-- the trader: boots, overalls, a checked shirt, a friendly face and a wide straw hat
	local body = cf * CFrame.new(0, 0, 3.2) * CFrame.Angles(0, math.rad(180), 0)
	for _, x in ipairs({ -0.5, 0.5 }) do
		p(model, body * CFrame.new(x, 1, 0), Vector3.new(0.9, 2, 0.9), { 64, 82, 130 }, "Fabric")
	end
	p(model, body * CFrame.new(0, 3.1, 0), Vector3.new(2.2, 2.2, 1.1), { 196, 72, 56 }, "Fabric")
	p(model, body * CFrame.new(0, 2.6, -0.05), Vector3.new(1.6, 1.4, 1.15), { 64, 82, 130 }, "Fabric")
	p(model, body * CFrame.new(0, 4.8, 0), Vector3.new(1.3, 1.3, 1.3), { 232, 188, 150 }, "SmoothPlastic")
	for _, x in ipairs({ -0.3, 0.3 }) do
		p(model, body * CFrame.new(x, 4.95, -0.66), Vector3.new(0.18, 0.18, 0.05), { 40, 30, 24 }, "SmoothPlastic")
	end
	standing(model, body * CFrame.new(0, 5.45, 0), 0.15, 3.2, { 226, 196, 110 }, "Fabric")
	standing(model, body * CFrame.new(0, 5.5, 0), 0.8, 1.5, { 226, 196, 110 }, "Fabric")
	-- the basket: woven sides, a band, and the hay inside (shown on each player's screen)
	local basket = standing(model, cf * CFrame.new(0, 0, -3.6), 2.6, 4.4, { 150, 104, 58 }, "Fabric", "Basket")
	standing(model, cf * CFrame.new(0, 2.3, -3.6), 0.35, 4.6, DARK, "Wood")
	local fill = standing(model, cf * CFrame.new(0, 2.5, -3.6), 0.3, 4, { 222, 186, 92 }, "Grass", "BasketFill")
	fill.Transparency = 1
	fill.CanCollide = false
	prompt(basket, "sell", "Dump hay", "Your trader")
end

-- A teleporter pad: step on, press E and pick another of your pads.
function builders.teleporter(model, cf)
	standing(model, cf, 0.6, 8, { 70, 72, 84 }, "DiamondPlate", "Pad")
	local ring = standing(model, cf * CFrame.new(0, 0.6, 0), 0.15, 6.4, { 120, 200, 255 }, "Neon", "Ring")
	ring.CanCollide = false
	prompt(ring, "teleport", "Teleport", "Teleporter Pad")
end

-- Machines and generators: a body, a roof light that glows when running, a name plate.
local function engine(model, cf, def, kind)
	local size = Vector3.new(def.size[1], def.size[2], def.size[3])
	local body = p(model, cf * CFrame.new(0, size.Y / 2, 0), size, def.color, if kind == "generator" then "Metal" else "DiamondPlate")
	body.Name = "Body"
	local lamp = p(model, cf * CFrame.new(0, size.Y + 0.4, 0), Vector3.new(1, 0.8, 1), { 90, 90, 90 }, "Neon")
	lamp.Name = "Lamp"
	if kind == "machine" then
		local fan = p(model, cf * CFrame.new(0, size.Y * 0.6, -size.Z / 2 - 0.2), Vector3.new(0.4, size.Y * 0.6, size.Y * 0.6), METAL, "Metal", "Cylinder")
		fan.CFrame = fan.CFrame * CFrame.Angles(0, math.rad(90), 0)
		fan.Name = "Fan"
	end
	local plate = Instance.new("BillboardGui")
	plate.Size = UDim2.fromScale(8, 1.6)
	plate.StudsOffset = Vector3.new(0, size.Y / 2 + 2, 0)
	plate.MaxDistance = 60
	plate.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = def.name .. (if kind == "generator" then "  +" .. def.power .. " power" else "  " .. def.rate .. "/s, uses " .. def.draw)
	label.Parent = plate
end

function Pieces.make(id, cf)
	local item = Economy.item(id)
	if not item then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = id
	model:SetAttribute("Item", id)
	if builders[id] then
		builders[id](model, cf)
	else
		engine(model, cf, item.def, item.kind)
	end
	model.WorldPivot = cf
	return model
end

-- Lights a machine or generator's lamp: green when running, red when short of power.
function Pieces.light(model, running)
	local lamp = model:FindFirstChild("Lamp")
	if lamp then
		lamp.Color = if running then Color3.fromRGB(90, 255, 120) else Color3.fromRGB(255, 70, 60)
	end
end

return Pieces
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001E">
				<Properties>
					<string name="Name">Piles</string>
					<ProtectedString name="Source"><![CDATA[-- Each player's 70 m pile: 5,000 clumps of 1,000 straws on their plot, built from their save
-- (harvested clumps stay gone). Harvesting a clump to nothing removes it; the needle is in one.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Layout = require(Shared:WaitForChild("Layout"))(Config)

local Plots = require(script.Parent.Plots)
local Profile = require(script.Parent.Profile)

local Piles = {}
local piles = {} -- [plot index] = { folder, origin = Vector3 }
local cursor = setmetatable({}, { __mode = "k" }) -- [data] = where the machines got to in machineOrder
local terrain = workspace.Terrain
local HEAP = Enum.Material.Grass -- recoloured to straw; its grass blades read as loose straw
local STEPS = 8 -- a clump shrinks in this many visible steps as you harvest it

local function setup()
	terrain:SetMaterialColor(HEAP, Color3.fromRGB(Config.HeapColour[1], Config.HeapColour[2], Config.HeapColour[3]))
	pcall(function()
		terrain.Decoration = true -- the grass blades: individual straws on the heap
	end)
end

local function origin(plotIndex)
	local centre = Plots.centre(plotIndex)
	local x, z = Layout.origin(centre.X, centre.Z)
	return Vector3.new(x, 0, z)
end

-- How full a clump's terrain cell looks: the heap's rounded outside, shrinking as it's harvested.
local function fullness(index, left)
	if left <= 0 then
		return 0
	end
	local step = math.ceil(left / Economy.STRAWS_PER_CLUMP * STEPS) / STEPS
	return Layout.shape[index] * (0.3 + 0.7 * step)
end

local function writeCell(plotIndex, index, left)
	local o = piles[plotIndex] and piles[plotIndex].origin
	if not o then
		return
	end
	local c = o + Vector3.new(Layout[index][1], Layout[index][2], Layout[index][3])
	local half = Vector3.new(1, 1, 1) * (Config.ClumpSize / 2)
	local amount = fullness(index, left)
	terrain:WriteVoxels(Region3.new(c - half, c + half), Config.ClumpSize, { { { if amount > 0 then HEAP else Enum.Material.Air } } }, { { { amount } } })
end

function Piles.position(plotIndex, clump)
	local c = Layout[clump]
	return origin(plotIndex) + Vector3.new(c[1], c[2], c[3])
end

-- The clump nearest a point on (or just inside) the heap's surface, if one is left there.
function Piles.clumpAt(plotIndex, d, point)
	local o = origin(plotIndex)
	local s = Config.ClumpSize
	local gx, layer, gz = math.floor((point.X - o.X) / s + 0.5), math.floor(point.Y / s), math.floor((point.Z - o.Z) / s + 0.5)
	local best, bestDistance = nil, math.huge
	for dx = -1, 1 do
		for dy = -1, 1 do
			for dz = -1, 1 do
				local index = Layout.lookup(gx + dx, layer + dy, gz + dz)
				if index and Profile.clumpLeft(d, index) > 0 then
					local distance = (Piles.position(plotIndex, index) - point).Magnitude
					if distance < bestDistance then
						best, bestDistance = index, distance
					end
				end
			end
		end
	end
	return best
end

-- Builds the player's heap on their plot from their data, as one smooth piece of terrain.
function Piles.build(plotIndex, d)
	setup()
	local folder = Instance.new("Folder")
	folder.Name = "Pile"
	folder.Parent = Plots.folder(plotIndex)
	local o = origin(plotIndex)
	piles[plotIndex] = { folder = folder, origin = o }
	local s = Config.ClumpSize
	local n = math.ceil(Config.PileRadiusBottom / s) + 1
	local materials, amounts = {}, {}
	for x = 1, 2 * n + 1 do
		materials[x], amounts[x] = {}, {}
		for y = 1, Config.PileLayers do
			materials[x][y], amounts[x][y] = {}, {}
			for z = 1, 2 * n + 1 do
				materials[x][y][z], amounts[x][y][z] = Enum.Material.Air, 0
			end
		end
	end
	for index, cell in ipairs(Layout.cell) do
		local amount = fullness(index, Profile.clumpLeft(d, index))
		if amount > 0 then
			local x, y, z = cell[1] + n + 1, cell[2] + 1, cell[3] + n + 1
			materials[x][y][z], amounts[x][y][z] = HEAP, amount
		end
	end
	local corner = o - Vector3.new(n * s + s / 2, 0, n * s + s / 2)
	terrain:WriteVoxels(Region3.new(corner, corner + Vector3.new((2 * n + 1) * s, Config.PileLayers * s, (2 * n + 1) * s)), s, materials, amounts)
	return piles[plotIndex]
end

-- Clears a plot's heap from the terrain (when its player leaves).
function Piles.clear(plotIndex)
	local o = origin(plotIndex)
	local reach = (math.ceil(Config.PileRadiusBottom / Config.ClumpSize) + 1) * Config.ClumpSize + Config.ClumpSize / 2
	terrain:FillBlock(CFrame.new(o + Vector3.new(0, Config.PileLayers * Config.ClumpSize / 2, 0)), Vector3.new(reach * 2, Config.PileLayers * Config.ClumpSize, reach * 2), Enum.Material.Air)
	piles[plotIndex] = nil
end

-- Takes up to `amount` straws from a clump. Returns straws taken and whether the clump
-- (and so maybe the needle) is now gone.
function Piles.take(plotIndex, d, clump, amount)
	local left = Profile.clumpLeft(d, clump)
	local taken = math.min(amount, left)
	if taken <= 0 then
		return 0, false
	end
	Profile.setClumpLeft(d, clump, left - taken)
	if fullness(clump, left - taken) ~= fullness(clump, left) then
		writeCell(plotIndex, clump, left - taken)
	end
	return taken, left - taken <= 0
end

-- The next clump for the machines: they peel the heap from the outside in, bottom first.
function Piles.next(d)
	local order = Layout.machineOrder
	local i = cursor[d] or 1
	while i <= #order and string.sub(d.removed, order[i], order[i]) == "1" do
		i += 1
	end
	cursor[d] = i
	return order[i]
end

-- A fresh pile for a new needle, in the saved data (do this straight away).
function Piles.resetData(d)
	d.removed = string.rep("0", Config.Clumps)
	d.partial = {}
	d.needleClump = Profile.newNeedle()
	d.revealed = false
	cursor[d] = nil
end

-- Rebuilds the heap from the data (after resetData).
function Piles.rebuild(plotIndex, d)
	local pile = piles[plotIndex]
	if pile then
		pile.folder:Destroy()
	end
	Piles.build(plotIndex, d)
end

return Piles
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001F">
				<Properties>
					<string name="Name">PlayerData</string>
					<ProtectedString name="Source"><![CDATA[-- Each player's saved progress and the leaderboard. If the DataStore can't be read (Studio
-- before publishing, or an outage), the player plays with fresh progress that is not saved,
-- so a failed read never overwrites good data.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local Profile = require(script.Parent.Profile)

local PlayerData = {}
local profiles = {} -- [player] = { data, saveable, dirty, joined }
local passes = {} -- [player] = { VIP = true, ... } (checked each visit, not saved)
local loadedCallbacks = {}

local MAX_RECEIPTS = 50

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] saving is off: " .. tostring(result))
	end
end

local function key(player)
	return "player_" .. player.UserId
end

local function load(player)
	if not store then
		return Profile.fresh(nil), false
	end
	local tries = if RunService:IsStudio() then 1 else 3
	for attempt = 1, tries do
		local ok, saved = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			return Profile.fresh(saved), true
		end
		warn("[PlayerData] could not load " .. player.Name .. ": " .. tostring(saved))
		if attempt < tries then
			task.wait(attempt * 2)
		end
	end
	return Profile.fresh(nil), false
end

-- Everything the client shows comes from these attributes (and leaderstats).
local function publish(player, profile)
	local d = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = d.coins
		stats.Needles.Value = d.needles
	end
	local flags = PlayerData.flags(player)
	local plot = Economy.plot(d.placed, flags.doubleMachines)
	player:SetAttribute("Coins", d.coins)
	player:SetAttribute("Tool", d.tool)
	player:SetAttribute("Silo", d.silo)
	player:SetAttribute("Bucket", d.bucket)
	player:SetAttribute("Carried", d.carried + d.carriedGolden)
	player:SetAttribute("Capacity", Economy.capacity(d))
	player:SetAttribute("SiloStraw", d.siloStraw)
	player:SetAttribute("ClumpsLeft", Profile.clumpsLeft(d))
	player:SetAttribute("LoftSearched", d.loft.searched)
	player:SetAttribute("Needles", d.needles)
	player:SetAttribute("GoldenNeedles", d.loft.needles)
	player:SetAttribute("Power", Economy.power(d, flags.speedBoost))
	player:SetAttribute("MachineRate", plot.rate)
	player:SetAttribute("PowerMade", plot.made)
	player:SetAttribute("PowerDraw", plot.draw)
	player:SetAttribute("Multiplier", Economy.coinMultiplier(flags, d.needles))
	player:SetAttribute("Whistles", d.whistles)
	player:SetAttribute("Skin", d.skin)
	for _, prize in ipairs(Config.Wheel) do
		if not prize.reveal then
			player:SetAttribute("Skin_" .. prize.id, d.skins[prize.id] == true)
		end
	end
	for _, perk in ipairs(Config.Perks) do
		player:SetAttribute("Perk_" .. perk.id, d.perks[perk.id])
	end
	for _, list in ipairs({ Config.Pieces, Config.Machines, Config.Generators }) do
		for _, def in ipairs(list) do
			player:SetAttribute("Inv_" .. def.id, d.inventory[def.id] or 0)
			player:SetAttribute("Own_" .. def.id, Economy.owned(d, def.id))
		end
	end
	for name, until_ in pairs(d.boosts) do
		player:SetAttribute("Boost_" .. name, until_)
	end
	local done = 0
	for _, a in ipairs(Config.Achievements) do
		if d.achievements[a.id] then
			done += 1
		end
	end
	player:SetAttribute("Achievements", done)
	player:SetAttribute("LoftOpen", done >= #Config.Achievements)
end

function PlayerData.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

function PlayerData.sessionSeconds(player)
	local profile = profiles[player]
	return if profile then os.time() - profile.joined else 0
end

-- Passes and active boosts, as the rest of the game sees them.
function PlayerData.flags(player)
	local d = PlayerData.get(player)
	local own = passes[player] or {}
	local now = os.time()
	local function boost(name)
		return d ~= nil and (d.boosts[name] or 0) > now
	end
	return {
		vip = own.VIP == true,
		autoSell = own.AutoSell == true,
		doubleMachines = own.DoubleMachines == true,
		speedBoost = boost("SpeedBoost"),
		coinBoost = boost("CoinBoost"),
		luckyCharm = boost("LuckyCharm"),
	}
end

-- Change a player's data and show the change everywhere. Returns false if not loaded yet.
function PlayerData.update(player, change)
	local profile = profiles[player]
	if not profile then
		return false
	end
	change(profile.data)
	profile.dirty = true
	publish(player, profile)
	return true
end

function PlayerData.setPass(player, name, owned)
	passes[player] = passes[player] or {}
	passes[player][name] = owned
	player:SetAttribute("Pass" .. name, owned)
	local profile = profiles[player]
	if profile then
		publish(player, profile)
	end
end

-- Waits up to `timeout` seconds for a player's data. Returns it, or nil.
function PlayerData.waitFor(player, timeout)
	local waited = 0
	while not profiles[player] and player.Parent and waited < timeout do
		waited += task.wait(0.25)
	end
	return PlayerData.get(player)
end

function PlayerData.hasReceipt(player, purchaseId)
	local d = PlayerData.get(player)
	return d ~= nil and table.find(d.receipts, purchaseId) ~= nil
end

function PlayerData.addReceipt(player, purchaseId)
	PlayerData.update(player, function(d)
		table.insert(d.receipts, purchaseId)
		while #d.receipts > MAX_RECEIPTS do
			table.remove(d.receipts, 1)
		end
	end)
end

function PlayerData.save(player)
	local profile = profiles[player]
	if not profile or not profile.saveable or not store then
		return false
	end
	local data = profile.data
	data.lastSeen = os.time()
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if ok then
		profile.dirty = false
	else
		warn("[PlayerData] could not save " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- callback(player, saveable) runs once a player's data has loaded.
function PlayerData.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function added(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Coins", "Needles" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
	local data, saveable = load(player)
	if player.Parent == nil then
		return -- left while loading
	end
	local profile = { data = data, saveable = saveable, dirty = false, joined = os.time() }
	profiles[player] = profile
	publish(player, profile)
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, saveable)
	end
end

function PlayerData.init()
	Players.PlayerAdded:Connect(added)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(added, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerData.save(player)
		profiles[player] = nil
		passes[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				PlayerData.save(player)
				pending -= 1
			end)
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited += task.wait(0.5)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, profile in pairs(profiles) do
				if profile.dirty then
					task.spawn(PlayerData.save, player)
				end
			end
		end
	end)
end

return PlayerData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00020">
				<Properties>
					<string name="Name">Plots</string>
					<ProtectedString name="Source"><![CDATA[-- The four plots around the hub. A player gets a free plot when they join and gives it
-- back when they leave; their pile and buildings are rebuilt from their save each visit.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent.Build)

local Plots = {}
local owners = {} -- [plot index] = player
local byPlayer = {} -- [player] = plot index
local signs = {} -- [plot index] = TextLabel

function Plots.centre(index)
	local c = Config.PlotCentres[index]
	return Vector3.new(c[1], 0, c[2])
end

function Plots.folder(index)
	return workspace:WaitForChild("Plots"):WaitForChild("Plot" .. index)
end

function Plots.of(player)
	return byPlayer[player]
end

function Plots.owner(index)
	return owners[index]
end

-- True if `position` is on the plot (with a margin inside the edge), at a sensible height.
function Plots.contains(index, position, margin)
	local centre, half = Plots.centre(index), Config.PlotSize / 2 - (margin or 0)
	return math.abs(position.X - centre.X) <= half and math.abs(position.Z - centre.Z) <= half and position.Y >= -2 and position.Y <= 320
end

-- Where a player arrives on their plot: the corner nearest the hub.
function Plots.entrance(index)
	local centre = Plots.centre(index)
	return centre - centre.Unit * (Config.PlotSize / 2 - 6) + Vector3.new(0, 4, 0)
end

function Plots.build()
	local root = Instance.new("Folder")
	root.Name = "Plots"
	root.Parent = workspace
	for index in ipairs(Config.PlotCentres) do
		local folder = Instance.new("Folder")
		folder.Name = "Plot" .. index
		folder:SetAttribute("Index", index)
		folder.Parent = root
		local centre = Plots.centre(index)
		local half = Config.PlotSize / 2
		Build.part({ name = "Ground", size = Vector3.new(Config.PlotSize, 1, Config.PlotSize), cframe = CFrame.new(centre + Vector3.new(0, -0.45, 0)), color = { 124, 140, 66 }, material = "Grass", parent = folder })
		for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local edge = centre + Vector3.new(side[1] * half, 0.3, side[2] * half)
			local size = if side[1] ~= 0 then Vector3.new(1, 0.6, Config.PlotSize) else Vector3.new(Config.PlotSize, 0.6, 1)
			Build.part({ name = "Edge", size = size, cframe = CFrame.new(edge), color = { 150, 110, 70 }, material = "WoodPlanks", parent = folder })
		end
		local corner = centre - centre.Unit * (half - 2)
		local sign = Build.part({ name = "PlotSign", size = Vector3.new(12, 3, 0.4), cframe = CFrame.lookAt(corner + Vector3.new(0, 7, 0), Vector3.new(0, 7, 0)), color = { 246, 234, 204 }, material = "WoodPlanks", parent = folder })
		Build.post({ name = "SignPost", color = { 122, 86, 52 }, material = "Wood", parent = folder }, CFrame.new(corner), 5.5, 0.6)
		signs[index] = Build.text(sign, Enum.NormalId.Front, "FREE PLOT")
		Build.text(sign, Enum.NormalId.Back, "PLOT " .. index)
	end
end

-- Gives the player a free plot. Returns its index, or nil if all four are taken.
function Plots.claim(player)
	for index in ipairs(Config.PlotCentres) do
		if not owners[index] then
			owners[index] = player
			byPlayer[player] = index
			signs[index].Text = player.DisplayName .. "'s farm"
			return index
		end
	end
	return nil
end

Plots.onRelease = nil -- set by Main: clears the heap's terrain
function Plots.release(player)
	local index = byPlayer[player]
	if index then
		if Plots.onRelease then
			Plots.onRelease(index)
		end
		owners[index] = nil
		byPlayer[player] = nil
		signs[index].Text = "FREE PLOT"
		for _, child in ipairs(Plots.folder(index):GetChildren()) do
			if child.Name == "Pile" or child.Name == "Built" then
				child:Destroy()
			end
		end
	end
end

function Plots.init()
	Players.PlayerRemoving:Connect(Plots.release)
end

return Plots
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00021">
				<Properties>
					<string name="Name">Profile</string>
					<ProtectedString name="Source"><![CDATA[-- A player's data model: what is saved, with its defaults. Anything missing or of the
-- wrong type in a saved record falls back to the default, so old saves keep working.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Layout = require(Shared:WaitForChild("Layout"))(Config)

local Profile = {}
local rng = Random.new()

Profile.STATS = { "searches", "loads_filled", "straws_sold", "lucky_finds", "perks_maxed", "total_searched", "best_height" }

local function number(saved, name, default)
	local v = type(saved) == "table" and saved[name]
	return if type(v) == "number" then v else default
end

-- The needle hides deep inside the upper heap (Config.NeedleHeight, Config.NeedleCore).
function Profile.newNeedle()
	local spots = Layout.needleSpots
	return if #spots > 0 then spots[rng:NextInteger(1, #spots)] else rng:NextInteger(1, Config.Clumps)
end

function Profile.fresh(saved)
	saved = if type(saved) == "table" then saved else {}
	local d = {
		coins = number(saved, "coins", 0),
		tool = math.clamp(math.floor(number(saved, "tool", 1)), 1, #Config.Tools),
		silo = math.clamp(math.floor(number(saved, "silo", 1)), 1, #Config.Silos),
		bucket = math.clamp(math.floor(number(saved, "bucket", 1)), 1, #Config.Buckets),
		carried = number(saved, "carried", 0),
		carriedGolden = number(saved, "carriedGolden", 0),
		siloStraw = number(saved, "siloStraw", 0),
		needleClump = math.floor(number(saved, "needleClump", 0)),
		revealed = saved.revealed == true,
		needles = number(saved, "needles", 0),
		whistles = number(saved, "whistles", 0),
		lastSeen = number(saved, "lastSeen", 0),
		skin = if type(saved.skin) == "string" then saved.skin else "",
		removed = if type(saved.removed) == "string" and #saved.removed == Config.Clumps then saved.removed else string.rep("0", Config.Clumps),
		partial = {},
		perks = {},
		inventory = {},
		placed = {},
		skins = {},
		stats = {},
		achievements = {},
		boosts = {},
		receipts = {},
		loft = { searched = number(saved.loft, "searched", 0), needleAt = number(saved.loft, "needleAt", 0), needles = number(saved.loft, "needles", 0) },
	}
	if d.needleClump < 1 or d.needleClump > Config.Clumps then
		d.needleClump = Profile.newNeedle()
	end
	if string.sub(d.removed, d.needleClump, d.needleClump) == "1" then
		-- the needle's clump is gone but no new pile was started (an old save): start one now
		d.removed = string.rep("0", Config.Clumps)
		d.needleClump = Profile.newNeedle()
		d.revealed = false
	end
	if type(saved.partial) == "table" then
		for index, left in pairs(saved.partial) do
			if tonumber(index) and type(left) == "number" then
				d.partial[tostring(index)] = left
			end
		end
	end
	if string.find(d.removed, "1", 1, true) == nil then
		d.partial = {} -- a fresh pile has no half-harvested clumps
	end
	for _, perk in ipairs(Config.Perks) do
		d.perks[perk.id] = math.clamp(math.floor(number(saved.perks, perk.id, 0)), 0, perk.levels)
	end
	if type(saved.inventory) == "table" then
		for id, n in pairs(saved.inventory) do
			if Economy.item(id) and type(n) == "number" and n > 0 then
				d.inventory[id] = math.floor(n)
			end
		end
	end
	if type(saved.placed) == "table" then
		for _, p in ipairs(saved.placed) do
			if type(p) == "table" and Economy.item(p.k) and type(p.x) == "number" and type(p.y) == "number" and type(p.z) == "number" and #d.placed < Config.MaxPlaced then
				table.insert(d.placed, { k = p.k, x = p.x, y = p.y, z = p.z, r = if type(p.r) == "number" then p.r else 0 })
			end
		end
	end
	for _, prize in ipairs(Config.Wheel) do
		if not prize.reveal and type(saved.skins) == "table" and saved.skins[prize.id] == true then
			d.skins[prize.id] = true
		end
	end
	for _, name in ipairs(Profile.STATS) do
		d.stats[name] = number(saved.stats, name, 0)
	end
	for _, a in ipairs(Config.Achievements) do
		d.achievements[a.id] = type(saved.achievements) == "table" and saved.achievements[a.id] == true
	end
	for name in pairs(Config.Products) do
		d.boosts[name] = number(saved.boosts, name, 0)
	end
	if type(saved.receipts) == "table" then
		for _, id in ipairs(saved.receipts) do
			if type(id) == "string" then
				table.insert(d.receipts, id)
			end
		end
	end
	if d.loft.needleAt <= 0 then
		d.loft.needleAt = Economy.needleAt(Config.Loft.straws, Config.Loft.needleEarliest, rng)
	end
	return d
end

-- How many straws are left in clump `index` (0 if harvested).
function Profile.clumpLeft(d, index)
	if string.sub(d.removed, index, index) == "1" then
		return 0
	end
	return d.partial[tostring(index)] or Economy.STRAWS_PER_CLUMP
end

function Profile.setClumpLeft(d, index, left)
	if left <= 0 then
		d.partial[tostring(index)] = nil
		d.removed = string.sub(d.removed, 1, index - 1) .. "1" .. string.sub(d.removed, index + 1)
	else
		d.partial[tostring(index)] = left
	end
end

function Profile.clumpsLeft(d)
	local _, harvested = string.gsub(d.removed, "1", "")
	return Config.Clumps - harvested
end

return Profile
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00022">
				<Properties>
					<string name="Name">Search</string>
					<ProtectedString name="Source"><![CDATA[-- The loop: click the clump you're looking at to harvest it onto your tool, sell at the
-- merchant, and let powered machines harvest the top of your pile into your silo.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Finds = require(Shared:WaitForChild("Finds"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)
local Piles = require(script.Parent.Piles)
local Achievements = require(script.Parent.Achievements)
local Tools = require(script.Parent.Tools)

local Search = {}
local lastHarvest = {}
local rng = Random.new()

local function character(player)
	local c = player.Character
	local humanoid = c and c:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return c
end

-- The search tool, wherever it is. If it's in the backpack, the server equips it, so a click
-- never fails just because equipping didn't reach the server.
local function searchTool(player, c)
	for _, container in ipairs({ c, player:FindFirstChildOfClass("Backpack") }) do
		for _, item in ipairs(container and container:GetChildren() or {}) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				if container ~= c then
					local humanoid = c:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:EquipTool(item)
					end
				end
				return item
			end
		end
	end
	return nil
end

local function room(d)
	return Economy.capacity(d) - d.carried - d.carriedGolden
end

-- Sells what the player carries and their silo. Returns coins paid.
function Search.sell(player, reason, basket)
	local d = PlayerData.get(player)
	if not d or (d.carried + d.carriedGolden + d.siloStraw) <= 0 then
		return 0
	end
	local mult = Economy.coinMultiplier(PlayerData.flags(player), d.needles)
	local straws = d.carried + d.carriedGolden + d.siloStraw
	local coins = Economy.coinsFor(d.carried + d.siloStraw, false, mult) + Economy.coinsFor(d.carriedGolden, true, mult)
	PlayerData.update(player, function(data)
		data.coins += coins
		data.stats.straws_sold += straws
		data.carried, data.carriedGolden, data.siloStraw = 0, 0, 0
	end)
	Remotes.SearchFx:FireClient(player, { kind = "sold", coins = coins, straws = straws, reason = reason, basket = basket })
	Achievements.check(player)
	return coins
end

local function luckyFind(player, d, flags, position)
	local find = Finds[rng:NextInteger(1, #Finds)]
	local worth = Economy.coinsFor(Economy.power(d, false) * Config.LuckyValueSearches, false, Economy.coinMultiplier(flags, d.needles)) * (find.bonus or 1)
	PlayerData.update(player, function(data)
		data.coins += worth
		data.stats.lucky_finds += 1
	end)
	Remotes.SearchFx:FireClient(player, { kind = "find", name = find.name, story = find.story, coins = worth, position = position })
end

function Search.needleFound(player, golden, position)
	local d = PlayerData.get(player)
	local prize = Economy.coinsFor(Economy.power(d, false) * 5000, golden, Economy.coinMultiplier(PlayerData.flags(player), d.needles))
	local plotIndex = Plots.of(player)
	PlayerData.update(player, function(data)
		data.coins += prize
		if golden then
			data.loft.needles += 1
			data.loft.searched = 0
			data.loft.needleAt = Economy.needleAt(Config.Loft.straws, Config.Loft.needleEarliest, rng)
		else
			data.needles += 1
			Piles.resetData(data) -- saved at once, so leaving now can't lose the new needle
		end
	end)
	Remotes.Announce:FireAllClients({ kind = "needle", finder = player.DisplayName, finderId = player.UserId, golden = golden, prize = prize, position = position })
	if not golden and plotIndex then
		task.delay(6, function() -- let the celebration play, then a fresh pile with a new needle
			local current = PlayerData.get(player)
			if current and Plots.of(player) == plotIndex then
				Piles.rebuild(plotIndex, current)
			end
		end)
	end
	Achievements.check(player)
end

-- The golden haystack in the loft still counts straws, like the old haystack.
local function goldenHarvest(player, d, amount)
	local left = Config.Loft.straws - d.loft.searched
	amount = math.min(amount, room(d), left)
	if amount <= 0 then
		return 0, false
	end
	local hit = d.loft.searched < d.loft.needleAt and d.loft.searched + amount >= d.loft.needleAt
	PlayerData.update(player, function(data)
		data.loft.searched += amount
		data.carriedGolden += amount
	end)
	return amount, hit
end

-- Every click's result goes on the player as HarvestStatus (shown under the crosshair), and
-- the reason a click didn't harvest is also sent as a message (at most every 1.5 seconds).
local lastNope = {}
local function status(player, text)
	player:SetAttribute("HarvestStatus", text)
	player:SetAttribute("HarvestTick", (player:GetAttribute("HarvestTick") or 0) + 1)
end
local function nope(player, reason)
	status(player, reason)
	if time() - (lastNope[player] or 0) > 1.5 then
		lastNope[player] = time()
		Remotes.SearchFx:FireClient(player, { kind = "nope", reason = reason })
	end
end

local function harvest(player, target)
	local d, c = PlayerData.get(player), character(player)
	local now = time()
	if RunService:IsStudio() then
		print("[Harvest] click from", player.Name, "on", if typeof(target) == "Instance" then target:GetFullName() else tostring(target))
	end
	if not d then
		return nope(player, "Still loading your farm...")
	elseif not c then
		return nope(player, "Your character is respawning. Try again in a moment.")
	end
	if not searchTool(player, c) then
		Tools.give(player, d.tool, d.skin) -- lost somehow: hand a new one over and carry on
		if not searchTool(player, c) then
			return nope(player, "Your fork is on its way. Try again in a moment.")
		end
	end
	if now - (lastHarvest[player] or 0) < Economy.cooldown(d) * 0.9 then
		return status(player, player:GetAttribute("HarvestStatus") or "") -- faster than the tool swings: ignored
	end
	-- the heap is terrain: the client sends the point it aimed at (just inside the surface);
	-- the golden haystack in the loft is still parts, so that's the part itself
	local isPart = typeof(target) == "Instance" and target:IsA("BasePart")
	if not isPart and typeof(target) ~= "Vector3" then
		return nope(player, "That isn't hay.")
	end
	local point = if isPart then target.Position else target
	local head = c:FindFirstChild("Head")
	if not head or (head.Position - point).Magnitude > Config.Reach + 6 then
		return nope(player, "Too far away. Step closer to the hay.")
	end
	lastHarvest[player] = now
	local flags = PlayerData.flags(player)
	if room(d) <= 0 then
		if flags.autoSell then
			Search.sell(player, "auto")
		else
			status(player, "You're full. Dump your hay in your trader's basket.")
			Remotes.SearchFx:FireClient(player, { kind = "full" })
			return
		end
	end
	local power = math.min(Economy.power(d, flags.speedBoost), room(d))
	local taken, hit, golden, gone = 0, false, false, false
	local loft = workspace:FindFirstChild("Loft")
	if isPart then
		if not (loft and target:IsDescendantOf(loft) and player:GetAttribute("LoftOpen")) then
			return nope(player, "That isn't your hay.")
		end
		golden = true
		taken, hit = goldenHarvest(player, d, power)
	else
		local plotIndex = Plots.of(player)
		if not plotIndex then
			return nope(player, "You don't have a farm yet (all four plots may be taken).")
		end
		local clump = Plots.contains(plotIndex, point, 0) and Piles.clumpAt(plotIndex, d, point)
		if not clump then
			return nope(player, "That's not your heap. Yours is on the farm marked YOUR FARM.")
		end
		taken, gone = Piles.take(plotIndex, d, clump, power)
		hit = gone and clump == d.needleClump
		PlayerData.update(player, function(data)
			data.carried += taken
			data.stats.total_searched += taken
		end)
	end
	if taken <= 0 then
		return nope(player, "Nothing left in that clump.")
	end
	PlayerData.update(player, function(data)
		data.stats.searches += 1
		if room(data) <= 0 then
			data.stats.loads_filled += 1
		end
	end)
	status(player, "+" .. Format.commas(taken) .. " straw (carrying " .. Format.commas(d.carried + d.carriedGolden) .. " / " .. Format.commas(Economy.capacity(d)) .. ")")
	local warmth = nil
	local plotIndex = Plots.of(player)
	if not golden and d.tool >= Config.DetectorLevel and plotIndex then
		warmth = Economy.warmth((head.Position - Piles.position(plotIndex, d.needleClump)).Magnitude)
	end
	Remotes.SearchFx:FireClient(player, { kind = "harvest", golden = golden, gone = gone, straws = taken, position = point, warmth = warmth, full = room(d) <= 0 })
	if hit then
		Search.needleFound(player, golden, point)
	elseif rng:NextNumber() < Economy.luckyChance(d, flags.luckyCharm) then
		luckyFind(player, d, flags, point)
	end
	Achievements.check(player)
end

function Search.init()
	Remotes.Harvest.OnServerEvent:Connect(harvest)
	Remotes.Whistle.OnServerInvoke = function(player)
		local d = PlayerData.get(player)
		if not d or d.whistles <= 0 then
			return false, "No Merchant's Whistles left."
		end
		if d.carried + d.carriedGolden + d.siloStraw <= 0 then
			return false, "You have nothing to sell."
		end
		PlayerData.update(player, function(data)
			data.whistles -= 1
		end)
		return true, "The merchant comes running! Sold for " .. Format.short(Search.sell(player, "whistle")) .. " coins."
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt:GetAttribute("Action") ~= "sell" then
			return
		end
		-- a trader's basket on a plot only takes its owner's hay; the hub merchant takes anyone's
		local plotIndex = Plots.of(player)
		local stall = prompt:FindFirstAncestorOfClass("Model")
		local isStall = stall ~= nil and stall:GetAttribute("Item") == "trader"
		if isStall and not (plotIndex and stall:IsDescendantOf(Plots.folder(plotIndex))) then
			Remotes.Announce:FireClient(player, { kind = "notice", text = "That's someone else's trader. Yours is on your own farm." })
		elseif Search.sell(player, if isStall then "trader" else "merchant", prompt.Parent) <= 0 then
			Remotes.Announce:FireClient(player, { kind = "notice", text = "You have nothing to dump yet. Harvest some hay!" })
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastHarvest[player], lastNope[player] = nil, nil
	end)
end

return Search
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00023">
				<Properties>
					<string name="Name">Shop</string>
					<ProtectedString name="Source"><![CDATA[-- Buying with coins: tools and silos (in order), perks for the tool you hold, and
-- buildable items (pieces, machines, generators) that go into your inventory to place.
-- One remote: Buy(kind, key).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Tools = require(script.Parent.Tools)
local Achievements = require(script.Parent.Achievements)

local Shop = {}
local buyers = {}

local function short(d, price)
	if d.coins < price then
		return "You need " .. Format.short(price - d.coins) .. " more coins."
	end
	return nil
end

function buyers.tool(player, d, level)
	local tool = Config.Tools[level]
	if level ~= d.tool + 1 or not tool then
		return false, if tool then "Buy the tools in order." else "You already have the best tool!"
	end
	local missing = short(d, tool.price)
	if missing then
		return false, missing
	end
	PlayerData.update(player, function(data)
		data.coins -= tool.price
		data.tool = level
		for _, perk in ipairs(Config.Perks) do
			data.perks[perk.id] = 0 -- perks belong to the tool
		end
	end)
	Tools.give(player, level, d.skin)
	return true, "You got the " .. tool.name .. ": " .. tool.power .. " straws a click, carries " .. Format.commas(tool.capacity) .. "."
end

function buyers.bucket(player, d, level)
	local bucket = Config.Buckets[level]
	if level ~= d.bucket + 1 or not bucket then
		return false, if bucket then "Buy the buckets in order." else "You already have the biggest bucket!"
	end
	local missing = short(d, bucket.price)
	if missing then
		return false, missing
	end
	PlayerData.update(player, function(data)
		data.coins -= bucket.price
		data.bucket = level
	end)
	return true, "Your " .. bucket.name .. " carries " .. Format.commas(bucket.capacity) .. " more straws."
end

function buyers.silo(player, d, level)
	local silo = Config.Silos[level]
	if level ~= d.silo + 1 or not silo then
		return false, if silo then "Upgrade the silo in order." else "You already have the biggest silo!"
	end
	local missing = short(d, silo.price)
	if missing then
		return false, missing
	end
	PlayerData.update(player, function(data)
		data.coins -= silo.price
		data.silo = level
	end)
	return true, "Your " .. silo.name .. " holds " .. Format.commas(silo.size) .. " straws from your machines."
end

function buyers.perk(player, d, index)
	local perk = Config.Perks[index]
	if not perk then
		return false, "No such perk."
	end
	if d.perks[perk.id] >= perk.levels then
		return false, perk.name .. " is already maxed on this tool."
	end
	local price = Economy.perkPrice(d, index)
	local missing = short(d, price)
	if missing then
		return false, missing
	end
	PlayerData.update(player, function(data)
		data.coins -= price
		data.perks[perk.id] += 1
		if Economy.perksMaxed(data) then
			data.stats.perks_maxed += 1
		end
	end)
	return true, perk.name .. " " .. d.perks[perk.id] .. "/" .. perk.levels .. " on your " .. Economy.tool(d.tool).name .. "."
end

function buyers.item(player, d, id)
	local item = Economy.item(id)
	if not item then
		return false, "No such thing to buy."
	end
	if item.def.max and Economy.owned(d, id) >= item.def.max then
		return false, "You own the most " .. item.def.name .. "s allowed (" .. item.def.max .. ")."
	end
	local missing = short(d, item.def.price)
	if missing then
		return false, missing
	end
	PlayerData.update(player, function(data)
		data.coins -= item.def.price
		data.inventory[id] = (data.inventory[id] or 0) + 1
	end)
	return true, item.def.name .. " bought. Press B to build it on your plot."
end

function Shop.init()
	Remotes.Buy.OnServerInvoke = function(player, kind, key)
		local d = PlayerData.get(player)
		if not d then
			return false, "Still loading your progress..."
		end
		local buyer = type(kind) == "string" and buyers[kind]
		local validKey = if kind == "item" then type(key) == "string" else type(key) == "number" and key == math.floor(key)
		if not buyer or not validKey then
			return false, "Nothing to buy there."
		end
		local ok, message = buyer(player, d, key)
		if ok then
			Achievements.check(player)
		end
		return ok, message
	end
	Remotes.EquipSkin.OnServerInvoke = function(player, id)
		local d = PlayerData.get(player)
		if not d or type(id) ~= "string" or (id ~= "" and not d.skins[id]) then
			return false, "You don't have that skin."
		end
		PlayerData.update(player, function(data)
			data.skin = id
		end)
		Tools.give(player, d.tool, id)
		return true, if id == "" then "Back to the plain tool." else "Skin on!"
	end
end

return Shop
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00024">
				<Properties>
					<string name="Name">Structures</string>
					<ProtectedString name="Source"><![CDATA[-- Free building on your own plot: place pieces, machines and generators you've bought, take
-- them back, and ride elevators. Placements are saved relative to the plot's centre.
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)
local Pieces = require(script.Parent.Pieces)

local Structures = {}

-- Lights every machine and generator on the player's plot for the current power.
local function relight(player)
	local d = PlayerData.get(player)
	if d then
		local plot = Economy.plot(d.placed, PlayerData.flags(player).doubleMachines)
		Structures.light(player, plot.machines > 0 and plot.share >= 1)
	end
end

local function builtFolder(plotIndex)
	local plot = Plots.folder(plotIndex)
	local folder = plot:FindFirstChild("Built")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Built"
		folder.Parent = plot
	end
	return folder
end

local function spawnPiece(plotIndex, entry, slot)
	local cf = CFrame.new(Plots.centre(plotIndex) + Vector3.new(entry.x, entry.y, entry.z)) * CFrame.Angles(0, math.rad(entry.r), 0)
	local model = Pieces.make(entry.k, cf)
	if model then
		model:SetAttribute("Slot", slot)
		model.Parent = builtFolder(plotIndex)
	end
	return model
end

-- Everyone has a trader: one stall, placed between the hub and the heap on the first visit.
-- Players can take it back (X) and put it anywhere, even up on a platform.
local function ensureTrader(plotIndex, d)
	if Economy.owned(d, "trader") > 0 then
		return
	end
	local centre = Plots.centre(plotIndex)
	local toHub = -centre.Unit
	local rel = toHub * Config.TraderDistance
	local turn = math.deg(math.atan2(-toHub.X, -toHub.Z)) -- the stall's front faces the hub
	table.insert(d.placed, { k = "trader", x = math.floor(rel.X * 10 + 0.5) / 10, y = 0, z = math.floor(rel.Z * 10 + 0.5) / 10, r = turn % 360 })
end

-- Rebuilds everything the player has placed (on joining).
function Structures.build(plotIndex, d)
	local owner = Plots.owner(plotIndex)
	if owner then
		PlayerData.update(owner, function(data)
			ensureTrader(plotIndex, data)
		end)
	end
	for slot, entry in ipairs(d.placed) do
		spawnPiece(plotIndex, entry, slot)
	end
	if owner then
		task.defer(relight, owner)
	end
end

-- Renumbers the models after a removal so Slot attributes match d.placed again.
local function renumber(plotIndex, d)
	builtFolder(plotIndex):ClearAllChildren()
	Structures.build(plotIndex, d)
end

local function place(player, id, position, rotation)
	local d, plotIndex = PlayerData.get(player), Plots.of(player)
	if not d or not plotIndex then
		return false, "You don't have a plot yet."
	end
	if type(id) ~= "string" or not Economy.item(id) or (d.inventory[id] or 0) <= 0 then
		return false, "Buy that in the shop first."
	end
	if typeof(position) ~= "Vector3" or type(rotation) ~= "number" or rotation ~= rotation then
		return false, "Can't build there."
	end
	if not Plots.contains(plotIndex, position, 1) then
		return false, "You can only build on your own plot."
	end
	if #d.placed >= Config.MaxPlaced then
		return false, "Your plot is full (" .. Config.MaxPlaced .. " things)."
	end
	local rel = position - Plots.centre(plotIndex)
	local entry = { k = id, x = math.floor(rel.X * 10 + 0.5) / 10, y = math.floor(rel.Y * 10 + 0.5) / 10, z = math.floor(rel.Z * 10 + 0.5) / 10, r = rotation % 360 }
	PlayerData.update(player, function(data)
		data.inventory[id] -= 1
		table.insert(data.placed, entry)
	end)
	spawnPiece(plotIndex, entry, #d.placed)
	relight(player)
	return true, Economy.item(id).def.name .. " placed."
end

local function remove(player, model)
	local d, plotIndex = PlayerData.get(player), Plots.of(player)
	if not d or not plotIndex or typeof(model) ~= "Instance" or model.Parent ~= builtFolder(plotIndex) then
		return false, "That isn't yours to take."
	end
	local slot = model:GetAttribute("Slot")
	local entry = slot and d.placed[slot]
	if not entry then
		return false, "Can't take that."
	end
	PlayerData.update(player, function(data)
		table.remove(data.placed, slot)
		data.inventory[entry.k] = (data.inventory[entry.k] or 0) + 1
	end)
	renumber(plotIndex, d)
	relight(player)
	return true, Economy.item(entry.k).def.name .. " back in your inventory."
end

-- Machine and generator lamps: green when there's enough power, red when not.
function Structures.light(player, running)
	local plotIndex = Plots.of(player)
	if not plotIndex then
		return
	end
	for _, model in ipairs(builtFolder(plotIndex):GetChildren()) do
		local item = Economy.item(model:GetAttribute("Item") or "")
		if item and item.kind ~= "piece" then
			Pieces.light(model, item.kind == "generator" or running)
		end
	end
end

-- Teleporter pads: from a pad you stand on to any other pad on your own plot.
local function teleport(player, destination)
	local plotIndex = Plots.of(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not plotIndex or not root or typeof(destination) ~= "Instance" or destination.Parent ~= builtFolder(plotIndex) or destination:GetAttribute("Item") ~= "teleporter" then
		return
	end
	local near = false
	for _, model in ipairs(builtFolder(plotIndex):GetChildren()) do
		if model ~= destination and model:GetAttribute("Item") == "teleporter" and (model:GetPivot().Position - root.Position).Magnitude <= 14 then
			near = true
		end
	end
	if near then
		root.CFrame = destination:GetPivot() * CFrame.new(0, 4, 0)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function Structures.init()
	Remotes.Teleport.OnServerEvent:Connect(teleport)
	Remotes.Place.OnServerInvoke = place
	Remotes.TakeBack.OnServerInvoke = remove
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local direction = prompt:GetAttribute("Direction")
		local model = prompt:FindFirstAncestorOfClass("Model")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not direction or not model or not root or model:GetAttribute("Item") ~= "elevator" then
			return
		end
		local base = model:GetPivot()
		local target = if direction == "up" then base * CFrame.new(0, 54, 0) else base * CFrame.new(0, 3.5, 0)
		root.CFrame = target
		root.AssemblyLinearVelocity = Vector3.zero
	end)
end

return Structures
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00025">
				<Properties>
					<string name="Name">Tools</string>
					<ProtectedString name="Source"><![CDATA[-- The search tools: a pitchfork-shaped Tool per level, coloured from Config.Tools.
-- The tool goes in StarterGear too, so players keep it when they respawn.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Build = require(script.Parent.Build)

local Tools = {}

local function attach(tool, handle, size, offset, colour, material)
	local part = Instance.new("Part")
	part.Name = "Head"
	part.Size = size
	part.Color = colour
	part.Material = material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
	part.Parent = tool
	return part
end

-- The skin (from the Wheel of Fortune) recolours the tool; "" is the plain tool.
local function skinOf(id)
	for _, prize in ipairs(Config.Wheel) do
		if prize.id == id and not prize.reveal then
			return prize
		end
	end
	return nil
end

function Tools.make(level, skinId)
	local def = Config.Tools[level]
	local skin = skinOf(skinId or "")
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.ToolTip = Format.commas(def.power) .. " straws a click, carries " .. Format.commas(def.capacity)
	tool.CanBeDropped = false
	tool.Grip = CFrame.new(0, -1, 0) -- held a little below the middle, fork up
	tool:SetAttribute("Level", level)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 6, 0.3)
	handle.Color = Build.rgb(if skin then skin.shaft else def.shaft)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local colour = Build.rgb(if skin then skin.head else def.head)
	local material = Enum.Material[if skin then skin.material else def.material]
	attach(tool, handle, Vector3.new(1.7, 0.3, 0.3), CFrame.new(0, 2.9, 0), colour, material)
	for x = -1, 1 do
		attach(tool, handle, Vector3.new(0.16, 1.5, 0.16), CFrame.new(x * 0.7, 3.75, 0), colour, material)
	end
	-- the hay you've harvested sits on the tines and grows as you harvest (see Carry.luau)
	local load = attach(tool, handle, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 4, 0), Build.rgb({ 222, 186, 92 }), Enum.Material.Grass)
	load.Name = "Load"
	load.Shape = Enum.PartType.Ball
	load.Transparency = 1
	return tool
end

local function clear(container, character)
	local equipped = false
	if container then
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				equipped = equipped or container == character
				item:Destroy()
			end
		end
	end
	return equipped
end

-- True if the player holds or carries a search tool.
function Tools.has(player)
	local function holds(container)
		for _, item in ipairs(container and container:GetChildren() or {}) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				return true
			end
		end
		return false
	end
	return holds(player:FindFirstChildOfClass("Backpack")) or holds(player.Character)
end

-- Replace whatever search tool the player has with the one for `level`. May wait briefly.
function Tools.give(player, level, skinId)
	local gear = player:FindFirstChild("StarterGear") or player:WaitForChild("StarterGear", 10)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	clear(gear, nil)
	clear(backpack, nil)
	local wasEquipped = clear(character, character)
	if gear then
		Tools.make(level, skinId).Parent = gear
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if backpack and humanoid and humanoid.Health > 0 then
		local tool = Tools.make(level, skinId)
		tool.Parent = backpack
		if wasEquipped then
			humanoid:EquipTool(tool)
		end
	end
end

return Tools
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00026">
				<Properties>
					<string name="Name">Wheel</string>
					<ProtectedString name="Source"><![CDATA[-- The Wheel of Fortune: one Robux spin (the WheelSpin product) = one prize, picked here on the
-- server by weight. Every spin wins something. Where paid random items are restricted the
-- wheel is hidden on the client, and a spin that slips through is replaced by a fixed prize.
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)

local Wheel = {}
local rng = Random.new()

function Wheel.restricted(player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	return not ok or info.ArePaidRandomItemsRestricted == true -- unknown counts as restricted
end

-- Grants one spin. Returns a message for the player.
function Wheel.spin(player)
	local d = PlayerData.get(player)
	local coins = Economy.coinsFor(Economy.power(d, false) * Config.WheelDuplicateSearches, false, 1)
	if Wheel.restricted(player) then
		PlayerData.update(player, function(data)
			data.coins += coins
		end)
		return "The wheel isn't available where you live, so you got " .. coins .. " coins instead."
	end
	local index, prize = Economy.spin(rng)
	local message
	if prize.reveal then
		PlayerData.update(player, function(data)
			data.revealed = true
		end)
		Remotes.Announce:FireClient(player, { kind = "reveal", clump = d.needleClump })
		Remotes.Announce:FireAllClients({ kind = "notice", text = player.DisplayName .. " won the NEEDLE REVEAL on the Wheel of Fortune!" })
		message = "JACKPOT! The needle's clump is glowing on your pile."
	elseif d.skins[prize.id] then
		PlayerData.update(player, function(data)
			data.coins += coins
		end)
		message = "You already have the " .. prize.name .. ", so you got " .. coins .. " coins."
	else
		PlayerData.update(player, function(data)
			data.skins[prize.id] = true
		end)
		message = "You won the " .. prize.name .. "! Wear it from the Skins menu."
	end
	Remotes.Announce:FireClient(player, { kind = "wheel", index = index, name = prize.name, text = message })
	return message
end

-- Tells a player on joining where their needle is, if they won the reveal for this pile.
function Wheel.remind(player)
	local d = PlayerData.get(player)
	if d and d.revealed then
		task.delay(10, function()
			Remotes.Announce:FireClient(player, { kind = "reveal", clump = d.needleClump })
		end)
	end
end

return Wheel
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00027">
				<Properties>
					<string name="Name">World</string>
					<ProtectedString name="Source"><![CDATA[-- Hollow Creek Farm, smaller now: four plots around a hub with the merchant, the Wheel of
-- Fortune and the golden door to the secret Golden Loft. Sunset light, fence and trees.
local Lighting = game:GetService("Lighting")

local Build = require(script.Parent.Build)

local World = {}
local terrain = workspace.Terrain
local AUTUMN = { { 214, 120, 40 }, { 196, 72, 44 }, { 232, 176, 54 }, { 150, 150, 58 } }
local WOOD = { 122, 86, 52 }

World.MERCHANT = Vector3.new(0, 0, -36) -- on the north road
World.WHEEL = Vector3.new(0, 0, 36) -- on the south road
World.DOOR = Vector3.new(36, 0, 0) -- the golden door, on the east road
World.LOFT = Vector3.new(0, 330, 0) -- the secret level floats high above the hub

local function prompt(parent, action, text, object, key)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = text
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = key or Enum.KeyCode.E
	p:SetAttribute("Action", action)
	p.Parent = parent
	return p
end

function World.ground()
	terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(118, 136, 58)) -- Grass is the straw heap
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(124, 94, 62))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(152, 138, 120))
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(420, 16, 420), Enum.Material.LeafyGrass)
	terrain:FillBlock(CFrame.new(0, -2, 0), Vector3.new(30, 4, 330), Enum.Material.Ground)
	terrain:FillBlock(CFrame.new(0, -2, 0), Vector3.new(330, 4, 30), Enum.Material.Ground)
	terrain:FillCylinder(CFrame.new(0, -2, 0), 4, 22, Enum.Material.Cobblestone)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Color = Color3.fromRGB(196, 150, 92)
	spawn.Material = Enum.Material.WoodPlanks
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = workspace
end

function World.lighting()
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(86, 70, 60)
	Lighting.OutdoorAmbient = Color3.fromRGB(170, 136, 112)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 196, 146)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, old in ipairs(Lighting:GetChildren()) do
		if old:IsA("Atmosphere") or old:IsA("PostEffect") then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 204, 158)
	atmosphere.Decay = Color3.fromRGB(176, 108, 78)
	atmosphere.Glare = 0.5
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 20
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.12
	grade.Contrast = 0.06
	grade.TintColor = Color3.fromRGB(255, 246, 234)
	grade.Parent = Lighting
end

local function fence(folder)
	local half = 165
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for i = -16, 16 do
			local along = i * 10
			local pos = if side[1] ~= 0 then Vector3.new(side[1] * half, 0, along) else Vector3.new(along, 0, side[2] * half)
			Build.part({ name = "Post", size = Vector3.new(1.2, 5, 1.2), cframe = CFrame.new(pos + Vector3.new(0, 2.5, 0)), color = WOOD, material = "Wood", parent = folder })
		end
		for _, h in ipairs({ 1.6, 3.4 }) do
			local size = if side[1] ~= 0 then Vector3.new(0.5, 0.45, half * 2) else Vector3.new(half * 2, 0.45, 0.5)
			Build.part({ name = "Rail", size = size, cframe = CFrame.new(side[1] * half, h, side[2] * half), color = WOOD, material = "Wood", parent = folder })
		end
	end
end

local function trees(folder)
	local rng = Random.new(7)
	for i = 1, 36 do
		local a = i / 36 * math.pi * 2
		local r = rng:NextNumber(185, 205)
		local base = CFrame.new(math.cos(a) * r, 0, math.sin(a) * r)
		local height = rng:NextNumber(10, 16)
		Build.post({ name = "Trunk", color = { 96, 66, 44 }, material = "Wood", parent = folder }, base, height, 2.6)
		for _ = 1, 3 do
			local size = rng:NextNumber(10, 16)
			local offset = Vector3.new(rng:NextNumber(-4, 4), height + rng:NextNumber(0, 5), rng:NextNumber(-4, 4))
			Build.part({ name = "Leaves", shape = "Ball", size = Vector3.new(size, size, size), cframe = base * CFrame.new(offset), color = AUTUMN[rng:NextInteger(1, #AUTUMN)], material = "Grass", parent = folder })
		end
	end
end

local function merchant(folder)
	local cf = CFrame.lookAt(World.MERCHANT, Vector3.new(0, 0, 0))
	Build.part({ name = "Counter", size = Vector3.new(12, 3.6, 3), cframe = cf * CFrame.new(0, 1.8, -1), color = { 150, 104, 60 }, material = "WoodPlanks", parent = folder })
	for _, x in ipairs({ -5.5, 5.5 }) do
		Build.part({ name = "StallPost", size = Vector3.new(0.7, 10, 0.7), cframe = cf * CFrame.new(x, 5, 3), color = WOOD, material = "Wood", parent = folder })
	end
	local awning = Build.part({ name = "Awning", size = Vector3.new(14, 0.4, 9), cframe = cf * CFrame.new(0, 10.2, 1) * CFrame.Angles(math.rad(-8), 0, 0), color = { 200, 60, 50 }, material = "Fabric", parent = folder })
	for i = 0, 6 do
		Build.part({ name = "Stripe", size = Vector3.new(1, 0.42, 9), cframe = awning.CFrame * CFrame.new(-6 + i * 2, 0, 0), color = { 246, 240, 226 }, material = "Fabric", parent = folder })
	end
	local body = cf * CFrame.new(0, 0, 3)
	Build.part({ name = "MerchantBody", size = Vector3.new(2.4, 3.2, 1.4), cframe = body * CFrame.new(0, 3.6, 0), color = { 80, 110, 70 }, material = "Fabric", parent = folder })
	local head = Build.part({ name = "MerchantHead", shape = "Ball", size = Vector3.new(1.8, 1.8, 1.8), cframe = body * CFrame.new(0, 6.1, 0), color = { 230, 190, 150 }, parent = folder })
	Build.part({ name = "MerchantHat", shape = "Cylinder", size = Vector3.new(0.3, 3.4, 3.4), cframe = body * CFrame.new(0, 6.9, 0) * CFrame.Angles(0, 0, math.rad(90)), color = { 112, 84, 48 }, material = "Fabric", parent = folder })
	local coins = Build.part({ name = "CoinPile", shape = "Ball", size = Vector3.new(1.4, 1.4, 1.4), cframe = cf * CFrame.new(3, 4.1, -1), color = { 245, 200, 66 }, material = "Metal", parent = folder })
	coins.Reflectance = 0.3
	prompt(head, "sell", "Sell your straw", "Hay Merchant")
end

local function wheel(folder)
	local cf = CFrame.lookAt(World.WHEEL, Vector3.new(0, 0, 0))
	Build.part({ name = "WheelStand", size = Vector3.new(2, 14, 2), cframe = cf * CFrame.new(0, 7, 1.5), color = WOOD, material = "Wood", parent = folder })
	local disc = Build.part({ name = "WheelDisc", shape = "Cylinder", size = Vector3.new(0.6, 16, 16), cframe = cf * CFrame.new(0, 13, 0) * CFrame.Angles(0, math.rad(90), 0), color = { 245, 200, 66 }, material = "SmoothPlastic", parent = folder })
	Build.part({ name = "WheelPointer", size = Vector3.new(1, 2.4, 0.6), cframe = cf * CFrame.new(0, 21.6, -0.6), color = { 200, 50, 50 }, material = "Neon", parent = folder })
	local sign = Build.part({ name = "WheelSign", size = Vector3.new(14, 2.4, 0.4), cframe = cf * CFrame.new(0, 2.4, -1), color = { 246, 234, 204 }, material = "WoodPlanks", parent = folder })
	Build.text(sign, Enum.NormalId.Front, "WHEEL OF FORTUNE: odds shown before you spin")
	prompt(disc, "wheel", "See the wheel", "Wheel of Fortune")
end

local function door(folder)
	local cf = CFrame.lookAt(World.DOOR, Vector3.new(0, 0, 0))
	for _, x in ipairs({ -4, 4 }) do
		Build.part({ name = "DoorPost", size = Vector3.new(1.2, 12, 1.2), cframe = cf * CFrame.new(x, 6, 0), color = { 200, 160, 60 }, material = "Metal", parent = folder })
	end
	Build.part({ name = "DoorTop", size = Vector3.new(9.2, 1.2, 1.4), cframe = cf * CFrame.new(0, 12.6, 0), color = { 200, 160, 60 }, material = "Metal", parent = folder })
	local panel = Build.part({ name = "GoldenDoor", size = Vector3.new(6.8, 11, 0.5), cframe = cf * CFrame.new(0, 5.5, 0), color = { 255, 214, 90 }, material = "Neon", transparency = 0.25, parent = folder })
	Build.text(panel, Enum.NormalId.Front, "THE GOLDEN LOFT\n???", { color = Color3.fromRGB(110, 70, 20), pixels = 30 })
	prompt(panel, "loft", "Enter", "Golden Door")
end

function World.build()
	World.lighting()
	local farm = Instance.new("Folder")
	farm.Name = "Farm"
	farm.Parent = workspace
	fence(farm)
	trees(farm)
	merchant(farm)
	wheel(farm)
	door(farm)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local base = CFrame.new(math.cos(a) * 19, 0, math.sin(a) * 19)
		Build.post({ name = "LampPost", color = { 52, 48, 46 }, material = "Metal", parent = farm }, base, 9, 0.6)
		local lamp = Build.part({ name = "Lamp", size = Vector3.new(1.6, 1.6, 1.6), cframe = base * CFrame.new(0, 9.6, 0), color = { 255, 196, 110 }, material = "Neon", parent = farm })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 190, 120)
		light.Range = 22
		light.Brightness = 1.6
		light.Parent = lamp
	end
end

return World
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00028">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00029">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX0002A">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0002B">
					<Properties>
						<string name="Name">BuildMode</string>
						<ProtectedString name="Source"><![CDATA[-- Free building in first person. Z and C pick from your inventory bar (or press M and click
-- it), aim with the crosshair, R to turn it, click (or PLACE) to build. X takes things back.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)
local Cursor = require(script.Parent.Cursor)
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer
local BuildMode = {}
local active, removing, selected, rotation = false, false, nil, 0
local ghost, arrow, bar, buttons, status, notify = nil, nil, nil, {}, nil, nil
local hovered = nil
local removeBox = Instance.new("SelectionBox")
removeBox.Color3 = Color3.fromRGB(255, 90, 70)
removeBox.LineThickness = 0.1
removeBox.Parent = player:WaitForChild("PlayerGui")

local ALL = {}
for _, list in ipairs({ Config.Pieces, Config.Generators, Config.Machines }) do
	for _, def in ipairs(list) do
		table.insert(ALL, def)
	end
end

local function myPlot()
	local index = player:GetAttribute("Plot")
	local c = index and Config.PlotCentres[index]
	return c and Vector3.new(c[1], 0, c[2]), index
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	local things = { player.Character, ghost, workspace:FindFirstChild("MyEffects") }
	for i = 1, 3 do
		if things[i] then
			table.insert(ignore, things[i])
		end
	end
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 90, params)
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
end

local function makeGhost(def)
	clearGhost()
	local size = Vector3.new(def.size[1], def.size[2], def.size[3])
	ghost = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Size = size, Transparency = 0.55, Material = Enum.Material.ForceField, Color = Color3.fromRGB(120, 255, 140), Parent = workspace })
	arrow = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Size = Vector3.new(0.6, 0.6, 3), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 220, 90), Parent = ghost })
end

local function refreshBar()
	for id, button in pairs(buttons) do
		local n = player:GetAttribute("Inv_" .. id) or 0
		button.Visible = n > 0
		local def = Economy.item(id).def
		button.Text = def.name .. " x" .. n
		button.BackgroundColor3 = if selected == id then Ui.colors.green else Ui.colors.wood
	end
end

local function select(id)
	selected, removing = id, false
	makeGhost(Economy.item(id).def)
	status.Text = Economy.item(id).def.name .. ": aim, R to turn, click to place. Z/C: other items. X: take back. B: done."
	refreshBar()
end

local function place()
	if not selected or not ghost then
		return
	end
	local base = ghost.CFrame.Position - Vector3.new(0, ghost.Size.Y / 2, 0)
	local ok, message = Remotes.Place:InvokeServer(selected, base, rotation)
	notify.toast(message, if ok then Ui.colors.green else Ui.colors.red)
	if ok then
		Juice.burst(base + Vector3.new(0, 1, 0), 18)
		Juice.punch(1.5)
		if (player:GetAttribute("Inv_" .. selected) or 0) <= 0 then
			selected = nil
			clearGhost()
		end
	end
	refreshBar()
end

local function takeBack()
	if hovered then
		local ok, message = Remotes.TakeBack:InvokeServer(hovered)
		notify.toast(message, if ok then Ui.colors.wood else Ui.colors.red)
	end
end

function BuildMode.toggle(on)
	active = if on == nil then not active else on
	bar.Visible, status.Visible = active, active
	if active then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:UnequipTools()
		end
		status.Text = "Z/C to pick something to build (buy more in the Shop). B when done."
		refreshBar()
	else
		selected, removing, hovered = nil, false, nil
		removeBox.Adornee = nil
		clearGhost()
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local backpack = player:FindFirstChildOfClass("Backpack")
		for _, tool in ipairs(backpack and backpack:GetChildren() or {}) do
			if humanoid and tool:IsA("Tool") and tool:GetAttribute("Level") ~= nil then
				humanoid:EquipTool(tool) -- back to harvesting
				break
			end
		end
	end
end

function BuildMode.mount(gui, notifier)
	notify = notifier
	bar = Ui.make("ScrollingFrame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0.9, 0, 0, 64), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, BackgroundTransparency = 1, ScrollBarThickness = 4, Visible = false, Parent = gui }, {
		Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	status = Ui.label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -84), Size = UDim2.fromOffset(560, 26), Visible = false, Parent = gui }, 20)
	for order, def in ipairs(ALL) do
		local button = Ui.button(def.name, Ui.colors.wood, { LayoutOrder = order, Size = UDim2.fromOffset(150, 56), Visible = false, Parent = bar })
		button.Activated:Connect(function()
			select(def.id)
		end)
		buttons[def.id] = button
	end
	local touchRow = Ui.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.55, 0), Size = UDim2.fromOffset(120, 180), BackgroundTransparency = 1, Parent = gui }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6) }) })
	touchRow.Visible = false
	for _, b in ipairs({ { "PLACE", place }, { "TURN", function() rotation = (rotation + 45) % 360 end }, { "TAKE BACK", function() if removing then takeBack() else removing = true; selected = nil; clearGhost() end end } }) do
		Ui.button(b[1], Ui.colors.wood, { Size = UDim2.fromOffset(120, 52), Parent = touchRow }).Activated:Connect(b[2])
	end
	player.AttributeChanged:Connect(function(name)
		if active and string.sub(name, 1, 4) == "Inv_" then
			refreshBar()
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.B and not processed then
			BuildMode.toggle()
		end
		if not active or processed then
			return
		end
		touchRow.Visible = UserInputService.TouchEnabled
		if input.KeyCode == Enum.KeyCode.Z or input.KeyCode == Enum.KeyCode.C then
			local owned = {}
			for _, def in ipairs(ALL) do
				if (player:GetAttribute("Inv_" .. def.id) or 0) > 0 then
					table.insert(owned, def.id)
				end
			end
			if #owned > 0 then
				local at = table.find(owned, selected) or 0
				at = if input.KeyCode == Enum.KeyCode.C then at % #owned + 1 elseif at <= 1 then #owned else at - 1
				select(owned[at])
			end
		elseif input.KeyCode == Enum.KeyCode.R then
			rotation = (rotation + (if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 15 else 45)) % 360
		elseif input.KeyCode == Enum.KeyCode.X then
			removing, selected = not removing, nil
			clearGhost()
			status.Text = if removing then "Click something you built to take it back into your inventory." else "Pick something to build."
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not Cursor.isFree() or input.KeyCode == Enum.KeyCode.F then
			if removing then
				takeBack()
			else
				place()
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not active then
			return
		end
		touchRow.Visible = UserInputService.TouchEnabled
		local hit = aimPoint()
		local centre, index = myPlot()
		if removing then
			local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
			local built = index and workspace.Plots:FindFirstChild("Plot" .. index) and workspace.Plots["Plot" .. index]:FindFirstChild("Built")
			hovered = if model and built and model.Parent == built then model else nil
			removeBox.Adornee = hovered
			return
		end
		removeBox.Adornee = nil
		if ghost and hit and centre then
			local grid = Config.BuildGrid
			local p = hit.Position
			local snapped = Vector3.new(math.floor(p.X / grid + 0.5) * grid, p.Y, math.floor(p.Z / grid + 0.5) * grid)
			local cf = CFrame.new(snapped + Vector3.new(0, ghost.Size.Y / 2, 0)) * CFrame.Angles(0, math.rad(rotation), 0)
			ghost.CFrame = ghost.CFrame:Lerp(cf, 0.5) -- glides into place
			arrow.CFrame = ghost.CFrame * CFrame.new(0, ghost.Size.Y / 2 + 0.5, -ghost.Size.Z / 2)
			local half = Config.PlotSize / 2 - 1
			local inside = math.abs(snapped.X - centre.X) <= half and math.abs(snapped.Z - centre.Z) <= half
			ghost.Color = if inside then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 100, 90)
		end
	end)
end

return BuildMode
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0002C">
					<Properties>
						<string name="Name">Cursor</string>
						<ProtectedString name="Source"><![CDATA[-- First person locks the mouse to the centre of the screen. Menus need a pointer, so a
-- hidden "modal" button frees the mouse while a menu is open or while you hold M.
local UserInputService = game:GetService("UserInputService")

local Ui = require(script.Parent.Ui)

local Cursor = {}
local modal = nil
local reasons = {}

local function apply()
	local free = false
	for _, on in pairs(reasons) do
		free = free or on
	end
	if modal then
		modal.Visible = free
	end
	UserInputService.MouseIconEnabled = free
end

function Cursor.mount(gui)
	modal = Ui.make("TextButton", { Name = "FreeMouse", Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1), Modal = true, Visible = false, Parent = gui })
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			reasons.key = not reasons.key
			apply()
		end
	end)
	apply()
end

-- Something (a window, build mode) wants the mouse free (true) or no longer needs it (false).
function Cursor.need(reason, on)
	reasons[reason] = on
	apply()
end

function Cursor.isFree()
	return modal ~= nil and modal.Visible
end

return Cursor
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0002D">
					<Properties>
						<string name="Name">Harvest</string>
						<ProtectedString name="Source"><![CDATA[-- Aiming in first person: the clump under the crosshair (within reach, on your own pile or the
-- golden haystack) gets a soft outline, and clicking with your tool harvests it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer
local Harvest = {}
local target = nil
local lastSwing = 0
local hooked = setmetatable({}, { __mode = "k" })

local Layout = require(Shared:WaitForChild("Layout"))(Config)
local HEAP = Enum.Material.Grass

-- The heap is terrain, so a see-through box marks the clump you're aiming at.
local marker = Instance.new("Part")
marker.Name = "AimMarker"
marker.Anchored, marker.CanCollide, marker.CanQuery, marker.CanTouch = true, false, false, false
marker.Transparency = 1
marker.Size = Vector3.new(1, 1, 1) * (Config.ClumpSize + 0.2)
local outline = Instance.new("SelectionBox")
outline.Color3 = Color3.fromRGB(255, 236, 170)
outline.LineThickness = 0.05
outline.SurfaceTransparency = 0.88
outline.SurfaceColor3 = Color3.fromRGB(255, 236, 170)
outline.Parent = player:WaitForChild("PlayerGui")

local function myOrigin()
	local plot = player:GetAttribute("Plot")
	local centre = plot and Config.PlotCentres[plot]
	if not centre then
		return nil
	end
	local x, z = Layout.origin(centre[1], centre[2])
	return Vector3.new(x, 0, z), Vector3.new(centre[1], 0, centre[2])
end

-- Where on your own heap a ray hit: the point just inside the surface and its clump's centre.
local function onMyHeap(result)
	if not result or result.Instance ~= workspace.Terrain or result.Material ~= HEAP then
		return nil
	end
	local origin, centre = myOrigin()
	if not origin then
		return nil
	end
	local inside = result.Position - result.Normal * 1.5
	local half = Config.PlotSize / 2
	if math.abs(inside.X - centre.X) > half or math.abs(inside.Z - centre.Z) > half then
		return nil
	end
	local s = Config.ClumpSize
	local gx, layer, gz = math.floor((inside.X - origin.X) / s + 0.5), math.floor(inside.Y / s), math.floor((inside.Z - origin.Z) / s + 0.5)
	return inside, origin + Vector3.new(gx * s, layer * s + s / 2, gz * s)
end

local function harvestable(part)
	local loft = workspace:FindFirstChild("Loft")
	return part ~= nil and loft ~= nil and part:IsDescendantOf(loft) and string.sub(part.Name, 1, 6) == "Golden" and player:GetAttribute("LoftOpen") == true
end

local function cast(distance, ignoreEffects)
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if ignoreEffects then { character, workspace:FindFirstChild("MyEffects") } else { character }
	return workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * distance, params)
end

-- What a click would harvest: (what to send the server, where it is, the marker's centre)
local function aim()
	local head = player.Character and player.Character:FindFirstChild("Head")
	local result = head and cast(Config.Reach + 4, true)
	if not result or (result.Position - head.Position).Magnitude > Config.Reach then
		return nil
	end
	local inside, cell = onMyHeap(result)
	if inside then
		return inside, result.Position, cell
	elseif harvestable(result.Instance) then
		return result.Instance, result.Position, nil
	end
	return nil
end

function Harvest.target()
	return target
end

-- A click that hit nothing to harvest: say what the crosshair is on (at most every 2 s).
local lastMiss = 0
Harvest.onMiss = nil
Harvest.lastFired = 0
function Harvest.miss()
	if time() - lastMiss < 2 or not Harvest.onMiss then
		return
	end
	lastMiss = time()
	local result = cast(300, false)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not player:GetAttribute("Plot") then
		Harvest.onMiss("Your farm isn't ready yet. Wait a moment.")
	elseif not result then
		Harvest.onMiss("Aim the dot in the middle of the screen at your hay heap.")
	elseif result.Instance == workspace.Terrain and result.Material == HEAP then
		local far = head and (result.Position - head.Position).Magnitude or 0
		if onMyHeap(result) and far > Config.Reach then
			Harvest.onMiss("Too far: " .. math.floor(far) .. " studs. Get within " .. Config.Reach .. ".")
		elseif not onMyHeap(result) then
			Harvest.onMiss("That's not your heap. Yours is on the farm marked YOUR FARM.")
		end
	else
		Harvest.onMiss("That's " .. (if result.Instance == workspace.Terrain then "the ground" else result.Instance.Name) .. ", not hay. Aim the dot at your heap.")
	end
end

local function cooldown()
	return Config.SearchCooldown * (1 - Config.Perks[2].per_level * (player:GetAttribute("Perk_swift") or 0))
end

-- One swing: harvest the clump under the crosshair (shared by the tool and the mouse button).
local function swing(tool)
	local part, point = aim()
	if part == nil then
		Harvest.miss()
		return
	end
	if time() - lastSwing < cooldown() then
		return
	end
	lastSwing = time()
	Harvest.lastFired = time()
	Remotes.Harvest:FireServer(part)
	-- instant feel: a puff where you hit and a tiny camera push (the combo waits for the server)
	Juice.burst(point, 6, typeof(part) == "Instance")
	Juice.punch(1.2)
	local anim = Instance.new("StringValue") -- the default Animate script plays a swing for this
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	task.delay(0.5, function()
		anim:Destroy()
	end)
end

local function heldTool()
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return if tool and tool:GetAttribute("Level") ~= nil then tool else nil
end

local function hookTool(tool)
	if hooked[tool] or not tool:IsA("Tool") or tool:GetAttribute("Level") == nil then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		swing(tool)
	end)
end

function Harvest.start()
	-- the mouse button too, in case the tool's own click doesn't come through in first person
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		-- with the mouse locked to the crosshair, a click can't be meant for a menu
		local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
		if processed and not locked then
			return
		end
		local tool = heldTool()
		if tool then
			swing(tool)
		elseif Harvest.onMiss and player.Character then
			Harvest.onMiss("Hold your fork to harvest: press 1.")
		end
	end)
	RunService.RenderStepped:Connect(function()
		local part, _, cell = aim()
		target = part
		if cell then
			marker.Position = cell
			marker.Parent = workspace:FindFirstChild("MyEffects") or workspace
			outline.Adornee = marker
		else
			outline.Adornee = if typeof(part) == "Instance" then part else nil
		end
	end)
	local backpackConnection = nil
	local function onCharacter(character)
		local humanoid = character:WaitForChild("Humanoid")
		local backpack = player:WaitForChild("Backpack")
		local equipped = false
		local function arrive(tool)
			hookTool(tool)
			if not equipped and tool:IsA("Tool") and tool:GetAttribute("Level") ~= nil then
				equipped = true
				task.defer(function()
					if humanoid.Parent and tool.Parent == backpack then
						humanoid:EquipTool(tool)
					end
				end)
			end
		end
		if backpackConnection then
			backpackConnection:Disconnect()
		end
		backpackConnection = backpack.ChildAdded:Connect(arrive)
		for _, tool in ipairs(backpack:GetChildren()) do
			arrive(tool)
		end
		character.ChildAdded:Connect(hookTool)
		for _, tool in ipairs(character:GetChildren()) do
			hookTool(tool) -- already held when this script started
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

return Harvest
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0002E">
					<Properties>
						<string name="Name">HayFx</string>
						<ProtectedString name="Source"><![CDATA[-- The hay you can see moving: every harvest lifts a lump off the heap onto your tool, and
-- dumping sends your load flying into your trader's basket, which fills and is carted away.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Ui = require(script.Parent.Ui)
local Juice = require(script.Parent.Juice)

local HayFx = {}
local HAY = Color3.fromRGB(Config.HeapColour[1], Config.HeapColour[2], Config.HeapColour[3])
local GOLD = Color3.fromRGB(255, 214, 90)

local function lump(position, size, golden)
	local folder = workspace:FindFirstChild("MyEffects") or workspace
	return Ui.make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Shape = Enum.PartType.Ball, Material = Enum.Material.Grass, Color = if golden then GOLD else HAY,
		Size = Vector3.new(size, size * 0.75, size), CFrame = CFrame.new(position), Parent = folder,
	})
end

-- Where your tool's hay sits on screen: low and to the right, in front of you.
local function toolPoint()
	local camera = workspace.CurrentCamera
	return camera and (camera.CFrame * CFrame.new(1.3, -1.3, -2.6)).Position
end

-- A lump of hay pulled off the heap at `from`, flying onto your tool.
function HayFx.lift(from, golden)
	local to = toolPoint()
	if not to then
		return
	end
	local ball = lump(from, 1.6, golden)
	local mid = (from + to) / 2 + Vector3.new(0, 1.5, 0)
	Juice.ease(ball, 0.14, { CFrame = CFrame.new(mid), Size = Vector3.new(1.2, 0.9, 1.2) }, Enum.EasingStyle.Sine)
	task.delay(0.14, function()
		local target = toolPoint() or to
		Juice.ease(ball, 0.14, { CFrame = CFrame.new(target), Size = Vector3.new(0.5, 0.4, 0.5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	Debris:AddItem(ball, 0.3)
end

-- Dumping: lumps fly from you into the basket, the hay in it rises, then the trader carts it off.
function HayFx.dump(basket, straws)
	if typeof(basket) ~= "Instance" or not basket:IsA("BasePart") then
		return
	end
	local from = toolPoint()
	local top = basket.Position + Vector3.new(0, basket.Size.X / 2, 0)
	local count = math.clamp(math.floor(math.log10(math.max(straws, 1)) * 2), 3, 10)
	for i = 1, count do
		task.delay((i - 1) * 0.06, function()
			if not from then
				return
			end
			local ball = lump(from, 1.1, false)
			local arc = (from + top) / 2 + Vector3.new(math.random(-10, 10) / 10, 3, math.random(-10, 10) / 10)
			Juice.ease(ball, 0.2, { CFrame = CFrame.new(arc) }, Enum.EasingStyle.Sine)
			task.delay(0.2, function()
				Juice.ease(ball, 0.2, { CFrame = CFrame.new(top), Size = Vector3.new(0.6, 0.45, 0.6) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end)
			Debris:AddItem(ball, 0.42)
		end)
	end
	local fill = basket.Parent and basket.Parent:FindFirstChild("BasketFill")
	if not fill then
		return
	end
	local bottom = basket.CFrame * CFrame.new(-basket.Size.X / 2 + 0.3, 0, 0) -- the cylinder's axis is X
	local rim = basket.CFrame * CFrame.new(basket.Size.X / 2 - 0.1, 0, 0)
	fill.CFrame = bottom
	fill.Transparency = 0
	task.delay(count * 0.06 + 0.3, function()
		Juice.ease(fill, 0.5, { CFrame = rim }, Enum.EasingStyle.Back)
		Juice.burst(top, 18, false)
		task.delay(0.6 + Config.BasketDrainSeconds * 0.25, function()
			Juice.ease(fill, Config.BasketDrainSeconds, { CFrame = bottom }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.delay(Config.BasketDrainSeconds, function()
				fill.Transparency = 1
			end)
		end)
	end)
end

return HayFx
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0002F">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- The always-on screen: a crosshair, your pile's progress at the top, and on the left your
-- coins (they count up smoothly), what you carry, your silo, power and the menu buttons.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent.Ui)
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer

local Hud = {}
Hud.state = { inLoft = false, warmth = nil, targeting = false }

local function bar(parent, y, colour)
	local back = Ui.make("Frame", { Size = UDim2.new(1, -16, 0, 10), Position = UDim2.fromOffset(8, y), BackgroundColor3 = Ui.colors.woodDark, Parent = parent }, { Ui.corner(5) })
	return Ui.make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = colour, Parent = back }, { Ui.corner(5) })
end

local function fillTo(fill, share)
	Juice.ease(fill, 0.25, { Size = UDim2.fromScale(math.clamp(share, 0, 1), 1) })
end

function Hud.mount(gui, open)
	local crosshair = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Ui.colors.white, BackgroundTransparency = 0.2, Parent = gui }, { Ui.corner(3), Ui.stroke(Ui.colors.woodDark, 1) })

	local top = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(470, 84), BackgroundColor3 = Ui.colors.wood, BackgroundTransparency = 0.1, Parent = gui }, { Ui.corner(14), Ui.stroke(Ui.colors.woodDark, 3) })
	Ui.autoScale(top)
	local title = Ui.label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 4), TextColor3 = Ui.colors.hay, Parent = top }, 20)
	local countLabel = Ui.label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 27), Parent = top }, 20)
	local pileFill = bar(top, 54, Ui.colors.hay)
	local warmth = Ui.label({ Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 67), TextColor3 = Ui.colors.cream, Parent = top }, 13)

	local left = Ui.make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(220, 470), BackgroundTransparency = 1, Parent = gui }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(left)
	local stats = Ui.make("Frame", { LayoutOrder = 1, Size = UDim2.fromOffset(220, 176), BackgroundColor3 = Ui.colors.wood, BackgroundTransparency = 0.1, Parent = left }, { Ui.corner(12), Ui.stroke(Ui.colors.woodDark, 3) })
	local coinsLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 4), TextColor3 = Ui.colors.hay, Parent = stats }, 32)
	local carryLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 42), Parent = stats }, 16)
	local carryFill = bar(stats, 62, Ui.colors.green)
	local siloLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 76), Parent = stats }, 16)
	local siloFill = bar(stats, 96, Ui.colors.blue)
	local powerLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 110), Parent = stats }, 15)
	local rateLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 130), Parent = stats }, 15)
	local bonusLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 150), Parent = stats }, 15)
	local coinValue = Instance.new("NumberValue")

	local function button(order, text, colour, onClick)
		local b = Ui.button(text, colour, { LayoutOrder = order, Size = UDim2.fromOffset(220, 40), Parent = left })
		b.Activated:Connect(onClick)
		return b
	end
	button(2, "SHOP  (Q)", Ui.colors.green, function()
		open("Shop")
	end)
	button(3, "BUILD  (B)", Ui.colors.wood, function()
		open("Build")
	end)
	local achievementsButton = button(4, "ACHIEVEMENTS", Ui.colors.blue, function()
		open("Achievements")
	end)
	button(5, "FINDS & SKINS", Ui.colors.purple, function()
		open("Finds")
	end)
	local whistle = button(6, "WHISTLE: SELL HERE", Ui.colors.red, function()
		open("Whistle")
	end)
	local boosts = Ui.label({ LayoutOrder = 7, Size = UDim2.fromOffset(220, 50), TextColor3 = Ui.colors.hay, TextYAlignment = Enum.TextYAlignment.Top, Parent = left }, 14)
	Ui.label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(560, 18), Text = "M: mouse & menus   Q: shop   B: build   E: use", TextTransparency = 0.3, Parent = gui }, 15)

	local function refresh()
		local needles = player:GetAttribute("Needles") or 0
		if Hud.state.inLoft then
			local searched = player:GetAttribute("LoftSearched") or 0
			title.Text = "THE GOLDEN LOFT: " .. (player:GetAttribute("GoldenNeedles") or 0) .. " golden needle(s) found"
			countLabel.Text = Format.commas(Config.Loft.straws - searched) .. " golden straws left. 1 golden needle."
			fillTo(pileFill, 1 - searched / Config.Loft.straws)
		else
			local clumps = player:GetAttribute("ClumpsLeft") or Config.Clumps
			title.Text = "YOUR PILE: " .. needles .. " needle(s) found"
			countLabel.Text = Format.commas(clumps) .. " of " .. Format.commas(Config.Clumps) .. " clumps left. 1 needle inside."
			fillTo(pileFill, clumps / Config.Clumps)
		end
		local w = Hud.state.warmth
		warmth.Text = if (player:GetAttribute("Tool") or 1) >= Config.DetectorLevel and w then "Needle Detector: " .. w else ""
		Juice.countTo(coinsLabel, coinValue, player:GetAttribute("Coins") or 0, function(v)
			return Format.short(math.floor(v + 0.5)) .. " coins"
		end)
		local carried, capacity = player:GetAttribute("Carried") or 0, player:GetAttribute("Capacity") or 1
		carryLabel.Text = "Carrying " .. Format.commas(carried) .. " / " .. Format.commas(capacity) .. (if carried >= capacity then "  FULL!" else "")
		fillTo(carryFill, carried / capacity)
		carryFill.BackgroundColor3 = if carried >= capacity then Ui.colors.red else Ui.colors.green
		local siloSize = Economy.silo(player:GetAttribute("Silo") or 1).size
		local silo = player:GetAttribute("SiloStraw") or 0
		siloLabel.Text = "Silo " .. Format.commas(silo) .. " / " .. Format.commas(siloSize)
		fillTo(siloFill, silo / siloSize)
		local made, draw = player:GetAttribute("PowerMade") or 0, player:GetAttribute("PowerDraw") or 0
		powerLabel.Text = "Power " .. made .. " made / " .. draw .. " used" .. (if draw > made then "  LOW!" else "")
		powerLabel.TextColor3 = if draw > made then Color3.fromRGB(255, 130, 110) else Ui.colors.white
		rateLabel.Text = (player:GetAttribute("Power") or 1) .. " a click, machines " .. string.format("%.1f", player:GetAttribute("MachineRate") or 0) .. "/s"
		bonusLabel.Text = "Coin bonus x" .. string.format("%.2f", player:GetAttribute("Multiplier") or 1)
		achievementsButton.Text = "ACHIEVEMENTS " .. (player:GetAttribute("Achievements") or 0) .. "/" .. #Config.Achievements
		whistle.Visible = (player:GetAttribute("Whistles") or 0) > 0
		local lines, now = {}, os.time()
		for name, label in pairs({ SpeedBoost = "2x speed", CoinBoost = "2x coins", LuckyCharm = "Lucky charm" }) do
			local until_ = player:GetAttribute("Boost_" .. name) or 0
			if until_ > now then
				table.insert(lines, label .. ": " .. math.ceil((until_ - now) / 60) .. " min")
			end
		end
		boosts.Text = table.concat(lines, "\n")
	end

	player.AttributeChanged:Connect(refresh)
	task.spawn(function()
		while true do
			refresh()
			task.wait(5) -- the boost timers count down
		end
	end)
	task.spawn(function()
		while true do
			crosshair.BackgroundColor3 = if Hud.state.targeting then Ui.colors.hay else Ui.colors.white
			task.wait(0.1)
		end
	end)
	Hud.refresh = refresh
	return { refresh = refresh, coins = coinsLabel, crosshair = crosshair }
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00030">
					<Properties>
						<string name="Name">Jetpack</string>
						<ProtectedString name="Source"><![CDATA[-- The Jetpack (a Robux game pass; the server sets the "PassJetpack" attribute when you own it).
-- In the air, hold Space (or the FLY button on touch screens) to rise, let go to drift gently
-- down, or press the hover key to stay put; WASD steers as usual. A LinearVelocity on the
-- HumanoidRootPart only sets the up/down speed, eased, with a force capped at a few body
-- weights, so it can lift you but never fling you. Tunables live in Config.Jetpack.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Ui = require(script.Parent.Ui)

local Jetpack = {}
local player = Players.LocalPlayer
local cfg = Config.Jetpack or {}
local rig = nil -- { root, humanoid, lift, flame } for the current character
local flying, hover, touchHeld = false, false, false
local speed = 0
local fuel = cfg.fuelSeconds or 0
local touchRow = nil

local function owned()
	return player:GetAttribute("PassJetpack") == true
end

local hoverKey = Enum.KeyCode.H
pcall(function()
	hoverKey = Enum.KeyCode[cfg.hoverKey or "H"]
end)

local function build(character)
	rig, flying, hover, speed = nil, false, false, 0
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not root or not humanoid or not root:IsA("BasePart") or not humanoid:IsA("Humanoid") then
		return
	end
	local attachment = Ui.make("Attachment", { Name = "JetpackAttachment", Parent = root })
	local lift = Ui.make("LinearVelocity", {
		Name = "JetpackLift",
		Attachment0 = attachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Line,
		LineDirection = Vector3.new(0, 1, 0),
		LineVelocity = 0,
		MaxForce = 0,
		Enabled = false,
		Parent = root,
	})
	-- a soft flame and puff of smoke from behind your back (+Z is behind the root part)
	local nozzle = Ui.make("Attachment", { Name = "JetpackNozzle", Position = Vector3.new(0, -1.4, 0.9), Parent = root })
	local flame = Ui.make("ParticleEmitter", {
		Rate = 0,
		EmissionDirection = Enum.NormalId.Bottom,
		Lifetime = NumberRange.new(0.4, 0.9),
		Speed = NumberRange.new(4, 7),
		SpreadAngle = Vector2.new(12, 12),
		Drag = 3,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.4, 0.9), NumberSequenceKeypoint.new(1, 1.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 196, 110)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(240, 150, 90)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 196, 190)) }),
		LightEmission = 0.25,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Parent = nozzle,
	})
	rig = { root = root, humanoid = humanoid, lift = lift, flame = flame }
end

local function wantsUp()
	if touchHeld then
		return true
	end
	if UserInputService:GetFocusedTextBox() then
		return false -- typing in chat
	end
	local ok, pad = pcall(UserInputService.IsGamepadButtonDown, UserInputService, Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
	return UserInputService:IsKeyDown(Enum.KeyCode.Space) or (ok and pad == true)
end

local function step(dt)
	if touchRow then
		touchRow.Visible = owned() and UserInputService.TouchEnabled
	end
	if not rig or not rig.root.Parent then
		return
	end
	local root, humanoid, lift = rig.root, rig.humanoid, rig.lift
	local full = cfg.fuelSeconds or 0
	local inAir = humanoid.FloorMaterial == Enum.Material.Air and humanoid.Health > 0
	if not owned() or not inAir or humanoid.Sit then
		flying, hover = false, false
		lift.Enabled = false
		rig.flame.Rate = 0
		if full > 0 and humanoid.FloorMaterial ~= Enum.Material.Air then
			fuel = math.min(full, fuel + full / math.max(cfg.refuelSeconds or 4, 0.1) * dt)
		end
		return
	end
	local hasFuel = full <= 0 or fuel > 0
	local target = nil
	if wantsUp() and hasFuel then
		target = cfg.riseSpeed or 18
	elseif hover and hasFuel then
		target = 0
	elseif flying then
		target = -(cfg.fallSpeed or 7) -- you let go (or ran out): drift down softly
	end
	if target == nil then
		lift.Enabled = false -- an ordinary jump, no jetpack
		rig.flame.Rate = 0
		return
	end
	if not flying then
		flying = true
		speed = root.AssemblyLinearVelocity.Y -- start from how you're moving: no jolt
	end
	if target > 0 and root.Position.Y >= (cfg.ceiling or 275) then
		target = 0
	end
	if full > 0 and target >= 0 then
		fuel = math.max(0, fuel - dt)
	end
	speed += (target - speed) * (1 - math.exp(-(cfg.ease or 5) * dt))
	lift.LineVelocity = speed
	lift.MaxForce = root.AssemblyMass * workspace.Gravity * (cfg.thrust or 2.5)
	lift.Enabled = true
	rig.flame.Rate = if target > 0 then 40 elseif target == 0 then 18 else 6
end

function Jetpack.start(gui, notify)
	player.CharacterAdded:Connect(build)
	if player.Character then
		task.spawn(build, player.Character)
	end
	RunService.Heartbeat:Connect(step)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= hoverKey or not owned() or not rig or rig.humanoid.FloorMaterial ~= Enum.Material.Air then
			return
		end
		hover = not hover
		if notify then
			notify.toast(if hover then "Jetpack: hovering." else "Jetpack: drifting down.", Ui.colors.blue)
		end
	end)

	-- touch screens: hold FLY to rise, tap HOVER to stay put
	touchRow = Ui.make("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -190), Size = UDim2.fromOffset(100, 110), BackgroundTransparency = 1, Visible = false, Parent = gui }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6) }) })
	local fly = Ui.button("FLY", Ui.colors.blue, { Size = UDim2.fromOffset(100, 52), Parent = touchRow })
	fly.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchHeld = true
		end
	end)
	fly.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchHeld = false
		end
	end)
	Ui.button("HOVER", Ui.colors.wood, { Size = UDim2.fromOffset(100, 52), Parent = touchRow }).Activated:Connect(function()
		if rig and rig.humanoid.FloorMaterial == Enum.Material.Air then
			hover = not hover
		end
	end)

	local told = false
	local function tell()
		if owned() and not told and notify then
			told = true
			notify.toast("Jetpack ready! In the air, hold Space to fly up, " .. (cfg.hoverKey or "H") .. " to hover.", Ui.colors.blue)
		end
	end
	player:GetAttributeChangedSignal("PassJetpack"):Connect(tell)
	tell()
end

return Jetpack
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00031">
					<Properties>
						<string name="Name">Juice</string>
						<ProtectedString name="Source"><![CDATA[-- Feedback that makes harvesting feel good: straw bursts, floating numbers, a soft camera
-- punch, a combo streak, pop rings when a clump is cleared, coins flying to your counter,
-- and gentle milestone celebrations. Everything eases in and out; nothing flashes.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local Juice = {}
local gui, comboLabel, coinTarget = nil, nil, nil
local combo, lastHit = 0, 0
local fx = Instance.new("Folder")
fx.Name = "MyEffects"
fx.Parent = workspace

local function ease(instance, seconds, goal, style, direction)
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end
Juice.ease = ease

-- Plays a sound from Config.Sounds if one is set (IDs from the Toolbox; "" = silent), with
-- Config.SoundSettings' volume, pitch and a little random wobble. One that fails to load stays silent.
function Juice.sound(name, pitch)
	local id = Config.Sounds and Config.Sounds[name]
	if type(id) ~= "string" or id == "" then
		return
	end
	local settings = (Config.SoundSettings and Config.SoundSettings[name]) or {}
	local wobble = settings.wobble or 0
	pcall(function()
		local sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = settings.volume or 0.5
		sound.PlaybackSpeed = (pitch or 1) * (settings.pitch or 1) * (1 + (math.random() * 2 - 1) * wobble)
		sound.Parent = SoundService
		sound:Play()
		Debris:AddItem(sound, 3)
	end)
end

function Juice.mount(screen, coinsLabel)
	gui, coinTarget = screen, coinsLabel -- coinsLabel may be nil if the HUD failed
	comboLabel = Ui.label({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 40, 0.5, -30), Size = UDim2.fromOffset(220, 40), TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, TextStrokeTransparency = 1, TextColor3 = Ui.colors.hay, Parent = screen }, 34)
end

-- A puff of straw at a world position.
function Juice.burst(position, count, golden)
	local anchor = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(position), Parent = fx })
	local emitter = Ui.make("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(8, 18),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -30, 0),
		Drag = 2,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.1) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-240, 240),
		Color = ColorSequence.new(if golden then Color3.fromRGB(255, 220, 90) else Color3.fromRGB(242, 212, 120)),
		LightEmission = if golden then 0.5 else 0.1,
		Parent = anchor,
	})
	emitter:Emit(count)
	Debris:AddItem(anchor, 1.5)
end

-- A number that floats up from a world position and fades.
function Juice.float(position, text, colour)
	local anchor = Ui.make("Attachment", { WorldPosition = position, Parent = workspace.Terrain })
	local board = Ui.make("BillboardGui", { Adornee = anchor, Size = UDim2.fromScale(6, 1.6), StudsOffset = Vector3.new(math.random(-10, 10) / 10, 1, 0), AlwaysOnTop = true, LightInfluence = 0, Parent = player:WaitForChild("PlayerGui") })
	local label = Ui.label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = colour or Ui.colors.hay, Parent = board }, 48)
	ease(board, 0.9, { StudsOffset = board.StudsOffset + Vector3.new(0, 2.5, 0) })
	ease(label, 0.9, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(board, 1)
	Debris:AddItem(anchor, 1)
end

-- A soft, quick push of the camera's field of view: you feel the hit without a jolt.
function Juice.punch(strength)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local base = 70
	camera.FieldOfView = base - (strength or 1.5)
	ease(camera, 0.18, { FieldOfView = base }, Enum.EasingStyle.Sine)
end

-- A ring that grows and fades where a clump disappeared.
function Juice.pop(position, golden)
	local ring = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(position), Material = Enum.Material.Neon, Color = if golden then Color3.fromRGB(255, 214, 90) else Color3.fromRGB(255, 236, 170), Transparency = 0.3, Parent = fx })
	ease(ring, 0.45, { Size = Vector3.new(9, 9, 9), Transparency = 1 })
	Debris:AddItem(ring, 0.5)
	Juice.burst(position, 28, golden)
	Juice.punch(3)
	Juice.sound("pop", 0.9 + math.random() * 0.2)
end

-- The combo streak: harvests within 1.2 seconds of each other count up.
function Juice.hit()
	local now = time()
	combo = if now - lastHit < 1.2 then combo + 1 else 1
	lastHit = now
	if comboLabel and combo >= 3 then
		comboLabel.Text = "x" .. combo .. (if combo >= 50 then " ON FIRE!" elseif combo >= 20 then " GREAT!" else "")
		comboLabel.TextTransparency, comboLabel.TextStrokeTransparency = 0, 0.4
		comboLabel.TextColor3 = Ui.colors.hay:Lerp(Color3.fromRGB(255, 120, 60), math.clamp(combo / 60, 0, 1))
		local scale = comboLabel:FindFirstChildOfClass("UIScale") or Ui.make("UIScale", { Parent = comboLabel })
		scale.Scale = 1.25
		ease(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(1.3, function()
			if time() - lastHit >= 1.2 then
				ease(comboLabel, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
			end
		end)
	end
	Juice.sound("harvest", 0.95 + math.min(combo, 40) * 0.006)
	return combo
end

-- Little coins that fly from the middle of the screen into your coin counter.
function Juice.coins(amount)
	if not gui or not coinTarget then
		return
	end
	local count = math.clamp(math.floor(math.log10(math.max(amount, 1)) * 3), 3, 14)
	local target = coinTarget.AbsolutePosition + coinTarget.AbsoluteSize / 2
	for i = 1, count do
		task.delay(i * 0.04, function()
			local coin = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0.5, math.random(-60, 60), 0.5, math.random(-40, 40)), BackgroundColor3 = Color3.fromRGB(255, 206, 70), Parent = gui }, { Ui.corner(9), Ui.stroke(Color3.fromRGB(190, 130, 30), 2) })
			ease(coin, 0.55, { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(10, 10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(coin, 0.6)
		end)
	end
	local scale = coinTarget:FindFirstChildOfClass("UIScale") or Ui.make("UIScale", { Parent = coinTarget })
	task.delay(0.55, function()
		scale.Scale = 1.15
		ease(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		Juice.sound("coins")
	end)
end

-- A big, warm "well done" for milestones: confetti from the top of the screen.
function Juice.confetti()
	if not gui then
		return
	end
	local colours = { Color3.fromRGB(255, 206, 70), Color3.fromRGB(240, 120, 80), Color3.fromRGB(120, 200, 120), Color3.fromRGB(110, 170, 240) }
	for i = 1, 40 do
		local bit = Ui.make("Frame", { Size = UDim2.fromOffset(8, 14), Position = UDim2.new(math.random(), 0, 0, -20), Rotation = math.random(0, 360), BackgroundColor3 = colours[i % #colours + 1], Parent = gui }, { Ui.corner(3) })
		ease(bit, 1.6 + math.random() * 1.2, { Position = UDim2.new(bit.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.05, 0), Rotation = bit.Rotation + math.random(-360, 360) }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		Debris:AddItem(bit, 3)
	end
	Juice.sound("cheer")
end

-- Counts a TextLabel smoothly from one number to another.
function Juice.countTo(label, holder, value, format)
	if label.Text == "" then
		label.Text = format(holder.Value)
	end
	ease(holder, 0.6, { Value = value }, Enum.EasingStyle.Quart)
	if not holder:GetAttribute("Hooked") then
		holder:SetAttribute("Hooked", true)
		holder.Changed:Connect(function(v)
			label.Text = format(v)
		end)
	end
end

Juice.format = Format
return Juice
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX00032">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[-- The player's side of the game: first-person harvesting, building, the menus, and all the
-- feedback that makes it feel good. The server decides everything that matters.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Ui = require(script.Parent:WaitForChild("Ui"))
local Notify = require(script.Parent:WaitForChild("Notify"))
local Cursor = require(script.Parent:WaitForChild("Cursor"))
local Juice = require(script.Parent:WaitForChild("Juice"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Panels = require(script.Parent:WaitForChild("Panels"))
local Harvest = require(script.Parent:WaitForChild("Harvest"))
local BuildMode = require(script.Parent:WaitForChild("BuildMode"))
local WorldFx = require(script.Parent:WaitForChild("WorldFx"))
local HayFx = require(script.Parent:WaitForChild("HayFx"))
local Teleport = require(script.Parent:WaitForChild("Teleport"))
local Music = require(script.Parent:WaitForChild("Music"))
local Jetpack = require(script.Parent:WaitForChild("Jetpack"))
local Offer = require(script.Parent:WaitForChild("Offer"))

local player = Players.LocalPlayer
local gui = Ui.make("ScreenGui", { Name = "HaystackUi", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

-- Errors show on screen (red, top right) so a broken part can be reported without the
-- Output window. Each part starts on its own, so one failing can't stop harvesting.
local errorBox = Ui.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 60), Size = UDim2.fromOffset(420, 160), TextColor3 = Color3.fromRGB(255, 90, 80), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = Enum.Font.Code, Parent = gui }, 14)
local function report(text)
	errorBox.Text = string.sub(errorBox.Text .. "\n" .. text, -900)
end
game:GetService("ScriptContext").Error:Connect(function(message, trace)
	report("ERROR: " .. tostring(message) .. "\n" .. string.sub(tostring(trace), 1, 200))
end)
local function step(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		report("ERROR starting " .. name .. ": " .. tostring(err))
	end
end

local panels, hud
step("messages", function()
	Notify.mount(gui)
end)
step("harvesting", function()
	Harvest.onMiss = function(text)
		Notify.toast(text, Ui.colors.wood)
	end
	Harvest.start()
end)
step("mouse", function()
	Cursor.mount(gui)
end)
step("HUD", function()
	hud = Hud.mount(gui, function(name)
		if panels then
			panels.open(name)
		end
	end)
end)
step("effects", function()
	Juice.mount(gui, hud and hud.coins)
end)
step("building", function()
	BuildMode.mount(gui, Notify)
end)
step("menus", function()
	panels = Panels.mount(gui, Notify, {
		Build = function()
			BuildMode.toggle()
		end,
		Whistle = function()
			local ok, success, message = pcall(Remotes.Whistle.InvokeServer, Remotes.Whistle)
			Notify.toast(if ok then tostring(message) else "Try again.", if ok and success then Ui.colors.green else Ui.colors.red)
		end,
	})
end)
step("world effects", function()
	WorldFx.start()
end)
step("teleporters", function()
	Teleport.mount(gui)
end)
step("music", function()
	Music.start(gui)
end)
step("jetpack", function()
	Jetpack.start(gui, Notify)
end)
step("offers", function()
	Offer.start(gui)
end)
if not hud then
	hud = { refresh = function() end }
end

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.Q and panels then
		panels.open("Shop")
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt)
	if prompt:GetAttribute("Action") == "wheel" and panels then
		panels.open("Wheel")
	elseif prompt:GetAttribute("Action") == "teleport" then
		Teleport.open(prompt:FindFirstAncestorOfClass("Model"))
	end
end)

-- What the server said about your last click, just under the crosshair. If a click gets no
-- answer at all, say so: that means the server's harvesting isn't running (see Output).
local statusLabel = Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 26), Size = UDim2.fromOffset(520, 26), TextTransparency = 1, TextStrokeTransparency = 1, Parent = gui }, 18)
local statusToken, lastAnswer = 0, 0
local function showStatus(text, colour)
	statusToken += 1
	local token = statusToken
	statusLabel.Text = text
	statusLabel.TextColor3 = colour or Ui.colors.cream
	statusLabel.TextTransparency, statusLabel.TextStrokeTransparency = 0, 0.4
	task.delay(2.5, function()
		if token == statusToken then
			Juice.ease(statusLabel, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end
player:GetAttributeChangedSignal("HarvestTick"):Connect(function()
	lastAnswer = time()
	showStatus(tostring(player:GetAttribute("HarvestStatus") or ""))
end)
task.spawn(function()
	while true do
		task.wait(0.5)
		local fired = Harvest.lastFired or 0
		if fired > lastAnswer and time() - fired > 2 then
			lastAnswer = time()
			showStatus("The server didn't answer your click. Look for red text in the Output window.", Color3.fromRGB(255, 120, 100))
		end
	end
end)

-- what the crosshair is on, whether you're in the loft (HUD state, not attributes)
task.spawn(function()
	while true do
		task.wait(0.1)
		Hud.state.targeting = Harvest.target() ~= nil
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local inLoft = root ~= nil and root.Position.Y > 300
		if Hud.state.inLoft ~= inLoft then
			Hud.state.inLoft = inLoft
			hud.refresh()
		end
	end
end)

-- milestones: every 1% of the pile, and every 100 clumps, a little celebration
local lastClumps = player:GetAttribute("ClumpsLeft")
player:GetAttributeChangedSignal("ClumpsLeft"):Connect(function()
	local now = player:GetAttribute("ClumpsLeft") or Config.Clumps
	if lastClumps and now < lastClumps then
		local done = Config.Clumps - now
		if done % 100 == 0 then
			Juice.confetti()
			Notify.banner(done .. " CLUMPS HARVESTED!", math.floor(done / Config.Clumps * 100) .. "% of your pile. The needle is in one of the " .. Format.commas(now) .. " left.", 5)
		elseif done % 10 == 0 then
			Notify.toast(done .. " clumps harvested!", Ui.colors.wood)
		end
	end
	lastClumps = now
end)

Remotes.SearchFx.OnClientEvent:Connect(function(message)
	if message.kind == "harvest" then
		Juice.hit()
		HayFx.lift(message.position, message.golden)
		Juice.float(message.position + Vector3.new(0, 2, 0), "+" .. message.straws, if message.golden then Ui.colors.hay else Ui.colors.cream)
		if message.gone then -- you cleared a clump: it pops
			Juice.pop(message.position, message.golden)
		end
		if message.warmth then
			Hud.state.warmth = message.warmth
			hud.refresh()
		end
		if message.full then
			Notify.toast("Your tool is full! Sell at the merchant in the hub.", Ui.colors.red)
		end
	elseif message.kind == "nope" then
		Notify.toast(message.reason, Ui.colors.wood)
	elseif message.kind == "full" then
		Notify.toast("Your tool is full! Sell at the merchant (or buy a bigger tool).", Ui.colors.red)
	elseif message.kind == "sold" then
		Juice.coins(message.coins)
		HayFx.dump(message.basket, message.straws)
		Notify.toast((if message.reason == "trader" then "Dumped " else "Sold ") .. Format.commas(message.straws) .. " straw for " .. Format.short(message.coins) .. " coins" .. (if message.reason == "auto" then " (Auto Sell)" else ""), Ui.colors.green)
	elseif message.kind == "find" then
		Juice.burst(message.position, 30, true)
		Juice.confetti()
		panels.addFind(message.name, message.story)
		Notify.banner("LUCKY FIND: " .. message.name, message.story .. "\nThe merchant pays " .. Format.short(message.coins) .. " coins for it.", 6)
	end
end)

Remotes.Announce.OnClientEvent:Connect(function(message)
	if message.kind == "needle" then
		if message.finderId == player.UserId then
			Juice.confetti()
			task.delay(0.6, Juice.confetti)
			Juice.punch(6)
			Notify.banner(if message.golden then "YOU FOUND THE GOLDEN NEEDLE!" else "YOU FOUND THE NEEDLE!",
				"You earned " .. Format.short(message.prize) .. " coins" .. (if message.golden then "." else " and +20% coins forever. A fresh pile with a new needle grows back in a moment."), 12)
		else
			Notify.toast(message.finder .. " found " .. (if message.golden then "a golden needle!" else "their needle!"), Ui.colors.hay)
		end
	elseif message.kind == "reveal" then
		WorldFx.reveal(message.clump)
		Juice.confetti()
		Notify.banner("THE NEEDLE IS REVEALED!", "Its clump glows gold on your pile. Climb up and harvest it!", 10)
	elseif message.kind == "wheel" then
		WorldFx.spin(message.index, #Config.Wheel)
		task.delay(4.3, function()
			Juice.confetti()
			Notify.banner("WHEEL OF FORTUNE: " .. message.name, message.text, 7)
		end)
	elseif message.kind == "notice" then
		Notify.toast(message.text, Ui.colors.wood)
	elseif message.kind == "error" then
		report(message.text)
	end
end)

Remotes.Achievement.OnClientEvent:Connect(function(a)
	Juice.confetti()
	Notify.banner("SECRET ACHIEVEMENT: " .. a.name, a.text .. "\n" .. a.done .. " of " .. a.total .. " discovered." .. (if a.done >= a.total then " A golden door in the hub is open!" else ""), 7)
end)

task.delay(3, function()
	Notify.banner(
		"Welcome to " .. Config.FarmName .. "!",
		"This is your farm. Your heap holds " .. Format.commas(Config.TotalStraws) .. " straws and one needle, hidden deep in the upper heap. "
			.. "Aim at the heap and click to lift hay onto your fork, then dump it in your trader's basket (E). Buy tools, buckets, stairs, lifts and machines (Q) and build them (B).",
		12
	)
end)
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00033">
					<Properties>
						<string name="Name">Music</string>
						<ProtectedString name="Source"><![CDATA[-- Soft background music: the Config.Music playlist in a loop, low and relaxing, fading gently
-- from one track to the next. A small button (top right) turns it on and off for the session.
-- A track that won't load (a missing or private asset) is skipped quietly.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Ui = require(script.Parent.Ui)

local Music = {}
local on = true
local current = nil -- the Sound playing now
local button = nil

local function volume()
	return Config.MusicVolume or 0.25
end

local function fade(sound, goal, seconds)
	local tween = TweenService:Create(sound, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = goal })
	tween:Play()
	return tween
end

-- Waits for a track to load. Returns the Sound, or nil (and cleans up) if it never does.
local function load(track)
	if type(track) ~= "table" or type(track.id) ~= "string" or track.id == "" then
		return nil
	end
	local ok, sound = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "Music"
		s.SoundId = track.id
		s.Volume = 0
		s.Looped = false
		s.Parent = SoundService
		return s
	end)
	if not ok or not sound then
		return nil
	end
	local deadline = time() + (Config.MusicLoadSeconds or 10)
	while not sound.IsLoaded and time() < deadline do
		task.wait(0.25)
	end
	if not sound.IsLoaded or sound.TimeLength <= 0 then
		sound:Destroy()
		return nil
	end
	return sound
end

local function play(sound)
	local fadeTime = Config.MusicFadeSeconds or 3
	current = sound
	pcall(function()
		sound:Play()
	end)
	if not on then
		sound:Pause()
	else
		fade(sound, volume(), fadeTime)
	end
	-- wait until near the end (paused time doesn't count), then fade out
	while sound.Parent and sound.TimeLength - sound.TimePosition > fadeTime do
		task.wait(0.5)
		if on and not sound.IsPlaying and sound.TimePosition < 0.1 and sound.TimeLength > 0 then
			break -- it stopped by itself (it ended early or failed mid-way)
		end
	end
	if sound.Parent then
		fade(sound, 0, fadeTime)
		task.wait(fadeTime)
		sound:Destroy()
	end
end

local function loop()
	local tracks = Config.Music or {}
	local index = 0
	local failsInARow = 0
	while true do
		index = index % #tracks + 1
		local sound = load(tracks[index])
		if sound then
			failsInARow = 0
			play(sound)
		else
			failsInARow += 1
			if failsInARow >= #tracks then
				task.wait(120) -- nothing loads: try again much later, quietly
				failsInARow = 0
			end
		end
		task.wait(0.5)
	end
end

local function show()
	if button then
		button.Text = if on then "♪ On" else "♪ Off"
		button.BackgroundColor3 = if on then Ui.colors.wood else Ui.colors.grey
	end
end

function Music.toggle()
	on = not on
	show()
	local sound = current
	if sound and sound.Parent then
		if on then
			sound:Resume()
			fade(sound, volume(), 1)
		else
			fade(sound, 0, 0.8).Completed:Connect(function()
				if not on and sound.Parent then
					sound:Pause()
				end
			end)
		end
	end
end

function Music.start(gui)
	if type(Config.Music) ~= "table" or #Config.Music == 0 then
		return -- no music set up: no button either
	end
	button = Ui.button("", Ui.colors.wood, { Name = "MusicToggle", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(92, 40), Parent = gui })
	Ui.autoScale(button)
	button.Activated:Connect(Music.toggle)
	show()
	task.spawn(loop)
end

return Music
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00034">
					<Properties>
						<string name="Name">Notify</string>
						<ProtectedString name="Source"><![CDATA[-- Messages: small toasts under the haystack counter, and a big banner for case news.
local Ui = require(script.Parent.Ui)

local Notify = {}
local stack, banner, bannerTitle, bannerBody
local order = 0
local bannerToken = 0

function Notify.mount(gui)
	stack = Ui.make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.fromOffset(460, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(stack)

	banner = Ui.make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Ui.colors.wood,
		Visible = false,
		Parent = gui,
	}, {
		Ui.corner(18),
		Ui.stroke(Ui.colors.hay, 4),
		Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }),
	})
	Ui.autoScale(banner)
	bannerTitle = Ui.paragraph("", { LayoutOrder = 1, Font = Ui.font, TextSize = 34, TextColor3 = Ui.colors.hay, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	bannerBody = Ui.paragraph("", { LayoutOrder = 2, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	banner.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			banner.Visible = false
		end
	end)
end

function Notify.toast(text, colour)
	if not stack then
		return
	end
	order += 1
	local card = Ui.make("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = colour or Ui.colors.wood,
		Parent = stack,
	}, {
		Ui.corner(12),
		Ui.stroke(Ui.colors.woodDark, 2),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
	})
	Ui.paragraph(text, { Font = Ui.font, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local cards = {}
	for _, child in ipairs(stack:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	if #cards > 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
	task.delay(4, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Notify.banner(title, body, seconds)
	if not banner then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerBody.Text = body
	banner.Visible = true
	task.delay(seconds or 6, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

return Notify
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00035">
					<Properties>
						<string name="Name">Offer</string>
						<ProtectedString name="Source"><![CDATA[-- One gentle Robux suggestion per session: after Config.OfferAfterClumps clumps harvested since
-- you joined, a small card asks "Enjoying the harvest?" and lists the Robux items that are set
-- up (ID not 0), each saying exactly what it gives, next to an equally big "No thanks".
-- No timers, no "limited", no flashing; it never comes back this session. Buying goes through
-- Roblox's own purchase prompt (which shows the price and can be cancelled), like the shop.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Ui = require(script.Parent.Ui)
local Cursor = require(script.Parent.Cursor)

local Offer = {}
local player = Players.LocalPlayer
local OPTIONS = {
	{ kind = "product", key = "SpeedBoost", title = "Speed Boost", text = "2x straws a click for 1 hour" },
	{ kind = "pass", key = "Jetpack", title = "Jetpack", text = "Fly up and hover over your pile, for good" },
}

local function available()
	local list = {}
	for _, option in ipairs(OPTIONS) do
		local id = if option.kind == "pass" then Config.GamePasses[option.key] else Config.Products[option.key]
		local alreadyOwned = option.kind == "pass" and player:GetAttribute("Pass" .. option.key) == true
		if type(id) == "number" and id ~= 0 and not alreadyOwned then
			table.insert(list, { option = option, id = id })
		end
	end
	return list
end

local function show(gui, list)
	local card = Ui.make("Frame", {
		Name = "Offer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Ui.colors.cream,
		Parent = gui,
	}, {
		Ui.corner(18),
		Ui.stroke(Ui.colors.wood, 4),
		Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
	})
	local scale = Ui.autoScale(card)
	local full = scale.Scale
	Ui.paragraph("Enjoying the harvest?", { LayoutOrder = 1, Font = Ui.font, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	Ui.paragraph("If you'd like a hand, these are here. Totally optional.", { LayoutOrder = 2, TextSize = 17, TextColor3 = Ui.colors.grey, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })

	Cursor.need("offer", true)
	local function close()
		Cursor.need("offer", false)
		card:Destroy()
	end
	for i, entry in ipairs(list) do
		local option, id = entry.option, entry.id
		local button = Ui.button(option.title .. ": " .. option.text .. " (Robux)", Ui.colors.blue, { LayoutOrder = 2 + i, Size = UDim2.new(1, 0, 0, 52), Parent = card })
		button.Activated:Connect(function()
			close()
			if option.kind == "pass" then
				MarketplaceService:PromptGamePassPurchase(player, id)
			else
				MarketplaceService:PromptProductPurchase(player, id)
			end
		end)
	end
	Ui.button("No thanks", Ui.colors.wood, { LayoutOrder = 10, Size = UDim2.new(1, 0, 0, 52), Parent = card }).Activated:Connect(close)

	-- ease in softly
	scale.Scale = full * 0.9
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = full }):Play()
end

function Offer.start(gui)
	local goal = Config.OfferAfterClumps or 25
	local harvested, shown = 0, false
	local last = player:GetAttribute("ClumpsLeft")
	player:GetAttributeChangedSignal("ClumpsLeft"):Connect(function()
		local now = player:GetAttribute("ClumpsLeft")
		if type(now) == "number" and type(last) == "number" and now < last and now >= last - 5 then
			harvested += last - now -- small drops only: a fresh pile or a Straw Blast don't count
		end
		last = now
		if shown or harvested < goal then
			return
		end
		shown = true -- once per session, whatever happens next
		local list = available()
		if #list > 0 then
			task.delay(1.5, show, gui, list) -- a moment after the click, not in the middle of it
		end
	end)
end

return Offer
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00036">
					<Properties>
						<string name="Name">Panels</string>
						<ProtectedString name="Source"><![CDATA[-- The windows: Shop, secret Achievements, Finds & Skins, and the Wheel of Fortune (odds first).
-- Opening one frees the mouse; closing them all locks it again for first person.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)
local Shop = require(script.Parent.Shop)
local Cursor = require(script.Parent.Cursor)
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer
local Panels = {}

local function pct(chance)
	local text = string.format("%.4f", chance * 100)
	text = string.gsub(text, "0+$", "")
	text = string.gsub(text, "%.$", "")
	return text .. "%"
end

function Panels.mount(gui, notify, actions)
	local windows, refreshers = {}, {}
	windows.Shop = Shop.mount(gui, notify)
	refreshers.Shop = Shop.refresh

	-- Achievements: secret until earned
	local achievements, achievementsBody = Ui.window(gui, "Achievements")
	windows.Achievements = achievements
	refreshers.Achievements = function()
		task.spawn(function()
			local ok, list = pcall(function()
				return Remotes.GetAchievements:InvokeServer()
			end)
			if not ok or type(list) ~= "table" then
				return
			end
			for _, child in ipairs(achievementsBody:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local done = 0
			for i, a in ipairs(list) do
				done += if a.done then 1 else 0
				local f = Ui.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = if a.done then Color3.fromRGB(226, 244, 220) else Color3.fromRGB(220, 214, 204), Parent = achievementsBody }, { Ui.corner(10) })
				Ui.label({ Text = if a.done then a.name else "???", Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = f }, 22)
				Ui.label({ Text = if a.done then a.text else "A secret achievement. Keep playing to discover it.", Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 31), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = f }, 14)
			end
			Ui.paragraph(done .. " of " .. #list .. " discovered. Some say all ten open a golden door...", { LayoutOrder = 0, Font = Ui.font, TextSize = 20, Parent = achievementsBody })
		end)
	end

	-- Finds & Skins
	local finds, findsBody = Ui.window(gui, "Finds")
	windows.Finds = finds
	local found, count = {}, 0
	local skinsHeader = Ui.paragraph("Tool skins (win them on the Wheel of Fortune):", { LayoutOrder = 1, Font = Ui.font, TextSize = 20, Parent = findsBody })
	local skinButtons = {}
	local function wear(id)
		local ok, _, message = pcall(Remotes.EquipSkin.InvokeServer, Remotes.EquipSkin, id)
		notify.toast(if ok then tostring(message) else "Try again.", Ui.colors.purple)
	end
	local plain = Ui.button("Plain tool", Ui.colors.wood, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 40), Parent = findsBody })
	plain.Activated:Connect(function()
		wear("")
	end)
	for i, prize in ipairs(Config.Wheel) do
		if not prize.reveal then
			local b = Ui.button(prize.name, Ui.colors.grey, { LayoutOrder = 2 + i, Size = UDim2.new(1, 0, 0, 40), Parent = findsBody })
			b.Activated:Connect(function()
				wear(prize.id)
			end)
			skinButtons[prize.id] = b
		end
	end
	local storyHeader = Ui.paragraph("Lucky finds: odd things in the hay, and what they tell you.", { LayoutOrder = 50, Font = Ui.font, TextSize = 20, Parent = findsBody })
	refreshers.Finds = function()
		for id, b in pairs(skinButtons) do
			local owned = player:GetAttribute("Skin_" .. id) == true
			b.Visible = owned
			b.BackgroundColor3 = if player:GetAttribute("Skin") == id then Ui.colors.green else Ui.colors.purple
		end
		skinsHeader.Text = "Tool skins (win them on the Wheel of Fortune):"
		storyHeader.Text = if count == 0 then "Lucky finds: nothing yet. Keep harvesting!" else "Lucky finds:"
	end

	-- Wheel of Fortune: the odds are always on screen before you can spin
	local wheel, wheelBody = Ui.window(gui, "Wheel of Fortune")
	windows.Wheel = wheel
	local restricted = true
	task.spawn(function()
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		restricted = not ok or info.ArePaidRandomItemsRestricted == true
	end)
	refreshers.Wheel = function()
		for _, child in ipairs(wheelBody:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if restricted then
			Ui.paragraph("The Wheel of Fortune isn't available where you live.", { Parent = wheelBody })
			return
		end
		Ui.paragraph("Every spin wins a prize. These are the exact odds of each:", { LayoutOrder = 1, Font = Ui.font, TextSize = 20, Parent = wheelBody })
		local odds = Economy.wheelOdds()
		for i, prize in ipairs(Config.Wheel) do
			Ui.paragraph(prize.name .. ":  " .. pct(odds[i]) .. (if prize.reveal then "  (shows the clump the needle is in)" else ""), { LayoutOrder = 1 + i, TextColor3 = if prize.reveal then Ui.colors.red else Ui.colors.ink, Parent = wheelBody })
		end
		Ui.paragraph("A skin you already have pays coins instead.", { LayoutOrder = 50, TextColor3 = Ui.colors.grey, Parent = wheelBody })
		local id = Config.Products.WheelSpin
		if id and id ~= 0 then
			Ui.button("SPIN (Robux)", Ui.colors.blue, { LayoutOrder = 60, Size = UDim2.new(1, 0, 0, 52), Parent = wheelBody }).Activated:Connect(function()
				MarketplaceService:PromptProductPurchase(player, id)
			end)
		else
			Ui.paragraph("Spins open once the game is published and the WheelSpin product is created.", { LayoutOrder = 60, TextColor3 = Ui.colors.grey, Parent = wheelBody })
		end
	end

	local function anyOpen()
		for _, frame in pairs(windows) do
			if frame.Visible then
				return true
			end
		end
		return false
	end

	local function open(name)
		if name == "Build" or name == "Whistle" then
			for _, frame in pairs(windows) do
				frame.Visible = false
			end
			Cursor.need("window", false)
			actions[name]()
			return
		end
		for key, frame in pairs(windows) do
			if key == name then
				frame.Visible = not frame.Visible
				if frame.Visible then
					local scale = frame:FindFirstChildOfClass("UIScale")
					local full = scale and scale.Scale or 1
					if scale then
						scale.Scale = full * 0.9
						Juice.ease(scale, 0.25, { Scale = full }, Enum.EasingStyle.Back)
					end
					refreshers[key]()
				end
			else
				frame.Visible = false
			end
		end
		Cursor.need("window", anyOpen())
	end
	for _, frame in pairs(windows) do
		frame:GetPropertyChangedSignal("Visible"):Connect(function()
			Cursor.need("window", anyOpen())
		end)
	end

	local panels = { open = open }
	function panels.addFind(name, story)
		if found[name] then
			return
		end
		found[name], count = true, count + 1
		Ui.paragraph("You found " .. name .. ". " .. story, { LayoutOrder = 50 + count, TextColor3 = Ui.colors.blue, Parent = findsBody })
		refreshers.Finds()
	end
	return panels
end

return Panels
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00037">
					<Properties>
						<string name="Name">Shop</string>
						<ProtectedString name="Source"><![CDATA[-- The Shop window: Tools, Perks, Storage (buckets and silos), Build (stairs, lifts...), Machines, Power and Robux.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer

local ROBUX = {
	{ kind = "product", key = "SpeedBoost", title = "2x Speed (1 hour)", text = "Every click takes twice the straws." },
	{ kind = "product", key = "CoinBoost", title = "2x Coins (1 hour)", text = "The merchant pays double." },
	{ kind = "product", key = "LuckyCharm", title = "Lucky Charm (1 hour)", text = "5x the chance of a lucky find." },
	{ kind = "product", key = "StrawBlast", title = "Straw Blast", text = "Blast 100,000 straws off the top of your pile." },
	{ kind = "product", key = "MerchantWhistle", title = "Merchant's Whistle x10", text = "Sell anywhere, ten times." },
	{ kind = "pass", key = "AutoSell", title = "Auto Sell", text = "Your load sells itself when your tool is full." },
	{ kind = "pass", key = "DoubleMachines", title = "Double Machines", text = "Every machine works twice as fast." },
	{ kind = "pass", key = "VIP", title = "VIP", text = "+25% coins; machines work an hour after you leave." },
	{ kind = "pass", key = "Jetpack", title = "Jetpack", text = "Hold Space in the air to fly up and hover over your pile." },
}

local Shop = {}
local frame = nil

local function ask(remote, ...)
	local ok, success, message = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		return false, "The farm didn't answer. Try again."
	end
	return success, message
end

local function row(parent, order, name, text, colour)
	local f = Ui.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = colour or Ui.colors.paper, Parent = parent }, { Ui.corner(10) })
	Ui.label({ Text = name, Size = UDim2.new(0.6, -12, 0, 28), Position = UDim2.fromOffset(12, 5), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = f }, 22)
	local sub = Ui.label({ Text = text, Size = UDim2.new(0.6, -12, 0, 24), Position = UDim2.fromOffset(12, 35), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = f }, 14)
	local button = Ui.button("", Ui.colors.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.36, 0, 0, 46), Parent = f })
	return button, sub
end

local function price(button, cost, done, available, doneText)
	if done then
		button.Text, button.BackgroundColor3 = doneText or "OWNED", Ui.colors.grey
	elseif not available then
		button.Text, button.BackgroundColor3 = "LOCKED", Ui.colors.grey
	else
		button.Text = "BUY " .. Format.short(cost)
		button.BackgroundColor3 = if (player:GetAttribute("Coins") or 0) >= cost then Ui.colors.green else Ui.colors.red
	end
end

function Shop.mount(gui, notify)
	local body
	frame, body = Ui.window(gui, "Shop")
	frame.Size = UDim2.fromOffset(640, 540)
	local tabs = Ui.make("Frame", { Size = UDim2.new(1, -24, 0, 38), Position = UDim2.fromOffset(12, 64), BackgroundTransparency = 1, Parent = frame }, { Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
	body.Position, body.Size = UDim2.fromOffset(12, 108), UDim2.new(1, -24, 1, -116)
	local pages, refreshers, order = {}, {}, 0
	Shop.refreshers = refreshers

	local function buy(kind, key, button)
		local ok, message = ask(Remotes.Buy, kind, key)
		notify.toast(message, if ok then Ui.colors.green else Ui.colors.red)
		if ok and button then
			local scale = button:FindFirstChildOfClass("UIScale") or Ui.make("UIScale", { Parent = button })
			scale.Scale = 1.15
			Juice.ease(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			Juice.sound("coins", 1.2)
		end
		Shop.refresh()
	end

	local function page(name, colour, build)
		order += 1
		local list = Ui.make("Frame", { Name = name, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, Parent = body }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
		pages[name], refreshers[name] = list, build(list)
		Ui.button(name, colour, { LayoutOrder = order, Size = UDim2.new(1 / 7, -4, 1, 0), Parent = tabs }).Activated:Connect(function()
			for key, p in pairs(pages) do
				p.Visible = key == name
			end
			Shop.refresh()
		end)
	end

	page("Tools", Ui.colors.green, function(list)
		local rows = {}
		for level, tool in ipairs(Config.Tools) do
			rows[level] = row(list, level, tool.name, tool.power .. " a click, carries " .. Format.commas(tool.capacity))
			rows[level].Activated:Connect(function()
				buy("tool", level, rows[level])
			end)
		end
		return function()
			local owned = player:GetAttribute("Tool") or 1
			for level, button in ipairs(rows) do
				price(button, Config.Tools[level].price, level <= owned, level == owned + 1)
			end
		end
	end)

	page("Perks", Ui.colors.purple, function(list)
		local rows, subs = {}, {}
		for i, perk in ipairs(Config.Perks) do
			rows[i], subs[i] = row(list, i, perk.name, perk.text)
			rows[i].Activated:Connect(function()
				buy("perk", i, rows[i])
			end)
		end
		return function()
			local d = { tool = player:GetAttribute("Tool") or 1, perks = {} }
			for _, perk in ipairs(Config.Perks) do
				d.perks[perk.id] = player:GetAttribute("Perk_" .. perk.id) or 0
			end
			for i, perk in ipairs(Config.Perks) do
				local level = d.perks[perk.id]
				subs[i].Text = perk.text .. ". " .. level .. "/" .. perk.levels .. " on this tool."
				price(rows[i], Economy.perkPrice(d, i), level >= perk.levels, true, "MAXED")
			end
		end
	end)

	-- buckets (carry more on foot) and silos (hold what your machines harvest)
	page("Storage", Ui.colors.blue, function(list)
		local buckets, rows = {}, {}
		for level = 2, #Config.Buckets do
			local bucket = Config.Buckets[level]
			buckets[level] = row(list, level, bucket.name, "hangs at your hip: carries " .. Format.commas(bucket.capacity) .. " more straws")
			buckets[level].Activated:Connect(function()
				buy("bucket", level, buckets[level])
			end)
		end
		for level, silo in ipairs(Config.Silos) do
			rows[level] = row(list, 100 + level, silo.name, "holds " .. Format.commas(silo.size) .. " straws from your machines")
			rows[level].Activated:Connect(function()
				buy("silo", level, rows[level])
			end)
		end
		return function()
			local bucket = player:GetAttribute("Bucket") or 1
			for level, button in pairs(buckets) do
				price(button, Config.Buckets[level].price, level <= bucket, level == bucket + 1)
			end
			local owned = player:GetAttribute("Silo") or 1
			for level, button in ipairs(rows) do
				price(button, Config.Silos[level].price, level <= owned, level == owned + 1)
			end
		end
	end)

	local function itemPage(name, colour, list_, describe)
		page(name, colour, function(list)
			local rows, subs = {}, {}
			for i, def in ipairs(list_) do
				rows[i], subs[i] = row(list, i, def.name, "")
				rows[i].Activated:Connect(function()
					buy("item", def.id, rows[i])
				end)
			end
			return function()
				for i, def in ipairs(list_) do
					local own, inv = player:GetAttribute("Own_" .. def.id) or 0, player:GetAttribute("Inv_" .. def.id) or 0
					subs[i].Text = describe(def) .. "  You have " .. own .. (if def.max then "/" .. def.max else "") .. (if inv > 0 then " (" .. inv .. " to build)" else "")
					price(rows[i], def.price, def.max ~= nil and own >= def.max, true, "MAXED")
				end
			end
		end)
	end
	itemPage("Build", Ui.colors.wood, Config.Pieces, function(def)
		return def.text
	end)
	itemPage("Machines", Ui.colors.red, Config.Machines, function(def)
		return def.rate .. " straws/s, uses " .. def.draw .. " power."
	end)
	itemPage("Power", Color3.fromRGB(200, 160, 40), Config.Generators, function(def)
		return "Makes " .. def.power .. " power."
	end)

	page("Robux", Color3.fromRGB(80, 160, 90), function(list)
		local any = false
		for i, item in ipairs(ROBUX) do
			local id = if item.kind == "pass" then Config.GamePasses[item.key] else Config.Products[item.key]
			if id and id ~= 0 then
				any = true
				local button = row(list, i, item.title, item.text, Color3.fromRGB(226, 236, 250))
				button.Text, button.BackgroundColor3 = "ROBUX", Ui.colors.blue
				button.Activated:Connect(function()
					if item.kind == "pass" then
						MarketplaceService:PromptGamePassPurchase(player, id)
					else
						MarketplaceService:PromptProductPurchase(player, id)
					end
				end)
			end
		end
		if not any then
			Ui.paragraph("Robux items appear here once the game is published and the items are created.", { TextColor3 = Ui.colors.grey, Parent = list })
		end
		return function() end
	end)

	pages.Tools.Visible = true
	player.AttributeChanged:Connect(function()
		Shop.refresh()
	end)
	return frame
end

function Shop.refresh()
	if not frame or not frame.Visible then
		return
	end
	for _, list in ipairs(frame.Body:GetChildren()) do
		if list:IsA("Frame") and list.Visible and Shop.refreshers then
			Shop.refreshers[list.Name]()
		end
	end
end

return Shop
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00038">
					<Properties>
						<string name="Name">Teleport</string>
						<ProtectedString name="Source"><![CDATA[-- The teleporter menu: standing on one of your pads, pick any of your other pads (listed by
-- how high up they are). The server checks you're on a pad and moves you.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)
local Cursor = require(script.Parent.Cursor)

local player = Players.LocalPlayer
local Teleport = {}
local window, body

local function close()
	if window then
		window.Visible = false
	end
	Cursor.need("teleport", false)
end

function Teleport.mount(gui)
	window, body = Ui.window(gui, "Teleport", function()
		Cursor.need("teleport", false)
	end)
	window.Size = UDim2.fromOffset(420, 420)
end

-- Opens the menu for the pad `from` (a Model on your plot).
function Teleport.open(from)
	if not window then
		return
	end
	for _, child in ipairs(body:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local plot = player:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	local built = plot and plots and plots:FindFirstChild("Plot" .. plot) and plots["Plot" .. plot]:FindFirstChild("Built")
	local pads = {}
	for _, model in ipairs(built and built:GetChildren() or {}) do
		if model:IsA("Model") and model:GetAttribute("Item") == "teleporter" and model ~= from then
			table.insert(pads, model)
		end
	end
	table.sort(pads, function(a, b)
		return a:GetPivot().Position.Y < b:GetPivot().Position.Y
	end)
	if #pads == 0 then
		Ui.paragraph("This is your only pad. Buy another Teleporter Pad (Q, Build) and put it somewhere else, like high up on a platform.", { LayoutOrder = 1, Parent = body })
	end
	for i, pad in ipairs(pads) do
		local height = math.floor(pad:GetPivot().Position.Y + 0.5)
		local name = if height <= 3 then "On the ground" else height .. " studs up"
		Ui.button("Pad " .. i .. ":  " .. name, Ui.colors.blue, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 48), Parent = body }).Activated:Connect(function()
			Remotes.Teleport:FireServer(pad)
			close()
		end)
	end
	window.Visible = true
	Cursor.need("teleport", true)
end

return Teleport
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00039">
					<Properties>
						<string name="Name">Ui</string>
						<ProtectedString name="Source"><![CDATA[-- A small UI kit: the farm colours, rounded wooden buttons and windows that scale with
-- the screen (phones get a smaller UI, big monitors a larger one).
local Ui = {}

Ui.colors = {
	wood = Color3.fromRGB(110, 70, 40),
	woodDark = Color3.fromRGB(62, 38, 22),
	hay = Color3.fromRGB(242, 196, 82),
	cream = Color3.fromRGB(255, 244, 222),
	paper = Color3.fromRGB(246, 232, 200),
	red = Color3.fromRGB(200, 64, 48),
	green = Color3.fromRGB(84, 166, 70),
	blue = Color3.fromRGB(64, 136, 206),
	purple = Color3.fromRGB(136, 92, 196),
	grey = Color3.fromRGB(128, 120, 112),
	ink = Color3.fromRGB(56, 36, 20),
	white = Color3.new(1, 1, 1),
}
Ui.font = Enum.Font.FredokaOne
Ui.body = Enum.Font.GothamMedium

local camera = workspace.CurrentCamera or workspace:WaitForChild("Camera")
local scales = {}

local function screenScale()
	return math.clamp(camera.ViewportSize.Y / 760, 0.55, 1.15)
end

camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	for _, scale in ipairs(scales) do
		scale.Scale = screenScale()
	end
end)

-- Instance.new with properties and children; Parent is set last.
function Ui.make(className, props, children)
	local instance = Instance.new(className)
	for name, value in pairs(props) do
		if name ~= "Parent" then
			instance[name] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.corner(radius)
	return Ui.make("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(color, thickness)
	return Ui.make("UIStroke", { Color = color or Ui.colors.woodDark, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Ui.maxText(size)
	return Ui.make("UITextSizeConstraint", { MaxTextSize = size })
end

-- Scales `frame` (around its AnchorPoint) with the screen height.
function Ui.autoScale(frame)
	local scale = Ui.make("UIScale", { Scale = screenScale(), Parent = frame })
	table.insert(scales, scale)
	return scale
end

-- A text label. `maxSize` caps the scaled text size.
function Ui.label(props, maxSize)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.font,
		Text = "",
		TextColor3 = Ui.colors.white,
		TextScaled = true,
		TextWrapped = true,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.35,
	}
	for name, value in pairs(props) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults, { Ui.maxText(maxSize or 40) })
end

function Ui.button(text, color, props)
	local defaults = {
		Text = text,
		Font = Ui.font,
		TextScaled = true,
		TextColor3 = Ui.colors.white,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.4,
		BackgroundColor3 = color,
		AutoButtonColor = true,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextButton", defaults, {
		Ui.corner(10),
		Ui.stroke(Ui.colors.woodDark, 3),
		Ui.maxText(28),
		Ui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
end

-- A centred window with a title and a close button. Returns frame, body (a scrolling list).
function Ui.window(parent, title, onClose)
	local frame = Ui.make("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 480),
		BackgroundColor3 = Ui.colors.cream,
		Visible = false,
		Parent = parent,
	}, { Ui.corner(18), Ui.stroke(Ui.colors.wood, 5) })
	Ui.autoScale(frame)
	Ui.make("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Ui.colors.wood, Parent = frame }, { Ui.corner(16) })
	Ui.label({ Text = title, Size = UDim2.new(1, -120, 0, 46), Position = UDim2.fromOffset(20, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame }, 34)
	local close = Ui.button("X", Ui.colors.red, { Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -56, 0, 8), Parent = frame })
	close.Activated:Connect(function()
		frame.Visible = false
		if onClose then
			onClose()
		end
	end)
	local body = Ui.make("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.new(1, -24, 1, -76),
		Position = UDim2.fromOffset(12, 68),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Ui.colors.wood,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, {
		Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})
	return frame, body
end

-- Paragraph text that grows to fit, for lists inside windows.
function Ui.paragraph(text, props)
	local defaults = {
		Text = text,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Ui.body,
		TextSize = 19,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.colors.ink,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults)
end

return Ui
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0003A">
					<Properties>
						<string name="Name">WorldFx</string>
						<ProtectedString name="Source"><![CDATA[-- World effects on your screen: the glowing needle clump (Wheel jackpot), the wheel turning
-- when you spin, your machines' fans spinning, and a marker over your own farm.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Layout = require(Shared:WaitForChild("Layout"))(Config)
local Ui = require(script.Parent.Ui)
local Juice = require(script.Parent.Juice)

local player = Players.LocalPlayer
local WorldFx = {}

local function myPlot()
	local index = player:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	return index and plots and plots:FindFirstChild("Plot" .. index)
end

-- The Wheel's NEEDLE REVEAL: the needle's clump glows through everything.
function WorldFx.reveal(clump)
	local plot = player:GetAttribute("Plot")
	local centre = plot and Config.PlotCentres[plot]
	local offset = Layout[clump]
	if not centre or not offset then
		return
	end
	local x, z = Layout.origin(centre[1], centre[2])
	-- a soft golden glow inside the heap where the needle's clump is, seen through the straw
	local part = Ui.make("Part", { Name = "NeedleGlow", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), Position = Vector3.new(x + offset[1], offset[2], z + offset[3]), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 214, 90), Transparency = 0.2, Parent = workspace })
	local glow = Instance.new("Highlight")
	glow.FillColor = Color3.fromRGB(255, 214, 90)
	glow.OutlineColor = Color3.fromRGB(255, 255, 255)
	glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	glow.Adornee = part
	glow.Parent = part
	local board = Ui.make("BillboardGui", { Adornee = part, Size = UDim2.fromOffset(220, 40), StudsOffset = Vector3.new(0, 5, 0), AlwaysOnTop = true, LightInfluence = 0, Parent = part })
	Ui.label({ Text = "THE NEEDLE IS HERE", Size = UDim2.fromScale(1, 1), TextColor3 = Ui.colors.hay, Parent = board }, 30)
	TweenService:Create(glow, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { FillTransparency = 0.8 }):Play()
	-- gone once the needle's found (the clump count jumps back to full)
	player:GetAttributeChangedSignal("Needles"):Connect(function()
		part:Destroy()
	end)
end

-- Turns the wheel a few times and eases it to a stop on the prize's slice.
function WorldFx.spin(index, slices)
	local farm = workspace:FindFirstChild("Farm")
	local disc = farm and farm:FindFirstChild("WheelDisc")
	if not disc then
		return
	end
	Juice.sound("spin")
	local start = disc.CFrame
	local turns = math.pi * 2 * 5 + (index - 0.5) / slices * math.pi * 2
	local angle = Instance.new("NumberValue")
	angle.Changed:Connect(function(a)
		disc.CFrame = start * CFrame.Angles(a, 0, 0)
	end)
	TweenService:Create(angle, TweenInfo.new(4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Value = turns }):Play()
	task.delay(4.2, function()
		angle:Destroy()
	end)
end

local function spinFans()
	local spinning = 0
	RunService.RenderStepped:Connect(function(dt)
		spinning += dt
		if spinning < 1 / 30 then
			return
		end
		local step = spinning * 6
		spinning = 0
		local plot = myPlot()
		local built = plot and plot:FindFirstChild("Built")
		if not built then
			return
		end
		for _, model in ipairs(built:GetChildren()) do
			local fan = model:FindFirstChild("Fan")
			local lamp = model:FindFirstChild("Lamp")
			if fan and lamp and lamp.Color.G > lamp.Color.R then -- green lamp: powered
				fan.CFrame = fan.CFrame * CFrame.Angles(step, 0, 0)
			end
		end
	end)
end

local function markFarm()
	local plot = myPlot()
	local sign = plot and plot:WaitForChild("PlotSign", 30)
	if sign then
		local board = Ui.make("BillboardGui", { Adornee = sign, Size = UDim2.fromScale(16, 3), StudsOffset = Vector3.new(0, 6, 0), LightInfluence = 0, MaxDistance = 600, ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") })
		Ui.label({ Text = "YOUR FARM", Size = UDim2.fromScale(1, 1), TextColor3 = Ui.colors.hay, Parent = board }, 48)
	end
end

function WorldFx.start()
	task.spawn(spinFans)
	task.spawn(function()
		while not player:GetAttribute("Plot") do
			player:GetAttributeChangedSignal("Plot"):Wait()
		end
		markFarm()
	end)
end

return WorldFx
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="Workspace" referent="RBX0003B">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">false</bool>
		</Properties>
	</Item>
