			<Item class="ModuleScript" referent="RBX00013">
				<Properties>
					<string name="Name">Build</string>
					<ProtectedString name="Source"><![CDATA[-- Helpers for building the world out of simple anchored parts.
local Build = {}

function Build.rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- spec: name, size (Vector3), cframe, color ({r, g, b} or Color3), material ("Wood"),
-- shape ("Ball" | "Cylinder"), collide (default true), shadow (default true), transparency, class
function Build.part(spec)
	local p = Instance.new(spec.class or "Part")
	p.Name = spec.name or "Part"
	p.Anchored = true
	if spec.shape then
		p.Shape = Enum.PartType[spec.shape]
	end
	p.Size = spec.size
	p.CFrame = spec.cframe
	if typeof(spec.color) == "Color3" then
		p.Color = spec.color
	elseif spec.color then
		p.Color = Build.rgb(spec.color)
	end
	p.Material = Enum.Material[spec.material or "SmoothPlastic"]
	p.CanCollide = spec.collide ~= false
	p.CastShadow = spec.shadow ~= false
	p.Transparency = spec.transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if spec.collide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.Parent = spec.parent
	return p
end

-- A standing cylinder: bottom centre at `base` (CFrame), `height` tall.
function Build.post(spec, base, height, diameter)
	spec.shape = "Cylinder"
	spec.size = Vector3.new(height, diameter, diameter)
	spec.cframe = base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	return Build.part(spec)
end

-- A gable roof: a block turned 45 degrees, its lower half hidden inside the walls.
-- `top` is the CFrame of the ridge line's centre at wall height; the ridge runs along Z.
function Build.roof(spec, top, width, depth)
	local side = width / math.sqrt(2)
	spec.size = Vector3.new(side, side, depth)
	spec.cframe = top * CFrame.Angles(0, 0, math.rad(45))
	return Build.part(spec)
end

-- Text on one face of a part. Returns the TextLabel.
function Build.text(part, face, text, options)
	options = options or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = options.pixels or 40
	gui.LightInfluence = 0.6
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = options.font or Enum.Font.FredokaOne
	label.TextColor3 = options.color or Color3.fromRGB(58, 38, 22)
	label.TextWrapped = true
	label.Parent = gui
	return label
end

return Build
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00014">
				<Properties>
					<string name="Name">Haystack</string>
					<ProtectedString name="Source"><![CDATA[-- The giant haystack everyone searches, and the golden haystack of the secret Loft.
-- Progress is per player (saved), so the mounds never shrink; the HUD shows your own progress.
local Build = require(script.Parent.Build)
local World = require(script.Parent.World)

local Haystack = {}

local HAY = { { 226, 190, 92 }, { 212, 172, 76 }, { 236, 204, 112 } }
local GOLD = { { 250, 206, 70 }, { 240, 186, 50 }, { 255, 224, 110 } }

local function mound(name, centre, size, colours, parent, seed)
	local model = Instance.new("Model")
	model.Name = name
	local function ball(label, diameter, offset, colour, material)
		return Build.part({ name = label, shape = "Ball", size = Vector3.new(diameter, diameter, diameter), cframe = CFrame.new(centre + offset), color = colour, material = material or "Grass", parent = model })
	end
	local core = ball("Core", size, Vector3.new(0, size * 0.14, 0), colours[1])
	local rng = Random.new(seed)
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local d = size * (0.5 + (i % 3) * 0.06)
		ball("Lump", d, Vector3.new(math.cos(a) * size * 0.36, size * 0.02, math.sin(a) * size * 0.36), colours[i % 3 + 1])
	end
	ball("Top", size * 0.42, Vector3.new(size * 0.04, size * 0.58, -size * 0.04), colours[3])
	for _ = 1, 40 do
		local a = rng:NextNumber() * math.pi * 2
		local h = rng:NextNumber(size * 0.1, size * 0.62)
		local r = size * 0.48 - h * 0.45
		Build.part({
			name = "Straw",
			shape = "Cylinder",
			size = Vector3.new(rng:NextNumber(3, 6), 0.2, 0.2),
			cframe = CFrame.new(centre + Vector3.new(math.cos(a) * r, h, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(-1, 1), a, rng:NextNumber(-0.6, 0.6)),
			color = { 246, 222, 140 },
			collide = false,
			shadow = false,
			parent = model,
		})
	end
	if colours == GOLD then
		for _, part in ipairs(model:GetChildren()) do
			if part:IsA("BasePart") and part.Name ~= "Straw" then
				part.Material = Enum.Material.Sand
				part.Reflectance = 0.15
			end
		end
	end
	model.WorldPivot = CFrame.new(centre)
	model:SetAttribute("Centre", centre)
	model.Parent = parent
	return model, core
end

function Haystack.build()
	local folder = Instance.new("Folder")
	folder.Name = "Haystacks"
	folder.Parent = workspace
	mound("Haystack", World.HAYSTACK, 56, HAY, folder, 1)
	-- the Golden Loft: a platform in the clouds above the barn, reached from the loft hatch
	local loft = Instance.new("Model")
	loft.Name = "Loft"
	local floor = Build.part({ name = "LoftFloor", size = Vector3.new(90, 2, 90), cframe = CFrame.new(World.LOFT - Vector3.new(0, 1, 0)), color = { 214, 184, 130 }, material = "WoodPlanks", parent = loft })
	floor.Reflectance = 0.05
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		local cf = CFrame.new(World.LOFT + Vector3.new(math.cos(a) * 44, 2.5, math.sin(a) * 44)) * CFrame.Angles(0, -a, 0)
		Build.part({ name = "LoftRail", size = Vector3.new(1, 5, 90), cframe = cf, color = { 122, 86, 52 }, material = "Wood", parent = loft })
		local lamp = Build.part({ name = "LoftLamp", size = Vector3.new(2, 2, 2), cframe = cf * CFrame.new(0, 6, 0), color = { 255, 214, 90 }, material = "Neon", parent = loft })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 80)
		light.Range = 40
		light.Brightness = 1.2
		light.Parent = lamp
	end
	local cloud = Build.part({ name = "Cloud", shape = "Ball", size = Vector3.new(130, 30, 130), cframe = CFrame.new(World.LOFT - Vector3.new(0, 16, 0)), color = { 255, 240, 220 }, material = "Sand", collide = false, transparency = 0.15, parent = loft })
	cloud.CastShadow = false
	local sign = Build.part({ name = "LoftSign", size = Vector3.new(16, 3, 0.4), cframe = CFrame.new(World.LOFT + Vector3.new(0, 8, 42)), color = { 60, 44, 30 }, material = "Wood", parent = loft })
	Build.text(sign, Enum.NormalId.Back, "THE GOLDEN LOFT: golden straw pays 20x", { color = Color3.fromRGB(245, 200, 66) })
	local pad = Build.part({ name = "LoftPad", size = Vector3.new(8, 0.4, 8), cframe = CFrame.new(World.LOFT + Vector3.new(0, 0.2, 36)), color = { 245, 200, 66 }, material = "Neon", parent = loft })
	Build.text(pad, Enum.NormalId.Top, "step here to go back down", { color = Color3.fromRGB(60, 44, 30), pixels = 24 })
	loft.Parent = folder
	mound("GoldenHaystack", World.LOFT + Vector3.new(0, 0, -8), 34, GOLD, folder, 2)
end

-- Which haystack the player can search from `position`: "hay", "gold" or nil.
function Haystack.at(position, range)
	local function near(centre, r)
		return Vector3.new(position.X - centre.X, 0, position.Z - centre.Z).Magnitude <= r and math.abs(position.Y - centre.Y) < 40
	end
	if near(World.HAYSTACK, range) then
		return "hay"
	elseif near(World.LOFT + Vector3.new(0, 0, -8), range * 0.75) then
		return "gold"
	end
	return nil
end

return Haystack
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00015">
				<Properties>
					<string name="Name">Loft</string>
					<ProtectedString name="Source"><![CDATA[-- The Golden Loft: the secret level above the barn, open only to players with all ten
-- achievements. The server moves the player up and down so nobody can walk in uninvited.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local World = require(script.Parent.World)

local Loft = {}

local function teleport(player, position)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(position)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function Loft.init()
	Remotes.Loft.OnServerInvoke = function(player, direction)
		if direction == "up" then
			if not player:GetAttribute("LoftOpen") then
				return false, "The Golden Loft opens when all ten achievements are done."
			end
			teleport(player, World.LOFT + Vector3.new(0, 4, 30))
			return true, "Welcome to the Golden Loft. Golden straw pays 20x!"
		end
		teleport(player, World.BARN + Vector3.new(0, 4, -18))
		return true, "Back down on the farm."
	end
end

return Loft
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX00016">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[-- Starts the game. The ground and spawn point are built first, so nobody spawns into the void.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local World = require(script.Parent.World)
World.ground()

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Haystack = require(script.Parent.Haystack)
local PlayerData = require(script.Parent.PlayerData)
local Tools = require(script.Parent.Tools)
local Achievements = require(script.Parent.Achievements)
local Search = require(script.Parent.Search)
local Shop = require(script.Parent.Shop)
local Loft = require(script.Parent.Loft)
local Monetization = require(script.Parent.Monetization)

World.build()
Haystack.build()

PlayerData.onLoaded(function(player, saveable)
	local data = PlayerData.get(player)
	if data then
		Tools.give(player, data.tool)
	end
	-- a backstop: after every spawn, make sure the fork arrived (it comes from StarterGear)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		local current = PlayerData.get(player)
		if current and player.Parent and not Tools.has(player) then
			Tools.give(player, current.tool)
		end
	end)
	if not saveable and not RunService:IsStudio() then
		Remotes.Announce:FireClient(player, {
			kind = "notice",
			text = "Saving isn't working right now, so progress in this server won't be kept.",
		})
	end
end)

PlayerData.init()
Monetization.init()
Achievements.init()
Search.init()
Shop.init()
Loft.init()
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00017">
				<Properties>
					<string name="Name">Monetization</string>
					<ProtectedString name="Source"><![CDATA[-- Robux items. Every ID in Config.GamePasses and Config.Products starts at 0 (switched off);
-- create the item on the Creator Dashboard after publishing, then paste its ID into Config.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Search = require(script.Parent.Search)

local Monetization = {}

local function nameOf(table_, id)
	for name, itemId in pairs(table_) do
		if itemId ~= 0 and itemId == id then
			return name
		end
	end
	return nil
end

local function checkPasses(player)
	for name, id in pairs(Config.GamePasses) do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				PlayerData.setPass(player, name, true)
			end
		end
	end
	Search.offline(player)
end

local grants = {}

local function boost(name)
	return function(player)
		PlayerData.update(player, function(d)
			d.boosts[name] = math.max(d.boosts[name] or 0, os.time()) + Config.BoostSeconds
		end)
		return "Your " .. name .. " is on for an hour."
	end
end
grants.SpeedBoost = boost("SpeedBoost")
grants.CoinBoost = boost("CoinBoost")
grants.LuckyCharm = boost("LuckyCharm")

function grants.MerchantWhistle(player)
	PlayerData.update(player, function(d)
		d.whistles += Config.WhistleUses
	end)
	return "You have " .. Config.WhistleUses .. " more Merchant's Whistles: sell your bag anywhere."
end

function grants.StrawBlast(player)
	local before = PlayerData.get(player).searched
	for _ = 1, 50 do -- searched in handfuls so the bag, the needle and the finds all count
		Search.blast(player, Config.StrawBlastAmount / 50)
	end
	local after = PlayerData.get(player).searched
	return "Straw Blast! " .. Format.commas(math.max(0, after - before)) .. " straws blown through your haystack."
end

-- Roblox calls this for every developer product purchase, retrying until we say granted.
local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not PlayerData.waitFor(player, 15) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if PlayerData.hasReceipt(player, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already given
	end
	local name = nameOf(Config.Products, info.ProductId)
	local grant = name and grants[name]
	if not grant then
		warn("[Monetization] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local message = grant(player)
	PlayerData.addReceipt(player, info.PurchaseId)
	PlayerData.save(player)
	Remotes.Announce:FireClient(player, { kind = "notice", text = message })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.init()
	PlayerData.onLoaded(checkPasses)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = nameOf(Config.GamePasses, passId)
		if purchased and name then
			PlayerData.setPass(player, name, true)
			Remotes.Announce:FireClient(player, { kind = "notice", text = "Thank you! Your " .. name .. " pass is active." })
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
end

return Monetization
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00018">
				<Properties>
					<string name="Name">PlayerData</string>
					<ProtectedString name="Source"><![CDATA[-- Each player's saved progress and the leaderboard. If the DataStore can't be read (Studio
-- before publishing, or an outage), the player plays with fresh progress that is not saved,
-- so a failed read never overwrites good data.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local Profile = require(script.Parent.Profile)

local PlayerData = {}
local profiles = {} -- [player] = { data, saveable, dirty, joined }
local passes = {} -- [player] = { VIP = true, ... } (checked each visit, not saved)
local loadedCallbacks = {}

local MAX_RECEIPTS = 50

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] saving is off: " .. tostring(result))
	end
end

local function key(player)
	return "player_" .. player.UserId
end

local function load(player)
	if not store then
		return Profile.fresh(nil), false
	end
	local tries = if RunService:IsStudio() then 1 else 3
	for attempt = 1, tries do
		local ok, saved = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			return Profile.fresh(saved), true
		end
		warn("[PlayerData] could not load " .. player.Name .. ": " .. tostring(saved))
		if attempt < tries then
			task.wait(attempt * 2)
		end
	end
	return Profile.fresh(nil), false
end

-- Everything the client shows comes from these attributes (and leaderstats).
local function publish(player, profile)
	local d = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = d.coins
		stats.Needles.Value = d.needles
	end
	local flags = PlayerData.flags(player)
	player:SetAttribute("Coins", d.coins)
	player:SetAttribute("Tool", d.tool)
	player:SetAttribute("Bag", d.bag)
	player:SetAttribute("BagStraw", d.bagStraw)
	player:SetAttribute("BagGolden", d.bagGolden)
	player:SetAttribute("Searched", d.searched)
	player:SetAttribute("LoftSearched", d.loft.searched)
	player:SetAttribute("Needles", d.needles)
	player:SetAttribute("GoldenNeedles", d.loft.needles)
	player:SetAttribute("Power", Economy.power(d, flags.speedBoost))
	player:SetAttribute("MachineRate", Economy.machineRate(d, flags.doubleMachines))
	player:SetAttribute("Multiplier", Economy.coinMultiplier(flags) * (1 + 0.2 * d.needles))
	player:SetAttribute("Whistles", d.whistles)
	for _, perk in ipairs(Config.Perks) do
		player:SetAttribute("Perk_" .. perk.id, d.perks[perk.id])
	end
	for i in ipairs(Config.Machines) do
		player:SetAttribute("Machine_" .. i, d.machines[i])
	end
	for name, until_ in pairs(d.boosts) do
		player:SetAttribute("Boost_" .. name, until_)
	end
	local done = 0
	for _, a in ipairs(Config.Achievements) do
		if d.achievements[a.id] then
			done += 1
		end
	end
	player:SetAttribute("Achievements", done)
	player:SetAttribute("LoftOpen", done >= #Config.Achievements)
end

function PlayerData.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

function PlayerData.sessionSeconds(player)
	local profile = profiles[player]
	return if profile then os.time() - profile.joined else 0
end

-- Passes and active boosts, as the rest of the game sees them.
function PlayerData.flags(player)
	local d = PlayerData.get(player)
	local own = passes[player] or {}
	local now = os.time()
	local function boost(name)
		return d ~= nil and (d.boosts[name] or 0) > now
	end
	return {
		vip = own.VIP == true,
		autoSell = own.AutoSell == true,
		doubleMachines = own.DoubleMachines == true,
		speedBoost = boost("SpeedBoost"),
		coinBoost = boost("CoinBoost"),
		luckyCharm = boost("LuckyCharm"),
	}
end

-- Change a player's data and show the change everywhere. Returns false if not loaded yet.
function PlayerData.update(player, change)
	local profile = profiles[player]
	if not profile then
		return false
	end
	change(profile.data)
	profile.dirty = true
	publish(player, profile)
	return true
end

function PlayerData.setPass(player, name, owned)
	passes[player] = passes[player] or {}
	passes[player][name] = owned
	player:SetAttribute("Pass" .. name, owned)
	local profile = profiles[player]
	if profile then
		publish(player, profile)
	end
end

-- Waits up to `timeout` seconds for a player's data. Returns it, or nil.
function PlayerData.waitFor(player, timeout)
	local waited = 0
	while not profiles[player] and player.Parent and waited < timeout do
		waited += task.wait(0.25)
	end
	return PlayerData.get(player)
end

function PlayerData.hasReceipt(player, purchaseId)
	local d = PlayerData.get(player)
	return d ~= nil and table.find(d.receipts, purchaseId) ~= nil
end

function PlayerData.addReceipt(player, purchaseId)
	PlayerData.update(player, function(d)
		table.insert(d.receipts, purchaseId)
		while #d.receipts > MAX_RECEIPTS do
			table.remove(d.receipts, 1)
		end
	end)
end

function PlayerData.save(player)
	local profile = profiles[player]
	if not profile or not profile.saveable or not store then
		return false
	end
	local data = profile.data
	data.lastSeen = os.time()
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if ok then
		profile.dirty = false
	else
		warn("[PlayerData] could not save " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- callback(player, saveable) runs once a player's data has loaded.
function PlayerData.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function added(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Coins", "Needles" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
	local data, saveable = load(player)
	if player.Parent == nil then
		return -- left while loading
	end
	local profile = { data = data, saveable = saveable, dirty = false, joined = os.time() }
	profiles[player] = profile
	publish(player, profile)
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, saveable)
	end
end

function PlayerData.init()
	Players.PlayerAdded:Connect(added)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(added, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerData.save(player)
		profiles[player] = nil
		passes[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				PlayerData.save(player)
				pending -= 1
			end)
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited += task.wait(0.5)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, profile in pairs(profiles) do
				if profile.dirty then
					task.spawn(PlayerData.save, player)
				end
			end
		end
	end)
end

return PlayerData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00019">
				<Properties>
					<string name="Name">Profile</string>
					<ProtectedString name="Source"><![CDATA[-- A player's data model: what is saved, with its defaults. Anything missing or of the
-- wrong type in a saved record falls back to the default, so old saves keep working.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local Profile = {}
local rng = Random.new()

Profile.STATS = { "searches", "bags_filled", "straws_sold", "lucky_finds", "perks_maxed", "total_searched" }

local function number(saved, name, default)
	local v = type(saved) == "table" and saved[name]
	return if type(v) == "number" then v else default
end

function Profile.fresh(saved)
	saved = if type(saved) == "table" then saved else {}
	local d = {
		coins = number(saved, "coins", 0),
		tool = math.clamp(math.floor(number(saved, "tool", 1)), 1, #Config.Tools),
		bag = math.clamp(math.floor(number(saved, "bag", 1)), 1, #Config.Bags),
		bagStraw = number(saved, "bagStraw", 0),
		bagGolden = number(saved, "bagGolden", 0),
		searched = number(saved, "searched", 0),
		needleAt = number(saved, "needleAt", 0),
		needles = number(saved, "needles", 0),
		whistles = number(saved, "whistles", 0),
		lastSeen = number(saved, "lastSeen", 0),
		perks = {},
		machines = {},
		stats = {},
		achievements = {},
		boosts = {},
		receipts = {},
		loft = { searched = number(saved.loft, "searched", 0), needleAt = number(saved.loft, "needleAt", 0), needles = number(saved.loft, "needles", 0) },
	}
	for _, perk in ipairs(Config.Perks) do
		d.perks[perk.id] = math.clamp(math.floor(number(saved.perks, perk.id, 0)), 0, perk.levels)
	end
	for i, m in ipairs(Config.Machines) do
		d.machines[i] = math.clamp(math.floor(number(saved.machines, i, 0)), 0, m.max)
	end
	for _, name in ipairs(Profile.STATS) do
		d.stats[name] = number(saved.stats, name, 0)
	end
	for _, a in ipairs(Config.Achievements) do
		d.achievements[a.id] = type(saved.achievements) == "table" and saved.achievements[a.id] == true
	end
	for name in pairs(Config.Products) do
		d.boosts[name] = number(saved.boosts, name, 0)
	end
	if type(saved.receipts) == "table" then
		for _, id in ipairs(saved.receipts) do
			if type(id) == "string" then
				table.insert(d.receipts, id)
			end
		end
	end
	if d.needleAt <= 0 then
		d.needleAt = Economy.needleAt(Config.TotalStraws, Config.NeedleEarliest, rng)
	end
	if d.loft.needleAt <= 0 then
		d.loft.needleAt = Economy.needleAt(Config.Loft.straws, Config.Loft.needleEarliest, rng)
	end
	return d
end

return Profile
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001A">
				<Properties>
					<string name="Name">Search</string>
					<ProtectedString name="Source"><![CDATA[-- The loop: search the haystack (straw goes in your bag), machines add straw by themselves,
-- sell the bag to the merchant for coins. Lucky finds and the needle hide in the straw.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Finds = require(Shared:WaitForChild("Finds"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Haystack = require(script.Parent.Haystack)
local PlayerData = require(script.Parent.PlayerData)
local Achievements = require(script.Parent.Achievements)
local World = require(script.Parent.World)

local Search = {}
local lastSearch = {}
local rng = Random.new()

local function root(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function holdingTool(player)
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Level") ~= nil
end

local function bagRoom(d)
	return Economy.bag(d.bag).size - d.bagStraw - d.bagGolden
end

-- Sells the bag. Returns coins paid (0 if the bag was empty).
function Search.sell(player, reason)
	local d = PlayerData.get(player)
	if not d or (d.bagStraw <= 0 and d.bagGolden <= 0) then
		return 0
	end
	local flags = PlayerData.flags(player)
	local mult = Economy.coinMultiplier(flags) * (1 + 0.2 * d.needles)
	local coins = Economy.coinsFor(d.bagStraw, false, mult) + Economy.coinsFor(d.bagGolden, true, mult)
	local straws = d.bagStraw + d.bagGolden
	PlayerData.update(player, function(data)
		data.coins += coins
		data.stats.straws_sold += straws
		data.bagStraw, data.bagGolden = 0, 0
	end)
	Remotes.SearchFx:FireClient(player, { kind = "sold", coins = coins, straws = straws, reason = reason })
	Achievements.check(player)
	return coins
end

local function luckyFind(player, d, flags)
	local find = Finds[rng:NextInteger(1, #Finds)]
	local worth = Economy.coinsFor(Economy.power(d, false) * Config.LuckyValueSearches, false, Economy.coinMultiplier(flags)) * (find.bonus or 1)
	PlayerData.update(player, function(data)
		data.coins += worth
		data.stats.lucky_finds += 1
	end)
	Remotes.SearchFx:FireClient(player, { kind = "find", name = find.name, story = find.story, coins = worth })
end

local function needleFound(player, golden)
	local d = PlayerData.get(player)
	local prize = Economy.coinsFor(Economy.power(d, false) * 5000, golden, Economy.coinMultiplier(PlayerData.flags(player)))
	PlayerData.update(player, function(data)
		data.coins += prize
		if golden then
			data.loft.needles += 1
			data.loft.searched = 0
			data.loft.needleAt = Economy.needleAt(Config.Loft.straws, Config.Loft.needleEarliest, rng)
		else
			data.needles += 1
			data.searched = 0 -- a fresh haystack, a new needle, and +20% coins for good
			data.needleAt = Economy.needleAt(Config.TotalStraws, Config.NeedleEarliest, rng)
		end
	end)
	Remotes.Announce:FireAllClients({ kind = "needle", finder = player.DisplayName, finderId = player.UserId, golden = golden, prize = prize })
	Achievements.check(player)
end

-- Takes `amount` straws from the player's haystack (or the loft's) into the bag.
-- Returns straws actually taken; fires nothing itself.
local function dig(player, d, where, amount)
	local golden = where == "gold"
	local progress = if golden then d.loft else d
	local total = if golden then Config.Loft.straws else Config.TotalStraws
	amount = math.min(amount, bagRoom(d), total - progress.searched)
	if amount <= 0 then
		return 0, false
	end
	local hit = progress.searched < progress.needleAt and progress.searched + amount >= progress.needleAt
	PlayerData.update(player, function(data)
		local p = if golden then data.loft else data
		p.searched += amount
		if golden then
			data.bagGolden += amount
		else
			data.bagStraw += amount
			data.stats.total_searched += amount
		end
	end)
	return amount, hit
end

function Search.perform(player)
	local d, part = PlayerData.get(player), root(player)
	if not d or not part then
		return
	end
	local where = Haystack.at(part.Position, Config.SearchRange)
	if not where or (where == "gold" and not player:GetAttribute("LoftOpen")) then
		return
	end
	local flags = PlayerData.flags(player)
	if bagRoom(d) <= 0 then
		if flags.autoSell then
			Search.sell(player, "auto")
		else
			Remotes.SearchFx:FireClient(player, { kind = "full" })
			return
		end
	end
	local amount, hit = dig(player, d, where, Economy.power(d, flags.speedBoost))
	if amount <= 0 then
		return
	end
	PlayerData.update(player, function(data)
		data.stats.searches += 1
		if bagRoom(data) <= 0 then
			data.stats.bags_filled += 1
		end
	end)
	local warmth = if d.tool >= Config.DetectorLevel and where == "hay" then Economy.warmth(d.searched, d.needleAt, Config.TotalStraws) else nil
	Remotes.SearchFx:FireClient(player, { kind = "search", where = where, straws = amount, warmth = warmth, full = bagRoom(d) <= 0 })
	if hit then
		needleFound(player, where == "gold")
	elseif rng:NextNumber() < Economy.luckyChance(d, flags.luckyCharm) then
		luckyFind(player, d, flags)
	end
	Achievements.check(player)
end

function Search.request(player)
	local d = PlayerData.get(player)
	local now = os.clock()
	if not d or now - (lastSearch[player] or 0) < Economy.cooldown(d) * 0.9 then
		return
	end
	lastSearch[player] = now
	if holdingTool(player) then
		Search.perform(player)
	end
end

-- Machines add straw to the bag every second while the player is in the game.
local function tickMachines()
	for _, player in ipairs(Players:GetPlayers()) do
		local d = PlayerData.get(player)
		if d then
			local flags = PlayerData.flags(player)
			local rate = Economy.machineRate(d, flags.doubleMachines)
			if rate > 0 and bagRoom(d) > 0 then
				local amount, hit = dig(player, d, "hay", rate)
				if hit then
					needleFound(player, false)
				elseif amount > 0 and bagRoom(d) <= 0 and flags.autoSell then
					Search.sell(player, "auto")
				end
			end
		end
	end
end

-- The Straw Blast product: `amount` straws searched at once, needle and finds included.
function Search.blast(player, amount)
	local d = PlayerData.get(player)
	if not d then
		return
	end
	local flags = PlayerData.flags(player)
	if bagRoom(d) <= 0 then
		Search.sell(player, "auto") -- a blast always sells on the spot
	end
	local taken, hit = dig(player, d, "hay", amount)
	if taken > 0 then
		Search.sell(player, "auto")
	end
	if hit then
		needleFound(player, false)
	elseif taken > 0 and rng:NextNumber() < Economy.luckyChance(d, flags.luckyCharm) * 10 then
		luckyFind(player, d, flags)
	end
end

-- VIP: machines kept working for up to an hour after the player left.
function Search.offline(player)
	local d = PlayerData.get(player)
	if not d or d.lastSeen <= 0 or not PlayerData.flags(player).vip then
		return
	end
	local seconds = math.clamp(os.time() - d.lastSeen, 0, Config.VipOfflineSeconds)
	local amount = dig(player, d, "hay", math.floor(Economy.machineRate(d, PlayerData.flags(player).doubleMachines) * seconds))
	if amount > 0 then
		Remotes.Announce:FireClient(player, { kind = "notice", text = "Your machines gathered " .. Format.commas(amount) .. " straws while you were away (VIP)." })
	end
end

local function nearMerchant(player)
	local part = root(player)
	return part ~= nil and (Vector3.new(part.Position.X, 0, part.Position.Z) - Vector3.new(World.MERCHANT.X, 0, World.MERCHANT.Z)).Magnitude <= Config.MerchantRange
end

function Search.init()
	Remotes.Search.OnServerEvent:Connect(Search.request)
	Remotes.Sell.OnServerInvoke = function(player)
		if not nearMerchant(player) then
			return false, "Walk to the merchant's stall to sell."
		end
		local coins = Search.sell(player, "merchant")
		return coins > 0, if coins > 0 then "Sold for " .. Format.short(coins) .. " coins." else "Your bag is empty."
	end
	Remotes.Whistle.OnServerInvoke = function(player)
		local d = PlayerData.get(player)
		if not d or d.whistles <= 0 then
			return false, "No Merchant's Whistles left."
		end
		if d.bagStraw <= 0 and d.bagGolden <= 0 then
			return false, "Your bag is empty."
		end
		PlayerData.update(player, function(data)
			data.whistles -= 1
		end)
		local coins = Search.sell(player, "whistle")
		return true, "The merchant comes running! Sold for " .. Format.short(coins) .. " coins."
	end
	Players.PlayerRemoving:Connect(function(player)
		lastSearch[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			tickMachines()
		end
	end)
end

return Search
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001B">
				<Properties>
					<string name="Name">Shop</string>
					<ProtectedString name="Source"><![CDATA[-- Buying with coins: tools (in order), bags, machines and perks. One remote: Buy(kind, index).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Tools = require(script.Parent.Tools)
local Achievements = require(script.Parent.Achievements)

local Shop = {}

local function pay(player, d, price)
	if d.coins < price then
		return false, "You need " .. Format.short(price - d.coins) .. " more coins."
	end
	return true
end

local buyers = {}

function buyers.tool(player, d, level)
	if level ~= d.tool + 1 then
		return false, "Buy the tools in order."
	end
	local tool = Config.Tools[level]
	if not tool then
		return false, "You already have the best tool!"
	end
	local ok, message = pay(player, d, tool.price)
	if not ok then
		return false, message
	end
	PlayerData.update(player, function(data)
		data.coins -= tool.price
		data.tool = level
		for _, perk in ipairs(Config.Perks) do
			data.perks[perk.id] = 0 -- perks belong to the tool
		end
	end)
	Tools.give(player, level)
	return true, "You got the " .. tool.name .. ": " .. tool.power .. " straws a search. Perks start again on a new tool."
end

function buyers.bag(player, d, level)
	if level ~= d.bag + 1 then
		return false, "Buy the bags in order."
	end
	local bag = Config.Bags[level]
	if not bag then
		return false, "You already have the biggest bag!"
	end
	local ok, message = pay(player, d, bag.price)
	if not ok then
		return false, message
	end
	PlayerData.update(player, function(data)
		data.coins -= bag.price
		data.bag = level
	end)
	return true, "You got the " .. bag.name .. ": it holds " .. Format.commas(bag.size) .. " straws."
end

function buyers.machine(player, d, index)
	local m = Config.Machines[index]
	if not m then
		return false, "No such machine."
	end
	local owned = d.machines[index]
	if owned >= m.max then
		return false, "You own the most " .. m.name .. "s allowed (" .. m.max .. ")."
	end
	local price = Economy.machinePrice(index, owned)
	local ok, message = pay(player, d, price)
	if not ok then
		return false, message
	end
	PlayerData.update(player, function(data)
		data.coins -= price
		data.machines[index] = owned + 1
	end)
	return true, "A " .. m.name .. " joins your yard: +" .. m.rate .. " straws a second, even while you're not clicking."
end

function buyers.perk(player, d, index)
	local perk = Config.Perks[index]
	if not perk then
		return false, "No such perk."
	end
	if d.perks[perk.id] >= perk.levels then
		return false, perk.name .. " is already maxed on this tool."
	end
	local price = Economy.perkPrice(d, index)
	local ok, message = pay(player, d, price)
	if not ok then
		return false, message
	end
	PlayerData.update(player, function(data)
		data.coins -= price
		data.perks[perk.id] += 1
		if Economy.perksMaxed(data) then
			data.stats.perks_maxed += 1
		end
	end)
	return true, perk.name .. " " .. d.perks[perk.id] .. "/" .. perk.levels .. " on your " .. Economy.tool(d.tool).name .. "."
end

function Shop.init()
	Remotes.Buy.OnServerInvoke = function(player, kind, index)
		local d = PlayerData.get(player)
		if not d then
			return false, "Still loading your progress..."
		end
		local buyer = type(kind) == "string" and buyers[kind]
		if not buyer or type(index) ~= "number" or index ~= math.floor(index) then
			return false, "Nothing to buy there."
		end
		local ok, message = buyer(player, d, index)
		if ok then
			Achievements.check(player)
		end
		return ok, message
	end
end

return Shop
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001C">
				<Properties>
					<string name="Name">Tools</string>
					<ProtectedString name="Source"><![CDATA[-- The search tools: a pitchfork-shaped Tool per level, coloured from Config.Tools.
-- The tool goes in StarterGear too, so players keep it when they respawn.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Build = require(script.Parent.Build)

local Tools = {}

local function attach(tool, handle, size, offset, colour, material)
	local part = Instance.new("Part")
	part.Name = "Head"
	part.Size = size
	part.Color = colour
	part.Material = material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
	part.Parent = tool
end

function Tools.make(level)
	local def = Config.Tools[level]
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.ToolTip = Format.commas(def.power) .. " straws a search"
	tool.CanBeDropped = false
	tool.Grip = CFrame.new(0, -1, 0) -- held a little below the middle, fork up
	tool:SetAttribute("Level", level)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 6, 0.3)
	handle.Color = Build.rgb(def.shaft)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local colour, material = Build.rgb(def.head), Enum.Material[def.material]
	attach(tool, handle, Vector3.new(1.7, 0.3, 0.3), CFrame.new(0, 2.9, 0), colour, material)
	for x = -1, 1 do
		attach(tool, handle, Vector3.new(0.16, 1.5, 0.16), CFrame.new(x * 0.7, 3.75, 0), colour, material)
	end
	return tool
end

local function clear(container, character)
	local equipped = false
	if container then
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				equipped = equipped or container == character
				item:Destroy()
			end
		end
	end
	return equipped
end

-- True if the player holds or carries a search tool.
function Tools.has(player)
	local function holds(container)
		for _, item in ipairs(container and container:GetChildren() or {}) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				return true
			end
		end
		return false
	end
	return holds(player:FindFirstChildOfClass("Backpack")) or holds(player.Character)
end

-- Replace whatever search tool the player has with the one for `level`. May wait briefly.
function Tools.give(player, level)
	local gear = player:FindFirstChild("StarterGear") or player:WaitForChild("StarterGear", 10)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	clear(gear, nil)
	clear(backpack, nil)
	local wasEquipped = clear(character, character)
	if gear then
		Tools.make(level).Parent = gear
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if backpack and humanoid and humanoid.Health > 0 then
		local tool = Tools.make(level)
		tool.Parent = backpack
		if wasEquipped then
			humanoid:EquipTool(tool)
		end
	end
end

return Tools
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001D">
				<Properties>
					<string name="Name">World</string>
					<ProtectedString name="Source"><![CDATA[-- Hollow Creek Farm at sunset: terrain, plaza, the merchant's stall, the machine yard, the
-- barn with the Golden Loft above it, fence and trees. The haystacks are in Haystack.luau.
local Lighting = game:GetService("Lighting")

local Build = require(script.Parent.Build)

local World = {}
local terrain = workspace.Terrain
local AUTUMN = { { 214, 120, 40 }, { 196, 72, 44 }, { 232, 176, 54 }, { 150, 150, 58 } }
local WOOD = { 122, 86, 52 }

World.HAYSTACK = Vector3.new(0, 0, -110) -- the giant haystack, north of the plaza
World.MERCHANT = Vector3.new(74, 0, 10) -- the merchant's stall, east
World.YARD = Vector3.new(-80, 0, 0) -- the machine yard, west
World.BARN = Vector3.new(0, 0, 96) -- the barn, south; the Golden Loft is above it
World.LOFT = Vector3.new(0, 130, 96) -- the secret level floats high above the barn

function World.ground()
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(118, 136, 58))
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(124, 94, 62))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(152, 138, 120))
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(640, 16, 640), Enum.Material.Grass)
	terrain:FillCylinder(CFrame.new(0, -2, 0), 4, 30, Enum.Material.Cobblestone)
	for _, target in ipairs({ World.HAYSTACK, World.MERCHANT, World.YARD, World.BARN }) do
		local dir = Vector3.new(target.X, 0, target.Z).Unit
		local from, to = dir * 28 + Vector3.new(0, -2, 0), target - dir * 20 + Vector3.new(0, -2, 0)
		terrain:FillBlock(CFrame.lookAt((from + to) / 2, to), Vector3.new(7, 4, (to - from).Magnitude), Enum.Material.Ground)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 16) -- faces north, towards the haystack
	spawn.Color = Color3.fromRGB(196, 150, 92)
	spawn.Material = Enum.Material.WoodPlanks
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = workspace
end

function World.lighting()
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(86, 70, 60)
	Lighting.OutdoorAmbient = Color3.fromRGB(170, 136, 112)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 196, 146)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, old in ipairs(Lighting:GetChildren()) do
		if old:IsA("Atmosphere") or old:IsA("PostEffect") then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(255, 204, 158)
	atmosphere.Decay = Color3.fromRGB(176, 108, 78)
	atmosphere.Glare = 0.5
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 20
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.1
	grade.Contrast = 0.06
	grade.TintColor = Color3.fromRGB(255, 246, 234)
	grade.Parent = Lighting
end

local function fence(folder)
	local count, radius = 56, 200
	for i = 0, count - 1 do
		local a, b = i / count * math.pi * 2, (i + 1) / count * math.pi * 2
		local p = Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		local q = Vector3.new(math.cos(b) * radius, 0, math.sin(b) * radius)
		Build.part({ name = "Post", size = Vector3.new(1.2, 5, 1.2), cframe = CFrame.new(p + Vector3.new(0, 2.5, 0)), color = WOOD, material = "Wood", parent = folder })
		for _, h in ipairs({ 1.6, 3.4 }) do
			local mid = (p + q) / 2 + Vector3.new(0, h, 0)
			Build.part({ name = "Rail", size = Vector3.new(0.5, 0.45, (q - p).Magnitude), cframe = CFrame.lookAt(mid, q + Vector3.new(0, h, 0)), color = WOOD, material = "Wood", parent = folder })
		end
	end
end

local function trees(folder)
	local rng = Random.new(7)
	for i = 1, 40 do
		local a = i / 40 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local r = rng:NextNumber(218, 275)
		local base = CFrame.new(math.cos(a) * r, 0, math.sin(a) * r)
		local height = rng:NextNumber(10, 16)
		Build.post({ name = "Trunk", color = { 96, 66, 44 }, material = "Wood", parent = folder }, base, height, 2.6)
		for _ = 1, 3 do
			local size = rng:NextNumber(10, 17)
			local offset = Vector3.new(rng:NextNumber(-4, 4), height + rng:NextNumber(0, 5), rng:NextNumber(-4, 4))
			Build.part({ name = "Leaves", shape = "Ball", size = Vector3.new(size, size, size), cframe = base * CFrame.new(offset), color = AUTUMN[rng:NextInteger(1, #AUTUMN)], material = "Grass", parent = folder })
		end
	end
end

local function plaza(folder)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local base = CFrame.new(math.cos(a) * 24, 0, math.sin(a) * 24)
		Build.post({ name = "LampPost", color = { 52, 48, 46 }, material = "Metal", parent = folder }, base, 9, 0.6)
		local lamp = Build.part({ name = "Lamp", size = Vector3.new(1.6, 1.6, 1.6), cframe = base * CFrame.new(0, 9.6, 0), color = { 255, 196, 110 }, material = "Neon", parent = folder })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 190, 120)
		light.Range = 22
		light.Brightness = 1.6
		light.Parent = lamp
	end
	local signs = { { "HAYSTACK", World.HAYSTACK }, { "MERCHANT", World.MERCHANT }, { "MACHINE YARD", World.YARD }, { "BARN", World.BARN } }
	Build.post({ name = "Signpost", color = WOOD, material = "Wood", parent = folder }, CFrame.new(0, 0, -4), 11, 1)
	for i, sign in ipairs(signs) do
		local towards = Vector3.new(sign[2].X, 0, sign[2].Z).Unit
		local cf = CFrame.lookAt(Vector3.new(0, 10.4 - i * 1.4, -4) + towards * 4.4, Vector3.new(0, 10.4 - i * 1.4, -4) + towards * 20)
		local board = Build.part({ name = sign[1], size = Vector3.new(8, 1.3, 0.35), cframe = cf, color = { 214, 184, 130 }, material = "WoodPlanks", parent = folder })
		Build.text(board, Enum.NormalId.Front, sign[1])
		Build.text(board, Enum.NormalId.Back, sign[1])
	end
end

local function merchant(folder)
	local cf = CFrame.lookAt(World.MERCHANT, Vector3.new(0, 0, World.MERCHANT.Z)) -- the counter faces the plaza
	Build.part({ name = "Counter", size = Vector3.new(12, 3.6, 3), cframe = cf * CFrame.new(0, 1.8, -3), color = { 150, 104, 60 }, material = "WoodPlanks", parent = folder })
	for _, x in ipairs({ -5.5, 5.5 }) do
		Build.part({ name = "StallPost", size = Vector3.new(0.7, 10, 0.7), cframe = cf * CFrame.new(x, 5, 2), color = WOOD, material = "Wood", parent = folder })
	end
	local awning = Build.part({ name = "Awning", size = Vector3.new(14, 0.4, 9), cframe = cf * CFrame.new(0, 10.2, -1) * CFrame.Angles(math.rad(-8), 0, 0), color = { 200, 60, 50 }, material = "Fabric", parent = folder })
	for i = 0, 6 do
		Build.part({ name = "Stripe", size = Vector3.new(1, 0.42, 9), cframe = awning.CFrame * CFrame.new(-6 + i * 2, 0, 0), color = { 246, 240, 226 }, material = "Fabric", parent = folder })
	end
	local sign = Build.part({ name = "MerchantSign", size = Vector3.new(10, 2, 0.4), cframe = cf * CFrame.new(0, 7.2, 2), color = { 246, 234, 204 }, material = "WoodPlanks", parent = folder })
	Build.text(sign, Enum.NormalId.Front, "HAY MERCHANT: straw bought here")
	-- the merchant himself
	local body = cf * CFrame.new(0, 0, 5)
	Build.part({ name = "MerchantBody", size = Vector3.new(2.4, 3.2, 1.4), cframe = body * CFrame.new(0, 3.6, 0), color = { 80, 110, 70 }, material = "Fabric", parent = folder })
	Build.part({ name = "MerchantHead", shape = "Ball", size = Vector3.new(1.8, 1.8, 1.8), cframe = body * CFrame.new(0, 6.1, 0), color = { 230, 190, 150 }, parent = folder })
	Build.part({ name = "MerchantHat", shape = "Cylinder", size = Vector3.new(0.3, 3.4, 3.4), cframe = body * CFrame.new(0, 6.9, 0) * CFrame.Angles(0, 0, math.rad(90)), color = { 112, 84, 48 }, material = "Fabric", parent = folder })
	for _, x in ipairs({ -1.9, 1.9 }) do
		Build.part({ name = "MerchantLeg", size = Vector3.new(0.9, 2, 0.9), cframe = body * CFrame.new(x * 0.4, 1, 0), color = { 60, 50, 44 }, material = "Fabric", parent = folder })
	end
	Build.part({ name = "Scales", size = Vector3.new(2, 0.3, 1.2), cframe = cf * CFrame.new(-3, 3.75, -3), color = { 200, 170, 80 }, material = "Metal", parent = folder })
	local coins = Build.part({ name = "CoinPile", shape = "Ball", size = Vector3.new(1.6, 1, 1.6), cframe = cf * CFrame.new(3, 3.9, -3), color = { 245, 200, 66 }, material = "Metal", parent = folder })
	coins.Reflectance = 0.3
end

local function yard(folder)
	local cf = CFrame.new(World.YARD)
	terrain:FillBlock(cf * CFrame.new(0, -2, 0), Vector3.new(44, 4, 34), Enum.Material.Ground)
	for _, z in ipairs({ -17, 17 }) do
		Build.part({ name = "YardRail", size = Vector3.new(44, 0.5, 0.5), cframe = cf * CFrame.new(0, 2.4, z), color = WOOD, material = "Wood", parent = folder })
	end
	local sign = Build.part({ name = "YardSign", size = Vector3.new(12, 2.2, 0.4), cframe = cf * CFrame.new(0, 7, -17) , color = { 246, 234, 204 }, material = "WoodPlanks", parent = folder })
	Build.text(sign, Enum.NormalId.Front, "MACHINE YARD: your machines work here")
	Build.text(sign, Enum.NormalId.Back, "MACHINE YARD")
	for _, x in ipairs({ -6, 6 }) do
		Build.part({ name = "SignPost", size = Vector3.new(0.6, 7, 0.6), cframe = cf * CFrame.new(x, 3.5, -17), color = WOOD, material = "Wood", parent = folder })
	end
end

local function barn(folder)
	local cf = CFrame.lookAt(World.BARN, Vector3.new(0, 0, 0)) -- the doors face the plaza
	Build.part({ name = "BarnWalls", size = Vector3.new(30, 18, 22), cframe = cf * CFrame.new(0, 9, 0), color = { 176, 52, 40 }, material = "WoodPlanks", parent = folder })
	Build.roof({ name = "BarnRoof", color = { 86, 62, 52 }, material = "Slate", parent = folder }, cf * CFrame.new(0, 18, 0) * CFrame.Angles(0, math.rad(90), 0), 32, 21.9)
	Build.part({ name = "BarnDoorFrame", size = Vector3.new(10, 12, 0.3), cframe = cf * CFrame.new(0, 6, -11.1), color = { 240, 232, 214 }, material = "WoodPlanks", parent = folder })
	Build.part({ name = "BarnDoor", size = Vector3.new(8.6, 10.6, 0.3), cframe = cf * CFrame.new(0, 5.8, -11.2), color = { 150, 42, 34 }, material = "WoodPlanks", parent = folder })
	-- the loft hatch: the way up to the Golden Loft (the client opens it once all ten achievements are done)
	local hatch = Build.part({ name = "LoftHatch", size = Vector3.new(5, 5, 0.4), cframe = cf * CFrame.new(0, 14.5, -11.2), color = { 60, 44, 30 }, material = "Wood", parent = folder })
	Build.text(hatch, Enum.NormalId.Front, "GOLDEN LOFT\n10 achievements open it", { color = Color3.fromRGB(245, 200, 66), pixels = 30 })
	local window = Build.part({ name = "LoftGlow", size = Vector3.new(4, 4, 0.2), cframe = cf * CFrame.new(0, 14.5, -11.45), color = { 255, 214, 90 }, material = "Neon", transparency = 0.6, collide = false, parent = folder })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 80)
	light.Range = 18
	light.Brightness = 0.8
	light.Parent = window
end

function World.build()
	World.lighting()
	local farm = Instance.new("Folder")
	farm.Name = "Farm"
	farm.Parent = workspace
	fence(farm)
	trees(farm)
	plaza(farm)
	merchant(farm)
	yard(farm)
	barn(farm)
end

return World
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX0001E">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0001F">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX00020">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00021">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- The always-on screen: your haystack progress at the top, your bag, coins and rates on the
-- left, the buttons for the shop and achievements, and the active boosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local Hud = {}

function Hud.mount(gui, open)
	local top = Ui.make("Frame", {
		Name = "Haystack",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(470, 86),
		BackgroundColor3 = Ui.colors.wood,
		Parent = gui,
	}, { Ui.corner(14), Ui.stroke(Ui.colors.woodDark, 3) })
	Ui.autoScale(top)
	local title = Ui.label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 4), TextColor3 = Ui.colors.hay, Parent = top }, 20)
	local countLabel = Ui.label({ Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 27), Parent = top }, 22)
	local bar = Ui.make("Frame", { Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 55), BackgroundColor3 = Ui.colors.woodDark, Parent = top }, { Ui.corner(7) })
	local fill = Ui.make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Ui.colors.hay, Parent = bar }, { Ui.corner(7) })
	local warmth = Ui.label({ Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 70), TextColor3 = Ui.colors.cream, Parent = top }, 13)

	local left = Ui.make("Frame", {
		Name = "Left",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(210, 420),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(left)
	local stats = Ui.make("Frame", { LayoutOrder = 1, Size = UDim2.fromOffset(210, 150), BackgroundColor3 = Ui.colors.wood, Parent = left }, { Ui.corner(12), Ui.stroke(Ui.colors.woodDark, 3) })
	local coinsLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 38), Position = UDim2.fromOffset(8, 6), TextColor3 = Ui.colors.hay, Parent = stats }, 34)
	local bagLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 46), Parent = stats }, 18)
	local bagBar = Ui.make("Frame", { Size = UDim2.new(1, -16, 0, 10), Position = UDim2.fromOffset(8, 70), BackgroundColor3 = Ui.colors.woodDark, Parent = stats }, { Ui.corner(5) })
	local bagFill = Ui.make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Ui.colors.green, Parent = bagBar }, { Ui.corner(5) })
	local powerLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 84), Parent = stats }, 16)
	local machineLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 104), Parent = stats }, 16)
	local bonusLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 124), Parent = stats }, 16)

	local function button(order, text, colour, onClick)
		local b = Ui.button(text, colour, { LayoutOrder = order, Size = UDim2.fromOffset(210, 48), Parent = left })
		b.Activated:Connect(onClick)
		return b
	end
	button(2, "SHOP", Ui.colors.green, function()
		open("Shop")
	end)
	local achievementsButton = button(3, "ACHIEVEMENTS", Ui.colors.blue, function()
		open("Achievements")
	end)
	button(4, "FINDS", Ui.colors.purple, function()
		open("Finds")
	end)
	local boosts = Ui.label({ LayoutOrder = 5, Size = UDim2.fromOffset(210, 60), TextColor3 = Ui.colors.hay, TextYAlignment = Enum.TextYAlignment.Top, Parent = left }, 15)

	local function refresh()
		local searched, total = player:GetAttribute("Searched") or 0, Config.TotalStraws
		local inLoft = player:GetAttribute("InLoft") == true
		if inLoft then
			searched, total = player:GetAttribute("LoftSearched") or 0, Config.Loft.straws
			title.Text = "THE GOLDEN LOFT: " .. (player:GetAttribute("GoldenNeedles") or 0) .. " golden needle(s) found"
		else
			title.Text = "YOUR HAYSTACK: " .. (player:GetAttribute("Needles") or 0) .. " needle(s) found"
		end
		countLabel.Text = Format.commas(total - searched) .. " straws left. 1 needle."
		fill.Size = UDim2.fromScale(math.clamp(searched / total, 0, 1), 1)
		local w = player:GetAttribute("Warmth")
		warmth.Text = if (player:GetAttribute("Tool") or 1) >= Config.DetectorLevel and w then
			"Needle Detector: " .. (if w >= 0.99 then "IT'S IN THE NEXT HANDFUL!" elseif w > 0.7 then "HOT" elseif w > 0.3 then "warm" else "cold")
		else ""
		coinsLabel.Text = Format.short(player:GetAttribute("Coins") or 0) .. " coins"
		local size = Economy.bag(player:GetAttribute("Bag") or 1).size
		local carried = (player:GetAttribute("BagStraw") or 0) + (player:GetAttribute("BagGolden") or 0)
		bagLabel.Text = "Bag: " .. Format.commas(carried) .. " / " .. Format.commas(size) .. (if carried >= size then " FULL!" else "")
		bagFill.Size = UDim2.fromScale(math.clamp(carried / size, 0, 1), 1)
		bagFill.BackgroundColor3 = if carried >= size then Ui.colors.red else Ui.colors.green
		powerLabel.Text = (player:GetAttribute("Power") or 1) .. " straws a search"
		machineLabel.Text = "Machines: " .. string.format("%.2g", player:GetAttribute("MachineRate") or 0) .. " a second"
		bonusLabel.Text = "Coin bonus: x" .. string.format("%.2f", player:GetAttribute("Multiplier") or 1)
		achievementsButton.Text = "ACHIEVEMENTS " .. (player:GetAttribute("Achievements") or 0) .. "/" .. #Config.Achievements
		local lines, now = {}, os.time()
		for name, label in pairs({ SpeedBoost = "2x speed", CoinBoost = "2x coins", LuckyCharm = "Lucky charm" }) do
			local until_ = player:GetAttribute("Boost_" .. name) or 0
			if until_ > now then
				table.insert(lines, label .. ": " .. math.ceil((until_ - now) / 60) .. " min left")
			end
		end
		local whistles = player:GetAttribute("Whistles") or 0
		if whistles > 0 then
			table.insert(lines, "Merchant's Whistles: " .. whistles)
		end
		boosts.Text = table.concat(lines, "\n")
	end

	player.AttributeChanged:Connect(refresh)
	task.spawn(function()
		while true do
			refresh()
			task.wait(5) -- the boost timers count down
		end
	end)
	return { refresh = refresh }
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX00022">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[-- The player's side of the game: builds the UI, listens to the farm, turns clicks with your
-- fork into searches, and offers SELL at the merchant and the climb into the Golden Loft.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Ui = require(script.Parent:WaitForChild("Ui"))
local Notify = require(script.Parent:WaitForChild("Notify"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Panels = require(script.Parent:WaitForChild("Panels"))
local WorldFx = require(script.Parent:WaitForChild("WorldFx"))

local player = Players.LocalPlayer
local gui = Ui.make("ScreenGui", { Name = "HaystackUi", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

Notify.mount(gui)
local panels = Panels.mount(gui, Notify)
Hud.mount(gui, panels.open)
WorldFx.start()

local function ask(remote, ...)
	local ok, success, message = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		return false, "The farm didn't answer. Try again."
	end
	return success, message
end

-- The action button at the bottom: SELL at the merchant, CLIMB at the loft hatch, whistle anywhere.
local action = Ui.button("", Ui.colors.green, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100), Size = UDim2.fromOffset(300, 54), Visible = false, Parent = gui })
Ui.autoScale(action)
local actionKind = nil
action.Activated:Connect(function()
	if actionKind == "sell" then
		local ok, message = ask(Remotes.Sell)
		Notify.toast(message, ok and Ui.colors.green or Ui.colors.red)
	elseif actionKind == "loft" then
		local ok, message = ask(Remotes.Loft, "up")
		Notify.toast(message, ok and Ui.colors.purple or Ui.colors.red)
	elseif actionKind == "down" then
		local _, message = ask(Remotes.Loft, "down")
		Notify.toast(message, Ui.colors.wood)
	elseif actionKind == "whistle" then
		local ok, message = ask(Remotes.Whistle)
		Notify.toast(message, ok and Ui.colors.green or Ui.colors.red)
	end
end)

local MERCHANT, BARN, LOFT_PAD = Vector3.new(74, 0, 10), Vector3.new(0, 0, 96), Vector3.new(0, 130, 132)
local function flat(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end
task.spawn(function()
	while true do
		task.wait(0.25)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local kind, text, colour = nil, "", Ui.colors.green
		if root then
			local inLoft = root.Position.Y > 100
			player:SetAttribute("InLoft", inLoft)
			local carried = (player:GetAttribute("BagStraw") or 0) + (player:GetAttribute("BagGolden") or 0)
			if not inLoft and flat(root.Position, MERCHANT) <= Config.MerchantRange then
				kind, text = "sell", "SELL " .. Format.commas(carried) .. " STRAW"
			elseif not inLoft and flat(root.Position, BARN + Vector3.new(0, 0, -14)) <= 9 and root.Position.Z < BARN.Z then
				kind, text, colour = "loft", (if player:GetAttribute("LoftOpen") then "CLIMB INTO THE GOLDEN LOFT" else "LOFT LOCKED: 10 ACHIEVEMENTS"), Ui.colors.purple
			elseif inLoft and flat(root.Position, LOFT_PAD) <= 6 then
				kind, text, colour = "down", "GO BACK DOWN", Ui.colors.wood
			elseif (player:GetAttribute("Whistles") or 0) > 0 and carried > 0 then
				kind, text, colour = "whistle", "WHISTLE: SELL HERE (" .. player:GetAttribute("Whistles") .. " left)", Ui.colors.blue
			end
		end
		actionKind = kind
		action.Visible = kind ~= nil
		action.Text, action.BackgroundColor3 = text, colour
	end
end)

Remotes.SearchFx.OnClientEvent:Connect(function(message)
	if message.kind == "search" then
		WorldFx.searched(message)
		if message.warmth then
			player:SetAttribute("Warmth", message.warmth)
		end
		if message.full then
			Notify.toast("Your bag is full! Sell it to the merchant.", Ui.colors.red)
		end
	elseif message.kind == "full" then
		Notify.toast("Your bag is full! Sell it to the merchant (or buy a bigger bag).", Ui.colors.red)
	elseif message.kind == "sold" then
		Notify.toast("Sold " .. Format.commas(message.straws) .. " straw for " .. Format.short(message.coins) .. " coins" .. (if message.reason == "auto" then " (Auto Sell)" else ""), Ui.colors.green)
	elseif message.kind == "find" then
		panels.addFind(message.name, message.story)
		Notify.banner("LUCKY FIND: " .. message.name, message.story .. "\nThe merchant pays " .. Format.short(message.coins) .. " coins for it.", 6)
	end
end)

Remotes.Announce.OnClientEvent:Connect(function(message)
	if message.kind == "needle" then
		local me = message.finderId == player.UserId
		if me then
			WorldFx.celebrate(message.golden)
			Notify.banner(if message.golden then "YOU FOUND THE GOLDEN NEEDLE!" else "YOU FOUND THE NEEDLE!",
				"You earned " .. Format.short(message.prize) .. " coins" .. (if message.golden then "." else " and +20% coins forever. A new needle is now hidden in a fresh haystack."), 12)
		else
			Notify.toast(message.finder .. " found " .. (if message.golden then "a golden needle!" else "their needle!"), Ui.colors.hay)
		end
	elseif message.kind == "loft" then
		Notify.toast(message.finder .. " unlocked the Golden Loft!", Ui.colors.purple)
	elseif message.kind == "notice" then
		Notify.toast(message.text, Ui.colors.wood)
	end
end)

Remotes.Achievement.OnClientEvent:Connect(function(a)
	Notify.banner("ACHIEVEMENT: " .. a.name, a.text .. "\n" .. a.done .. " of " .. a.total .. " done." .. (if a.done >= a.total then " The Golden Loft is open!" else ""), 7)
end)

-- Clicking (or tapping) with your search tool asks the server to search.
local hooked = setmetatable({}, { __mode = "k" })
local lastSwing = 0
local function hookTool(tool)
	if hooked[tool] or not tool:IsA("Tool") or tool:GetAttribute("Level") == nil then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		Remotes.Search:FireServer()
		if os.clock() - lastSwing > 0.35 then
			lastSwing = os.clock()
			local swing = Instance.new("StringValue") -- the default Animate script plays a swing for this
			swing.Name = "toolanim"
			swing.Value = "Slash"
			swing.Parent = tool
			Debris:AddItem(swing, 0.5)
		end
	end)
end

local backpackConnection = nil
local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local backpack = player:WaitForChild("Backpack")
	local equipped = false
	local function arrive(tool)
		hookTool(tool)
		if not equipped and tool:IsA("Tool") and tool:GetAttribute("Level") ~= nil then
			equipped = true
			task.defer(function()
				if humanoid.Parent and tool.Parent == backpack then
					humanoid:EquipTool(tool)
				end
			end)
		end
	end
	if backpackConnection then
		backpackConnection:Disconnect()
	end
	backpackConnection = backpack.ChildAdded:Connect(arrive)
	for _, tool in ipairs(backpack:GetChildren()) do
		arrive(tool)
	end
	character.ChildAdded:Connect(hookTool)
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

task.delay(2, function()
	Notify.banner(
		"Welcome to " .. Config.FarmName .. "!",
		"A needle is hidden somewhere in " .. Format.commas(Config.TotalStraws) .. " straws. Walk to the haystack and click with your fork to search. "
			.. "Sell your straw to the merchant, buy better tools and machines, and finish all ten achievements to open the Golden Loft.",
		12
	)
end)
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00023">
					<Properties>
						<string name="Name">Notify</string>
						<ProtectedString name="Source"><![CDATA[-- Messages: small toasts under the haystack counter, and a big banner for case news.
local Ui = require(script.Parent.Ui)

local Notify = {}
local stack, banner, bannerTitle, bannerBody
local order = 0
local bannerToken = 0

function Notify.mount(gui)
	stack = Ui.make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.fromOffset(460, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(stack)

	banner = Ui.make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Ui.colors.wood,
		Visible = false,
		Parent = gui,
	}, {
		Ui.corner(18),
		Ui.stroke(Ui.colors.hay, 4),
		Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }),
	})
	Ui.autoScale(banner)
	bannerTitle = Ui.paragraph("", { LayoutOrder = 1, Font = Ui.font, TextSize = 34, TextColor3 = Ui.colors.hay, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	bannerBody = Ui.paragraph("", { LayoutOrder = 2, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	banner.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			banner.Visible = false
		end
	end)
end

function Notify.toast(text, colour)
	if not stack then
		return
	end
	order += 1
	local card = Ui.make("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = colour or Ui.colors.wood,
		Parent = stack,
	}, {
		Ui.corner(12),
		Ui.stroke(Ui.colors.woodDark, 2),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
	})
	Ui.paragraph(text, { Font = Ui.font, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local cards = {}
	for _, child in ipairs(stack:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	if #cards > 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
	task.delay(4, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Notify.banner(title, body, seconds)
	if not banner then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerBody.Text = body
	banner.Visible = true
	task.delay(seconds or 6, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

return Notify
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00024">
					<Properties>
						<string name="Name">Panels</string>
						<ProtectedString name="Source"><![CDATA[-- The Achievements window and the Finds notebook (the story bits your lucky finds revealed).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)
local Shop = require(script.Parent.Shop)

local Panels = {}

function Panels.mount(gui, notify)
	local windows, refreshers = {}, {}
	windows.Shop = Shop.mount(gui, notify)
	refreshers.Shop = Shop.refresh

	-- Achievements
	local achievements, achievementsBody = Ui.window(gui, "Achievements")
	windows.Achievements = achievements
	local header = Ui.paragraph("", { LayoutOrder = 0, Font = Ui.font, TextSize = 22, Parent = achievementsBody })
	local rows = {}
	for i, a in ipairs(Config.Achievements) do
		local frame = Ui.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = Ui.colors.paper, Parent = achievementsBody }, { Ui.corner(10) })
		local name = Ui.label({ Text = a.name, Size = UDim2.new(0.68, -12, 0, 28), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = frame }, 22)
		Ui.label({ Text = a.text, Size = UDim2.new(0.68, -12, 0, 24), Position = UDim2.fromOffset(12, 34), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = frame }, 15)
		local state = Ui.label({ Size = UDim2.new(0.3, -12, 1, -12), Position = UDim2.new(0.7, 0, 0, 6), TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = frame }, 18)
		rows[a.id] = { frame = frame, name = name, state = state }
	end
	Ui.paragraph("Complete all ten to open the Golden Loft above the barn.", { LayoutOrder = 99, TextColor3 = Ui.colors.purple, Font = Ui.font, TextSize = 20, Parent = achievementsBody })
	refreshers.Achievements = function()
		task.spawn(function()
			local ok, list = pcall(function()
				return Remotes.GetAchievements:InvokeServer()
			end)
			if not ok or type(list) ~= "table" then
				return
			end
			local done = 0
			for _, a in ipairs(list) do
				local r = rows[a.id]
				if r then
					if a.done then
						done += 1
						r.state.Text, r.state.TextColor3 = "DONE", Ui.colors.green
						r.frame.BackgroundColor3 = Color3.fromRGB(226, 244, 220)
					else
						r.state.Text = Format.short(math.min(a.value, a.goal)) .. " / " .. Format.short(a.goal)
						r.state.TextColor3 = Ui.colors.grey
					end
				end
			end
			header.Text = done .. " of " .. #list .. " achievements done"
		end)
	end

	-- Finds notebook
	local finds, findsBody = Ui.window(gui, "Finds")
	windows.Finds = finds
	local found = {}
	Ui.paragraph("Odd things turn up in the hay. The merchant pays for them, and each one tells a bit of the story.", { LayoutOrder = 0, TextColor3 = Ui.colors.grey, Parent = findsBody })
	local empty = Ui.paragraph("Nothing found yet. Keep searching!", { LayoutOrder = 1, Parent = findsBody })
	refreshers.Finds = function() end

	local function open(name)
		for key, frame in pairs(windows) do
			if key == name then
				frame.Visible = not frame.Visible
				if frame.Visible then
					refreshers[key]()
				end
			else
				frame.Visible = false
			end
		end
	end

	local panels = { open = open }
	function panels.addFind(name, story)
		if found[name] then
			return
		end
		found[name] = true
		empty.Visible = false
		local n = 0
		for _ in pairs(found) do
			n += 1
		end
		Ui.paragraph("You found " .. name .. ". " .. story, { LayoutOrder = n + 1, TextColor3 = Ui.colors.blue, Parent = findsBody })
	end
	return panels
end

return Panels
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00025">
					<Properties>
						<string name="Name">Shop</string>
						<ProtectedString name="Source"><![CDATA[-- The Shop window: tabs for Tools, Bags, Machines, Perks (coins) and Robux.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local ROBUX = {
	{ kind = "product", key = "SpeedBoost", title = "2x Speed (1 hour)", text = "Every search takes twice the straws." },
	{ kind = "product", key = "CoinBoost", title = "2x Coins (1 hour)", text = "The merchant pays double." },
	{ kind = "product", key = "LuckyCharm", title = "Lucky Charm (1 hour)", text = "5x the chance of a lucky find." },
	{ kind = "product", key = "StrawBlast", title = "Straw Blast", text = "Search 100,000 straws at once." },
	{ kind = "product", key = "MerchantWhistle", title = "Merchant's Whistle x10", text = "Sell your bag anywhere, ten times." },
	{ kind = "pass", key = "AutoSell", title = "Auto Sell", text = "Your bag sells itself when it fills up." },
	{ kind = "pass", key = "DoubleMachines", title = "Double Machines", text = "Every machine works twice as fast." },
	{ kind = "pass", key = "VIP", title = "VIP", text = "+25% coins, and machines keep working for an hour after you leave." },
}

local Shop = {}

local function ask(remote, ...)
	local ok, success, message = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		return false, "The farm didn't answer. Try again."
	end
	return success, message
end

-- One line in the shop: a name, a description and a button.
local function row(parent, order, name, text, colour)
	local frame = Ui.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 66), BackgroundColor3 = colour or Ui.colors.paper, Parent = parent }, { Ui.corner(10) })
	Ui.label({ Text = name, Size = UDim2.new(0.6, -12, 0, 30), Position = UDim2.fromOffset(12, 5), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = frame }, 24)
	local sub = Ui.label({ Text = text, Size = UDim2.new(0.6, -12, 0, 24), Position = UDim2.fromOffset(12, 37), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = frame }, 15)
	local button = Ui.button("", Ui.colors.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.37, 0, 0, 48), Parent = frame })
	return button, sub
end

local function priceButton(button, price, owned, next_)
	local coins = player:GetAttribute("Coins") or 0
	if owned then
		button.Text, button.BackgroundColor3 = "OWNED", Ui.colors.grey
	elseif not next_ then
		button.Text, button.BackgroundColor3 = "LOCKED", Ui.colors.grey
	else
		button.Text = "BUY " .. Format.short(price)
		button.BackgroundColor3 = if coins >= price then Ui.colors.green else Ui.colors.red
	end
end

function Shop.mount(gui, notify)
	local frame, body = Ui.window(gui, "Shop")
	frame.Size = UDim2.fromOffset(600, 520)
	local tabs = Ui.make("Frame", { Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 64), BackgroundTransparency = 1, Parent = frame }, { Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	body.Position = UDim2.fromOffset(12, 110)
	body.Size = UDim2.new(1, -24, 1, -118)
	local pages, refreshers, buttons = {}, {}, {}

	local function buy(kind, index)
		local ok, message = ask(Remotes.Buy, kind, index)
		notify.toast(message, ok and Ui.colors.green or Ui.colors.red)
		Shop.refresh()
	end

	local function page(name, colour, build)
		local list = Ui.make("Frame", { Name = name, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, Parent = body }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
		pages[name] = list
		refreshers[name] = build(list)
		local tab = Ui.button(name, colour, { LayoutOrder = #buttons + 1, Size = UDim2.new(0.19, 0, 1, 0), Parent = tabs })
		table.insert(buttons, tab)
		tab.Activated:Connect(function()
			for key, p in pairs(pages) do
				p.Visible = key == name
			end
			Shop.refresh()
		end)
	end

	page("Tools", Ui.colors.green, function(list)
		local rows = {}
		for level, tool in ipairs(Config.Tools) do
			rows[level] = row(list, level, tool.name, tool.power .. " straws a search")
			rows[level].Activated:Connect(function()
				buy("tool", level)
			end)
		end
		return function()
			local owned = player:GetAttribute("Tool") or 1
			for level, button in ipairs(rows) do
				priceButton(button, Config.Tools[level].price, level <= owned, level == owned + 1)
			end
		end
	end)

	page("Bags", Ui.colors.blue, function(list)
		local rows = {}
		for level, bag in ipairs(Config.Bags) do
			rows[level] = row(list, level, bag.name, "holds " .. Format.commas(bag.size) .. " straws")
			rows[level].Activated:Connect(function()
				buy("bag", level)
			end)
		end
		return function()
			local owned = player:GetAttribute("Bag") or 1
			for level, button in ipairs(rows) do
				priceButton(button, Config.Bags[level].price, level <= owned, level == owned + 1)
			end
		end
	end)

	page("Machines", Ui.colors.wood, function(list)
		local rows, subs = {}, {}
		for i, m in ipairs(Config.Machines) do
			rows[i], subs[i] = row(list, i, m.name, "")
			rows[i].Activated:Connect(function()
				buy("machine", i)
			end)
		end
		return function()
			for i, m in ipairs(Config.Machines) do
				local owned = player:GetAttribute("Machine_" .. i) or 0
				subs[i].Text = "+" .. m.rate .. " straws a second each. You own " .. owned .. " of " .. m.max .. "."
				priceButton(rows[i], Economy.machinePrice(i, owned), owned >= m.max, owned < m.max)
				if owned >= m.max then
					rows[i].Text = "MAXED"
				end
			end
		end
	end)

	page("Perks", Ui.colors.purple, function(list)
		local rows, subs = {}, {}
		for i, perk in ipairs(Config.Perks) do
			rows[i], subs[i] = row(list, i, perk.name, perk.text)
			rows[i].Activated:Connect(function()
				buy("perk", i)
			end)
		end
		local note = Ui.paragraph("Perks belong to the tool you hold. A new tool starts with none.", { LayoutOrder = 9, TextColor3 = Ui.colors.grey, Parent = list })
		return function()
			local d = { tool = player:GetAttribute("Tool") or 1, perks = {} }
			for _, perk in ipairs(Config.Perks) do
				d.perks[perk.id] = player:GetAttribute("Perk_" .. perk.id) or 0
			end
			for i, perk in ipairs(Config.Perks) do
				local level = d.perks[perk.id]
				subs[i].Text = perk.text .. ". Level " .. level .. "/" .. perk.levels .. " on your " .. Economy.tool(d.tool).name .. "."
				priceButton(rows[i], Economy.perkPrice(d, i), level >= perk.levels, level < perk.levels)
				if level >= perk.levels then
					rows[i].Text = "MAXED"
				end
			end
			note.Visible = true
		end
	end)

	page("Robux", Ui.colors.red, function(list)
		local any = false
		for order, item in ipairs(ROBUX) do
			local id = if item.kind == "pass" then Config.GamePasses[item.key] else Config.Products[item.key]
			if id and id ~= 0 then
				any = true
				local button = row(list, order, item.title, item.text, Color3.fromRGB(226, 236, 250))
				button.Text, button.BackgroundColor3 = "ROBUX", Ui.colors.blue
				button.Activated:Connect(function()
					if item.kind == "pass" then
						MarketplaceService:PromptGamePassPurchase(player, id)
					else
						MarketplaceService:PromptProductPurchase(player, id)
					end
				end)
			end
		end
		if not any then
			Ui.paragraph("Robux items appear here once the game is published and the items are created.", { TextColor3 = Ui.colors.grey, Parent = list })
		end
		return function() end
	end)

	pages.Tools.Visible = true

	function Shop.refresh()
		if not frame.Visible then
			return
		end
		for name, p in pairs(pages) do
			if p.Visible then
				refreshers[name]()
			end
		end
	end
	player.AttributeChanged:Connect(Shop.refresh)
	return frame
end

return Shop
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00026">
					<Properties>
						<string name="Name">Ui</string>
						<ProtectedString name="Source"><![CDATA[-- A small UI kit: the farm colours, rounded wooden buttons and windows that scale with
-- the screen (phones get a smaller UI, big monitors a larger one).
local Ui = {}

Ui.colors = {
	wood = Color3.fromRGB(110, 70, 40),
	woodDark = Color3.fromRGB(62, 38, 22),
	hay = Color3.fromRGB(242, 196, 82),
	cream = Color3.fromRGB(255, 244, 222),
	paper = Color3.fromRGB(246, 232, 200),
	red = Color3.fromRGB(200, 64, 48),
	green = Color3.fromRGB(84, 166, 70),
	blue = Color3.fromRGB(64, 136, 206),
	purple = Color3.fromRGB(136, 92, 196),
	grey = Color3.fromRGB(128, 120, 112),
	ink = Color3.fromRGB(56, 36, 20),
	white = Color3.new(1, 1, 1),
}
Ui.font = Enum.Font.FredokaOne
Ui.body = Enum.Font.GothamMedium

local camera = workspace.CurrentCamera or workspace:WaitForChild("Camera")
local scales = {}

local function screenScale()
	return math.clamp(camera.ViewportSize.Y / 760, 0.55, 1.15)
end

camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	for _, scale in ipairs(scales) do
		scale.Scale = screenScale()
	end
end)

-- Instance.new with properties and children; Parent is set last.
function Ui.make(className, props, children)
	local instance = Instance.new(className)
	for name, value in pairs(props) do
		if name ~= "Parent" then
			instance[name] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.corner(radius)
	return Ui.make("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(color, thickness)
	return Ui.make("UIStroke", { Color = color or Ui.colors.woodDark, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Ui.maxText(size)
	return Ui.make("UITextSizeConstraint", { MaxTextSize = size })
end

-- Scales `frame` (around its AnchorPoint) with the screen height.
function Ui.autoScale(frame)
	local scale = Ui.make("UIScale", { Scale = screenScale(), Parent = frame })
	table.insert(scales, scale)
	return scale
end

-- A text label. `maxSize` caps the scaled text size.
function Ui.label(props, maxSize)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.font,
		Text = "",
		TextColor3 = Ui.colors.white,
		TextScaled = true,
		TextWrapped = true,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.35,
	}
	for name, value in pairs(props) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults, { Ui.maxText(maxSize or 40) })
end

function Ui.button(text, color, props)
	local defaults = {
		Text = text,
		Font = Ui.font,
		TextScaled = true,
		TextColor3 = Ui.colors.white,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.4,
		BackgroundColor3 = color,
		AutoButtonColor = true,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextButton", defaults, {
		Ui.corner(10),
		Ui.stroke(Ui.colors.woodDark, 3),
		Ui.maxText(28),
		Ui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
end

-- A centred window with a title and a close button. Returns frame, body (a scrolling list).
function Ui.window(parent, title, onClose)
	local frame = Ui.make("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 480),
		BackgroundColor3 = Ui.colors.cream,
		Visible = false,
		Parent = parent,
	}, { Ui.corner(18), Ui.stroke(Ui.colors.wood, 5) })
	Ui.autoScale(frame)
	Ui.make("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Ui.colors.wood, Parent = frame }, { Ui.corner(16) })
	Ui.label({ Text = title, Size = UDim2.new(1, -120, 0, 46), Position = UDim2.fromOffset(20, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame }, 34)
	local close = Ui.button("X", Ui.colors.red, { Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -56, 0, 8), Parent = frame })
	close.Activated:Connect(function()
		frame.Visible = false
		if onClose then
			onClose()
		end
	end)
	local body = Ui.make("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.new(1, -24, 1, -76),
		Position = UDim2.fromOffset(12, 68),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Ui.colors.wood,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, {
		Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})
	return frame, body
end

-- Paragraph text that grows to fit, for lists inside windows.
function Ui.paragraph(text, props)
	local defaults = {
		Text = text,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Ui.body,
		TextSize = 19,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.colors.ink,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults)
end

return Ui
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00027">
					<Properties>
						<string name="Name">WorldFx</string>
						<ProtectedString name="Source"><![CDATA[-- What you see in the world: labels over the haystacks and the merchant, straw bursts and
-- floating text when you search, your own machines in the yard, and the loft hatch.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local WorldFx = {}
local mounds = {} -- "hay" | "gold" -> { core, attachment, emitter }
local yard = nil

local function billboard(adornee, size, offset, lines)
	local gui = Ui.make("BillboardGui", { Adornee = adornee, Size = size, StudsOffset = offset, MaxDistance = 400, LightInfluence = 0, ResetOnSpawn = false, Parent = playerGui })
	local out = {}
	local y = 0
	for _, line in ipairs(lines) do
		out[line.key] = Ui.label({ Text = line.text or "", Size = UDim2.fromScale(1, line.h), Position = UDim2.fromScale(0, y), TextColor3 = line.color or Ui.colors.white, Parent = gui }, line.max or 60)
		y += line.h
	end
	return gui, out
end

local function tagMound(model, key, title)
	local core = model:WaitForChild("Core")
	local attachment = Ui.make("Attachment", { Name = "StrawFx", Position = Vector3.new(0, core.Size.Y * 0.4, 0), Parent = core })
	local emitter = Ui.make("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(16, 30),
		SpreadAngle = Vector2.new(70, 70),
		Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new(0.8, 0.2),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-200, 200),
		Color = ColorSequence.new(if key == "gold" then Color3.fromRGB(255, 220, 90) else Color3.fromRGB(242, 212, 120)),
		LightEmission = if key == "gold" then 0.6 else 0.15,
		EmissionDirection = Enum.NormalId.Top,
		Parent = attachment,
	})
	billboard(core, UDim2.fromScale(22, 5), Vector3.new(0, core.Size.Y * 0.5 + 10, 0), {
		{ key = "title", text = title, h = 0.5, color = if key == "gold" then Ui.colors.hay else Ui.colors.white },
		{ key = "sub", text = "Hold your fork and click to search", h = 0.5, color = Ui.colors.cream, max = 44 },
	})
	mounds[key] = { core = core, attachment = attachment, emitter = emitter }
end

local function floatText(core, text, colour)
	local gui = Ui.make("BillboardGui", { Adornee = core, Size = UDim2.fromScale(12, 2.5), StudsOffset = Vector3.new(math.random(-6, 6), core.Size.Y * 0.5 + 2, 0), LightInfluence = 0, AlwaysOnTop = true, ResetOnSpawn = false, Parent = playerGui })
	local label = Ui.label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = colour, Parent = gui }, 60)
	TweenService:Create(gui, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = gui.StudsOffset + Vector3.new(0, 5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(gui, 1.1)
end

function WorldFx.searched(message)
	local m = mounds[message.where or "hay"]
	if not m then
		return
	end
	m.emitter:Emit(math.clamp(4 + math.floor(message.straws / 2), 4, 24))
	floatText(m.core, "+" .. Format.commas(message.straws) .. (if message.where == "gold" then " golden straw" else " straw"), Ui.colors.hay)
end

function WorldFx.celebrate(golden)
	local m = mounds[if golden then "gold" else "hay"]
	if m then
		m.emitter:Emit(120)
		floatText(m.core, if golden then "GOLDEN NEEDLE!" else "NEEDLE FOUND!", Color3.fromRGB(140, 255, 140))
	end
end

-- Your machines, shown in the yard: one small model per machine you own (only you see them).
local function refreshYard()
	if not yard then
		return
	end
	yard:ClearAllChildren()
	local origin = workspace:FindFirstChild("Farm") and workspace.Farm:FindFirstChild("YardSign")
	local base = if origin then origin.Position - Vector3.new(0, 7, -17) + Vector3.new(0, 0, 4) else nil
	if not base then
		return
	end
	local n = 0
	for i, m in ipairs(Config.Machines) do
		for _ = 1, player:GetAttribute("Machine_" .. i) or 0 do
			local col, rowi = n % 8, math.floor(n / 8)
			local cf = CFrame.new(base + Vector3.new(-17.5 + col * 5, 0, 2 + rowi * 6))
			local body = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = Vector3.new(3, 2.4 + i * 0.4, 3), CFrame = cf * CFrame.new(0, 1.2 + i * 0.2, 0), Color = Color3.fromRGB(m.color[1], m.color[2], m.color[3]), Material = Enum.Material.Metal, Parent = yard })
			local wheel = Ui.make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 2.2, 2.2), CFrame = cf * CFrame.new(0, 2.6 + i * 0.4, -1.6) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(80, 70, 60), Material = Enum.Material.Wood, Parent = yard })
			Ui.make("UIScale", { Parent = body }) -- harmless marker so the model reads as "machine"
			TweenService:Create(wheel, TweenInfo.new(2 - i * 0.2, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { CFrame = wheel.CFrame * CFrame.Angles(math.rad(180), 0, 0) }):Play()
			if n == 0 then
				billboard(body, UDim2.fromScale(14, 3), Vector3.new(0, 5, 0), { { key = "t", text = "Your machines", h = 1, color = Ui.colors.hay } })
			end
			n += 1
		end
	end
end

local function tagMerchant()
	local farm = workspace:WaitForChild("Farm", 60)
	local head = farm and farm:WaitForChild("MerchantHead", 30)
	if head then
		billboard(head, UDim2.fromScale(16, 4), Vector3.new(0, 4, 0), {
			{ key = "t", text = "Hay Merchant", h = 0.5, color = Ui.colors.hay },
			{ key = "s", text = "Walk up and press SELL", h = 0.5, color = Ui.colors.cream, max = 44 },
		})
	end
end

local function tagHatch()
	local farm = workspace:WaitForChild("Farm", 60)
	local hatch = farm and farm:WaitForChild("LoftHatch", 30)
	if hatch then
		local _, labels = billboard(hatch, UDim2.fromScale(16, 4), Vector3.new(0, 5, 0), {
			{ key = "t", text = "The Golden Loft", h = 0.5, color = Ui.colors.hay },
			{ key = "s", text = "", h = 0.5, color = Ui.colors.cream, max = 44 },
		})
		local function refresh()
			labels.s.Text = if player:GetAttribute("LoftOpen") then "Walk up to climb in" else "Locked: finish all 10 achievements"
		end
		player:GetAttributeChangedSignal("LoftOpen"):Connect(refresh)
		refresh()
	end
end

function WorldFx.start()
	task.spawn(function()
		local folder = workspace:WaitForChild("Haystacks", 60)
		if folder then
			tagMound(folder:WaitForChild("Haystack", 30), "hay", "THE HAYSTACK: " .. Format.commas(Config.TotalStraws) .. " straws, 1 needle")
			tagMound(folder:WaitForChild("GoldenHaystack", 30), "gold", "THE GOLDEN HAYSTACK: golden straw pays 20x")
		end
	end)
	task.spawn(tagMerchant)
	task.spawn(tagHatch)
	yard = Instance.new("Folder")
	yard.Name = "MyMachines"
	yard.Parent = workspace
	task.spawn(function()
		workspace:WaitForChild("Farm", 60)
		task.wait(1)
		refreshYard()
		for i in ipairs(Config.Machines) do
			player:GetAttributeChangedSignal("Machine_" .. i):Connect(refreshYard)
		end
	end)
end

return WorldFx
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
