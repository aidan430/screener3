			<Item class="ModuleScript" referent="RBX00008">
				<Properties>
					<string name="Name">Format</string>
					<ProtectedString name="Source"><![CDATA[-- Number formatting for the UI. Plain Luau: no Roblox services.
local Format = {}

-- 5000000 -> "5,000,000"
function Format.commas(n)
	local digits = string.format("%.0f", math.floor(math.abs(n)))
	local grouped = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")))
	if string.sub(grouped, 1, 1) == "," then
		grouped = string.sub(grouped, 2)
	end
	if n < 0 then
		return "-" .. grouped
	end
	return grouped
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

local function fixed(value)
	if value >= 100 then
		return string.format("%.0f", value)
	elseif value >= 10 then
		return string.format("%.1f", value)
	end
	return string.format("%.2f", value)
end

-- 1234 -> "1.23K", 5000000 -> "5M", 950 -> "950"
function Format.short(n)
	local value = math.abs(n)
	if value < 1000 then
		return tostring(math.floor(n))
	end
	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text = fixed(value)
	if tonumber(text) >= 1000 and index < #SUFFIXES then -- 999.96K rounds up: show 1M
		value /= 1000
		index += 1
		text = fixed(value)
	end
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return (if n < 0 then "-" else "") .. text .. SUFFIXES[index]
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00009">
				<Properties>
					<string name="Name">HayLook</string>
					<ProtectedString name="Source"><![CDATA[-- One look for every loose bit of hay (on tools, in buckets and baskets, flying, dropped
-- bundles, the mounds round the heap): the imported hay model (Config.HayModel, which the
-- server shares as ReplicatedStorage.HayTemplate), else a mesh from Config.HayMesh, else a
-- rounded ball of the Grass material (which wears the hay texture if one is set).
-- Plain module: works on the server and the client.
return function(Config)
	local HayLook = {}
	local HAY = Color3.fromRGB(Config.HeapColour[1], Config.HeapColour[2], Config.HeapColour[3])
	local GOLD = Color3.fromRGB(255, 214, 90)

	-- A hay lump `size` studs across, `golden` for the Golden Loft's straw.
	function HayLook.lump(size, golden)
		local template = game:GetService("ReplicatedStorage"):FindFirstChild("HayTemplate")
		if template then
			local hay = template:Clone()
			hay.Name = "Hay"
			hay.Anchored, hay.CanCollide, hay.CanQuery, hay.CanTouch, hay.CastShadow = false, false, false, false, false
			hay:SetAttribute("BaseSize", template.Size)
			HayLook.resize(hay, size)
			return hay
		end
		local part = Instance.new("Part")
		part.Name = "Hay"
		part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false
		part.Material = Enum.Material.Grass
		part.Color = if golden then GOLD else HAY
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if Config.HayMesh ~= "" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = Config.HayMesh
			mesh.TextureId = Config.HayMeshTexture
			mesh.VertexColor = if golden then Vector3.new(1.3, 1.1, 0.4) else Vector3.new(1, 1, 1)
			mesh.Parent = part
		else
			part.Shape = Enum.PartType.Ball
		end
		HayLook.resize(part, size)
		return part
	end

	-- Sets a lump's size (the model is 1 stud across, so its mesh scales with the part).
	function HayLook.resize(part, size)
		local base = part:GetAttribute("BaseSize")
		if base then -- the imported model, 1 stud across at its widest
			part.Size = base * math.max(size, 0.05)
			return
		end
		local s = Vector3.new(size, size * 0.72, size)
		part.Size = Vector3.new(math.max(s.X, 0.05), math.max(s.Y, 0.05), math.max(s.Z, 0.05))
		local mesh = part:FindFirstChildOfClass("SpecialMesh")
		if mesh then
			mesh.Scale = Vector3.new(size, size, size) -- the model is 1 x 0.69 x 1 studs
		end
	end

	return HayLook
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000A">
				<Properties>
					<string name="Name">Layout</string>
					<ProtectedString name="Source"><![CDATA[-- Where each clump sits in the heap: one cell of the 4-stud terrain grid each, in
-- Config.PileLayers layers that taper from PileRadiusBottom to a rounded top (PileDome, PileCurve), trimmed
-- at the bottom edge to exactly Config.Clumps. Always the same order (bottom to top), so a clump's
-- index means the same clump in every visit; saves refer to clumps by index.
-- Plain Luau: no Roblox services. Returns a list of { x, y, z } offsets from the heap's base centre,
-- with these extras:
--   .cell[i] = { gx, layer, gz }       .lookup(gx, layer, gz) -> index or nil
--   .shape[i] = terrain fullness 0..1 that rounds the heap's outside smoothly
--   .core[i] = how far out the clump is, 0 at the middle to 1 at the outside
--   .machineOrder = indices from the outside skin inwards (machines peel the heap evenly)
--   .needleSpots = indices deep inside the upper heap, where the needle hides
--   .origin(x, z) = the heap's base centre for a plot centre, on the terrain grid
return function(Config)
	local s = Config.ClumpSize
	local layerCount = Config.PileLayers
	local r0, r1, curve, dome = Config.PileRadiusBottom, Config.PileRadiusTop, Config.PileCurve, Config.PileDome
	local layers, radius = {}, {}
	local total = 0
	for i = 0, layerCount - 1 do
		local r = r1 + (r0 - r1) * math.max(0, 1 - (i / (layerCount - 1)) ^ dome) ^ curve
		radius[i] = r
		local n = math.floor(r / s)
		local layer = {}
		for gx = -n, n do
			for gz = -n, n do
				if (gx * s) ^ 2 + (gz * s) ^ 2 <= r * r then
					table.insert(layer, { gx, i, gz, gx * gx + gz * gz })
				end
			end
		end
		total += #layer
		layers[i + 1] = layer
	end
	-- too many: trim the outermost clumps of the lowest layers, a quarter of a layer at most
	local excess = total - Config.Clumps
	for _, layer in ipairs(layers) do
		if excess <= 0 then
			break
		end
		table.sort(layer, function(a, b)
			if a[4] ~= b[4] then
				return a[4] > b[4]
			elseif a[1] ~= b[1] then
				return a[1] < b[1]
			end
			return a[3] < b[3]
		end)
		local cut = math.min(excess, math.floor(#layer / 4))
		for _ = 1, cut do
			table.remove(layer, 1)
		end
		excess -= cut
	end
	local out = { cell = {}, shape = {}, core = {}, machineOrder = {}, needleSpots = {} }
	local grid = {}
	for _, layer in ipairs(layers) do
		table.sort(layer, function(a, b)
			if a[1] ~= b[1] then
				return a[1] < b[1]
			end
			return a[3] < b[3]
		end)
		for _, c in ipairs(layer) do
			table.insert(out, { c[1] * s, c[2] * s + s / 2, c[3] * s })
			local index = #out
			local r = radius[c[2]]
			local d = math.sqrt(c[4]) * s
			out.cell[index] = { c[1], c[2], c[3] }
			-- fullness rounds the outside smoothly, then a fixed random dent per cell makes the
			-- surface lumpy, like hay forked onto a pile, instead of a smooth dome of dirt
			local hash = bit32.bxor(c[1] * 73856093, c[2] * 19349663, c[3] * 83492791) % 1000 / 1000
			out.shape[index] = math.clamp(((r - d) / s + 0.5) * (1 - Config.HeapLumpiness * hash), 0.3, 1)
			out.core[index] = math.clamp(d / math.max(r, s), 0, 1)
			grid[c[1] .. "," .. c[2] .. "," .. c[3]] = index
		end
	end
	function out.lookup(gx, layer, gz)
		return grid[gx .. "," .. layer .. "," .. gz]
	end
	-- outside first (most exposed), then lower first, then by index, so the order never changes
	for i = 1, #out do
		out.machineOrder[i] = i
	end
	table.sort(out.machineOrder, function(a, b)
		local ca, cb = math.floor(out.core[a] * 8), math.floor(out.core[b] * 8)
		if ca ~= cb then
			return ca > cb
		elseif out.cell[a][2] ~= out.cell[b][2] then
			return out.cell[a][2] < out.cell[b][2]
		end
		return a < b
	end)
	local low, high = Config.NeedleHeight[1] * layerCount, Config.NeedleHeight[2] * layerCount
	for i = 1, #out do
		local layer = out.cell[i][2]
		if layer >= low and layer <= high and out.core[i] <= Config.NeedleCore then
			table.insert(out.needleSpots, i)
		end
	end
	function out.origin(x, z)
		return math.floor(x / s) * s + s / 2, math.floor(z / s) * s + s / 2
	end
	return out
end
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
