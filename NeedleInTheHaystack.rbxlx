			<Item class="ModuleScript" referent="RBX00015">
				<Properties>
					<string name="Name">Haystacks</string>
					<ProtectedString name="Source"><![CDATA[-- The ten haystacks: their straw counts (the 5,000,000 shared between them) and their looks.
-- A haystack shrinks as it is searched and grows back when a new case starts.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Build = require(script.Parent.Build)

local Haystacks = {}
local states = {} -- one per haystack, in Piles.json order
local byId = {}
local gameState = ReplicatedStorage:WaitForChild("GameState")

local HAY = { { 226, 190, 92 }, { 212, 172, 76 }, { 236, 204, 112 } }
local GROW_SECONDS = 2.5

local function mound(pile, parent)
	local model = Instance.new("Model")
	model.Name = pile.id
	local base = Vector3.new(pile.x, 0, pile.z)
	local function ball(name, size, offset, colour)
		return Build.part({ name = name, shape = "Ball", size = Vector3.new(size, size, size), cframe = CFrame.new(base + offset), color = colour, material = "Grass", parent = model })
	end
	ball("Core", 22, Vector3.new(0, 3, 0), HAY[1])
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		ball("Lump", 13 + (i % 3) * 1.5, Vector3.new(math.cos(a) * 8, 0.5, math.sin(a) * 8), HAY[i % 3 + 1])
	end
	ball("Top", 9, Vector3.new(1, 13, -1), HAY[3])
	local rng = Random.new(#pile.id * 31 + math.floor(pile.x))
	for _ = 1, 14 do
		local a = rng:NextNumber() * math.pi * 2
		local h = rng:NextNumber(2, 13)
		local r = 10.5 - h * 0.45
		Build.part({
			name = "Straw",
			shape = "Cylinder",
			size = Vector3.new(rng:NextNumber(2.5, 4.5), 0.18, 0.18),
			cframe = CFrame.new(base + Vector3.new(math.cos(a) * r, h, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(-1, 1), a, rng:NextNumber(-0.6, 0.6)),
			color = { 246, 222, 140 },
			collide = false,
			shadow = false,
			parent = model,
		})
	end
	model.WorldPivot = CFrame.new(base) -- shrinks towards the ground
	model:SetAttribute("PileId", pile.id)
	model:SetAttribute("DisplayName", pile.name)
	model:SetAttribute("Side", pile.side)
	model.Parent = parent
	return model
end

local elapsed = 0
local function refresh(dt)
	elapsed += dt
	if elapsed < 0.25 then
		return
	end
	elapsed = 0
	local total = 0
	for _, state in ipairs(states) do
		total += state.remaining
		if state.dirty and not state.growing then
			state.dirty = false
			state.model:SetAttribute("Remaining", state.remaining)
			local scale = Economy.pileScale(state.remaining, state.total)
			if math.abs(scale - state.scale) > 0.004 then
				state.scale = scale
				state.model:ScaleTo(scale)
			end
		end
	end
	gameState:SetAttribute("Remaining", total)
end

function Haystacks.build(piles)
	local folder = Instance.new("Folder")
	folder.Name = "Haystacks"
	folder.Parent = workspace
	local each = math.floor(Config.TotalStraws / #piles)
	for _, pile in ipairs(piles) do
		local state = {
			pile = pile,
			model = mound(pile, folder),
			position = Vector3.new(pile.x, 0, pile.z),
			total = each,
			remaining = each,
			scale = 1,
			dirty = true,
		}
		state.model:SetAttribute("Total", each)
		table.insert(states, state)
		byId[pile.id] = state
	end
	gameState:SetAttribute("TotalStraws", each * #piles)
	gameState:SetAttribute("Remaining", each * #piles)
	RunService.Heartbeat:Connect(refresh)
end

-- Every haystack back to full, for a new case. They grow back over a couple of seconds,
-- so anyone standing next to a small one is nudged aside rather than flung.
function Haystacks.refill()
	local from = {}
	for _, state in ipairs(states) do
		state.remaining = state.total
		state.growing = true
		from[state] = state.scale
		state.model:SetAttribute("Remaining", state.total)
	end
	gameState:SetAttribute("Remaining", Config.TotalStraws)
	task.spawn(function()
		local started = os.clock()
		local progress = 0
		while progress < 1 do
			RunService.Heartbeat:Wait()
			progress = math.min(1, (os.clock() - started) / GROW_SECONDS)
			for _, state in ipairs(states) do
				local scale = from[state] + (1 - from[state]) * progress
				if math.abs(scale - state.scale) > 0.002 then
					state.scale = scale
					state.model:ScaleTo(scale)
				end
			end
		end
		for _, state in ipairs(states) do
			state.growing = false
			state.dirty = true -- catch up with searches made while growing
		end
	end)
end

-- The haystack a player standing at `position` can search, if any.
function Haystacks.nearest(position)
	local best, bestDistance = nil, Config.SearchRange
	for _, state in ipairs(states) do
		local flat = Vector3.new(position.X - state.position.X, 0, position.Z - state.position.Z)
		if flat.Magnitude <= bestDistance then
			best, bestDistance = state, flat.Magnitude
		end
	end
	return best
end

function Haystacks.take(state, amount)
	state.remaining = math.max(0, state.remaining - amount)
	state.dirty = true
end

function Haystacks.get(id)
	return byId[id]
end

return Haystacks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00016">
				<Properties>
					<string name="Name">Landmarks</string>
					<ProtectedString name="Source"><![CDATA[-- The ten farm landmarks, one behind each haystack, built from simple parts.
-- Each builder gets `cf`: a ground-level frame whose front (-Z) faces the plaza.
local Build = require(script.Parent.Build)

local Landmarks = {}
local terrain = workspace.Terrain
local builders = {}

local function p(model, cf, size, color, material, shape)
	return Build.part({ size = size, cframe = cf, color = color, material = material or "SmoothPlastic", shape = shape, parent = model })
end

function builders.windmill(model, cf)
	local stone = { 198, 182, 152 }
	p(model, cf * CFrame.new(0, 5, 0), Vector3.new(12, 10, 12), stone, "WoodPlanks")
	p(model, cf * CFrame.new(0, 14, 0), Vector3.new(10, 8, 10), stone, "WoodPlanks")
	p(model, cf * CFrame.new(0, 21.5, 0), Vector3.new(8, 7, 8), stone, "WoodPlanks")
	p(model, cf * CFrame.new(0, 26, 0), Vector3.new(9, 9, 9), { 170, 62, 50 }, "Wood", "Ball")
	p(model, cf * CFrame.new(0, 3.5, -6.05), Vector3.new(3.4, 7, 0.2), { 70, 48, 32 }, "Wood")
	-- the sails turn on each player's screen (WorldFx rotates the Blades model)
	local hub = cf * CFrame.new(0, 22, -5)
	p(model, hub * CFrame.Angles(0, math.rad(90), 0), Vector3.new(2.4, 2.2, 2.2), { 90, 70, 52 }, "Wood", "Cylinder")
	local blades = Instance.new("Model")
	blades.Name = "Blades"
	for i = 0, 3 do
		local turn = hub * CFrame.new(0, 0, -1.4) * CFrame.Angles(0, 0, math.rad(i * 90))
		p(blades, turn * CFrame.new(0, 8, 0), Vector3.new(2.6, 14, 0.3), { 238, 230, 212 }, "Fabric")
		p(blades, turn * CFrame.new(0, 8, 0.2), Vector3.new(0.5, 15, 0.4), { 110, 82, 58 }, "Wood")
	end
	blades.WorldPivot = hub * CFrame.new(0, 0, -1.4)
	blades.Parent = model
end

function builders.barn(model, cf)
	p(model, cf * CFrame.new(0, 8, 0), Vector3.new(26, 16, 20), { 176, 52, 40 }, "WoodPlanks")
	-- ridge runs across the barn; the roof stays inside the side walls so only the eaves show
	Build.roof({ color = { 86, 62, 52 }, material = "Slate", parent = model }, cf * CFrame.new(0, 16, 0) * CFrame.Angles(0, math.rad(90), 0), 28, 25.9)
	p(model, cf * CFrame.new(0, 5.5, -10.1), Vector3.new(9, 11, 0.3), { 240, 232, 214 }, "WoodPlanks")
	p(model, cf * CFrame.new(0, 5.5, -10.2), Vector3.new(7.6, 9.6, 0.3), { 150, 42, 34 }, "WoodPlanks")
end

function builders.tractor(model, cf)
	local green, red, black = { 62, 140, 62 }, { 196, 54, 40 }, { 34, 34, 36 }
	p(model, cf * CFrame.new(0, 4, 0), Vector3.new(6, 3.4, 12), green, "Metal")
	p(model, cf * CFrame.new(0, 8, 3), Vector3.new(5.6, 5, 5), green, "Metal")
	p(model, cf * CFrame.new(0, 10.7, 3), Vector3.new(6.4, 0.4, 6.4), black, "Metal")
	for _, side in ipairs({ -1, 1 }) do
		p(model, cf * CFrame.new(side * 4, 3.6, 3.6), Vector3.new(2, 7.2, 7.2), black, "Rubber", "Cylinder")
		p(model, cf * CFrame.new(side * 4.1, 3.6, 3.6), Vector3.new(2, 3, 3), red, "Metal", "Cylinder")
		p(model, cf * CFrame.new(side * 3.6, 2, -4), Vector3.new(1.6, 4, 4), black, "Rubber", "Cylinder")
	end
	Build.post({ color = black, material = "Metal", parent = model }, cf * CFrame.new(1.8, 5.6, -3), 4, 0.6)
end

function builders.pond(model, cf)
	local centre = cf.Position
	terrain:FillCylinder(CFrame.new(centre.X, -2.5, centre.Z), 5, 17, Enum.Material.Water)
	local rng = Random.new(11)
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local base = CFrame.new(centre + Vector3.new(math.cos(a) * 17, 0, math.sin(a) * 17))
		Build.post({ color = { 92, 120, 52 }, material = "Grass", collide = false, parent = model }, base, rng:NextNumber(3, 5.5), 0.35)
	end
	for i = 1, 3 do
		local duck = cf * CFrame.new(-6 + i * 3.5, 0.4, -2 + (i % 2) * 4) * CFrame.Angles(0, i, 0)
		p(model, duck, Vector3.new(1.6, 1.2, 2.4), { 246, 244, 236 })
		p(model, duck * CFrame.new(0, 1, -1), Vector3.new(1, 1, 1), { 62, 120, 72 })
		p(model, duck * CFrame.new(0, 0.9, -1.7), Vector3.new(0.5, 0.3, 0.5), { 240, 160, 40 })
	end
end

function builders.appletree(model, cf)
	Build.post({ color = { 96, 66, 44 }, material = "Wood", parent = model }, cf, 15, 3)
	local canopy = { { 0, 19, 0, 18 }, { 5, 16, 3, 13 }, { -5, 17, -2, 13 }, { 0, 16, 5, 12 } }
	for i, c in ipairs(canopy) do
		p(model, cf * CFrame.new(c[1], c[2], c[3]), Vector3.new(c[4], c[4], c[4]), i % 2 == 0 and { 168, 156, 52 } or { 116, 140, 50 }, "Grass", "Ball")
	end
	local rng = Random.new(5)
	for _ = 1, 12 do
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 0.8), rng:NextNumber(-1, 1)).Unit
		p(model, cf * CFrame.new(Vector3.new(0, 18, 0) + dir * 9.2), Vector3.new(1.3, 1.3, 1.3), { 200, 30, 36 }, "SmoothPlastic", "Ball")
	end
end

function builders.well(model, cf)
	local stone = { 146, 140, 134 }
	Build.post({ color = stone, material = "Slate", parent = model }, cf, 3.4, 9)
	Build.post({ color = { 18, 26, 34 }, material = "SmoothPlastic", parent = model }, cf * CFrame.new(0, 3.3, 0), 0.2, 7.4)
	for _, x in ipairs({ -3.8, 3.8 }) do
		p(model, cf * CFrame.new(x, 6.4, 0), Vector3.new(0.8, 6.4, 0.8), { 110, 78, 50 }, "Wood")
	end
	for _, s in ipairs({ -1, 1 }) do
		p(model, cf * CFrame.new(s * 2.2, 10.4, 0) * CFrame.Angles(0, 0, math.rad(-s * 35)), Vector3.new(5.6, 0.3, 6.4), { 120, 60, 44 }, "WoodPlanks")
	end
	p(model, cf * CFrame.new(0, 7.6, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(1.4, 1.2, 1.2), { 120, 100, 80 }, "Metal", "Cylinder")
end

function builders.pumpkins(model, cf)
	terrain:FillBlock(cf * CFrame.new(0, -2, 0), Vector3.new(22, 4, 18), Enum.Material.Ground)
	local rng = Random.new(3)
	for _ = 1, 10 do
		local size = rng:NextNumber(2.4, 4.6)
		local spot = cf * CFrame.new(rng:NextNumber(-9, 9), size / 2 - 0.3, rng:NextNumber(-7, 7))
		p(model, spot, Vector3.new(size, size, size), { 232, 120, 30 }, "SmoothPlastic", "Ball")
		p(model, spot * CFrame.new(0, size / 2, 0), Vector3.new(0.35, 0.9, 0.35), { 82, 110, 40 }, "Wood")
	end
end

function builders.coop(model, cf)
	p(model, cf * CFrame.new(0, 4, 0), Vector3.new(10, 6, 8), { 232, 220, 188 }, "WoodPlanks")
	Build.roof({ color = { 170, 56, 44 }, material = "WoodPlanks", parent = model }, cf * CFrame.new(0, 7, 0), 11, 7.9)
	p(model, cf * CFrame.new(0, 2.6, -4.05), Vector3.new(2, 2.4, 0.2), { 60, 44, 30 }, "Wood")
	p(model, cf * CFrame.new(0, 1, -6.4) * CFrame.Angles(math.rad(-24), 0, 0), Vector3.new(2, 0.3, 5), { 150, 112, 70 }, "Wood")
	for i = 1, 3 do
		local hen = cf * CFrame.new(-5 + i * 2.6, 0.9, -9 + (i % 2) * 1.6) * CFrame.Angles(0, i * 2, 0)
		p(model, hen, Vector3.new(1.4, 1.4, 1.8), { 248, 246, 240 })
		p(model, hen * CFrame.new(0, 1, -0.8), Vector3.new(0.9, 0.9, 0.9), { 248, 246, 240 })
		p(model, hen * CFrame.new(0, 1.6, -0.8), Vector3.new(0.25, 0.4, 0.6), { 210, 40, 40 })
	end
end

function builders.scarecrow(model, cf)
	local wood = { 120, 88, 56 }
	p(model, cf * CFrame.new(0, 5, 0), Vector3.new(0.8, 10, 0.8), wood, "Wood")
	p(model, cf * CFrame.new(0, 8, 0), Vector3.new(8, 0.6, 0.6), wood, "Wood")
	p(model, cf * CFrame.new(0, 7.4, 0), Vector3.new(3.2, 3.6, 1.4), { 166, 58, 48 }, "Fabric")
	p(model, cf * CFrame.new(0, 10.6, 0), Vector3.new(2.6, 2.6, 2.6), { 222, 196, 138 }, "Fabric", "Ball")
	Build.post({ color = { 112, 84, 48 }, material = "Fabric", parent = model }, cf * CFrame.new(0, 11.6, 0), 0.3, 4.6)
	Build.post({ color = { 112, 84, 48 }, material = "Fabric", parent = model }, cf * CFrame.new(0, 11.8, 0), 1.6, 2.4)
	for _, x in ipairs({ -3.6, 3.6 }) do
		p(model, cf * CFrame.new(x, 8.7, 0), Vector3.new(0.8, 0.8, 1.2), { 30, 28, 32 })
	end
end

function builders.shed(model, cf)
	p(model, cf * CFrame.new(0, 4.5, 0), Vector3.new(12, 9, 10), { 124, 104, 84 }, "WoodPlanks")
	Build.roof({ color = { 76, 68, 62 }, material = "Slate", parent = model }, cf * CFrame.new(0, 9, 0), 13, 9.9)
	p(model, cf * CFrame.new(0, 3.6, -5.05), Vector3.new(4, 7.2, 0.2), { 84, 64, 46 }, "Wood")
	local lean = cf * CFrame.new(4, 3, -5.6) * CFrame.Angles(math.rad(12), 0, 0)
	p(model, lean, Vector3.new(0.3, 6, 0.3), { 150, 110, 70 }, "Wood")
	p(model, lean * CFrame.new(0, 3, 0), Vector3.new(1.4, 0.25, 0.25), { 160, 164, 170 }, "Metal")
end

function Landmarks.build(pile, parent)
	local builder = builders[pile.id]
	if not builder then
		return nil
	end
	local base = Vector3.new(pile.x, 0, pile.z)
	local origin = base + base.Unit * 30
	local model = Instance.new("Model")
	model.Name = pile.id
	builder(model, CFrame.lookAt(origin, Vector3.new(0, 0, 0)))
	model.Parent = parent
	return model
end

return Landmarks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX00017">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[-- Starts the game. The ground and spawn point are built first, so nobody spawns into the void.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local World = require(script.Parent.World)
World.ground()

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Piles = require(Shared:WaitForChild("Piles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Haystacks = require(script.Parent.Haystacks)
local PlayerData = require(script.Parent.PlayerData)
local Tools = require(script.Parent.Tools)
local Rounds = require(script.Parent.Rounds)
local Search = require(script.Parent.Search)
local Shop = require(script.Parent.Shop)
local Monetization = require(script.Parent.Monetization)

World.build(Piles)
Haystacks.build(Piles)

PlayerData.onLoaded(function(player, saveable)
	local data = PlayerData.get(player)
	if data then
		Tools.give(player, data.tool)
	end
	-- a backstop: after every spawn, make sure the fork arrived (it comes from StarterGear)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		local current = PlayerData.get(player)
		if current and player.Parent and not Tools.has(player) then
			Tools.give(player, current.tool)
		end
	end)
	if not saveable and not RunService:IsStudio() then
		Remotes.Announce:FireClient(player, {
			kind = "notice",
			text = "Saving isn't working right now, so progress in this server won't be kept.",
		})
	end
end)

PlayerData.init()
Monetization.init()
Search.init()
Shop.init()
Rounds.init()
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00018">
				<Properties>
					<string name="Name">Monetization</string>
					<ProtectedString name="Source"><![CDATA[-- Robux items. Every ID in Config.GamePasses and Config.Products starts at 0 (switched off);
-- create the item on the Creator Dashboard after publishing, then paste its ID into Config.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Rounds = require(script.Parent.Rounds)

local Monetization = {}

local function passName(id)
	for name, passId in pairs(Config.GamePasses) do
		if passId ~= 0 and passId == id then
			return name
		end
	end
	return nil
end

local function productName(id)
	for name, productId in pairs(Config.Products) do
		if productId ~= 0 and productId == id then
			return name
		end
	end
	return nil
end

local function checkPasses(player)
	for name, id in pairs(Config.GamePasses) do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				PlayerData.setPass(player, name, true)
			end
		end
	end
end

-- Roblox calls this for every developer product purchase, retrying until we say granted.
local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = PlayerData.waitFor(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if PlayerData.hasReceipt(player, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already given
	end
	local name = productName(info.ProductId)
	if name == "ClueHint" then
		if not Rounds.giveClue(player) then
			-- no clue left to give (all found, or between cases): pay coins instead
			PlayerData.addCoins(player, Economy.coinsFor(Economy.power(data.tool) * 100, PlayerData.multiplier(player)))
			Remotes.Announce:FireClient(player, { kind = "notice", text = "No clue left in this case, so you got coins instead." })
		end
	else
		warn("[Monetization] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	PlayerData.addReceipt(player, info.PurchaseId)
	PlayerData.save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Monetization.init()
	Players.PlayerAdded:Connect(checkPasses)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(checkPasses, player)
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passName(passId)
		if purchased and name then
			PlayerData.setPass(player, name, true)
			Remotes.Announce:FireClient(player, { kind = "notice", text = "Thank you! Your pass is active." })
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
end

return Monetization
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00019">
				<Properties>
					<string name="Name">PlayerData</string>
					<ProtectedString name="Source"><![CDATA[-- Each player's saved progress (coins, tool, rebirths, needles found) and the leaderboard.
-- If the DataStore can't be read (Studio before publishing, or an outage), the player plays
-- with fresh progress that is not saved, so a failed read never overwrites good data.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)

local PlayerData = {}
local profiles = {} -- [player] = { data, saveable, dirty }
local passes = {} -- [player] = { DoubleCoins = true, ... } (checked each visit, not saved)
local loadedCallbacks = {}

local DEFAULTS = { coins = 0, tool = 1, rebirths = 0, needles = 0, solved = 0, clues = 0, straws = 0 }
local MAX_RECEIPTS = 50

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] saving is off: " .. tostring(result))
	end
end

local function key(player)
	return "player_" .. player.UserId
end

local function fresh(saved)
	local data = { receipts = {} }
	for name, value in pairs(DEFAULTS) do
		data[name] = value
		if type(saved) == "table" and type(saved[name]) == type(value) then
			data[name] = saved[name]
		end
	end
	if type(saved) == "table" and type(saved.receipts) == "table" then
		for _, id in ipairs(saved.receipts) do
			if type(id) == "string" then
				table.insert(data.receipts, id)
			end
		end
	end
	data.tool = math.clamp(math.floor(data.tool), 1, #Config.Tools)
	return data
end

local function load(player)
	if not store then
		return fresh(nil), false
	end
	local tries = if RunService:IsStudio() then 1 else 3
	for attempt = 1, tries do
		local ok, saved = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			return fresh(saved), true
		end
		warn("[PlayerData] could not load " .. player.Name .. ": " .. tostring(saved))
		if attempt < tries then
			task.wait(attempt * 2)
		end
	end
	return fresh(nil), false
end

local function publish(player, profile)
	local d = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = d.coins
		stats.Needles.Value = d.needles
	end
	player:SetAttribute("Coins", d.coins)
	player:SetAttribute("Tool", d.tool)
	player:SetAttribute("Power", Economy.power(d.tool))
	player:SetAttribute("Rebirths", d.rebirths)
	player:SetAttribute("Needles", d.needles)
	player:SetAttribute("Multiplier", PlayerData.multiplier(player))
end

function PlayerData.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Change a player's data and show the change everywhere. Returns false if not loaded yet.
function PlayerData.update(player, change)
	local profile = profiles[player]
	if not profile then
		return false
	end
	change(profile.data)
	profile.dirty = true
	publish(player, profile)
	return true
end

function PlayerData.addCoins(player, amount)
	return PlayerData.update(player, function(d)
		d.coins += amount
	end)
end

function PlayerData.setPass(player, name, owned)
	passes[player] = passes[player] or {}
	passes[player][name] = owned
	player:SetAttribute("Pass" .. name, owned)
	local profile = profiles[player]
	if profile then
		publish(player, profile)
	end
end

function PlayerData.hasPass(player, name)
	return passes[player] ~= nil and passes[player][name] == true
end

function PlayerData.multiplier(player)
	local d = PlayerData.get(player)
	return Economy.multiplier(d and d.rebirths or 0, PlayerData.hasPass(player, "DoubleCoins"))
end

-- Waits up to `timeout` seconds for a player's data. Returns it, or nil.
function PlayerData.waitFor(player, timeout)
	local waited = 0
	while not profiles[player] and player.Parent and waited < timeout do
		waited += task.wait(0.25)
	end
	return PlayerData.get(player)
end

function PlayerData.hasReceipt(player, purchaseId)
	local d = PlayerData.get(player)
	return d ~= nil and table.find(d.receipts, purchaseId) ~= nil
end

function PlayerData.addReceipt(player, purchaseId)
	PlayerData.update(player, function(d)
		table.insert(d.receipts, purchaseId)
		while #d.receipts > MAX_RECEIPTS do
			table.remove(d.receipts, 1)
		end
	end)
end

function PlayerData.save(player)
	local profile = profiles[player]
	if not profile or not profile.saveable or not store then
		return false
	end
	local data = profile.data
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if ok then
		profile.dirty = false
	else
		warn("[PlayerData] could not save " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- callback(player, saveable) runs once a player's data has loaded.
function PlayerData.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function added(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in ipairs({ "Coins", "Needles" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
	local data, saveable = load(player)
	if player.Parent == nil then
		return -- left while loading
	end
	local profile = { data = data, saveable = saveable, dirty = false }
	profiles[player] = profile
	publish(player, profile)
	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, saveable)
	end
end

function PlayerData.init()
	Players.PlayerAdded:Connect(added)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(added, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerData.save(player)
		profiles[player] = nil
		passes[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				PlayerData.save(player)
				pending -= 1
			end)
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited += task.wait(0.5)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, profile in pairs(profiles) do
				if profile.dirty then
					task.spawn(PlayerData.save, player)
				end
			end
		end
	end)
end

return PlayerData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001A">
				<Properties>
					<string name="Name">Rounds</string>
					<ProtectedString name="Source"><![CDATA[-- Cases: each round hides one needle in one haystack, gives each player clues as they
-- search, and ends when someone's handful of straw contains the needle.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Clues = require(Shared:WaitForChild("Clues"))
local Piles = require(Shared:WaitForChild("Piles"))
local Cases = require(Shared:WaitForChild("Cases"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local gameState = ReplicatedStorage:WaitForChild("GameState")

local Haystacks = require(script.Parent.Haystacks)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Rounds = {}
local rng = Random.new()
local caseCount = 0
local current = nil -- { number, story, needle, clues, phase }
local found = {} -- [player] = clues found this case
local helpers = {} -- [player] = true once they have searched this case

local function pick(n)
	return rng:NextInteger(1, n)
end

local function clueMessage(index)
	local clue = current.clues[index]
	return { case = current.number, index = index, count = #current.clues, text = clue.text, possible = clue.possible }
end

local function startCase()
	caseCount += 1
	local story = Cases[(caseCount - 1) % #Cases + 1]
	local needle = Piles[rng:NextInteger(1, #Piles)]
	current = { number = caseCount, story = story, needle = needle, clues = Clues.generate(Piles, needle.id, pick), phase = "searching" }
	table.clear(found)
	table.clear(helpers)
	Haystacks.refill()
	gameState:SetAttribute("Case", caseCount)
	gameState:SetAttribute("CaseTitle", story.title)
	gameState:SetAttribute("CaseIntro", story.intro)
	gameState:SetAttribute("NeedleName", story.needle)
	gameState:SetAttribute("ClueCount", #current.clues)
	gameState:SetAttribute("Phase", "searching")
	World.setNotice(caseCount, story.title, story.intro)
	Remotes.Announce:FireAllClients({ kind = "case", case = caseCount, title = story.title, intro = story.intro })
end

-- Hands the player their next clue for this case. Returns false if there is none left.
function Rounds.giveClue(player)
	if not current or current.phase ~= "searching" then
		return false
	end
	local index = (found[player] or 0) + 1
	if index > #current.clues then
		return false
	end
	found[player] = index
	PlayerData.update(player, function(d)
		d.clues += 1
	end)
	Remotes.Clue:FireClient(player, clueMessage(index))
	return true
end

function Rounds.cluesFor(player)
	local list = {}
	if current then
		for index = 1, found[player] or 0 do
			table.insert(list, clueMessage(index))
		end
	end
	return list
end

function Rounds.needleId()
	return current and current.phase == "searching" and current.needle.id or nil
end

-- Called for every handful, before the straws are taken from the haystack.
-- Returns true if this handful holds the needle.
function Rounds.search(player, state, amount)
	if not current or current.phase ~= "searching" then
		return false
	end
	helpers[player] = true
	if state.pile.id == current.needle.id and rng:NextNumber() < Economy.needleChance(amount, state.remaining) then
		return true
	end
	if rng:NextNumber() < Config.ClueChance then
		Rounds.giveClue(player)
	end
	return false
end

local function reward(player, searches)
	local d = PlayerData.get(player)
	if not d then
		return 0
	end
	local coins = Economy.coinsFor(Economy.power(d.tool) * searches, PlayerData.multiplier(player))
	PlayerData.update(player, function(data)
		data.coins += coins
		data.solved += 1
	end)
	return coins
end

function Rounds.solve(finder, state)
	if not current or current.phase ~= "searching" then
		return
	end
	current.phase = "solved"
	gameState:SetAttribute("Phase", "solved")
	local story = current.story
	local reveal = string.gsub(story.reveal, "{pile}", state.pile.name)
	for player in pairs(helpers) do
		if player ~= finder and player.Parent then
			reward(player, Config.HelperRewardSearches)
		end
	end
	local prize = reward(finder, Config.FinderRewardSearches)
	PlayerData.update(finder, function(d)
		d.needles += 1
	end)
	Remotes.Announce:FireAllClients({
		kind = "solved",
		case = current.number,
		finder = finder.DisplayName,
		finderId = finder.UserId,
		needle = story.needle,
		pile = state.pile.name,
		pileId = state.pile.id,
		reveal = reveal,
		prize = prize,
		helperSearches = Config.HelperRewardSearches,
		nextIn = Config.SolvedPause,
	})
	task.delay(Config.SolvedPause, startCase)
end

function Rounds.init()
	Players.PlayerRemoving:Connect(function(player)
		found[player] = nil
		helpers[player] = nil
	end)
	Remotes.GetState.OnServerInvoke = function(player)
		return { case = current and current.number or 0, clues = Rounds.cluesFor(player) }
	end
	startCase()
end

return Rounds
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001B">
				<Properties>
					<string name="Name">Search</string>
					<ProtectedString name="Source"><![CDATA[-- A search: the player clicks with their tool next to a haystack; the server checks they
-- really are there, takes a handful of straws, pays coins and asks Rounds about the needle.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Haystacks = require(script.Parent.Haystacks)
local PlayerData = require(script.Parent.PlayerData)
local Rounds = require(script.Parent.Rounds)

local Search = {}
local lastSearch = {}

local function rootOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function holdingTool(player)
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Level") ~= nil
end

function Search.perform(player)
	local data = PlayerData.get(player)
	local root = rootOf(player)
	if not data or not root then
		return
	end
	local state = Haystacks.nearest(root.Position)
	if not state then
		return
	end
	if state.remaining <= 0 then
		Remotes.SearchFx:FireClient(player, { pile = state.pile.id, straws = 0, coins = 0, empty = true })
		return
	end
	local amount = math.min(Economy.power(data.tool), state.remaining)
	local detector = data.tool >= Config.DetectorLevel and Rounds.needleId() == state.pile.id
	local hit = Rounds.search(player, state, amount)
	Haystacks.take(state, amount)
	local coins = Economy.coinsFor(amount, PlayerData.multiplier(player))
	PlayerData.update(player, function(d)
		d.coins += coins
		d.straws += amount
	end)
	Remotes.SearchFx:FireClient(player, { pile = state.pile.id, straws = amount, coins = coins, detector = detector })
	if hit then
		Rounds.solve(player, state)
	end
end

function Search.request(player)
	local now = os.clock()
	if now - (lastSearch[player] or 0) < Config.SearchCooldown then
		return
	end
	lastSearch[player] = now
	if holdingTool(player) then
		Search.perform(player)
	end
end

function Search.init()
	Remotes.Search.OnServerEvent:Connect(Search.request)
	Remotes.ToggleAuto.OnServerEvent:Connect(function(player, on)
		player:SetAttribute("AutoOn", on == true)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastSearch[player] = nil
	end)
	-- the Auto Search pass searches by itself while you hold your tool next to a haystack
	task.spawn(function()
		while true do
			task.wait(Config.AutoSearchInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if player:GetAttribute("AutoOn") and PlayerData.hasPass(player, "AutoSearch") and holdingTool(player) then
					task.spawn(Search.perform, player)
				end
			end
		end
	end)
end

return Search
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001C">
				<Properties>
					<string name="Name">Shop</string>
					<ProtectedString name="Source"><![CDATA[-- Buying the next search tool with coins, and rebirth (start again for more coins a search).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerData = require(script.Parent.PlayerData)
local Tools = require(script.Parent.Tools)

local Shop = {}

local function buyTool(player, level)
	local data = PlayerData.get(player)
	if not data then
		return false, "Still loading your progress..."
	end
	if type(level) ~= "number" or level ~= data.tool + 1 then
		return false, "Buy the tools in order."
	end
	local tool = Config.Tools[level]
	if not tool then
		return false, "You already have the best tool!"
	end
	if data.coins < tool.price then
		return false, "You need " .. Format.short(tool.price - data.coins) .. " more coins."
	end
	PlayerData.update(player, function(d)
		d.coins -= tool.price
		d.tool = level
	end)
	Tools.give(player, level)
	return true, "You got the " .. tool.name .. "! " .. Format.commas(tool.power) .. " straws a search."
end

local function rebirth(player)
	local data = PlayerData.get(player)
	if not data then
		return false, "Still loading your progress..."
	end
	local cost = Economy.rebirthCost(data.rebirths)
	if data.coins < cost then
		return false, "Rebirth needs " .. Format.short(cost) .. " coins."
	end
	PlayerData.update(player, function(d)
		d.coins = 0
		d.tool = 1
		d.rebirths += 1
	end)
	Tools.give(player, 1)
	local bonus = math.floor(Config.RebirthCoinBonus * (data.rebirths) * 100 + 0.5)
	return true, "Rebirth! Every search now earns +" .. bonus .. "% coins."
end

function Shop.init()
	Remotes.BuyTool.OnServerInvoke = buyTool
	Remotes.Rebirth.OnServerInvoke = rebirth
end

return Shop
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001D">
				<Properties>
					<string name="Name">Tools</string>
					<ProtectedString name="Source"><![CDATA[-- The search tools: a pitchfork-shaped Tool per level, coloured from Config.Tools.
-- The tool goes in StarterGear too, so players keep it when they respawn.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Build = require(script.Parent.Build)

local Tools = {}

local function attach(tool, handle, size, offset, colour, material)
	local part = Instance.new("Part")
	part.Name = "Head"
	part.Size = size
	part.Color = colour
	part.Material = material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
	part.Parent = tool
end

function Tools.make(level)
	local def = Config.Tools[level]
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.ToolTip = Format.commas(def.power) .. " straws a search"
	tool.CanBeDropped = false
	tool.Grip = CFrame.new(0, -1, 0) -- held a little below the middle, fork up
	tool:SetAttribute("Level", level)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 6, 0.3)
	handle.Color = Build.rgb(def.shaft)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local colour, material = Build.rgb(def.head), Enum.Material[def.material]
	attach(tool, handle, Vector3.new(1.7, 0.3, 0.3), CFrame.new(0, 2.9, 0), colour, material)
	for x = -1, 1 do
		attach(tool, handle, Vector3.new(0.16, 1.5, 0.16), CFrame.new(x * 0.7, 3.75, 0), colour, material)
	end
	return tool
end

local function clear(container, character)
	local equipped = false
	if container then
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				equipped = equipped or container == character
				item:Destroy()
			end
		end
	end
	return equipped
end

-- True if the player holds or carries a search tool.
function Tools.has(player)
	local function holds(container)
		for _, item in ipairs(container and container:GetChildren() or {}) do
			if item:IsA("Tool") and item:GetAttribute("Level") ~= nil then
				return true
			end
		end
		return false
	end
	return holds(player:FindFirstChildOfClass("Backpack")) or holds(player.Character)
end

-- Replace whatever search tool the player has with the one for `level`. May wait briefly.
function Tools.give(player, level)
	local gear = player:FindFirstChild("StarterGear") or player:WaitForChild("StarterGear", 10)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	clear(gear, nil)
	clear(backpack, nil)
	local wasEquipped = clear(character, character)
	if gear then
		Tools.make(level).Parent = gear
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if backpack and humanoid and humanoid.Health > 0 then
		local tool = Tools.make(level)
		tool.Parent = backpack
		if wasEquipped then
			humanoid:EquipTool(tool)
		end
	end
end

return Tools
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0001E">
				<Properties>
					<string name="Name">World</string>
					<ProtectedString name="Source"><![CDATA[-- Hollow Creek Farm at sunset: terrain, plaza, paths, fence, trees, signpost and the notice
-- board. The landmarks beside each haystack come from Landmarks.
local Lighting = game:GetService("Lighting")

local Build = require(script.Parent.Build)
local Landmarks = require(script.Parent.Landmarks)

local World = {}
local notice = {}

local terrain = workspace.Terrain
local AUTUMN = { { 214, 120, 40 }, { 196, 72, 44 }, { 232, 176, 54 }, { 150, 150, 58 } }
local WOOD = { 122, 86, 52 }

-- Ground and the spawn point come first, so nobody spawns into the void.
function World.ground()
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(118, 136, 58))
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(124, 94, 62))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(152, 138, 120))
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(640, 16, 640), Enum.Material.Grass)
	terrain:FillCylinder(CFrame.new(0, -2, 0), 4, 34, Enum.Material.Cobblestone)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, 20) -- faces north, towards the notice board
	spawn.Color = Color3.fromRGB(196, 150, 92)
	spawn.Material = Enum.Material.WoodPlanks
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = workspace
end

function World.lighting()
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(86, 70, 60)
	Lighting.OutdoorAmbient = Color3.fromRGB(170, 136, 112)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 196, 146)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, old in ipairs(Lighting:GetChildren()) do
		if old:IsA("Atmosphere") or old:IsA("PostEffect") then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(255, 204, 158)
	atmosphere.Decay = Color3.fromRGB(176, 108, 78)
	atmosphere.Glare = 0.5
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 20
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.5
	rays.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Saturation = 0.1
	grade.Contrast = 0.06
	grade.TintColor = Color3.fromRGB(255, 246, 234)
	grade.Parent = Lighting
end

local function paths(piles)
	for _, pile in ipairs(piles) do
		local target = Vector3.new(pile.x, -2, pile.z)
		local dir = Vector3.new(pile.x, 0, pile.z).Unit
		local from = dir * 30 + Vector3.new(0, -2, 0)
		local to = target - dir * 16
		terrain:FillBlock(CFrame.lookAt((from + to) / 2, to), Vector3.new(7, 4, (to - from).Magnitude), Enum.Material.Ground)
	end
end

local function fence(folder)
	local count, radius = 56, 214
	for i = 0, count - 1 do
		local a = i / count * math.pi * 2
		local b = (i + 1) / count * math.pi * 2
		local p = Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		local q = Vector3.new(math.cos(b) * radius, 0, math.sin(b) * radius)
		Build.part({ name = "Post", size = Vector3.new(1.2, 5, 1.2), cframe = CFrame.new(p + Vector3.new(0, 2.5, 0)), color = WOOD, material = "Wood", parent = folder })
		for _, h in ipairs({ 1.6, 3.4 }) do
			local mid = (p + q) / 2 + Vector3.new(0, h, 0)
			Build.part({ name = "Rail", size = Vector3.new(0.5, 0.45, (q - p).Magnitude), cframe = CFrame.lookAt(mid, q + Vector3.new(0, h, 0)), color = WOOD, material = "Wood", parent = folder })
		end
	end
end

local function trees(folder)
	local rng = Random.new(7)
	for i = 1, 40 do
		local a = i / 40 * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local r = rng:NextNumber(232, 290)
		local base = CFrame.new(math.cos(a) * r, 0, math.sin(a) * r)
		local height = rng:NextNumber(10, 16)
		Build.post({ name = "Trunk", color = { 96, 66, 44 }, material = "Wood", parent = folder }, base, height, 2.6)
		for _ = 1, 3 do
			local size = rng:NextNumber(10, 17)
			local offset = Vector3.new(rng:NextNumber(-4, 4), height + rng:NextNumber(0, 5), rng:NextNumber(-4, 4))
			Build.part({ name = "Leaves", shape = "Ball", size = Vector3.new(size, size, size), cframe = base * CFrame.new(offset), color = AUTUMN[rng:NextInteger(1, #AUTUMN)], material = "Grass", parent = folder })
		end
	end
end

local function plaza(folder)
	-- signpost in the middle, one arm per side of the farm
	Build.post({ name = "Signpost", color = WOOD, material = "Wood", parent = folder }, CFrame.new(0, 0, 0), 12, 1)
	local arms = { { "NORTH", -90, 10.6 }, { "EAST", 0, 9.4 }, { "SOUTH", 90, 8.2 }, { "WEST", 180, 7 } }
	for _, arm in ipairs(arms) do
		local cf = CFrame.new(0, arm[3], 0) * CFrame.Angles(0, math.rad(-arm[2]), 0) * CFrame.new(4.6, 0, 0)
		local board = Build.part({ name = arm[1], size = Vector3.new(8, 1.5, 0.35), cframe = cf, color = { 214, 184, 130 }, material = "WoodPlanks", parent = folder })
		Build.text(board, Enum.NormalId.Front, arm[1] .. " FIELDS")
		Build.text(board, Enum.NormalId.Back, arm[1] .. " FIELDS")
	end
	-- lamps around the plaza
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local base = CFrame.new(math.cos(a) * 26, 0, math.sin(a) * 26)
		Build.post({ name = "LampPost", color = { 52, 48, 46 }, material = "Metal", parent = folder }, base, 9, 0.6)
		local lamp = Build.part({ name = "Lamp", size = Vector3.new(1.6, 1.6, 1.6), cframe = base * CFrame.new(0, 9.6, 0), color = { 255, 196, 110 }, material = "Neon", parent = folder })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 190, 120)
		light.Range = 22
		light.Brightness = 1.6
		light.Parent = lamp
	end
	-- a few hay bales to sit on
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local cf = CFrame.new(math.cos(a) * 20, 1.5, math.sin(a) * 20) * CFrame.Angles(0, -a, 0)
		Build.part({ name = "Bale", size = Vector3.new(5, 3, 3), cframe = cf, color = { 220, 184, 96 }, material = "Grass", parent = folder })
	end
	-- the notice board shows the current case
	local boardCf = CFrame.lookAt(Vector3.new(0, 7, -14), Vector3.new(0, 7, 20))
	for _, x in ipairs({ -7.4, 7.4 }) do
		Build.part({ name = "BoardLeg", size = Vector3.new(0.8, 12, 0.8), cframe = boardCf * CFrame.new(x, -1, 0.4), color = WOOD, material = "Wood", parent = folder })
	end
	local board = Build.part({ name = "NoticeBoard", size = Vector3.new(14, 8, 0.5), cframe = boardCf, color = { 92, 64, 40 }, material = "WoodPlanks", parent = folder })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0.5
	gui.Parent = board
	local paper = Instance.new("Frame")
	paper.Size = UDim2.new(1, -30, 1, -30)
	paper.Position = UDim2.fromOffset(15, 15)
	paper.BackgroundColor3 = Color3.fromRGB(246, 234, 204)
	paper.Parent = gui
	local function line(name, y, height, font, size)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Size = UDim2.new(1, -30, height, 0)
		label.Position = UDim2.new(0, 15, y, 0)
		label.BackgroundTransparency = 1
		label.Font = font
		label.TextScaled = true
		label.TextWrapped = true
		label.TextColor3 = Color3.fromRGB(58, 38, 22)
		label.Text = ""
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = size
		limit.Parent = label
		label.Parent = paper
		return label
	end
	notice.case = line("Case", 0.05, 0.14, Enum.Font.FredokaOne, 40)
	notice.title = line("Title", 0.2, 0.18, Enum.Font.FredokaOne, 64)
	notice.intro = line("Intro", 0.42, 0.34, Enum.Font.Gotham, 34)
	notice.help = line("Help", 0.8, 0.14, Enum.Font.GothamBold, 30)
	notice.help.Text = "Search any haystack. Every search can turn up a clue."
end

function World.setNotice(number, title, intro)
	if notice.case then
		notice.case.Text = "CASE #" .. number
		notice.title.Text = title
		notice.intro.Text = intro
	end
end

function World.build(piles)
	World.lighting()
	local farm = Instance.new("Folder")
	farm.Name = "Farm"
	farm.Parent = workspace
	paths(piles)
	fence(farm)
	trees(farm)
	plaza(farm)
	local landmarks = Instance.new("Folder")
	landmarks.Name = "Landmarks"
	landmarks.Parent = workspace
	for _, pile in ipairs(piles) do
		Landmarks.build(pile, landmarks)
	end
end

return World
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX0001F">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00020">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX00021">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00022">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- The always-on screen: the great haystack counter at the top, your coins and search power
-- on the left, and the buttons for the shop, the clue book, rebirth and auto search.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")

local Hud = {}

function Hud.mount(gui, open)
	local top = Ui.make("Frame", {
		Name = "Haystack",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(470, 80),
		BackgroundColor3 = Ui.colors.wood,
		Parent = gui,
	}, { Ui.corner(14), Ui.stroke(Ui.colors.woodDark, 3) })
	Ui.autoScale(top)
	local caseLabel = Ui.label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 4), TextColor3 = Ui.colors.hay, Parent = top }, 20)
	local countLabel = Ui.label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 27), Parent = top }, 26)
	local bar = Ui.make("Frame", { Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 58), BackgroundColor3 = Ui.colors.woodDark, Parent = top }, { Ui.corner(7) })
	local fill = Ui.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Ui.colors.hay, Parent = bar }, { Ui.corner(7) })

	local left = Ui.make("Frame", {
		Name = "Left",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(200, 380),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(left)
	local stats = Ui.make("Frame", { LayoutOrder = 1, Size = UDim2.fromOffset(200, 106), BackgroundColor3 = Ui.colors.wood, Parent = left }, { Ui.corner(12), Ui.stroke(Ui.colors.woodDark, 3) })
	local coinsLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 6), TextColor3 = Ui.colors.hay, Parent = stats }, 36)
	local powerLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 50), Parent = stats }, 20)
	local bonusLabel = Ui.label({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 76), Parent = stats }, 18)

	local function button(order, text, colour, onClick)
		local b = Ui.button(text, colour, { LayoutOrder = order, Size = UDim2.fromOffset(200, 50), Parent = left })
		b.Activated:Connect(onClick)
		return b
	end
	button(2, "SHOP", Ui.colors.green, function()
		open("Shop")
	end)
	local cluesButton = button(3, "CLUE BOOK", Ui.colors.blue, function()
		open("Clue Book")
	end)
	button(4, "REBIRTH", Ui.colors.purple, function()
		open("Rebirth")
	end)
	local autoButton = button(5, "AUTO: OFF", Ui.colors.grey, function()
		Remotes.ToggleAuto:FireServer(not player:GetAttribute("AutoOn"))
	end)

	local function refreshHaystack()
		local total = gameState:GetAttribute("TotalStraws") or Config.TotalStraws
		local remaining = gameState:GetAttribute("Remaining") or total
		caseLabel.Text = "CASE #" .. (gameState:GetAttribute("Case") or 1) .. ": " .. (gameState:GetAttribute("CaseTitle") or "")
		if gameState:GetAttribute("Phase") == "solved" then
			countLabel.Text = "NEEDLE FOUND! The next case starts soon..."
		else
			countLabel.Text = Format.commas(remaining) .. " straws left. 1 needle."
		end
		fill.Size = UDim2.fromScale(math.clamp(remaining / total, 0, 1), 1)
	end

	local function refreshPlayer()
		coinsLabel.Text = Format.short(player:GetAttribute("Coins") or 0) .. " coins"
		powerLabel.Text = Format.short(player:GetAttribute("Power") or 0) .. " straws a search"
		bonusLabel.Text = "Coin bonus: x" .. string.format("%.1f", player:GetAttribute("Multiplier") or 1)
		autoButton.Visible = player:GetAttribute("PassAutoSearch") == true
		local on = player:GetAttribute("AutoOn") == true
		autoButton.Text = on and "AUTO: ON" or "AUTO: OFF"
		autoButton.BackgroundColor3 = on and Ui.colors.green or Ui.colors.grey
	end

	gameState.AttributeChanged:Connect(refreshHaystack)
	player.AttributeChanged:Connect(refreshPlayer)
	refreshHaystack()
	refreshPlayer()

	local hud = {}
	function hud.setClues(found, count)
		cluesButton.Text = if count > 0 then "CLUE BOOK " .. found .. "/" .. count else "CLUE BOOK"
	end
	return hud
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX00023">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[-- The player's side of the game: builds the UI, listens to the farm, and turns clicks with
-- your fork into searches (the server decides what each search finds).
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Ui = require(script.Parent:WaitForChild("Ui"))
local Notify = require(script.Parent:WaitForChild("Notify"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Panels = require(script.Parent:WaitForChild("Panels"))
local WorldFx = require(script.Parent:WaitForChild("WorldFx"))

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")

local gui = Ui.make("ScreenGui", { Name = "HaystackUi", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
local state = { case = 0, clues = {} }

Notify.mount(gui)
local panels = Panels.mount(gui, state, Notify)
local hud = Hud.mount(gui, panels.open)
WorldFx.start(gui)

local function cluesChanged()
	hud.setClues(#state.clues, gameState:GetAttribute("ClueCount") or 0)
	panels.refresh()
	WorldFx.setClues(state.clues, gameState:GetAttribute("Phase") == "solved")
end

Remotes.Clue.OnClientEvent:Connect(function(clue)
	if clue.case ~= state.case then
		state.case, state.clues = clue.case, {}
	end
	state.clues[clue.index] = clue
	Notify.toast("NEW CLUE " .. clue.index .. "/" .. clue.count .. ": " .. clue.text, Ui.colors.blue)
	cluesChanged()
end)

Remotes.Announce.OnClientEvent:Connect(function(message)
	if message.kind == "case" then
		state.case, state.clues = message.case, {}
		cluesChanged()
		Notify.banner("CASE #" .. message.case .. ": " .. message.title, message.intro .. "\n\nSearch any haystack. Every search can turn up a clue.", 9)
	elseif message.kind == "solved" then
		cluesChanged()
		WorldFx.celebrate(message.pileId)
		local who = if message.finderId == player.UserId then "You" else message.finder
		local prize = if message.finderId == player.UserId
			then "\nYou earned " .. Format.short(message.prize) .. " coins!"
			else "\nEveryone who searched this case earned a reward."
		Notify.banner(who .. " found the " .. message.needle .. "!", "It was in the " .. message.pile .. " haystack. " .. message.reveal .. prize .. "\nNext case in " .. message.nextIn .. " seconds.", 10)
	elseif message.kind == "notice" then
		Notify.toast(message.text, Ui.colors.wood)
	end
end)

local lastBeep = 0
Remotes.SearchFx.OnClientEvent:Connect(function(message)
	WorldFx.searched(message)
	if message.detector and os.clock() - lastBeep > 6 then
		lastBeep = os.clock()
		Notify.toast("Your Needle Detector is beeping like crazy!", Ui.colors.green)
	end
end)

-- Clicking (or tapping) with your search tool asks the server to search.
local hooked = setmetatable({}, { __mode = "k" })
local lastSwing = 0
local function hookTool(tool)
	if hooked[tool] or not tool:IsA("Tool") or tool:GetAttribute("Level") == nil then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		Remotes.Search:FireServer()
		if os.clock() - lastSwing > 0.35 then
			lastSwing = os.clock()
			local swing = Instance.new("StringValue") -- the default Animate script plays a swing for this
			swing.Name = "toolanim"
			swing.Value = "Slash"
			swing.Parent = tool
			Debris:AddItem(swing, 0.5)
		end
	end)
end

local backpackConnection = nil
local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local backpack = player:WaitForChild("Backpack")
	local equipped = false
	local function arrive(tool)
		hookTool(tool)
		-- hold the fork straight away the first time it arrives after spawning
		if not equipped and tool:IsA("Tool") and tool:GetAttribute("Level") ~= nil then
			equipped = true
			task.defer(function()
				if humanoid.Parent and tool.Parent == backpack then
					humanoid:EquipTool(tool)
				end
			end)
		end
	end
	if backpackConnection then
		backpackConnection:Disconnect()
	end
	backpackConnection = backpack.ChildAdded:Connect(arrive)
	for _, tool in ipairs(backpack:GetChildren()) do
		arrive(tool)
	end
	character.ChildAdded:Connect(hookTool)
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

-- Catch up on the current case (and any clues found before this script started).
task.spawn(function()
	local ok, snapshot = pcall(function()
		return Remotes.GetState:InvokeServer()
	end)
	if ok and type(snapshot) == "table" and #state.clues == 0 then
		state.case, state.clues = snapshot.case, snapshot.clues
	end
	cluesChanged()
end)

task.delay(2, function()
	Notify.banner(
		"Welcome to " .. Config.FarmName .. "!",
		"A needle is hidden in one of " .. Format.commas(Config.TotalStraws) .. " straws. Walk up to a haystack and click or tap "
			.. "with your fork to search. Searching earns coins and clues, and the clues tell you which haystack hides the needle.",
		10
	)
end)
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00024">
					<Properties>
						<string name="Name">Notify</string>
						<ProtectedString name="Source"><![CDATA[-- Messages: small toasts under the haystack counter, and a big banner for case news.
local Ui = require(script.Parent.Ui)

local Notify = {}
local stack, banner, bannerTitle, bannerBody
local order = 0
local bannerToken = 0

function Notify.mount(gui)
	stack = Ui.make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 98),
		Size = UDim2.fromOffset(460, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	Ui.autoScale(stack)

	banner = Ui.make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Ui.colors.wood,
		Visible = false,
		Parent = gui,
	}, {
		Ui.corner(18),
		Ui.stroke(Ui.colors.hay, 4),
		Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }),
	})
	Ui.autoScale(banner)
	bannerTitle = Ui.paragraph("", { LayoutOrder = 1, Font = Ui.font, TextSize = 34, TextColor3 = Ui.colors.hay, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	bannerBody = Ui.paragraph("", { LayoutOrder = 2, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = banner })
	banner.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			banner.Visible = false
		end
	end)
end

function Notify.toast(text, colour)
	if not stack then
		return
	end
	order += 1
	local card = Ui.make("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = colour or Ui.colors.wood,
		Parent = stack,
	}, {
		Ui.corner(12),
		Ui.stroke(Ui.colors.woodDark, 2),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
	})
	Ui.paragraph(text, { Font = Ui.font, TextSize = 20, TextColor3 = Ui.colors.white, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local cards = {}
	for _, child in ipairs(stack:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	if #cards > 4 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
	task.delay(4, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Notify.banner(title, body, seconds)
	if not banner then
		return
	end
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerBody.Text = body
	banner.Visible = true
	task.delay(seconds or 6, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

return Notify
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00025">
					<Properties>
						<string name="Name">Panels</string>
						<ProtectedString name="Source"><![CDATA[-- The windows: the Shop (tools for coins, extras for Robux), the Clue Book and Rebirth.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))(Config)
local Format = require(Shared:WaitForChild("Format"))
local Piles = require(Shared:WaitForChild("Piles"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")

local ROBUX = {
	{ kind = "pass", key = "DoubleCoins", title = "2x Coins", text = "Every search earns double coins, forever." },
	{ kind = "pass", key = "AutoSearch", title = "Auto Search", text = "Searches by itself while you hold your tool by a haystack." },
	{ kind = "product", key = "ClueHint", title = "Clue Hint", text = "Get your next clue right now." },
}

local Panels = {}

local function ask(remote, ...)
	local ok, success, message = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		return false, "The farm didn't answer. Try again."
	end
	return success, message
end

function Panels.mount(gui, state, notify)
	local windows = {}
	local refreshers = {}

	local function open(name)
		for key, frame in pairs(windows) do
			if key == name then
				frame.Visible = not frame.Visible
				if frame.Visible and refreshers[key] then
					refreshers[key]()
				end
			else
				frame.Visible = false
			end
		end
	end

	-- Shop
	local shop, shopBody = Ui.window(gui, "Shop")
	windows.Shop = shop
	local buyButtons = {}
	for level, tool in ipairs(Config.Tools) do
		local row = Ui.make("Frame", { LayoutOrder = level, Size = UDim2.new(1, 0, 0, 66), BackgroundColor3 = Ui.colors.paper, Parent = shopBody }, { Ui.corner(10) })
		Ui.label({ Text = tool.name, Size = UDim2.new(0.58, -12, 0, 30), Position = UDim2.fromOffset(12, 5), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = row }, 26)
		Ui.label({ Text = Format.commas(tool.power) .. " straws a search", Size = UDim2.new(0.58, -12, 0, 22), Position = UDim2.fromOffset(12, 38), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = row }, 18)
		local buy = Ui.button("", Ui.colors.green, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.4, 0, 0, 48), Parent = row })
		buy.Activated:Connect(function()
			local ok, message = ask(Remotes.BuyTool, level)
			notify.toast(message, ok and Ui.colors.green or Ui.colors.red)
			if refreshers.Shop then
				refreshers.Shop()
			end
		end)
		buyButtons[level] = buy
	end
	local order = #Config.Tools
	for _, item in ipairs(ROBUX) do
		local id = if item.kind == "pass" then Config.GamePasses[item.key] else Config.Products[item.key]
		if id and id ~= 0 then
			order += 1
			local row = Ui.make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 66), BackgroundColor3 = Color3.fromRGB(226, 236, 250), Parent = shopBody }, { Ui.corner(10) })
			Ui.label({ Text = item.title, Size = UDim2.new(0.62, -12, 0, 30), Position = UDim2.fromOffset(12, 5), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.ink, TextStrokeTransparency = 1, Parent = row }, 26)
			Ui.label({ Text = item.text, Size = UDim2.new(0.62, -12, 0, 24), Position = UDim2.fromOffset(12, 37), Font = Ui.body, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ui.colors.grey, TextStrokeTransparency = 1, Parent = row }, 16)
			local buy = Ui.button("ROBUX", Ui.colors.blue, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.34, 0, 0, 48), Parent = row })
			buy.Activated:Connect(function()
				if item.kind == "pass" then
					MarketplaceService:PromptGamePassPurchase(player, id)
				else
					MarketplaceService:PromptProductPurchase(player, id)
				end
			end)
		end
	end
	refreshers.Shop = function()
		local coins, owned = player:GetAttribute("Coins") or 0, player:GetAttribute("Tool") or 1
		for level, button in pairs(buyButtons) do
			local tool = Config.Tools[level]
			if level <= owned then
				button.Text, button.BackgroundColor3 = "OWNED", Ui.colors.grey
			elseif level == owned + 1 then
				button.Text = "BUY " .. Format.short(tool.price)
				button.BackgroundColor3 = if coins >= tool.price then Ui.colors.green else Ui.colors.red
			else
				button.Text, button.BackgroundColor3 = "LOCKED", Ui.colors.grey
			end
		end
	end

	-- Clue Book
	local book, bookBody = Ui.window(gui, "Clue Book")
	windows["Clue Book"] = book
	refreshers["Clue Book"] = function()
		for _, child in ipairs(bookBody:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local n = 0
		local function line(text, props)
			n += 1
			props = props or {}
			props.LayoutOrder = n
			props.Parent = bookBody
			return Ui.paragraph(text, props)
		end
		line("CASE #" .. (gameState:GetAttribute("Case") or 1) .. ": " .. (gameState:GetAttribute("CaseTitle") or ""), { Font = Ui.font, TextSize = 26 })
		line(gameState:GetAttribute("CaseIntro") or "", { TextColor3 = Ui.colors.grey })
		local count = gameState:GetAttribute("ClueCount") or 0
		line("Clues found: " .. #state.clues .. " of " .. count, { Font = Ui.font, TextSize = 22 })
		if #state.clues == 0 then
			line("None yet. Every search of any haystack can turn up a clue.")
		end
		for i, clue in ipairs(state.clues) do
			line(i .. ". " .. clue.text, { TextColor3 = Ui.colors.blue })
		end
		local latest = state.clues[#state.clues]
		local possible = {}
		for _, id in ipairs(latest and latest.possible or {}) do
			possible[id] = true
		end
		line("The haystacks:", { Font = Ui.font, TextSize = 22 })
		for _, pile in ipairs(Piles) do
			local out = latest ~= nil and not possible[pile.id]
			local text = pile.name .. " (" .. pile.side .. ")" .. (if out then ": ruled out" elseif latest and #latest.possible == 1 then ": THE NEEDLE IS HERE!" else "")
			line(text, { TextColor3 = if out then Ui.colors.grey else Ui.colors.ink })
		end
	end

	-- Rebirth
	local rebirth, rebirthBody = Ui.window(gui, "Rebirth")
	windows.Rebirth = rebirth
	local info = Ui.paragraph("", { LayoutOrder = 1, Parent = rebirthBody })
	local go = Ui.button("REBIRTH", Ui.colors.purple, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 56), Parent = rebirthBody })
	go.Activated:Connect(function()
		local ok, message = ask(Remotes.Rebirth)
		notify.toast(message, ok and Ui.colors.purple or Ui.colors.red)
		if ok then
			rebirth.Visible = false
		end
	end)
	refreshers.Rebirth = function()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local cost = Economy.rebirthCost(rebirths)
		info.Text = "Start again with 0 coins and the " .. Config.Tools[1].name .. ", and earn +"
			.. math.floor(Config.RebirthCoinBonus * 100) .. "% coins on every search, forever.\n\n"
			.. "Rebirths so far: " .. rebirths .. ".\nThis one costs " .. Format.short(cost) .. " coins. You have "
			.. Format.short(player:GetAttribute("Coins") or 0) .. "."
	end

	player.AttributeChanged:Connect(function()
		for key, frame in pairs(windows) do
			if frame.Visible and key ~= "Clue Book" and refreshers[key] then
				refreshers[key]()
			end
		end
	end)

	local panels = {}
	panels.open = open
	function panels.refresh()
		if book.Visible then
			refreshers["Clue Book"]()
		end
	end
	return panels
end

return Panels
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00026">
					<Properties>
						<string name="Name">Ui</string>
						<ProtectedString name="Source"><![CDATA[-- A small UI kit: the farm colours, rounded wooden buttons and windows that scale with
-- the screen (phones get a smaller UI, big monitors a larger one).
local Ui = {}

Ui.colors = {
	wood = Color3.fromRGB(110, 70, 40),
	woodDark = Color3.fromRGB(62, 38, 22),
	hay = Color3.fromRGB(242, 196, 82),
	cream = Color3.fromRGB(255, 244, 222),
	paper = Color3.fromRGB(246, 232, 200),
	red = Color3.fromRGB(200, 64, 48),
	green = Color3.fromRGB(84, 166, 70),
	blue = Color3.fromRGB(64, 136, 206),
	purple = Color3.fromRGB(136, 92, 196),
	grey = Color3.fromRGB(128, 120, 112),
	ink = Color3.fromRGB(56, 36, 20),
	white = Color3.new(1, 1, 1),
}
Ui.font = Enum.Font.FredokaOne
Ui.body = Enum.Font.GothamMedium

local camera = workspace.CurrentCamera or workspace:WaitForChild("Camera")
local scales = {}

local function screenScale()
	return math.clamp(camera.ViewportSize.Y / 760, 0.55, 1.15)
end

camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	for _, scale in ipairs(scales) do
		scale.Scale = screenScale()
	end
end)

-- Instance.new with properties and children; Parent is set last.
function Ui.make(className, props, children)
	local instance = Instance.new(className)
	for name, value in pairs(props) do
		if name ~= "Parent" then
			instance[name] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.corner(radius)
	return Ui.make("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(color, thickness)
	return Ui.make("UIStroke", { Color = color or Ui.colors.woodDark, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Ui.maxText(size)
	return Ui.make("UITextSizeConstraint", { MaxTextSize = size })
end

-- Scales `frame` (around its AnchorPoint) with the screen height.
function Ui.autoScale(frame)
	local scale = Ui.make("UIScale", { Scale = screenScale(), Parent = frame })
	table.insert(scales, scale)
	return scale
end

-- A text label. `maxSize` caps the scaled text size.
function Ui.label(props, maxSize)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.font,
		Text = "",
		TextColor3 = Ui.colors.white,
		TextScaled = true,
		TextWrapped = true,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.35,
	}
	for name, value in pairs(props) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults, { Ui.maxText(maxSize or 40) })
end

function Ui.button(text, color, props)
	local defaults = {
		Text = text,
		Font = Ui.font,
		TextScaled = true,
		TextColor3 = Ui.colors.white,
		TextStrokeColor3 = Ui.colors.woodDark,
		TextStrokeTransparency = 0.4,
		BackgroundColor3 = color,
		AutoButtonColor = true,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextButton", defaults, {
		Ui.corner(10),
		Ui.stroke(Ui.colors.woodDark, 3),
		Ui.maxText(28),
		Ui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
end

-- A centred window with a title and a close button. Returns frame, body (a scrolling list).
function Ui.window(parent, title, onClose)
	local frame = Ui.make("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 480),
		BackgroundColor3 = Ui.colors.cream,
		Visible = false,
		Parent = parent,
	}, { Ui.corner(18), Ui.stroke(Ui.colors.wood, 5) })
	Ui.autoScale(frame)
	Ui.make("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Ui.colors.wood, Parent = frame }, { Ui.corner(16) })
	Ui.label({ Text = title, Size = UDim2.new(1, -120, 0, 46), Position = UDim2.fromOffset(20, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame }, 34)
	local close = Ui.button("X", Ui.colors.red, { Size = UDim2.fromOffset(46, 42), Position = UDim2.new(1, -56, 0, 8), Parent = frame })
	close.Activated:Connect(function()
		frame.Visible = false
		if onClose then
			onClose()
		end
	end)
	local body = Ui.make("ScrollingFrame", {
		Name = "Body",
		Size = UDim2.new(1, -24, 1, -76),
		Position = UDim2.fromOffset(12, 68),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Ui.colors.wood,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, {
		Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Ui.make("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})
	return frame, body
end

-- Paragraph text that grows to fit, for lists inside windows.
function Ui.paragraph(text, props)
	local defaults = {
		Text = text,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Ui.body,
		TextSize = 19,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.colors.ink,
	}
	for name, value in pairs(props or {}) do
		defaults[name] = value
	end
	return Ui.make("TextLabel", defaults)
end

return Ui
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00027">
					<Properties>
						<string name="Name">WorldFx</string>
						<ProtectedString name="Source"><![CDATA[-- What you see in the world: a label over each haystack (name, straws left, what your clues
-- say), straw bursts and floating coins when you search, and the windmill's turning sails.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local WorldFx = {}
local tags = {} -- [pile id] = { model, core, count, fill, status, attachment, emitter }
local possible = nil -- pile ids your latest clue still allows (nil before your first clue)
local solved = false
local here = nil -- the panel for the haystack you're standing at

local function refreshTag(tag)
	local remaining = tag.model:GetAttribute("Remaining") or 0
	local total = tag.model:GetAttribute("Total") or 1
	tag.count.Text = Format.commas(remaining) .. " straws"
	tag.fill.Size = UDim2.fromScale(math.clamp(remaining / total, 0, 1), 1)
	local id = tag.model.Name
	if remaining <= 0 then
		tag.status.Text, tag.status.TextColor3 = "SEARCHED OUT", Ui.colors.grey
	elseif possible and not possible.set[id] then
		tag.status.Text, tag.status.TextColor3 = "RULED OUT", Color3.fromRGB(255, 120, 100)
	elseif possible and possible.count == 1 and not solved then
		tag.status.Text, tag.status.TextColor3 = "THE NEEDLE IS HERE!", Color3.fromRGB(140, 255, 140)
	elseif possible then
		tag.status.Text, tag.status.TextColor3 = "COULD BE HERE", Ui.colors.hay
	else
		tag.status.Text = ""
	end
end

local function makeTag(model)
	local core = model:WaitForChild("Core")
	local gui = Ui.make("BillboardGui", {
		Name = "PileTag_" .. model.Name,
		Adornee = core,
		Size = UDim2.fromScale(16, 6),
		StudsOffset = Vector3.new(0, 17, 0),
		MaxDistance = 350,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	Ui.label({ Text = (model:GetAttribute("DisplayName") or model.Name) .. " haystack", Size = UDim2.fromScale(1, 0.32), Parent = gui }, 60)
	local count = Ui.label({ Size = UDim2.fromScale(1, 0.22), Position = UDim2.fromScale(0, 0.32), TextColor3 = Ui.colors.hay, Parent = gui }, 44)
	local bar = Ui.make("Frame", { Size = UDim2.fromScale(0.8, 0.1), Position = UDim2.fromScale(0.1, 0.57), BackgroundColor3 = Ui.colors.woodDark, Parent = gui }, { Ui.corner(6) })
	local fill = Ui.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Ui.colors.hay, Parent = bar }, { Ui.corner(6) })
	local status = Ui.label({ Size = UDim2.fromScale(1, 0.26), Position = UDim2.fromScale(0, 0.72), Parent = gui }, 44)
	local attachment = Ui.make("Attachment", { Name = "StrawFx", Parent = core })
	local emitter = Ui.make("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(14, 26),
		SpreadAngle = Vector2.new(65, 65),
		Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new(0.7, 0.2),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-200, 200),
		Color = ColorSequence.new(Color3.fromRGB(242, 212, 120)),
		LightEmission = 0.15,
		EmissionDirection = Enum.NormalId.Top,
		Parent = attachment,
	})
	local tag = { model = model, core = core, gui = gui, count = count, fill = fill, status = status, attachment = attachment, emitter = emitter }
	tags[model.Name] = tag
	model:GetAttributeChangedSignal("Remaining"):Connect(function()
		refreshTag(tag)
	end)
	refreshTag(tag)
end

local function floatText(tag, text, colour)
	local gui = Ui.make("BillboardGui", {
		Adornee = tag.core,
		Size = UDim2.fromScale(10, 2.5),
		StudsOffset = Vector3.new(math.random(-4, 4), tag.core.Size.Y * 0.5 + 2, 0),
		LightInfluence = 0,
		AlwaysOnTop = true,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	local label = Ui.label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = colour, Parent = gui }, 60)
	TweenService:Create(gui, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = gui.StudsOffset + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(gui, 1.1)
end

local function burst(tag, count)
	tag.attachment.Position = Vector3.new(0, tag.core.Size.Y * 0.42, 0)
	tag.emitter:Emit(count)
end

function WorldFx.searched(message)
	local tag = tags[message.pile]
	if not tag then
		return
	end
	if message.empty then
		floatText(tag, "Nothing left here!", Ui.colors.grey)
		return
	end
	burst(tag, math.clamp(math.floor(message.straws / 500) + 6, 6, 24))
	floatText(tag, "+" .. Format.short(message.coins) .. " coins", Ui.colors.hay)
end

function WorldFx.celebrate(pileId)
	local tag = tags[pileId]
	if tag then
		burst(tag, 80)
		floatText(tag, "NEEDLE FOUND!", Color3.fromRGB(140, 255, 140))
	end
end

-- clues: your clues this case, in order. The latest one says which haystacks are still possible.
function WorldFx.setClues(clues, isSolved)
	solved = isSolved == true
	local latest = clues[#clues]
	if latest then
		possible = { set = {}, count = #latest.possible }
		for _, id in ipairs(latest.possible) do
			possible.set[id] = true
		end
	else
		possible = nil
	end
	for _, tag in pairs(tags) do
		refreshTag(tag)
	end
end

local function spinWindmill()
	local landmarks = workspace:WaitForChild("Landmarks", 60)
	local windmill = landmarks and landmarks:WaitForChild("windmill", 30)
	local blades = windmill and windmill:WaitForChild("Blades", 30)
	if not blades then
		return
	end
	RunService.RenderStepped:Connect(function(dt)
		blades:PivotTo(blades:GetPivot() * CFrame.Angles(0, 0, dt * 0.5))
	end)
end

-- Close to a haystack its floating label sits behind the top bar, so it hides and the
-- same facts show in a panel above the hotbar instead.
local function buildHerePanel(gui)
	local frame = Ui.make("Frame", {
		Name = "Here",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(380, 76),
		BackgroundColor3 = Ui.colors.wood,
		Visible = false,
		Parent = gui,
	}, { Ui.corner(14), Ui.stroke(Ui.colors.woodDark, 3) })
	Ui.autoScale(frame)
	here = {
		frame = frame,
		name = Ui.label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 4), Parent = frame }, 26),
		count = Ui.label({ Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 31), TextColor3 = Ui.colors.hay, Parent = frame }, 20),
		status = Ui.label({ Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 52), Parent = frame }, 20),
	}
end

local function watchNearby()
	while true do
		task.wait(0.2)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local nearest, best = nil, Config.SearchRange + 4
		if root then
			for _, tag in pairs(tags) do
				local centre = tag.model:GetPivot().Position
				local flat = Vector3.new(root.Position.X - centre.X, 0, root.Position.Z - centre.Z).Magnitude
				if flat < best then
					nearest, best = tag, flat
				end
			end
		end
		for _, tag in pairs(tags) do
			tag.gui.Enabled = tag ~= nearest
		end
		if here then
			here.frame.Visible = nearest ~= nil
			if nearest then
				here.name.Text = (nearest.model:GetAttribute("DisplayName") or "") .. " haystack (" .. (nearest.model:GetAttribute("Side") or "") .. ")"
				here.count.Text = nearest.count.Text .. " left. Click to search!"
				here.status.Text = if nearest.status.Text ~= "" then nearest.status.Text else "Find clues to rule haystacks out"
				here.status.TextColor3 = if nearest.status.Text ~= "" then nearest.status.TextColor3 else Ui.colors.white
			end
		end
	end
end

function WorldFx.start(gui)
	buildHerePanel(gui)
	task.spawn(watchNearby)
	task.spawn(function()
		local folder = workspace:WaitForChild("Haystacks", 60)
		if not folder then
			return
		end
		for _, model in ipairs(folder:GetChildren()) do
			task.spawn(makeTag, model)
		end
		folder.ChildAdded:Connect(makeTag)
	end)
	task.spawn(spinWindmill)
end

return WorldFx
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="Workspace" referent="RBX00028">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">false</bool>
		</Properties>
	</Item>
</roblox>
